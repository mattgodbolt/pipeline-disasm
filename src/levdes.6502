; $.LEVDES: &D9 bytes at sector &113. The stub loader for the Level Designer
; (MENU option 4, `*/LEVDES`): reads H.LEVDES from its hidden sectors and
; enters it. All of the code is in loader.6502inc, shared with GAME and
; GRAPHIC.

INCLUDE "os.6502inc"

; H.LEVDES, as src/disc.toml places it: track 36 sector 5 to track 39 sector 5.
; It's entered well inside itself.
hidden_first_sector = &16D
hidden_length = &1F00
hidden_load = &1100
hidden_entry = &2E21

SECTION levdes, filename="LEVDES", org=&0900, load=&900, exec=&900
.levdes_loader
{
    INCLUDE "loader.6502inc"
}
ENDSECTION

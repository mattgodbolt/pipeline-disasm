; $.LEVDES: the catalogued file at sector &113, &D9 bytes loaded and run at
; &0900. The stub loader for the Level Designer (MENU option 4,
; `*/LEVDES`): it reads H.LEVDES from its hidden sectors and enters it. All
; of the code is in hidden_loader.6502inc, which says what a stub and a
; hidden run are; it's shared with GAME and GRAPHIC, and this file gives it
; the four numbers that differ.

INCLUDE "os.6502inc"
INCLUDE "osconst.6502inc"

; H.LEVDES, the Level Designer's hidden run. No catalogue entry names it:
; the name is the build's (src/hidden_levdes.6502 makes it, src/disc.toml
; places it). Track 36 sector 5 to track 39 sector 5. It's entered well
; inside itself. Each source assembles on its own, so the addresses are
; written out here.
hidden_first_sector = &16D
hidden_length = &1F00
hidden_load = &1100
hidden_entry = &2E21                    ; entry, in hidden_levdes.6502

SECTION levdes, filename="LEVDES", org=&0900, load=&900, exec=&900
.levdes_loader
{
    INCLUDE "hidden_loader.6502inc"
}
ENDSECTION

; The layout of IO, the mission file: everything the game knows about a
; mission's four levels, packed to end at &5800 where the game keeps the map
; of the level being played. MISSION (the Mission Generator) saves it with
;   l0addr=&5800-numlev*size-grfs-attrs-miss-names
; and the sizes below are its numlev, size, grfs, attrs, miss and names; a
; level's fields and map are as leveldata.6502inc has them.
; H.GAME loads it with OSFILE and reads it at these addresses, so they're
; shared by src/io.6502 (which lays IO out) and src/hidden_game.6502.
INCLUDE "leveldata.6502inc"

IO_LEVELS        = 4
IO_LEVEL_FIELDS  = LEVEL_FIELDS_SIZE    ; per level, the fields, interleaved
IO_MAP_SIZE      = MAP_BYTES            ; per level, 64 x 64 cells of 4 bits
IO_LEVEL_SIZE    = IO_LEVEL_FIELDS + IO_MAP_SIZE
IO_GRAPHICS_SIZE = &E00        ; 28 pictures of 128 bytes
IO_ATTRS_SIZE    = 5
IO_MISSION_SIZE  = 30          ; the mission text, two halves of 15
IO_NAMES_SIZE    = &134        ; an extra picture and the object names
IO_END           = &5800

io_start = IO_END - IO_LEVELS * IO_LEVEL_SIZE - IO_GRAPHICS_SIZE - IO_ATTRS_SIZE - IO_MISSION_SIZE - IO_NAMES_SIZE

; The names block, which the Graphics Designer keeps with the graphics (it is
; DEFAULT's last &134 bytes): a picture drawn for a map cell marked as
; holding an object when no object is there, then fifteen 12-character
; object names.
io_no_object_picture = io_start
IO_NAME_LENGTH       = 12
io_object_names      = io_no_object_picture + 128

; The mission text: two VDU 31 (TAB) sequences and 12 characters each, with
; spaces stored as 9 (cursor right) so they don't paint over the background.
io_mission_text = io_start + IO_NAMES_SIZE

; The mission's attributes, set by MISSION's "change features".
io_attrs            = io_mission_text + IO_MISSION_SIZE
io_time_rate        = io_attrs + 0  ; added to a counter each cycle; the clock ticks when it carries
io_map_levels       = io_attrs + 1  ; the map (M) works on levels below this
io_backpack_last    = io_attrs + 2  ; the backpack's last slot: it holds this plus one
io_throw_distance   = io_attrs + 3  ; how far a thrown object flies, in cells
io_locked           = io_attrs + 4  ; negative: a finished mission shows an entry code

; The levels' fields, each stored as IO_LEVELS consecutive entries (level 0's,
; then level 1's...): field f of level s is at
;   io_levels + IO_LEVELS * LEVEL_FIELD_OFFSETS[f] + s * LEVEL_FIELD_SIZES[f]
; (MISSION's L% + numlev * pnt + S% * ext).
io_levels             = io_attrs + IO_ATTRS_SIZE
io_edit_code_high     = io_levels + IO_LEVELS * LEVEL_FIELD_OFFSETS[0]  ; the edit code, which MISSION
io_edit_code_middle   = io_levels + IO_LEVELS * LEVEL_FIELD_OFFSETS[1]  ; asks for before it saves an
io_edit_code_low      = io_levels + IO_LEVELS * LEVEL_FIELD_OFFSETS[2]  ; edited level
io_palettes           = io_levels + IO_LEVELS * LEVEL_FIELD_OFFSETS[3]  ; 4 each: logical << 4 | physical
io_level_setup        = io_levels + IO_LEVELS * LEVEL_FIELD_OFFSETS[4]  ; 8 each: LEVEL_*
io_level_objects      = io_levels + IO_LEVELS * LEVEL_FIELD_OFFSETS[5]  ; 32 each: 8 objects of 4 bytes
io_level_monsters     = io_levels + IO_LEVELS * LEVEL_FIELD_OFFSETS[6]  ; 16 each: 4 monsters of 4 bytes
io_level_trigger_flags = io_levels + IO_LEVELS * LEVEL_FIELD_OFFSETS[7] ; 32 each: a byte per trigger
io_level_trigger_places = io_levels + IO_LEVELS * LEVEL_FIELD_OFFSETS[8] ; 64 each: x, y per trigger
io_level_trigger_args_0 = io_levels + IO_LEVELS * LEVEL_FIELD_OFFSETS[9] ; 64 each: triggers 0-15, 4 bytes each
io_level_trigger_args_1 = io_levels + IO_LEVELS * LEVEL_FIELD_OFFSETS[10] ; 64 each: triggers 16-31

; The maps, 64 columns of 32 bytes: column x's cells y and y+1 share a byte,
; even y in the high nibble. The cell types are CELL_*.
io_maps = io_levels + IO_LEVELS * IO_LEVEL_FIELDS

; The graphics, as the Graphics Designer saves them (DEFAULT's first &E00
; bytes). Each 128-byte picture is 4 x 4 character cells of 8 bytes in MODE 5,
; stored a column at a time; the object icons are 2 x 2 cells.
io_graphics      = io_maps + IO_LEVELS * IO_MAP_SIZE
io_tiles         = io_graphics            ; 16 pictures, one per map cell type
io_object_icons  = io_graphics + 16 * 128 ; 16 icons of 32 bytes
io_player        = io_graphics + 20 * 128 ; 4 pictures, facing each way
io_alternates    = io_graphics + 24 * 128 ; second pictures for cell types 5, 7, 8, A

ASSERT io_graphics + IO_GRAPHICS_SIZE = IO_END

; Level 2: the second of IO's four. Written as leveldata.6502inc describes;
; src/io.6502 makes its bytes from this. A mission doesn't keep its levels'
; trigger names (MISSION names them "Puzzle 1" to "Puzzle 32" when it saves
; one as a level file), so these have none.
level_2 = {
    ; The editing code: MISSION wants it before it saves a locked mission's
    ; level, and the game shows it once the level's done.
    "878702",
    ; The palette: logical colours 0-3.
    {COLOUR_BLACK, COLOUR_BLUE, COLOUR_WHITE, COLOUR_RED},
    ; The setup.
    {
        54, 23,                         ; the player starts here
        84,                             ; sulphur to collect before the exit opens
        250,                            ; the clock
        63, 63,                         ; the exit
        CELL_SULPHUR * 16 + CELL_LAVA,  ; a monster reaching lava (~) goes out, leaving sulphur (o)
        %00000101                       ; second pictures: o on odd squares, ~ on odd squares
    },
    ; The objects: x, y, icon, uses and flags.
    {
        {35, 37, 14, OBJECT_VANISHES + 1},                   ; 0: Explosives
        {22, 61, 0, OBJECT_NO_THROW + 1},                    ; 1: Remote C.D.1
        {17, 59, 3, OBJECT_VANISHES + OBJECT_NO_THROW + 1},  ; 2: Blueprints
        {22, 22, 1, OBJECT_VANISHES + OBJECT_NO_THROW + 1},  ; 3: Remote C.D.2
        {42, 38, 2, OBJECT_NO_THROW + 1},                    ; 4: Remote C.D.3
        {44, 20, 14, OBJECT_VANISHES + 1},                   ; 5: Explosives
        {15, 48, 10, OBJECT_NO_THROW + 1},                   ; 6: Fire Blanket
        {10, 0, 12, OBJECT_NO_THROW + 8}                     ; 7: Extinguisher
    },
    ; The monsters: x, y, the way they're going, and which ways they try.
    {
        {21, 30, DIRECTION_LEFT, PATTERN_LEFT_WALL},        ; 0
        {19, 41, DIRECTION_RIGHT, PATTERN_BACK_AND_FORTH},  ; 1
        {14, 61, DIRECTION_DOWN, PATTERN_LEFT_WALL},        ; 2
        {28, 20, DIRECTION_DOWN, PATTERN_FOLLOW_EDGES}      ; 3
    },
    ; The triggers: name, action and flags, where, the action's A, X and Y,
    ; and a condition.
    {
        ; 0: blows up object 0
        {"", PUZZLE_DETONATE_OBJECT + PUZZLE_USES_OBJECT, 19, 63, &00, &18, &00, &2F},
        ; 1: (26, 42) becomes the floor (.); when facing up at a marker (@)
        {"", PUZZLE_PLACE_BLOCK + PUZZLE_USES_OBJECT, 26, 43, &00, &1A, &2A, &E9},
        ; 2: the cell in front becomes lava (~); when facing down at an object ($)
        {"", PUZZLE_NEXT_BLOCK + PUZZLE_USES_OBJECT, 20, 39, &0A, &A0, &A0, &FF},
        ; 3: (62, 39) becomes the floor (.); when facing right at a marker (@)
        {"", PUZZLE_PLACE_BLOCK + PUZZLE_USES_OBJECT, 61, 39, &00, &3E, &27, &D9},
        ; 4: (21, 32) becomes a pipe across (-); when facing left at a marker (@)
        {"", PUZZLE_PLACE_BLOCK + PUZZLE_USES_OBJECT, 22, 32, &0C, &15, &20, &C9},
        ; 5: blows up object 5; when facing down at a wall (=)
        {"", PUZZLE_DETONATE_OBJECT + PUZZLE_USES_OBJECT, 50, 31, &05, &A0, &14, &F8},
        ; 6: sets monster 0 going down
        {"", PUZZLE_MOVE_MONSTER + PUZZLE_USES_OBJECT + PUZZLE_REUSABLE, IGNORE + 61, IGNORE + 63, &03, &00, &00, &3E},
        ; 7: gives object 6 1 use and turns on trigger 6
        {"", PUZZLE_CHARGE_OBJECT + PUZZLE_USES_OBJECT + PUZZLE_REUSABLE, IGNORE + 63, IGNORE + 61, &06, &3F, &01, &39},
        ; 8: the cell at (20, 40) moves down; when facing right at a crate (c)
        {"", PUZZLE_MOVE_BLOCK, 21, 43, &03, &14, &28, &D6},
        ; 9: (35, 40) becomes a pipe across (-); when facing left
        {"", PUZZLE_PLACE_BLOCK, 36, 42, &0C, &23, &28, &80},
        ; 10: (33, 47) becomes a pipe down (|); when facing up
        {"", PUZZLE_PLACE_BLOCK, 30, 46, &0D, &21, &2F, &A0},
        ; 11: turns off trigger 6
        {"", PUZZLE_TURN_OFF + PUZZLE_REUSABLE, 54, 23, &06, &06, &06, &2F},
        ; 12: sets the clock to 187
        {"", PUZZLE_SET_LEVELS, 41, 29, &01, &BB, &15, &06},
        ; 13: the cell at (47, 31) moves down and right; when facing down
        {"", PUZZLE_MOVE_BLOCK, 50, 29, &07, &2F, &1F, &BF},
        ; 14: puts monster 0 at (14, 5) going right, following edges; when facing right
        {"", PUZZLE_PLACE_MONSTER + PUZZLE_REUSABLE, 13, 7, &38, &39, &15, &96},
        ; 15: puts monster 0 at (32, 20) going up, keeping to the right wall; when facing left
        {"", PUZZLE_PLACE_MONSTER + PUZZLE_REUSABLE, 29, 29, &80, &36, &52, &80},
        ; 16: turns on trigger 17; when facing left
        {"", PUZZLE_TURN_ON + PUZZLE_REUSABLE, 29, 29, &11, &11, &11, &80},
        ; 17: pushes the cell in front forwards; when facing a crate (c)
        {"", PUZZLE_MOVE_NEXT_BLOCK + PUZZLE_OFF + PUZZLE_REUSABLE, IGNORE + 32, IGNORE + 32, &04, &A0, &A0, &66},
        ; 18: turns off trigger 17; when facing right
        {"", PUZZLE_TURN_OFF + PUZZLE_REUSABLE, 29, 29, &11, &11, &11, &90},
        ; 19: the cell at (55, 17) moves right; when facing up
        {"", PUZZLE_MOVE_BLOCK, 58, 15, &01, &37, &11, &A0},
        ; 20: the cell at (57, 9) moves down and right; when facing up
        {"", PUZZLE_MOVE_BLOCK, 56, 7, &07, &39, &09, &A0},
        ; 21: turns on trigger 22; when facing up
        {"", PUZZLE_TURN_ON + PUZZLE_REUSABLE, 37, 31, &16, &16, &16, &A0},
        ; 22: pushes the cell in front to the right; when facing a pipe down (|)
        {"", PUZZLE_MOVE_NEXT_BLOCK + PUZZLE_OFF + PUZZLE_REUSABLE, IGNORE + 32, IGNORE + 32, &08, &A0, &A0, &6D},
        ; 23: turns off trigger 22; when facing down
        {"", PUZZLE_TURN_OFF + PUZZLE_REUSABLE, 37, 31, &16, &16, &16, &B0},
        ; 24: the cell in front becomes a pipe down (|); when facing the floor (.)
        {"", PUZZLE_NEXT_BLOCK + PUZZLE_OFF + PUZZLE_REUSABLE, IGNORE + 32, IGNORE + 32, &0D, &A0, &A0, &60},
        ; 25: turns on trigger 24; when facing down
        {"", PUZZLE_TURN_ON + PUZZLE_REUSABLE, 4, 57, &18, &18, &18, &B0},
        ; 26: turns off trigger 24; when facing up
        {"", PUZZLE_TURN_OFF + PUZZLE_REUSABLE, 7, 19, &18, &18, &18, &A0},
        ; 27: turns off trigger 22; when facing up
        {"", PUZZLE_TURN_OFF + PUZZLE_REUSABLE, 42, 19, &16, &16, &16, &A0},
        ; 28: puts monster 0 at (42, 44) going right, following edges; when facing down
        {"", PUZZLE_PLACE_MONSTER + PUZZLE_REUSABLE, 40, 40, &A8, &39, &B1, &B0},
        ; 29: turns on trigger 6; when facing down
        {"", PUZZLE_TURN_ON + PUZZLE_REUSABLE, 40, 40, &06, &06, &06, &B0},
        ; 30: turns off trigger 6; when facing up
        {"", PUZZLE_TURN_OFF + PUZZLE_REUSABLE, 40, 40, &06, &06, &06, &A0},
        ; 31: turns off triggers 22, 24 and 17
        {"", PUZZLE_TURN_OFF + PUZZLE_REUSABLE, 54, 23, &16, &18, &11, &20}
    },
    ; The map.
    {

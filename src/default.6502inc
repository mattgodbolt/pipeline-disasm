    "..33..333333....33..33......11..",
    "..33..33..33....33..33..11111111",
    "..33..3333....3333..33..11111111",
    "..1133..33333333..3333......11..",
    "..333333........333333......11..",
    "..11333333333333333333......11..",
    "..3311333333333333..33......11..",
    "..11333333333333......2222......",
    "..2211331133333333....22222222..",
    "222233113311331133..222222222222",
    "22222222113311332222222222222222",
    "222222222222222222222222222222..",
    "..22222222222222222222222222....",
    "......22222222222222............"
}

; The names of icons 0-14, 12 characters each.
default_object_names = {
    "Remote C.D.1",  ; 0
    "Remote C.D.2",  ; 1
    "Remote C.D.3",  ; 2
    " Blueprints ",  ; 3
    "   Mallet   ",  ; 4
    "  Spanner   ",  ; 5
    "Screwdriver ",  ; 6
    "   Magnet   ",  ; 7
    "Space Burger",  ; 8
    "Jovian Wine ",  ; 9
    "Fire Blanket",  ; 10
    " Laser Gun  ",  ; 11
    "Extinguisher",  ; 12
    " Detonator  ",  ; 13
    " Explosives "   ; 14
}

DEFAULT_NAME_LENGTH = 12

; The bytes of slots &00-&27, the graphics, as they start a graphics file and
; end a mission. (FUNCTIONs rather than macros: baron's symbol dump keeps a
; function's frame twice when it's called inside a macro.)
FUNCTION default_graphics() = FLATTEN({
    mode5_pictures(default_tiles),
    mode5_pictures(default_icons),
    mode5_pictures(default_player),
    mode5_pictures(default_alternates)
})

; The bytes of MISSION's names: slot &28 and the object names, as they end a
; graphics file and start a mission.
FUNCTION default_names()
    names = CODES(default_object_names)
    ASSERT RANK(names) = 2 AND LEN(names[0]) = DEFAULT_NAME_LENGTH, "an object's name is 12 characters"
= CONCAT(mode5_pictures({default_no_object}), FLATTEN(names))

; Constants for H.GAME (src/hidden_game.6502): its screen and pictures, and
; what the numbers in its data mean. The game INCLUDEs this inside its own
; scope, after os.6502inc, osconst.6502inc and io.6502inc (which brings
; leveldata.6502inc: CELL_*, DIRECTION_*, OBJECT_*, PUZZLE_* and the rest of
; a level's shared names). Baron lets a scope define a name the file has
; already defined outside it, silently, so nothing here may repeat a name
; from those.

; ---------------------------------------------------------------------------
; The screen: MODE 5 reprogrammed to 32 x 32 character cells in 8K, which the
; hardware scrolls and wraps round. A character cell is 4 pixels across and 8
; lines down, a byte a line; a character row is 32 of them.

SCREEN         = &6000
SCREEN_SIZE    = &2000
SCREEN_END     = SCREEN + SCREEN_SIZE
CHAR_BYTES     = 8
ROW_BYTES      = &100
SCREEN_COLUMNS = ROW_BYTES / CHAR_BYTES
SCREEN_ROWS    = SCREEN_SIZE / ROW_BYTES
ASSERT SCREEN_END = SCREEN_MEMORY_END    ; &8000: loops end when the high byte goes negative

; Text goes through the OS, which still thinks the screen is MODE 5's: from
; &5800, rows of 320 bytes, characters 16 bytes (two of the game's character
; cells) across. So TAB(x, y) lands at MODE5_SCREEN + 320y + 16x, which on the
; game's screen (starting at SCREEN, as on the title and backpack screens) is
; a character row and column; a TAB to the OS's rows 0-6 would land below
; SCREEN, in the map. TEXT_AT sends the TAB for a column and row of the
; game's screen; only even columns can be reached.
FUNCTION text_offset(column, row) = SCREEN - MODE5_SCREEN + row * ROW_BYTES + column * CHAR_BYTES
MACRO TEXT_AT column, row
    ASSERT text_offset(column, row) MOD MODE5_CHAR_BYTES = 0, "text can't start at column ", column
    EQUB VDU_TAB, (text_offset(column, row) MOD MODE5_ROW_BYTES) DIV MODE5_CHAR_BYTES, text_offset(column, row) DIV MODE5_ROW_BYTES
ENDMACRO

; ---------------------------------------------------------------------------
; The map's pictures (io.6502inc has the layout of IO, the mission, and
; leveldata.6502inc the map's).

; A map cell is drawn as a picture of 4 x 4 character cells, stored a column
; at a time; an object's icon is 2 x 2, drawn in the middle of a floor
; picture. The view is 8 map cells across and down, the player in the middle;
; it's offset by half a cell, so half a cell more shows at each edge.
CHARS_PER_CELL       = 4
PLAYER_CHAR          = (SCREEN_COLUMNS - CHARS_PER_CELL) / 2 ; the player's top left, from the view's
PICTURE_BYTES        = CHARS_PER_CELL * CHARS_PER_CELL * CHAR_BYTES
PICTURE_COLUMN_BYTES = CHARS_PER_CELL * CHAR_BYTES
ICON_BYTES           = PICTURE_BYTES / 4
ICON_COLUMN_BYTES    = PICTURE_COLUMN_BYTES / 2
VIEW_CELLS           = SCREEN_COLUMNS / CHARS_PER_CELL
ASSERT PICTURE_BYTES = LARGE_SPRITE_SIZE AND ICON_BYTES = SMALL_SPRITE_SIZE

; Positions in character cells (view_x and view_y, the view's top left;
; monsters; sprites): 64 map cells of 4 make 256, so a position is a byte, and
; a view off the map's left or top edge has a view_x or view_y from &FF down.
MAP_CHARS = MAP_SIZE * CHARS_PER_CELL
ASSERT MAP_CHARS = &100

; The views the game makes. Standing still, the view is half a cell into a
; map cell (place_player) and the player PLAYER_CHAR characters into the view;
; the player never leaves the map (stepping into lava or fire kills without
; the step, and a pipe kills with lava ahead), so the view goes from
; VIEW_FIRST, -PLAYER_CHAR (the player in the map's first column or row), up
; through 0 to VIEW_LAST (its last), passing through every value between
; while walking: &F2-&FF and &00-&EE, but never &EF-&F1. The title and
; backpack screens put it at CHARS_PER_CELL / 2.
VIEW_FIRST = MAP_CHARS - PLAYER_CHAR
VIEW_LAST  = MAP_CHARS - CHARS_PER_CELL - PLAYER_CHAR

; clip_sprite_x and clip_sprite_y sort a view into three kinds by its view_x
; (or view_y): below VIEW_PAST_END, a view on the map, compared plainly; from
; VIEW_PAST_END, a view running off the map's right (bottom) edge, where
; anything past view_x is in view, its far edge not checked; from
; VIEW_BEFORE_START, one hanging off the left (top) edge, view_x being
; negative, where nothing is before it.
;
; For everything on the map (positions 0 to MAP_CHARS - CHARS_PER_CELL) both
; are exact, and so would some others be (checked by running draw_sprite for
; every position at every view the game makes, docs/notes/game.md):
; - VIEW_PAST_END could be anything from MAP_CHARS - SCREEN_COLUMNS (&E0),
;   from where the view reaches the map's last column, so the far edge needn't
;   be checked, to MAP_CHARS - (SCREEN_COLUMNS - CHARS_PER_CELL) (&E4), up to
;   where a plain view's view_x + 28 doesn't carry. &E2, the middle, is the
;   first view standing still whose last half cell is off the map. Lower, a
;   sprite in the map's last column would have its columns past the view's
;   right edge drawn at its left edge, a row down; higher, sprites near the
;   map's end would vanish while walking.
; - VIEW_BEFORE_START could be anything from VIEW_LAST + 1 to VIEW_FIRST,
;   the views between never being made; &F1 is one short of VIEW_FIRST.
;   Lower, a view at the map's right edge would show sprites from its left
;   edge in the lava past it; higher, a view at the left edge would lose the
;   sprites there.
VIEW_PAST_END     = (MAP_SIZE - VIEW_CELLS) * CHARS_PER_CELL + CHARS_PER_CELL / 2
VIEW_BEFORE_START = VIEW_FIRST - 1
ASSERT MAP_CHARS - SCREEN_COLUMNS <= VIEW_PAST_END AND VIEW_PAST_END <= MAP_CHARS - (SCREEN_COLUMNS - CHARS_PER_CELL)
ASSERT VIEW_LAST < VIEW_BEFORE_START AND VIEW_BEFORE_START <= VIEW_FIRST
ASSERT SCREEN_ROWS = SCREEN_COLUMNS      ; the same numbers serve view_y

; Pictures by number from io_tiles: the cell types' (0-15), the object icons
; four to a picture (16-19), the player facing each way (20-23), and the
; second pictures of four cell types (24-27). The monsters are drawn with cell
; type E's picture and the one after it (F's, which isn't otherwise shown).
FUNCTION tile(type) = io_tiles + type * PICTURE_BYTES
FUNCTION icon(n) = io_object_icons + n * ICON_BYTES
FUNCTION player_facing(direction) = io_player + direction * PICTURE_BYTES
FIRST_ALTERNATE = (io_alternates - io_tiles) DIV PICTURE_BYTES
ALTERNATES      = 4       ; cell types with a second picture

; ---------------------------------------------------------------------------
; Directions are DIRECTION_LEFT to DIRECTION_DOWN (0-3), as the player faces,
; monsters go and direction_dx and _dy step. Those tables go on to the four
; diagonals (4-7), which explosions and Move block step to, and
; DIRECTION_NONE, no step at all (the same number as MONSTER_GONE, but the
; game's own, for those tables). A thrown object's direction is one of
; DIRECTION_* plus one, so that 0 can mean nothing's in flight.
DIRECTION_NONE = DIRECTION_DOWN_RIGHT + 1
THROWN_NONE  = 0
THROWN_LEFT  = DIRECTION_LEFT + 1
THROWN_RIGHT = DIRECTION_RIGHT + 1
THROWN_UP    = DIRECTION_UP + 1
THROWN_DOWN  = DIRECTION_DOWN + 1

; The turns table has a row of four directions for each TURN_*
; (leveldata.6502inc), the turn's row starting at TURN_* * TURN_ROW.
TURN_ROW = 4

; ---------------------------------------------------------------------------
; The player's actions, as action_table has them. The action keys are tested
; in this order, so the game keeps them in action_keys this way round.
ACTION_NONE     = 0
ACTION_PICK_UP  = 1     ; P
ACTION_DROP     = 2     ; D
ACTION_MAP      = 3     ; M
ACTION_BACKPACK = 4     ; CTRL
ACTION_THROW    = 5     ; T
ACTION_USE      = 6     ; Return
ACTION_LEFT     = 7     ; then ACTION_LEFT + each direction
ACTION_RIGHT    = 8
ACTION_UP       = 9
ACTION_DOWN     = 10
ACTION_STOP     = 11    ; a trigger stopped the player: nothing

; The order MENU leaves its ten keys in, as negative INKEY numbers.
MENU_KEY_LEFT     = 0
MENU_KEY_RIGHT    = 1
MENU_KEY_UP       = 2
MENU_KEY_DOWN     = 3
MENU_KEY_PICK_UP  = 4
MENU_KEY_DROP     = 5
MENU_KEY_USE      = 6
MENU_KEY_THROW    = 7
MENU_KEY_BACKPACK = 8
MENU_KEY_MAP      = 9
MENU_KEYS         = 10

; ---------------------------------------------------------------------------
; A level's monsters, objects and triggers, as the game keeps them.

; Monsters (MONSTERS of MONSTER_BYTES): x and y in character cells (4 to a
; map cell), a direction, and turning preferences. A direction plus
; MONSTER_STUCK is a monster that couldn't move; MONSTER_GONE and up, one
; that isn't out.
MONSTER_STUCK = 4

; Objects (OBJECTS of OBJECT_BYTES): x, y (x OBJECT_ABSENT while carried or
; in flight), an icon, and uses and flags. The game reads the uses with
; OBJECT_NO_CHARGES as well as OBJECT_CHARGES, so that it makes 32 or more,
; which never run out; OBJECT_NO_THROW's object can still be thrown, but its
; triggers aren't tried when it lands.
OBJECT_USES  = OBJECT_CHARGES OR OBJECT_NO_CHARGES

; The backpack: a slot holds an object's number, or is negative for empty.
; On the backpack screen its slots are BACKPACK_SPACING characters apart.
BACKPACK_SLOTS   = 4
EMPTY_SLOT       = &FF
BACKPACK_SPACING = 6

; Triggers (the designer's puzzles: PUZZLES of them): a flags byte, a place,
; and four arguments. Object n's triggers are n, n + OBJECTS, n + 2 * OBJECTS
; and n + 3 * OBJECTS. The flags' PUZZLE_ACTION is the action (PUZZLE_*, an
; index into trigger_actions), the rest PUZZLE_REUSABLE and the like; IGNORE
; in a place's x or y matches anywhere along it. The fourth argument is the
; condition (CONDITION_*): facing (or thrown) a direction, facing (or landing
; against) a cell type.

START_LIVES = 3

; How far through a level the player is (stage).
STAGE_COLLECTING = 0
STAGE_EXIT_LIT   = 1    ; just lit: the time left is scored
STAGE_ESCAPING   = 2    ; a few clock ticks to get clear
STAGE_DONE       = 3

; ---------------------------------------------------------------------------
; Sound.

CHANNEL_EFFECTS = 3       ; the sound effects' channel (SOUND_FLUSH and the rest
                          ; are in osconst.6502inc)

; Envelopes 1 and 2 are the tune's (each voice's channel is also its
; envelope); 3 and 4 the sound effects', which use 1 and 2 as well.
ENVELOPE_VOICE_1 = 1
ENVELOPE_VOICE_2 = 2
ENVELOPE_TONE    = 3
ENVELOPE_BEEP    = 4

; The tune: pitches go up 4 to a semitone.
TUNE_VOICE_BYTES = 32     ; a voice's notes...
TUNE_NOTES       = 30     ; ...of which this many are played
TUNE_LOWEST      = &21
SEMITONE         = 4
OCTAVE           = 12 * SEMITONE
TRANSPOSE_FOURTH = 5 * SEMITONE

; ---------------------------------------------------------------------------
; While IO loads, this much of the game (from the NMI routine's page, where
; the DFS's workspace was) is swapped out with the start of the screen.
SWAP_START = MOS_NMI_ROUTINE
SWAP_PAGES = &10
SWAP_END   = SWAP_START + SWAP_PAGES * &100

; The longest mission file name the title screen's L takes.
FILENAME_LENGTH = 12

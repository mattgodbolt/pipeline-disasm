; $.MENU: the PIPELINE menu, by Ian Holmes ("Originally: GUILDMASTER"),
; CHAINed by !BOOT, which MRUN runs again to bring the menu back when the
; designers or MISSION finish. A BASIC program at &1900 (PAGE on a B with a
; disc filing system), and past its end, in the same file, what its DIMs
; hold:
;
;   &1900  the program: setup, the loading picture (SCREEN) and the warning
;          page (WARNING), then the menu, which starts the game or the
;          designers, redefines the keys, or CHAINs MISSION
;   &2300  C%: the scroller, a vsync event handler that scrolls a long
;          message through the bottom eight rows of the menu, and the
;          message
;   &3200  S%: the top 16 rows of the menu screen, then leftovers, among
;          them a tune program at PAGE+&1C00
;
; The source follows the same order: lines 10-40 as EQUB records, the
; BASIC block (lines 50-1020), then C% and S% as code and data.
;
; The game and the two designers are each started through a stub: the
; small catalogued file GAME, GRAPHIC or LEVDES, which reads the real
; program from sectors the disc's catalogue doesn't list
; (hidden_loader.6502inc). Option 1 shows TITLE before */GAME. With W and T
; held down as the menu starts, line 290 runs PL, a hidden cheat, instead.
;
; It leaves the game's ten keys in &50-&59.
INCLUDE "os.6502inc"
INCLUDE "osconst.6502inc"
INCLUDE "basic.6502inc"
INCLUDE "teletext.6502inc"

; Where the scroller draws: eight rows at the bottom of the screen. Columns
; 0 and 1 hold its colour codes; 38 and 39 stay blank.
SCROLL_TOP   = 17
SCROLL_ROWS  = 8
SCROLL_LEFT  = 2
SCROLL_RIGHT = 37

; The scroller's zero page. It runs on the vsync event, under whatever BASIC
; is doing, so it keeps to the user's area (&70-&8F) - except for &60, and
; the character definition, which spills into &90-&93.
;
; Each pixel column of a character is drawn for two frames: scroll_phase
; flips between 0 and &49 every frame, and the scroller moves on to the
; next column on the frames it becomes &49. scroll_column_mask is the
; column's bit in each row of the character's definition.
SECTION scroll_phase_zero_page, org=&60, virtual=TRUE
.scroll_phase SKIP 1                ; &49 or 0
ENDSECTION
SECTION zero_page, org=&70, virtual=TRUE
.scroll_row_temp SKIP 2             ; start's pointer into the row being set up
.scroll_text_ptr SKIP 2             ; the character being scrolled in
.scroll_column_mask SKIP 1          ; the pixel column being drawn, as a bit
.scroll_text_start SKIP 2           ; set by line 300 to C%+&C9, the message
.scroll_handler_addr SKIP 2         ; set by line 300 to C%+&49, for EVNTV
    SKIP 2                          ; start leaves the row above the top's pointer here
.scroll_cell_ptrs SKIP 2 * SCROLL_ROWS  ; each scroller row's right-hand cell, top first
.char_definition SKIP 9             ; OSWORD &0A's block: the character, then its 8 rows
ENDSECTION


SECTION menu, filename="MENU", org=&1900, load=&1900, exec=&8023
.program
; Lines 10-40 are EQUB records. Line 40's REM is teletext codes, which LIST
; prints as a blue band reading "Hello, all my friends!" in double height:
; the quote makes LIST copy the bytes rather than expand them as keywords,
; and VDU_DELETE wipes the quote. In a BASIC block those bytes would make
; this file invalid UTF-8, and ENDBASIC ends the program, so these lines
; have to come before it.
    EQUB basic_line(10, CHR(BASIC_TOKEN_REM) + " PIPELINE menu prog")
    EQUB basic_line(20, CHR(BASIC_TOKEN_REM) + " By Ian Holmes")
    EQUB basic_line(30, CHR(BASIC_TOKEN_REM) + " Originally: GUILDMASTER")
    EQUB basic_line(40, CHR(BASIC_TOKEN_REM) + """" + CHR({VDU_DELETE, TT_ALPHA_BLUE, TT_NEW_BACKGROUND, TT_ALPHA_GREEN, TT_DOUBLE_HEIGHT}) + "Hello," + CHR({TT_ALPHA_YELLOW, TT_FLASH}) + "all my friends!  " + CHR(TT_BLACK_BACKGROUND) + "          " + CHR({TT_ALPHA_BLUE, TT_NEW_BACKGROUND, TT_ALPHA_GREEN, TT_DOUBLE_HEIGHT}) + "Hello," + CHR({TT_ALPHA_YELLOW, TT_FLASH}) + "all my friends!  " + CHR(TT_BLACK_BACKGROUND))
BASIC
; Setup. LOMEM=PAGE+&A00 starts the heap exactly where the program ends, so
; the DIMs land on the scroller and screen this file carries after it (C%
; and S%, below): DIM doesn't clear memory.
50LOMEM=PAGE+&A00:DIMC%&EFF,S%&700
; *SHADOW 1 keeps the screen in main memory on a B+ or Master, where the
; menu writes it directly; a B says "Bad command", which line 60 steps
; over. From line 80, any error runs a statement that is itself an error
; (a line of Little Richard), so the machine hangs instead of dropping into
; BASIC.
60ONERRORGOTO80
70*SHADOW 1
80ONERRORAWopBabaLuMopALopBamBoom
; Put every vector in page 2 back to the MOS's defaults (?&FFB6 bytes from
; the table at !&FFB7), undoing anything hooked in before the disc booted,
; but keep BRKV (the low half of the word at &202) pointing at BASIC's error
; handler.
90E%=!&202 AND&FFFF
100FORN%=0TO?&FFB6-1
110N%?&200=N%?!&FFB7:NEXT
120!&202=!&202 AND&FFFF0000ORE%
; *FX255 8 247 sets start-up option bit 3, so that BREAK on its own never
; boots the disc (SHIFT+BREAK still does), whatever the keyboard links say:
; a B reads the links only at power-on and CTRL+BREAK, and a plain BREAK
; keeps this. With memory cleared on BREAK (*FX200 2), Quit's reset (line
; 900), the BREAK key and PL's resets all stop at BASIC's prompt rather
; than start PIPELINE again. A Master takes a BREAK that clears memory as a
; power-on and reloads its configuration, so on one configured to BOOT,
; Quit restarts PIPELINE regardless. (docs/notes/basic.md has how the MOS
; decides, and the tests.) Escape becomes an ordinary key (*FX229 1).
; Then keyboard defaults (*FX12 auto-repeat, *FX18 no function key strings,
; *FX4 1 cursor keys giving 136-139, *FX16 no ADC sampling), flash colours
; every frame, the disc filing system and directory $ (on the current
; drive: *DISC doesn't go back to drive 0), no file messages (*OPT), and
; *TV255 1: the picture one line up, interlace off.
130*FX255 8 247
140*FX200 2
150*FX229 1
160*FX12
170*FX18
180*FX4 1
190*FX16
200*FX9 1
210*FX10 1
220*DISC
225*DIR $
230*OPT
240*TV255 1
; The loading picture (MODE 5, cursor off, colour 3 magenta), for ten
; seconds or a key; *FX15,1 first empties the keyboard buffer, so a key
; pressed earlier doesn't cut it short.
250MODE5:VDU23;8202;0;0;0;19,3,5;0;:*L.SCREEN
260*FX15,1
270I%=INKEY(1000):MODE7:VDU23;8202;0;0;0;
; The ten game keys go into &50-&59, as the low bytes of negative INKEY
; numbers, for the game to read. Then a test for a second processor that
; can't work: BASIC's indirection uses only the low 16 bits of an address,
; so ?&FFFF7C00 is ?&7C00, and reads back the 0 just written.
280RESTORE650:FORN%=&50TO&59:READ?N%:NEXT:?&FFFF7C00=128:?&7C00=0
; Line 290 holds two invisible raw bytes: VDU 21 just before the quote that
; ends "...re-load this program.", and VDU 6 after `*/PL "`. LIST shows
; nothing between them, hiding the cheat (with T and W held down here, the
; line runs PL), and the line reads as if it printed the message and waited
; for a key. The `":IFGET` belongs to the star command and DFS ignores it.
; Were the second-processor test ever true, OSBYTE 151 would write &7F to
; the system VIA's IER (&FE4E), turning off its interrupts, and the loop
; would hang.
290IF?&FFFF7C00>0PRINT''"Please turn off your Second Processor,  press Break, and re-load this program.":A%=151:X%=78:Y%=127:CALL&FFF4:REPEATUNTIL0ELSEIFINKEY-36ANDINKEY-34THEN*/PL "":IFGET
; The warning page (a Mode 7 screen loaded straight into screen memory),
; for ten seconds or a key, then clear its warning text (rows 18-24), draw
; the menu over its top 16 rows and start the scroller: line 300 passes the
; message (C%+&C9) in &75/&76 and the vsync handler (C%+&49) in &77/&78.
295*L.WARNING
296*FX15,1
297I%=INKEY(1000):VDU28;24,39,18:CLS
300PROCmenu:!&75=(C%+&49)*65536+C%+&C9:CALLC%
; The menu. A digit 1-6 lights its option (L%, 0 for none yet), the down
; and up cursor keys (138, 139) step the light round once one is lit, and
; RETURN takes it; left and right do nothing. Options 1, 3, 4 and 5, which
; leave the menu, first stop the scroller (*FX13 4 disables the vsync
; event), let Escape work again, and set LOMEM=TOP, dropping C% and S%.
; While those are allocated, BASIC's variables end above &3000, where MODE
; 1's screen starts, so option 1's MODE 1 would stop with "Bad MODE", which
; line 80's handler turns into a hang. Option 2 stays in the menu, and
; option 6, once confirmed, resets the machine, so neither needs this.
310REPEAT
320L%=0:REPEAT
330REPEATA%=GET:*FX15
340UNTILA%>48ANDA%<55ORA%=13ORA%=138ORA%=139
350IFA%>13PROCline
360UNTILA%=13ANDL%>0
370IFL%<>2ANDL%<>6THEN*FX13 4
380IFL%<>2ANDL%<>6THENLOMEM=TOP:*FX229
390ONL%GOSUB910,690,970,980,990,860
400PROCmenu:UNTIL0
; PROCline: moves the highlight for key A%: a digit lights that option, and
; down and up (138, 139) light the next or previous one, wrapping round
; (lines 430-440 turn them into digits); before anything is lit they do
; nothing. Out: L% = the option lit. The highlight is a TT_NEW_BACKGROUND
; over the space at column 11 of the option's row (window row L%+3);
; waiting for vsync first keeps the change from tearing.
410DEFPROCline
420IFA%>137ANDL%=0ENDPROC
430IFA%=138A%=L%+49:IFA%=55A%=49
440IFA%=139A%=L%+47:IFA%=48A%=54
450IFL%=A%-48ENDPROC
460*FX19
470IFL%>0PRINTTAB(11,L%+3)" ";
480L%=A%-48:PRINTTAB(11,L%+3)CHR$157;
490ENDPROC
; PROCcheck: refuses key P% (sets it to 0) if one of the N% keys already
; chosen is P%, or if it has no name in the table (A$). Line 780 calls it
; only from the second key on; the first can't repeat, and the keys with
; no name are ones a B's keyboard doesn't have.
500DEFPROCcheck:FORA%=0TON%-1
510IFA%?&50=256-P%P%=0
520NEXT:IFA$=""P%=0
530ENDPROC
; FNyes: waits for Y or N in either case, shows the answer for 0.8
; seconds, and returns non-zero for yes.
540DEFFNyes
550REPEATN%=GETOR32
560UNTILN%=110ORN%=121
570IFN%=121PRINT" Yes."; ELSEPRINT" No.";
580TIME=0:REPEATUNTILTIME>79
590=N%-110
; PROCmenu: clears the text window (rows 6-16, where the redefine page
; prints), then copies S%'s top 16 rows of the menu screen to HIMEM, the
; Mode 7 screen.
600DEFPROCmenu
610VDU28;16,39,6:CLS:FORN%=0TO&27CSTEP4:N%!HIMEM=N%!S%:NEXT:ENDPROC
; The default keys as negative INKEY numbers - Z, X, *, ?, P, D, RETURN,
; T, CTRL, M - and the names option 2 shows for them. The names are left
; over from Guildmaster, the game this menu was adapted from, so they
; don't describe what the keys do in PIPELINE.
650DATA-98,-67,-73,-105,-56,-51,-74,-36,-2,-102
660DATA MOVE WEST,MOVE EAST,MOVE NORTH,MOVE SOUTH,PICK UP OBJECT,DROP OBJECT,USE OBJECT,THROW OBJECT,VIEW BACKPACK,VIEW MAP
; Key names by internal key number (the first is INKEY -1, SHIFT). A blank
; name is a key that can't be chosen: the keyboard links (internal 2-9) and
; the matrix columns 10-15, which a B's keyboard doesn't have. ESCAPE's
; place holds "!", never seen, since ESCAPE starts the list again instead.
670DATA SHIFT,CTRL,,,,,,,,,,,,,,,Q,3,4,5,f4,8,f7,=,^,LEFT CURSOR,,,,,,,f0,W,E,T,7,I,9,0,`,DOWN CURSOR,,,,,,,1,2,D,R,6,U,O,P,[,UP CURSOR,,,,,,,CAPS LOCK,A,X,F,Y,J,K,@,*,RETURN,,,,,,,SHIFT LOCK
680DATAS,C,G,H,N,L,+,],DELETE,,,,,,,TAB,Z,SPACE,V,B,M,<,>,?,COPY,,,,,,,!,f1,f2,f3,f5,f6,f8,f9,|,RIGHT CURSOR
; Option 2, redefine keys (a GOSUB): for each action, scan INKEY -1 to
; -122 until a key is down, taking the highest-numbered one held; the links
; and missing columns (K% 3-16) are skipped, and repeats and unnamed keys
; refused. ESCAPE (113) ends the per-key REPEAT with UNTIL TRUE, then loops
; the outer one with UNTIL FALSE: back to the first key.
690REPEAT:CLS
700RESTORE660:FORN%=0TO9
710READA$:PRINTTAB(8)CHR$131A$": "CHR$130CHR$156;
720NEXT:N%=0:REPEAT
730PRINTTAB(0,N%)"Press:"CHR$129CHR$157TAB(28,N%);
740P%=0:REPEAT:FORK%=1TO122
750IFINKEY(-K%)IFK%<3ORK%>16P%=K%
760NEXT:RESTORE670
770FORA%=1TOP%:READA$:NEXT
780IFP%>0ANDN%>0 PROCcheck
790UNTILP%>0
800IFP%=113UNTILTRUE:UNTILFALSE
810PRINTA$TAB(0,N%)SPC(8);
820N%?&50=-P%:N%=N%+1
830UNTILN%=10:*FX15 1
840PRINT'CHR$134"Are these keys correct?";
850UNTILFNyes:RETURN
; Option 6, quit: CALL !-4 calls the address in the 6502's reset vector
; (BASIC reads !-4 as the word at &FFFC), which the MOS takes as a BREAK:
; with *FX200 2 memory is cleared, and line 130's *FX255 keeps it from
; booting the disc, so the machine is left at BASIC's prompt.
860CLS:FORN%=1TO2
870PRINTTAB(0,N%)CHR$141CHR$132CHR$157CHR$131"Exiting from Pipeline:  "CHR$156:NEXT
880PRINT'CHR$134"Are you sure?";
890IFFNyes=0RETURN
900CALL!-4
; Option 1, play: Escape without its side effects (*FX230 1) and no
; auto-repeat (*FX11) for the game, then TITLE draws its page in MODE 1
; with every colour black, and line 940 reveals it with the palette in line
; 1000, for three seconds or a key. Then MODE 7, and */GAME runs the stub
; that loads the game.
910*FX230 1
920*FX11
930MODE1:FORN%=0TO3:VDU19,N%,0;0;:NEXT:VDU23;8202;0;0;0;:*RUN TITLE
940RESTORE1000:FORN%=0TO3:READA%:VDU19,N%,A%;0;:NEXT:T%=INKEY(300)
950MODE7:VDU23;8202;0;0;0;
960*/GAME
; Options 3 and 4 run the Graphics and Level Designers' loader stubs;
; option 5 is the mission generator.
970*/GRAPHIC
980*/LEVDES
990CHAIN"MISSION"
1000DATA 0,1,4,7
; Nothing leads here: line 1020 runs the tune program carried at
; PAGE+&1C00 (in S%, below).
1010REM
1020PAGE=PAGE+&1C00:RUN
ENDBASIC
.program_end

; ---------------------------------------------------------------------------
; C%: line 50's LOMEM=PAGE+&A00 starts the heap where the program ends, so
; DIM C% &EFF puts its &F00 bytes here. DIM doesn't clear them, and the file
; was saved with the scroller and its message in place.

    ASSERT P% = program + &A00

.scroller
{
; Starts the scroller (CALL C% in line 300). Writes the codes for
; separated cyan graphics into columns 0 and 1 of each scroller row, aims
; scroll_cell_ptrs at each row's right-hand cell, points EVNTV at the
; handler and enables the vsync event.
; In: scroll_text_start = the message, scroll_handler_addr = the handler.
; Out: scroll_text_ptr, scroll_column_mask and scroll_phase set for the
;      message's first column.
; Clobbers: A, X, Y, scroll_row_temp, scroll_cell_ptrs - 2 (the spare slot).
.start
    LDA #&80
    STA scroll_column_mask          ; the character's leftmost pixel first
    ASL A
    STA scroll_text_ptr             ; (overwritten just below)
    STA scroll_phase
    LDA scroll_text_start
    STA scroll_text_ptr
    LDA scroll_text_start + 1
    STA scroll_text_ptr + 1

    ; Each row's pointer is the one below it less a row, starting from the
    ; bottom one. Each pass makes the pointer for the row above and, through
    ; it, puts the colour codes at the start of this row, so the last pass
    ; (row 17's codes) leaves a pointer to row 16 in the spare slot before
    ; the table.
    LDA #LO(mode7_address(SCROLL_RIGHT, SCROLL_TOP + SCROLL_ROWS - 1))
    STA scroll_cell_ptrs + 2 * (SCROLL_ROWS - 1)
    LDA #HI(mode7_address(SCROLL_RIGHT, SCROLL_TOP + SCROLL_ROWS - 1))
    STA scroll_cell_ptrs + 2 * (SCROLL_ROWS - 1) + 1
    LDX #2 * (SCROLL_ROWS - 1)
    LDY #TT_COLUMNS - SCROLL_RIGHT   ; from the row above's right cell to this row's first
.each_row
    LDA scroll_cell_ptrs, X
    SEC
    SBC #TT_COLUMNS
    STA scroll_row_temp
    STA scroll_cell_ptrs - 2, X
    LDA scroll_cell_ptrs + 1, X
    SBC #0
    STA scroll_row_temp + 1
    STA scroll_cell_ptrs - 1, X
    LDA #TT_SEPARATED
    STA (scroll_row_temp), Y
    INY
    LDA #TT_GFX_CYAN
    STA (scroll_row_temp), Y
    DEY
    DEX
    DEX
    BPL each_row

    LDA scroll_handler_addr
    STA EVNTV
    LDA scroll_handler_addr + 1
    STA EVNTV + 1
    LDA #OSBYTE_ENABLE_EVENT
.enable_vsync_event
    LDX #EVENT_VSYNC
    JMP OSBYTE

; Where line 300 points EVNTV: C%+&49, which is the operand of the LDX
; above, four bytes short of the handler. From there the bytes run as &04
; &4C and &F4 &FF, which an NMOS 6502 executes as two do-nothing NOPs
; (zero page and zero page,X: undocumented, but they only read), so the
; handler runs anyway. Presumably a slip that happened to work; a 65C02
; would take &04 as TSB &4C and set bits in BASIC's workspace.
vsync_entry = enable_vsync_event + 1
    ASSERT vsync_entry = scroller + &49

; The vsync event handler. Every frame, moves the eight scroller rows one
; cell left and fills each row's right-hand cell from one pixel column of
; the character being scrolled in: a solid block where its pixel is lit.
; A column stays for two frames, so a character is 16 cells wide and 8
; tall, and the message wraps when it reaches its terminating zero.
; Doesn't check which event it was called for: vsync is the only one on.
; In: scroll_text_ptr, scroll_column_mask and scroll_phase, as left last frame.
; Clobbers: A, X, Y, char_definition.
.vsync_handler
shift_from = &100 - (SCROLL_RIGHT - SCROLL_LEFT)    ; Y counts up to zero
    LDY #shift_from
.shift_left
    LDA mode7_address(SCROLL_LEFT + 1, SCROLL_TOP + 0) - shift_from, Y
    STA mode7_address(SCROLL_LEFT, SCROLL_TOP + 0) - shift_from, Y
    LDA mode7_address(SCROLL_LEFT + 1, SCROLL_TOP + 1) - shift_from, Y
    STA mode7_address(SCROLL_LEFT, SCROLL_TOP + 1) - shift_from, Y
    LDA mode7_address(SCROLL_LEFT + 1, SCROLL_TOP + 2) - shift_from, Y
    STA mode7_address(SCROLL_LEFT, SCROLL_TOP + 2) - shift_from, Y
    LDA mode7_address(SCROLL_LEFT + 1, SCROLL_TOP + 3) - shift_from, Y
    STA mode7_address(SCROLL_LEFT, SCROLL_TOP + 3) - shift_from, Y
    LDA mode7_address(SCROLL_LEFT + 1, SCROLL_TOP + 4) - shift_from, Y
    STA mode7_address(SCROLL_LEFT, SCROLL_TOP + 4) - shift_from, Y
    LDA mode7_address(SCROLL_LEFT + 1, SCROLL_TOP + 5) - shift_from, Y
    STA mode7_address(SCROLL_LEFT, SCROLL_TOP + 5) - shift_from, Y
    LDA mode7_address(SCROLL_LEFT + 1, SCROLL_TOP + 6) - shift_from, Y
    STA mode7_address(SCROLL_LEFT, SCROLL_TOP + 6) - shift_from, Y
    LDA mode7_address(SCROLL_LEFT + 1, SCROLL_TOP + 7) - shift_from, Y
    STA mode7_address(SCROLL_LEFT, SCROLL_TOP + 7) - shift_from, Y
    INY
    BNE shift_left

    LDA (scroll_text_ptr), Y
    BNE have_character
    LDA scroll_text_start           ; the end of the message: start again
    STA scroll_text_ptr
    LDA scroll_text_start + 1
    STA scroll_text_ptr + 1
    LDA (scroll_text_ptr), Y
.have_character
    STA char_definition
    LDX #LO(char_definition)
    LDY #HI(char_definition)
    LDA #OSWORD_READ_CHAR_DEFINITION
    JSR OSWORD

    LDX #0                          ; (unused: X comes from Y below)
    LDY #SCROLL_ROWS - 1
.each_pixel_row
    LDA char_definition + 1, Y
    AND scroll_column_mask
    BEQ unlit                       ; zero shows as a blank cell
    LDA #SOLID_BLOCK
.unlit
    PHA
    TYA
    ASL A
    TAX
    PLA
    STA (scroll_cell_ptrs, X)       ; pixel row Y's pointer
    DEY
    BPL each_pixel_row

    LDA scroll_phase
    EOR #&49                        ; any non-zero value would do
    STA scroll_phase
    BEQ done                        ; every other frame, the same column again
    LSR scroll_column_mask
    BCC done
    LDA #&80                        ; past the rightmost pixel: on to the next character
    STA scroll_column_mask
    INC scroll_text_ptr
    BNE done
    INC scroll_text_ptr + 1
.done
    RTS
}

; The message, ended by a zero; line 300 gives its address (C%+&C9) to the
; scroller in scroll_text_start.
.scroll_text
    ASSERT scroll_text = scroller + &C9
    EQUS "PIPELINE was written by Ian Holmes and William Reeve. Or so they claim. "
    EQUS "In the 25th century, the Earth's sulphur resources have dwindled. The "
    EQUS "only supplies are from off-world sources such as the Jovian moon Io. But "
    EQUS "the temperature control systems of the Io sulphur platforms have "
    EQUS "malfunctioned, and the platforms have started to overheat. Your mission "
    EQUS "is to salvage the precious sulphur drums, then locate the helpless "
    EQUS "control robot and rescue it. However, once the robot leaves its post at "
    EQUS "the computer terminals, they will go critical and eventually explode, so "
    EQUS "you will need to be a safe distance away to escape the blast. Fires and "
    EQUS "pitfalls are deadly, but you may find the abandoned pipe network useful. "
    EQUS "Each drum you save scores one point. Rescuing the robot scores more "
    EQUS "points, and there is a one hundred point bonus if you survive the "
    EQUS "explosion. There are four levels of play, and you begin the game with "
    EQUS "three lives. If you've read this far, you might as well read these "
    EQUS "messages: Hello Duncan, Deep, Soni, Dave (the lad), Godfroy (la poseur), "
    EQUS "Tim, Will, Jabwit, the C.R.A.S.S. team, the Rydell High class of '88, "
    EQUS "Muriel Volestrangler, and all others for whom, sadly, there is no room. "
    EQUS "Greetings and thanks to Suzanne and Marianne, who cheered me up on the "
    EQUS "bus. Metapsyche rules forever! (PRIVATE JOKE) Ok... voila William. "
    EQUS "RIGHT! This is William's message now (hang around for the funny bit of "
    EQUS "Ian's message):  3... 2... 1...    Firstly, thanks to: Ian, for writing "
    EQUS "this game (and arguing) with me (he was on BASIC I for 12 months of "
    EQUS "writing this, so he deserves a bonus. While we're at it, We are both "
    EQUS "monitor-less. Contributions c/o SS, Leeds). Thanks to: Chill and Jason "
    EQUS "for criticising constructively, Julian for criticising and being "
    EQUS "criticised, mr.crabtree (southpole). Hello to: Edmund, John (JRO), "
    EQUS "Thomas (TW), Richard (all of them), NP, Felicity, Sarah, Ben (BASS) "
    EQUS "Ellis, big and less-big Biddy. REALLY MASSIVE THANKS to:  KIM (and SJR) "
    EQUS "for all his help (too much to list here); BID (for graphics and laughs); "
    EQUS "CAMERON (for the atrocious ditty tune (Get in touch !)); Mum and Dad; "
    EQUS "Dr. Stephen; Chill again (for some screens and the loan of the 'yuck'). "
    EQUS "And of course, my cat (nameless) for being sweet. Must also say thanks "
    EQUS "to Johnathan Griffiths, and Hi to Peter Irvine and Jeremy Smith. May I "
    EQUS "please re-iterate any message you may have got (or are going to get) "
    EQUS "from Ian: unauthorised duplicating of this program is ILLEGAL and also "
    EQUS "remember that you may be depriving us of our livelihood, and many "
    EQUS "millions of people may die and .........  Hi also (provocatively) to "
    EQUS "Chris Jordan. Now back to Ian .... Hello darlings. This game was "
    EQUS "finished around August 1988. IF you have any criticisms, take this gem "
    EQUS "of advice to heart: we're about as interested in your petty complaints "
    EQUS "as we are in the bacterial love life of Larry Grayson's underwear. IF "
    EQUS "you bother to duplicate our attempt by illegal means, then you are below "
    EQUS "pity. IF you've read this far you either have a headache or a memory "
    EQUS "editor. This message is brought to you courtesy of my modesty. Credits: "
    EQUS "I wrote the mission generator, the ""playing"" section of the game and "
    EQUS "most of the level designer; William did everything to do with graphics, "
    EQUS "including the graphics designer. Further releases: RED AND YELLOW "
    EQUS "CORMORANTS FLY THROUGH DR.BLOOD'S DREAM GARDENS (by me); a mega 3D "
    EQUS "two-player arcade strategic probably unfinished shoot-em-up with "
    EQUS "sinister political connotations and a controversial set of control keys "
    EQUS "(haha). If you've enjoyed this message, why not buy one of the others in "
    EQUS "this series ? Otherwise just play the bl**dy game !!! "
    EQUS "....................."
    EQUB 0
    ASSERT P% = scroller + &F00

; ---------------------------------------------------------------------------
; S%: DIM S% &700 follows C%'s block. PROCmenu copies its first 16 rows to
; HIMEM (the Mode 7 screen) to draw the menu, over a CLS of the text window
; (rows 6 to 16) that the redefine-keys page later prints in. PROCline
; highlights an option by writing TT_NEW_BACKGROUND over the space at
; column 11 of its row: the background becomes the colour in force there,
; the pipe's blue, up to the TT_BLACK_BACKGROUND after the option's text.

.menu_screen
{
    ASSERT menu_screen = scroller + &EFF + 1
.screen
; rows 0-9: the logo, credits and pipe top, shared with WARNING
    INCLUDE "mode7_header.6502inc"
; rows 10-15: the options, yellow numbers and green text, between the pictures
    TT_ROW 10
    EQUB TT_GFX_BLUE, &FF, &E6, &AA, &BF, &BF, &BF, &BF, &6A, &F7, &A4, &20, TT_ALPHA_YELLOW, "1"
    EQUB TT_ALPHA_GREEN, "Start the game", TT_GFX_BLUE, &20, TT_BLACK_BACKGROUND, &66, &7F, &AA
    EQUB &BF, &BF, &BF, &BF, &BF
    TT_ROW 11
    EQUB TT_GFX_BLUE, &FF, &B9, &22, &22, &A2, &A2, &A2, &6A, &BD, &B1, &20, TT_ALPHA_YELLOW, "2"
    EQUB TT_ALPHA_GREEN, "Redefine keys", TT_GFX_BLUE, &20, &20, TT_BLACK_BACKGROUND, &39, &7F
    EQUB &22, &62, &72, &72, &32, &22
    TT_ROW 12
    EQUB TT_GFX_BLUE, &FF, &E6, TT_GFX_YELLOW, &22, &2F, &21, TT_GFX_BLUE, &6A, &F7, &A4, &20
    EQUB TT_ALPHA_YELLOW, "3", TT_ALPHA_GREEN, "Edit graphics", TT_GFX_BLUE, &20, &20
    EQUB TT_BLACK_BACKGROUND, &66, &7F, TT_GFX_BLUE, &6F, &7F, &7F, &3F, &20
    TT_ROW 13
    EQUB TT_GFX_BLUE, &FF, &B9, TT_GFX_RED, &7F, &7F, &7F, TT_GFX_BLUE, &6A, &BD, &B1, &20
    EQUB TT_ALPHA_YELLOW, "4", TT_ALPHA_GREEN, "Edit levels", TT_GFX_BLUE, &20, TT_GFX_BLUE, &20
    EQUB &20, TT_BLACK_BACKGROUND, &39, &7F, &20, TT_GFX_CYAN, &6A, &35, &20, &20
    TT_ROW 14
    EQUB TT_GFX_BLUE, &EF, &FE, &FD, &F0, &F0, &F0, &F0, &FE, &F7, &A4, &20, TT_ALPHA_YELLOW, "5"
    EQUB TT_ALPHA_GREEN, "Edit missions", TT_GFX_BLUE, &20, &20, TT_BLACK_BACKGROUND, &66, &7F
    EQUB &74, &F0, &F0, &F0, &F0, &F0
    TT_ROW 15
    EQUB TT_GFX_BLUE, &A2, &AF, &BB, &BB, &BB, &BB, &BB, &BB, &B9, &A1, &20, TT_ALPHA_YELLOW, "6"
    EQUB TT_ALPHA_GREEN, "Quit PIPELINE", TT_GFX_BLUE, &20, &20, TT_BLACK_BACKGROUND, &29, &BB
    EQUB &BB, &BB, &BB, &BB, &BB, &BB
}
.menu_screen_end
    ASSERT menu_screen_end - menu_screen = 16 * TT_COLUMNS   ; FOR N%=0 TO &27C STEP 4

; The rest of S% is never read by MENU's own code: it's what was in memory
; when the file was saved. First a blank row, holding the zero that ended
; some earlier message, then a short message in the scroller's format.
    EQUS "           "
    EQUB 0
    EQUS "                            What colour is acidified KMnO4 ? You may well "
    EQUS "ask. You may not so well answer. I didn't"
    EQUB 0

; A tune for SOUND's three channels, kept as a separate BASIC program;
; line 1020 runs it (PAGE=PAGE+&1C00:RUN), though no line leads there. Its
; pattern P$ picks the DATA lines (A is 40, B 50 ...) that hold three voices
; of notes as letters. Which tune it is isn't written down: asking Claude to
; name it trips an error in Claude's API, so that's left to people (see
; docs/notes/basic.md).
.tune
    ASSERT tune = program + &1C00
BASIC
10ENVELOPE1,5,1,-1,0,1,1,0,126,-15,0,-1,126,0:ENVELOPE3,1,0,0,0,0,0,0,92,4,-1,-1,92,118:DIME 3,D$(3):E!1=&30301:P$="DAEBAEBAA":FORN%=1TO3:SOUNDN%,0,0,1:NEXT:FORP=1TOLEN(P$):RESTOREASC(MID$(P$,P,1))*10-610
20FORN=1TO3:READD$(N):NEXT:FORN=1TOLEN(D$(1))+(P=LEN(P$)):FORA=3TO1STEP-1:N$=MID$(D$(A),N,1):IFN$<>" "ANDN$<>""SOUNDA,E?A,(ASC(N$)-65)*4,2ELSESOUND4096+A,0,0,2
30NEXT,,
40DATA"O    QS QO NL  L  L    LN  N  L  N NO  O  O    J","G    JJ JG EO  L  O    CE  E  E  E EG  T  S","J    NO NJ JT  T  T    HJ  J  H  J JJ  J  J"
50DATA"O  O  S    OL  L  Q    ON  J  S  Q  O        J  O  O  S  O  L  Q     O  N  J  S  Q  O           ","G  G  J     H  H  H     E  E  J  J  G           G  G  J  G  H  H     G  E  E  J  J  G"
60DATA"J  J  O     Q  Q  L     J  J  O  N  J  L  J  H  J  J  O  J  Q  L  L  O  J  N  O  N  J  L  J  H"
70DATA"O    QS QO NL  L  L    LN  N  L  N NO  O  O    J","",""
80DATA"O  O  S    OL  L  Q    ON  J  S  Q  O        J  O  O  S  O  L  Q     O  N  J  S    QO           ","",""
ENDBASIC

; The end of the Level Designer's source (BASIC assembler), which the tune
; was loaded over, cut off by the end of the file: the tail of one line and
; the start of the next six. It assembles to H.LEVDES's &168A-&16A6, so it
; gives some of the original label names: sel0 &1126, canc &1637, t2 &54,
; sure &1323, table &166B, key3 &169E, wind &14A8, help &16AD, and simt...
; (cut off) &16A7.
    EQUS "2:LDA#37:JSRsel0"
    EQUB basic_line(3900, "CMP#4:BEQcanc:STAt2")
    EQUB basic_line(3910, "JSRsure:LDAt2")
    EQUB basic_line(3920, "LDY#7:BNEtable")
    EQUB basic_line(3930, ".key3:LDA#62")
    EQUB basic_line(3940, "JSRwind:LDA#0")
    EQUB &0D, HI(3950), LO(3950), 19, "BEQhelp:.simt"   ; two bytes short of its length
    ASSERT P% = menu_screen + &700
ENDSECTION

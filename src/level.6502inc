; The level the Level Designer edits, as it sits in memory from &25A1 to
; &2FFF and as it is saved: "Save level" writes exactly these &A5F bytes
; (load &25A1, exec &8380), and LEVEL1 on the disc is one. MISSION *LOADs
; such files and packs them into IO for the game. What a level holds, and the
; names for its values, are in leveldata.6502inc; this is where the designer
; keeps each part.
;
; Up to 8 objects, 4 walking monsters and 32 puzzles; positions are map
; cells, x across and y down, 0-63.
INCLUDE "leveldata.6502inc"

level           = &25A1
level_end       = &3000

; Puzzle names, ten characters each, kept as eight in one table and the
; last two in another.
level_names     = level                         ; 32 x 8 characters
level_name_ends = level_names + PUZZLES * 8     ; 32 x 2 characters

; The fields, in order, then the map.
level_code      = level_name_ends + PUZZLES * 2
; A three-byte editing code; the designer won't keep a loaded level unless
; the user types its six digits.
level_palette   = level_code + LEVEL_FIELD_OFFSETS[3]
; Where the player starts, less 4 in each coordinate.
level_start_x   = level_code + LEVEL_FIELD_OFFSETS[4] + LEVEL_START_X
level_start_y   = level_code + LEVEL_FIELD_OFFSETS[4] + LEVEL_START_Y
level_collects  = level_code + LEVEL_FIELD_OFFSETS[4] + LEVEL_TO_COLLECT
level_time      = level_code + LEVEL_FIELD_OFFSETS[4] + LEVEL_TIME
level_finish_x  = level_code + LEVEL_FIELD_OFFSETS[4] + LEVEL_EXIT_X
level_finish_y  = level_code + LEVEL_FIELD_OFFSETS[4] + LEVEL_EXIT_Y
; Bits 0-3: the block that kills a monster; bits 4-7: the block it leaves.
level_monster_rules = level_code + LEVEL_FIELD_OFFSETS[4] + LEVEL_MONSTER_FOOD
; Two bits each for cell types 5, 8, 7 and A (the designer's wall one, wall
; two, collectable and trap), 5 in the top two: which squares show their
; second sprite.
level_sprites   = level_code + LEVEL_FIELD_OFFSETS[4] + LEVEL_ANIMATE
level_objects   = level_code + LEVEL_FIELD_OFFSETS[5]
level_monsters  = level_code + LEVEL_FIELD_OFFSETS[6]
level_puzzle_types = level_code + LEVEL_FIELD_OFFSETS[7]
level_puzzle_positions = level_code + LEVEL_FIELD_OFFSETS[8]
; Each puzzle's three effect bytes, by type (see the effect editors in the
; designer), then its conditions byte.
level_puzzle_effects = level_code + LEVEL_FIELD_OFFSETS[9]
level_map       = level_code + LEVEL_FIELDS_SIZE
ASSERT level_map + MAP_BYTES = level_end

; The designer's names for the map's blocks, from its block menu. They
; aren't what the game makes of them (CELL_* in leveldata.6502inc): its fatal
; trap is a crate, its crate a wall, its wall 2 lava, its S.monster a pipe
; junction, its barricade fire and its junction an object.
TILE_BLANK      = &0
TILE_SE_CURVE   = &1
TILE_SW_CURVE   = &2
TILE_NE_CURVE   = &3
TILE_NW_CURVE   = &4
TILE_WALL_1     = &5
TILE_FATAL_TRAP = &6
TILE_COLLECTABLE = &7
TILE_CRATE      = &8
TILE_MARKER     = &9
TILE_WALL_2     = &A
TILE_MONSTER    = &B
TILE_HORZ_PIPE  = &C
TILE_VERT_PIPE  = &D
TILE_BARRICADE  = &E
TILE_JUNCTION   = &F

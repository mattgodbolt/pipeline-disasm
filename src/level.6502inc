; The level the Level Designer edits, as it sits in memory from &25A1 to
; &2FFF and as it is saved: "Save level" writes exactly these &A5F bytes
; (load &25A1, exec &8380), and LEVEL1 on the disc is one. MISSION *LOADs
; such files and packs them into IO for the game. What a level holds, and the
; names for its values, are in leveldata.6502inc; this is where the designer
; keeps each part. LEVEL1 and PL include it too.
;
; Up to 8 objects, 4 walking monsters and 32 puzzles (the designer's word for
; the game's triggers: things that happen when the player walks onto a place
; or uses an object); positions are map cells, x across and y down, 0-63.
INCLUDE "leveldata.6502inc"

SECTION designer_level, org=&25A1, virtual=TRUE
.level

; Puzzle names, PUZZLE_NAME_LENGTH characters each, kept as the first
; PUZZLE_NAME_HEAD in one table and the rest in another.
.level_names     SKIP PUZZLES * PUZZLE_NAME_HEAD
.level_name_ends SKIP PUZZLES * (PUZZLE_NAME_LENGTH - PUZZLE_NAME_HEAD)

; The fields, in order, then the map. First a three-byte editing code; the
; designer won't keep a loaded level unless the user types its six digits.
.level_code      SKIP LEVEL_FIELD_OFFSETS[3]
.level_palette   SKIP LEVEL_FIELD_SIZES[3]
; The setup bytes (LEVEL_* in leveldata.6502inc). Where the player starts,
; less 4 in each coordinate: the top left of the game's view, 8 cells by 8,
; with the player 4 cells in.
.level_setup
.level_start_x   SKIP 1
.level_start_y   SKIP 1
.level_collects  SKIP 1
.level_time      SKIP 1
.level_finish_x  SKIP 1
.level_finish_y  SKIP 1
; Bits 0-3: the block that kills a monster; bits 4-7: the block it leaves.
.level_monster_rules SKIP 1
; Two bits each for cell types 5, 8, 7 and A (the designer's wall one, wall
; two, collectable and fatal trap), 5 in the top two: which squares show
; their second sprite (ALTERNATE_*).
.level_sprites   SKIP 1
.level_objects   SKIP LEVEL_FIELD_SIZES[5]
.level_monsters  SKIP LEVEL_FIELD_SIZES[6]
.level_puzzle_types SKIP LEVEL_FIELD_SIZES[7]
.level_puzzle_positions SKIP LEVEL_FIELD_SIZES[8]
; Each puzzle's three effect bytes, by type (see the effect editors in the
; designer), then its conditions byte.
.level_puzzle_effects SKIP LEVEL_FIELD_SIZES[9] + LEVEL_FIELD_SIZES[10]
.level_map       SKIP MAP_BYTES
.level_end
ENDSECTION

ASSERT level_end = &3000
ASSERT level_setup = level_code + LEVEL_FIELD_OFFSETS[4]
ASSERT level_start_x = level_setup + LEVEL_START_X
ASSERT level_start_y = level_setup + LEVEL_START_Y
ASSERT level_collects = level_setup + LEVEL_TO_COLLECT
ASSERT level_time = level_setup + LEVEL_TIME
ASSERT level_finish_x = level_setup + LEVEL_EXIT_X
ASSERT level_finish_y = level_setup + LEVEL_EXIT_Y
ASSERT level_monster_rules = level_setup + LEVEL_MONSTER_FOOD
ASSERT level_sprites = level_setup + LEVEL_ANIMATE
ASSERT level_objects = level_code + LEVEL_FIELD_OFFSETS[5]
ASSERT level_puzzle_effects = level_code + LEVEL_FIELD_OFFSETS[9]
ASSERT level_map = level_code + LEVEL_FIELDS_SIZE

; The designer's names for the map's blocks, from its block menu, against the
; game's cell types (CELL_* in leveldata.6502inc). Block n is cell type n;
; the menu just lists them in its own order (block_menu_map in
; hidden_levdes.6502 translates):
;
;   block  menu name     the game
;   0      Blank         CELL_FLOOR
;   1-4    SE/SW/NE/NW curve   CELL_SE_CURVE to CELL_NW_CURVE, curved walls
;   5      Wall 1        CELL_WALL_1
;   6      Crate         CELL_CRATE
;   7      Collectable   CELL_SULPHUR
;   8      Wall 2        CELL_WALL
;   9      Barricade     CELL_BARRICADE
;   A      Fatal trap    CELL_LAVA
;   B      Junction      CELL_JUNCTION
;   C      Horz.Pipe     CELL_PIPE_ACROSS
;   D      Vert.Pipe     CELL_PIPE_DOWN
;   E      S.Monster     CELL_FIRE (the designer marks monsters with it)
;   F      Marker        CELL_OBJECT (the designer marks the start, finish
;                        and objects with it)

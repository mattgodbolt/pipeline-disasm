; IO, the mission file: the four levels PIPELINE plays, their maps, and the
; pictures to draw them with. The Mission Generator (MISSION) puts it together
; from what the Level Designer and the Graphics Designer save; the game loads
; it at io_start so that it ends at &5800. src/io.6502inc has the layout and
; what each part means, shared with the game.
;
; The graphics and their names are the default set, DEFAULT's, described in
; src/default.6502inc. Maps are written a row at a time, one character a
; cell: "." for cell type 0, then 1-9 and A-F.

INCLUDE "io.6502inc"
INCLUDE "default.6502inc"

; A level map from its 64 rows of 64 cells. The game wants it a column at a
; time, two cells a byte, the even row in the high nibble: pack the rows in
; pairs, then gather the bytes a column at a time.
MACRO MAP rows
    cells = FIND(CODES(".123456789ABCDEF"), CODES(rows))
    ASSERT LEN(cells) = 64 AND LEN(FLATTEN(cells)) = 64 * 64, "a map is 64 rows of 64 cells"
    packed = FLATTEN(cells[0..2.., ..] * 16 + cells[1..3.., ..])
    n = 0..IO_MAP_SIZE-1
    EQUB packed[(n MOD 32) * 64 + n DIV 32]
ENDMACRO

SECTION io, filename="IO", org=io_start, load=io_start, exec=0
.io
{
.names
    ; MISSION's names, the end of the graphics file it was given (DEFAULT):
    ; a picture for an object cell with no object, then the object names.
    EQUB default_names()
    ASSERT names = io_no_object_picture
    ASSERT names + 128 = io_object_names

; Printed on the backpack screen (CTRL) as the level's goal.
.mission_text
    EQUB 31, 18, 16, "Collect", 9, "the", 9   ; TAB(18, 16) "Collect the"
    EQUB 31, 14, 17, 9, 9, "Sulphur!", 9, 9   ; TAB(14, 17) "Sulphur!"
    ASSERT mission_text = io_mission_text

.attrs
    EQUB 15                                  ; the clock's rate (MISSION shows it less 6: 9)
    EQUB 4                                   ; the map works on levels 1 to 4
    EQUB 2                                   ; the backpack holds 3
    EQUB 6                                   ; objects can be thrown 6 cells
    EQUB &FF                                 ; locked: the last level shows an entry code
    ASSERT attrs = io_attrs

; The levels' fields: each field is four entries, one per level.
.edit_code_high
    EQUB &CD, &A5, &09, &11
    ASSERT edit_code_high = io_edit_code_high
.edit_code_middle
    EQUB &DC, &A5, &A4, &C0
    ASSERT edit_code_middle = io_edit_code_middle
.edit_code_low
    EQUB &9C, &80, &D0, &8C
    ASSERT edit_code_low = io_edit_code_low

; VDU 19 for each logical colour: logical << 4 | physical.
.palettes
    EQUB &00, &14, &23, &31                  ; level 1
    EQUB &00, &14, &27, &31                  ; level 2
    EQUB &00, &14, &23, &35                  ; level 3
    EQUB &00, &14, &26, &31                  ; level 4
    ASSERT palettes = io_palettes

; Each level's setup: start (the view's top left cell; the player starts 4
; cells further in each way), how many cell 7s to collect, the clock, the
; exit's cell, monsters' food (low nibble: the cell type they eat; high:
; what it becomes), and the second-picture bits for cell types A, 7, 8, 5.
.level_setup
    EQUB &3A, &1F, 124, 250, &1F, &1C, &7A, %00000111  ; level 1
    EQUB &32, &13, 84, 250, &3F, &3F, &7A, %00000101  ; level 2
    EQUB &1C, &3B, 250, 240, &20, &2B, &AA, %01110111  ; level 3
    EQUB &23, &21, 85, 180, &0E, &0A, &7A, %11110100  ; level 4
    ASSERT level_setup = io_level_setup

; Objects: cell x, y, icon (and name), and its uses (bits 0-5; 32 and over
; never run out) and flags (bit 6: it vanishes when used up; bit 7: it does
; nothing when thrown). Object n has triggers n, n + 8, n + 16 and n + 24.
.level_objects
    ; level 1
    EQUB 32, 30,  0, &82      ; 0: Remote C.D.1; uses: 2, no triggers thrown
    EQUB 57, 15,  3, &A2      ; 1: Blueprints; uses: any, no triggers thrown
    EQUB 24, 30,  8, &C1      ; 2: Space Burger; uses: 1, vanishes, no triggers thrown
    EQUB 31, 47, 13, &81      ; 3: Detonator; uses: 1, no triggers thrown
    EQUB 12, 48,  5, &41      ; 4: Spanner; uses: 1, vanishes
    EQUB 38, 46,  4, &0A      ; 5: Mallet; uses: 10
    EQUB 54, 36,  2, &83      ; 6: Remote C.D.3; uses: 3, no triggers thrown
    EQUB 30, 38, 14, &E1      ; 7: Explosives; uses: any, vanishes, no triggers thrown
    ; level 2
    EQUB 35, 37, 14, &41      ; 0: Explosives; uses: 1, vanishes
    EQUB 22, 61,  0, &81      ; 1: Remote C.D.1; uses: 1, no triggers thrown
    EQUB 17, 59,  3, &C1      ; 2: Blueprints; uses: 1, vanishes, no triggers thrown
    EQUB 22, 22,  1, &C1      ; 3: Remote C.D.2; uses: 1, vanishes, no triggers thrown
    EQUB 42, 38,  2, &81      ; 4: Remote C.D.3; uses: 1, no triggers thrown
    EQUB 44, 20, 14, &41      ; 5: Explosives; uses: 1, vanishes
    EQUB 15, 48, 10, &81      ; 6: Fire Blanket; uses: 1, no triggers thrown
    EQUB 10,  0, 12, &88      ; 7: Extinguisher; uses: 8, no triggers thrown
    ; level 3
    EQUB 32, 47,  0, &A0      ; 0: Remote C.D.1; uses: any, no triggers thrown
    EQUB 43, 22,  3, &83      ; 1: Blueprints; uses: 3, no triggers thrown
    EQUB 13, 18,  1, &A0      ; 2: Remote C.D.2; uses: any, no triggers thrown
    EQUB 43, 37,  5, &A0      ; 3: Spanner; uses: any, no triggers thrown
    EQUB 19, 30,  7, &41      ; 4: Magnet; uses: 1, vanishes
    EQUB 41,  8,  9, &A0      ; 5: Jovian Wine; uses: any, no triggers thrown
    EQUB 27, 60,  2, &A0      ; 6: Remote C.D.3; uses: any, no triggers thrown
    EQUB  0, 63,  4, &04      ; 7: Mallet; uses: 4
    ; level 4
    EQUB 37, 39,  2, &A1      ; 0: Remote C.D.3; uses: any, no triggers thrown
    EQUB 27, 32,  1, &A0      ; 1: Remote C.D.2; uses: any, no triggers thrown
    EQUB 33, 55,  0, &A0      ; 2: Remote C.D.1; uses: any, no triggers thrown
    EQUB 55, 56,  6, &87      ; 3: Screwdriver; uses: 7, no triggers thrown
    EQUB  2, 44,  9, &49      ; 4: Jovian Wine; uses: 9, vanishes
    EQUB 45, 13,  4, &03      ; 5: Mallet; uses: 3
    EQUB 10, 37, 14, &41      ; 6: Explosives; uses: 1, vanishes
    EQUB 11, 63, 11, &A6      ; 7: Laser Gun; uses: any, no triggers thrown
    ASSERT level_objects = io_level_objects

; Monsters: x, y in character cells (4 to a map cell), direction (0-3 left,
; right, up, down; 4-7 stuck; 8 and up not out), and four 2-bit choices of
; which way to try next, from the bottom: back, on, clockwise, anticlockwise.
.level_monsters
    ; level 1
    EQUB &B4, &80, 2, %00111001   ; cell 45, 32, up; tries on, cw, acw, back
    EQUB &20, &7C, 1, %00100111   ; cell 8, 31, right; tries acw, on, cw, back
    EQUB &04, &14, 2, %00111001   ; cell 1, 5, up; tries on, cw, acw, back
    EQUB &3C, &0C, 3, %00111001   ; cell 15, 3, down; tries on, cw, acw, back
    ; level 2
    EQUB &54, &78, 0, %00100111   ; cell 21, 30, left; tries acw, on, cw, back
    EQUB &4C, &A4, 1, %10110001   ; cell 19, 41, right; tries on, back, acw, cw
    EQUB &38, &F4, 3, %00100111   ; cell 14, 61, down; tries acw, on, cw, back
    EQUB &70, &50, 3, %00111001   ; cell 28, 20, down; tries on, cw, acw, back
    ; level 3
    EQUB &64, &1C, 1, %01010101   ; cell 25, 7, right; tries on, on, on, on
    EQUB &1C, &3C, 2, %00100111   ; cell 7, 15, up; tries acw, on, cw, back
    EQUB &44, &28, 2, %00110110   ; cell 17, 10, up; tries cw, on, acw, back
    EQUB &04, &E0, 1, %00111001   ; cell 1, 56, right; tries on, cw, acw, back
    ; level 4
    EQUB &94, &D8, 2, %00110110   ; cell 37, 54, up; tries cw, on, acw, back
    EQUB &8C, &44, 3, %00101101   ; cell 35, 17, down; tries on, acw, cw, back
    EQUB &28, &4C, 2, %00111101   ; cell 10, 19, up; tries on, acw, acw, back
    EQUB &30, &98, 2, %00110110   ; cell 12, 38, up; tries cw, on, acw, back
    ASSERT level_monsters = io_level_monsters

; Triggers' flags: bits 0-3 the action; bit 4: it can fire again; bit 5:
; disabled (as it is once fired, without bit 4); bit 6: only once
; everything's collected; bit 7: it needs an object used or thrown, rather
; than the player walking on.
.level_trigger_flags
    ; level 1
    EQUB &91    ; 0: move a cell, with an object, again
    EQUB &98    ; 1: teleport, with an object, again
    EQUB &9D    ; 2: give pushes, with an object, again
    EQUB &85    ; 3: blow up an object, with an object
    EQUB &80    ; 4: set a cell, with an object
    EQUB &92    ; 5: set the cell in front, with an object, again
    EQUB &AF    ; 6: swap the keys, with an object, disabled
    EQUB &1A    ; 7: enable triggers, walked on, again
    EQUB &18    ; 8: teleport, walked on, again
    EQUB &13    ; 9: set the clock, walked on, again
    EQUB &80    ; 10: set a cell, with an object
    EQUB &00    ; 11: set a cell, walked on
    EQUB &80    ; 12: set a cell, with an object
    EQUB &18    ; 13: teleport, walked on, again
    EQUB &1A    ; 14: enable triggers, walked on, again
    EQUB &3E    ; 15: push the cell in front, walked on, disabled, again
    EQUB &1B    ; 16: disable triggers, walked on, again
    EQUB &00    ; 17: set a cell, walked on
    EQUB &04    ; 18: throw an object, walked on
    EQUB &18    ; 19: teleport, walked on, again
    EQUB &01    ; 20: move a cell, walked on
    EQUB &38    ; 21: teleport, walked on, disabled, again
    EQUB &80    ; 22: set a cell, with an object
    EQUB &00    ; 23: set a cell, walked on
    EQUB &81    ; 24: move a cell, with an object
    EQUB &07    ; 25: move a monster, walked on
    EQUB &00    ; 26: set a cell, walked on
    EQUB &00    ; 27: set a cell, walked on
    EQUB &00    ; 28: set a cell, walked on
    EQUB &00    ; 29: set a cell, walked on
    EQUB &80    ; 30: set a cell, with an object
    EQUB &00    ; 31: set a cell, walked on
    ; level 2
    EQUB &85    ; 0: blow up an object, with an object
    EQUB &80    ; 1: set a cell, with an object
    EQUB &82    ; 2: set the cell in front, with an object
    EQUB &80    ; 3: set a cell, with an object
    EQUB &80    ; 4: set a cell, with an object
    EQUB &85    ; 5: blow up an object, with an object
    EQUB &96    ; 6: set a monster's way, with an object, again
    EQUB &9C    ; 7: recharge an object, with an object, again
    EQUB &01    ; 8: move a cell, walked on
    EQUB &00    ; 9: set a cell, walked on
    EQUB &00    ; 10: set a cell, walked on
    EQUB &1B    ; 11: disable triggers, walked on, again
    EQUB &03    ; 12: set the clock, walked on
    EQUB &01    ; 13: move a cell, walked on
    EQUB &17    ; 14: move a monster, walked on, again
    EQUB &17    ; 15: move a monster, walked on, again
    EQUB &1A    ; 16: enable triggers, walked on, again
    EQUB &3E    ; 17: push the cell in front, walked on, disabled, again
    EQUB &1B    ; 18: disable triggers, walked on, again
    EQUB &01    ; 19: move a cell, walked on
    EQUB &01    ; 20: move a cell, walked on
    EQUB &1A    ; 21: enable triggers, walked on, again
    EQUB &3E    ; 22: push the cell in front, walked on, disabled, again
    EQUB &1B    ; 23: disable triggers, walked on, again
    EQUB &32    ; 24: set the cell in front, walked on, disabled, again
    EQUB &1A    ; 25: enable triggers, walked on, again
    EQUB &1B    ; 26: disable triggers, walked on, again
    EQUB &1B    ; 27: disable triggers, walked on, again
    EQUB &17    ; 28: move a monster, walked on, again
    EQUB &1A    ; 29: enable triggers, walked on, again
    EQUB &1B    ; 30: disable triggers, walked on, again
    EQUB &1B    ; 31: disable triggers, walked on, again
    ; level 3
    EQUB &80    ; 0: set a cell, with an object
    EQUB &98    ; 1: teleport, with an object, again
    EQUB &80    ; 2: set a cell, with an object
    EQUB &81    ; 3: move a cell, with an object
    EQUB &AE    ; 4: push the cell in front, with an object, disabled
    EQUB &83    ; 5: set the clock, with an object
    EQUB &C2    ; 6: set the cell in front, with an object, all collected
    EQUB &92    ; 7: set the cell in front, with an object, again
    EQUB &1B    ; 8: disable triggers, walked on, again
    EQUB &07    ; 9: move a monster, walked on
    EQUB &00    ; 10: set a cell, walked on
    EQUB &1B    ; 11: disable triggers, walked on, again
    EQUB &1A    ; 12: enable triggers, walked on, again
    EQUB &8D    ; 13: give pushes, with an object
    EQUB &00    ; 14: set a cell, walked on
    EQUB &1F    ; 15: swap the keys, walked on, again
    EQUB &1A    ; 16: enable triggers, walked on, again
    EQUB &02    ; 17: set the cell in front, walked on
    EQUB &1B    ; 18: disable triggers, walked on, again
    EQUB &34    ; 19: throw an object, walked on, disabled, again
    EQUB &1A    ; 20: enable triggers, walked on, again
    EQUB &1B    ; 21: disable triggers, walked on, again
    EQUB &32    ; 22: set the cell in front, walked on, disabled, again
    EQUB &00    ; 23: set a cell, walked on
    EQUB &07    ; 24: move a monster, walked on
    EQUB &00    ; 25: set a cell, walked on
    EQUB &07    ; 26: move a monster, walked on
    EQUB &07    ; 27: move a monster, walked on
    EQUB &19    ; 28: toggle the cell in front, walked on, again
    EQUB &02    ; 29: set the cell in front, walked on
    EQUB &1B    ; 30: disable triggers, walked on, again
    EQUB &32    ; 31: set the cell in front, walked on, disabled, again
    ; level 4
    EQUB &82    ; 0: set the cell in front, with an object
    EQUB &82    ; 1: set the cell in front, with an object
    EQUB &82    ; 2: set the cell in front, with an object
    EQUB &99    ; 3: toggle the cell in front, with an object, again
    EQUB &93    ; 4: set the clock, with an object, again
    EQUB &92    ; 5: set the cell in front, with an object, again
    EQUB &85    ; 6: blow up an object, with an object
    EQUB &97    ; 7: move a monster, with an object, again
    EQUB &82    ; 8: set the cell in front, with an object
    EQUB &4A    ; 9: enable triggers, walked on, all collected
    EQUB &23    ; 10: set the clock, walked on, disabled
    EQUB &6A    ; 11: enable triggers, walked on, all collected, disabled
    EQUB &20    ; 12: set a cell, walked on, disabled
    EQUB &23    ; 13: set the clock, walked on, disabled
    EQUB &00    ; 14: set a cell, walked on
    EQUB &00    ; 15: set a cell, walked on
    EQUB &32    ; 16: set the cell in front, walked on, disabled, again
    EQUB &0A    ; 17: enable triggers, walked on
    EQUB &0B    ; 18: disable triggers, walked on
    EQUB &03    ; 19: set the clock, walked on
    EQUB &00    ; 20: set a cell, walked on
    EQUB &47    ; 21: move a monster, walked on, all collected
    EQUB &00    ; 22: set a cell, walked on
    EQUB &0D    ; 23: give pushes, walked on
    EQUB &82    ; 24: set the cell in front, with an object
    EQUB &82    ; 25: set the cell in front, with an object
    EQUB &82    ; 26: set the cell in front, with an object
    EQUB &2D    ; 27: give pushes, walked on, disabled
    EQUB &92    ; 28: set the cell in front, with an object, again
    EQUB &0A    ; 29: enable triggers, walked on
    EQUB &20    ; 30: set a cell, walked on, disabled
    EQUB &01    ; 31: move a cell, walked on
    ASSERT level_trigger_flags = io_level_trigger_flags

; Where each trigger is: cell x, y (negative: anywhere on that axis).
.level_trigger_places
    ; level 1
    EQUB &1F, &20    ; 0: 31, 32
    EQUB &80, &80    ; 1: any, any
    EQUB &80, &80    ; 2: any, any
    EQUB &1F, &AF    ; 3: 31, any
    EQUB &06, &2E    ; 4: 6, 46
    EQUB &80, &80    ; 5: any, any

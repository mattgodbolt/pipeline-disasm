; IO, the mission file: the four levels PIPELINE plays and the pictures to
; draw them with, as the Mission Generator (MISSION) puts it together and
; saves it, from a graphics file and level files: the graphics file's names,
; the mission's name and attributes, the four levels' fields interleaved and
; their maps, and the graphics. The game loads it at io_start so that it ends
; at &5800. src/io.6502inc has the layout, computed from MISSION's own sizes,
; and what each part means, shared with the game.
;
; Nothing in it is described here: the graphics and their names are the
; default set (src/default.6502inc, which DEFAULT is too) and the levels are
; src/level1.6502inc (LEVEL1's too) to src/level4.6502inc.

INCLUDE "osconst.6502inc"
INCLUDE "io.6502inc"
INCLUDE "default.6502inc"
INCLUDE "level1.6502inc"
INCLUDE "level2.6502inc"
INCLUDE "level3.6502inc"
INCLUDE "level4.6502inc"

; The mission's name is two halves, each a VDU_TAB and 12 characters, the
; spaces stored as VDU_RIGHT so the picture behind them shows.
FUNCTION mission_name_half(x, y, text)
    ASSERT LEN(text) = IO_MISSION_SIZE / 2 - 3, "half a mission name is 12 characters"
    spaces = CODES(text) = ' '
= CONCAT(VDU_TAB, x, y, CODES(text) + (VDU_RIGHT - ' ') * spaces)

SECTION io, filename="IO", org=io_start, load=io_start, exec=0
.io
{
.names
    ; MISSION's names, the end of the graphics file it was given (DEFAULT):
    ; a picture for an object cell with no object, then the object names.
    EQUB default_names()
    ASSERT names = io_no_object_picture
    ASSERT names + 128 = io_object_names

; The mission's name, printed on the backpack screen (CTRL) as the goal.
; MISSION always puts the halves at (18, 16) and (14, 17).
.mission_text
    EQUB mission_name_half(18, 16, "Collect the ")
    EQUB mission_name_half(14, 17, "  Sulphur!  ")
    ASSERT mission_text = io_mission_text

.attrs
    EQUB 15                                  ; the clock's rate (MISSION shows it less 6: 9)
    EQUB 4                                   ; the map works on levels 1 to 4
    EQUB 2                                   ; the backpack holds 3
    EQUB 6                                   ; objects can be thrown 6 cells
    EQUB &FF                                 ; locked: the last level shows an entry code
    ASSERT attrs = io_attrs

; The four levels, as MISSION packs them: for each of a level's 11 fields
; (leveldata.6502inc), the four levels' in turn, then the four maps.
.levels
    EQUB FLATTEN(ZIP(level_fields(level_1), level_fields(level_2), level_fields(level_3), level_fields(level_4)))
    ASSERT levels = io_levels
.maps
    EQUB level_map_bytes(level_1), level_map_bytes(level_2), level_map_bytes(level_3), level_map_bytes(level_4)
    ASSERT maps = io_maps

; The graphics, the start of DEFAULT: the map cells' pictures, the object
; icons, the player and the cells' second pictures.
.graphics
    EQUB default_graphics()
    ASSERT graphics = io_graphics
    ASSERT P% = IO_END
}
ENDSECTION

; $.TITLE: &1679 bytes at sector &027, loaded at &6300 and run at &7900.
; The title page shown before the game: "PIPELINE by IAN HOLMES and WILLIAM
; REEVE" in red, blue and white MODE 1 lettering (docs/img/title.png, made
; with `tools/beebscreen.py 1 data/title_picture.bin OUT.png --palette
; 0,1,4,7 --title`).
;
; MENU's option 1 selects MODE 1, makes all four colours black, *RUNs this,
; then sets the palette to black, red, blue, white (VDU 19 to 0, 1, 4, 7),
; so the picture appears at once, whole, for up to three seconds before the
; game loads.
;
; The file is a packed picture and a little code to unpack it, in its last
; page (&7900). It loads into MODE 1 screen memory itself, and the picture
; unpacks over it, from the start of screen memory (&3000, the top of the
; picture) upwards. The packed data keeps ahead of the unpacking until its
; last 41 bytes, which lie below the picture. The code wouldn't keep ahead:
; the unpacking reaches its page before it has finished, so it first copies
; itself out of the way, to the page below the screen.
;
; The packing is runs of zeros: a nonzero byte stands for itself; a zero is
; followed by how many zeros it stands for (0 meaning 256). By the time the
; unpacker reaches the packed data's last 41 bytes (&78D7 on), it has
; written zeros over them, so they read as runs of 256 zeros, which carry
; the writing on through this code's old page and past the end of the screen
; to &8DB1, in the paged ROM's space (harmless on a model B, where it's ROM).
; The last 2K of the screen, below the picture, is then cleared, though the
; overrun has already left it all zero. (docs/notes/loaders.md has the
; simulation and jsbeeb's record of the writes.)

INCLUDE "os.6502inc"
INCLUDE "osconst.6502inc"

; Where the unpacker runs: the page below the screen. It's inside the block
; MENU DIMs as C% for its scrolling message (&2300-&31FF), but by now MENU
; has stopped the scroller and set LOMEM=TOP, which gives that memory back,
; so the menu's program and variables end well below it.
RELOCATED_PAGE = &2F00

; Zero page: user workspace, used three ways in turn.
SECTION relocate_zero_page, org=&70, virtual=TRUE
.relocate_to SKIP 2         ; where this page is copied to
.relocate_from SKIP 2       ; and from
ENDSECTION
SECTION unpack_zero_page, org=&70, virtual=TRUE
.packed SKIP 2              ; the next packed byte
.screen_ptr SKIP 2          ; the screen page being unpacked into, with Y
ENDSECTION
SECTION clear_zero_page, org=&70, virtual=TRUE
.clear_ptr SKIP 2           ; the page being cleared
ENDSECTION

SECTION title, filename="TITLE", org=&6300, load=&6300, exec=&7900
.title
{
; The picture, packed: data/title_picture.bin.
.picture
    INCBIN "../data/title_picture.bin"
.picture_end
    ASSERT LO(picture_end) = 0, "the unpacker stops at a page boundary"

; Entry, from *RUN. Copies this page down to RELOCATED_PAGE and carries on
; there. Y isn't set: the copy starts at whatever Y *RUN leaves (5 under DFS
; 1.2), which is fine as long as it's below unpack's offset in the page.
.start
    LDA #0
    STA relocate_to
    STA relocate_from
    LDA #HI(RELOCATED_PAGE)
    STA relocate_to+1
    LDA #HI(start)
    STA relocate_from+1
.relocate
    LDA (relocate_from), Y
    STA (relocate_to), Y
    INY
    BNE relocate
    JMP unpack

; The rest of the page runs from RELOCATED_PAGE, so it's assembled for
; there, though it sits here in the file.
SECTION title_relocated, org=RELOCATED_PAGE + LO(P%)
; Unpack the picture into the screen from MODE1_SCREEN, clear the bottom
; 2K, flush the keyboard and return to BASIC. X stays 0 for (packed,X) except
; while it counts a run.
; Clobbers: A, X, Y, packed and screen_ptr (clear_ptr shares packed).
.unpack
    LDA #0
    TAX
    TAY
    STA packed
    STA screen_ptr
    LDA #HI(picture)
    STA packed+1
    LDA #HI(MODE1_SCREEN)
    STA screen_ptr+1
.next_code
    LDA (packed, X)
    BNE store_literal
    ; A zero: the next byte is how many zeros.
    INC packed
    BNE read_run_length
    INC packed+1
    LDA packed+1
    CMP #HI(picture_end)
    BEQ clear_bottom
.read_run_length
    LDA (packed, X)
    TAX
    LDA #0
.store_zero
    STA (screen_ptr), Y
    DEX
    BEQ step_screen
    INY
    BNE store_zero
    INC screen_ptr+1
    BNE store_zero              ; always
.store_literal
    STA (screen_ptr), Y
.step_screen
    INY
    BNE step_packed
    INC screen_ptr+1
.step_packed
    INC packed
    BNE next_code
    INC packed+1
    LDA packed+1
    CMP #HI(picture_end)
    BNE next_code

    ; Clear what's under the picture: where the end of the packed data and
    ; this code were, and the overrun (all zeros already, as it happens).
.clear_bottom
    LDA #HI(PICTURE_BOTTOM)
    STA clear_ptr+1
    LDY #0
    STY clear_ptr
.clear_page
    TYA
.clear_byte
    STA (clear_ptr), Y
    INY
    BNE clear_byte
    INC clear_ptr+1
    LDA clear_ptr+1
    CMP #HI(SCREEN_MEMORY_END)
    BNE clear_page
    LDA #OSBYTE_FLUSH_BUFFERS
    LDX #1                      ; the input buffer: no keys typed during this
    JMP OSBYTE
ENDSECTION
}
ENDSECTION

; The picture fills the screen down to here (28.8 of MODE 1's 32 character
; rows); the rest is cleared.
PICTURE_BOTTOM = &7800

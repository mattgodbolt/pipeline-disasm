; $.MRUN: &80 bytes at sector &100, loaded and run at &0780. That's the top
; half of page 7, BASIC's keyboard input buffer: free while the editors run,
; and the command MRUN types for BASIC lands in the bottom half. The
; Graphics Designer, the Level Designer and MISSION all run `*/MRUN` to get
; back to the menu.
;
; It undoes the editors' hooks - RDCHV (the Level Designer's, still in place
; when it runs /MRUN) and EVNTV with the Escape event (the Graphics
; Designer's) - then types `*E.!BOOT` into the keyboard buffer and starts
; BASIC, which reads that as its first command: the boot file runs again
; from the top, and the menu comes back as it did at boot.
;
; What's left of the file past the text is whatever was in memory when it
; was saved. The rest of its sector on the disc holds more stale bytes,
; which src/disc.toml records.

INCLUDE "os.6502inc"
INCLUDE "osconst.6502inc"

; Zero page: BASIC's, unused until BASIC starts, which is the last thing
; this does. &50 serves twice, in turn. (A number in brackets is a size in
; bytes.)
default_vectors = &50       ; (2) the MOS's table of default vector contents
typed_index = &50           ; next character of boot_command to type

SECTION mrun, filename="MRUN", org=&0780, load=&780, exec=&780
.mrun
{
; Entry from *RUN; never returns.
.start
    ; Twice over, and X is set again before it's used: perhaps left over
    ; from when the Escape event's OSBYTE, below, came first.
    LDX #EVENT_ESCAPE
    LDX #EVENT_ESCAPE

    ; Put RDCHV and EVNTV back to the MOS defaults, from the ROM's table.
    LDA MOS_DEFAULT_VECTORS_PTR
    STA default_vectors
    LDA MOS_DEFAULT_VECTORS_PTR+1
    STA default_vectors+1
    LDY #RDCHV - USERV
    LDA (default_vectors), Y
    STA RDCHV
    INY
    LDA (default_vectors), Y
    STA RDCHV+1
    LDY #EVNTV - USERV
    LDA (default_vectors), Y
    STA EVNTV
    INY
    LDA (default_vectors), Y
    STA EVNTV+1
    LDA #OSBYTE_DISABLE_EVENT
    LDX #EVENT_ESCAPE
    JSR OSBYTE

    ; Type boot_command, up to and including its CR.
    LDY #0
    STY typed_index
.type_next
    LDA boot_command, Y
    PHA
    TAY
    LDX #BUFFER_KEYBOARD
    LDA #OSBYTE_INSERT_BUFFER
    JSR OSBYTE
    PLA
    INC typed_index
    LDY typed_index
    CMP #CR
    BNE type_next

    ; *BASIC makes BASIC the current language, and BASIC reads what was
    ; typed as its first command.
    LDX #LO(start_basic)
    LDY #HI(start_basic)
    JMP OSCLI

; Typed into the keyboard buffer for BASIC to read. BASIC's line input
; echoes the control codes as it reads them, so CTRL-V CTRL-G (VDU 22,7)
; clears to a MODE 7 screen before the boot file starts, but stores only
; printable characters: the command BASIC runs is "*E.!BOOT  ".
.boot_command
    EQUS "*E.!BOOT"
    EQUB VDU_MODE, 7            ; MODE 7
    EQUS "  ", CR

.start_basic
    EQUS "*BASIC", CR

; Uninitialised to the end of the file, which was saved as half a page:
; zeros, then stale memory.
.unused
    SKIP 13
    EQUB &B8, &A7, &EE, &A5, &A6, &A6, &8D, &A6
    EQUB &CA, &AC, &41, &A5, &19, &A5, &4A, &2E
    ASSERT P% - start = &80
}
ENDSECTION

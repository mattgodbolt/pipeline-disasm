; DEFAULT: the default graphics set, as the Graphics Designer saves it. It
; loads it at &4000 and saves &4000-&4F33 back; MISSION loads it to put in a
; mission, and IO carries the same pictures and names. The set itself, every
; picture drawn, is src/default.6502inc.
;
;   &000  slots &00-&27: the graphics (the large sprites &00-&0F, the small
;         &10-&1F, the large &20-&27)
;   &E00  MISSION's "names": slot &28, then the names of small sprites
;         &10-&1E, 12 characters each
;
; The designer's sheet shows the large slots in its own order
; (slot_of_position in H.GRAPH).
INCLUDE "default.6502inc"

SECTION default, filename="DEFAULT", org=&4000, load=&4000, exec=&0

.graphics
    EQUB default_graphics()
.names
    EQUB default_names()
    ASSERT P% = &4F34

ENDSECTION

; $.GRAPHIC: the catalogued file at sector &112, &D9 bytes loaded and run at
; &0900. The stub loader for the Graphics Designer (MENU option 3,
; `*/GRAPHIC`): it reads H.GRAPH from its hidden sectors and enters it. All
; of the code is in hidden_loader.6502inc, which says what a stub and a
; hidden run are; it's shared with GAME and LEVDES, and this file gives it
; the four numbers that differ.

INCLUDE "os.6502inc"
INCLUDE "osconst.6502inc"

; H.GRAPH, the Graphics Designer's hidden run. No catalogue entry names it:
; the name is the build's (src/hidden_graphic.6502 makes it, src/disc.toml
; places it). Track 32 sector 5 to track 35 sector 7. It loads part way into
; a page and is entered well inside itself. Each source assembles on its
; own, so the addresses are written out here.
hidden_first_sector = &145
hidden_length = &2100
hidden_load = &1AB0
hidden_entry = &2BAE                    ; start, in hidden_graphic.6502

SECTION graphic, filename="GRAPHIC", org=&0900, load=&900, exec=&900
.graphic_loader
{
    INCLUDE "hidden_loader.6502inc"
}
ENDSECTION

; A PIPELINE graphics set: its layout and what each slot is for, then the
; notation its pictures are written in here. The Graphics Designer edits a
; set at &4000 and saves it whole (DEFAULT is one: default.6502inc describes
; it); MISSION copies it into a mission, where the game draws with it
; (io.6502inc has where it goes there). Included by io.6502inc, so anything
; including that has this too.

; ---------------------------------------------------------------------------
; The layout: sprites in numbered slots, then the objects' names.

LARGE_SPRITE_WIDTH  = 16        ; pixels
LARGE_SPRITE_HEIGHT = 32
LARGE_SPRITE_SIZE   = LARGE_SPRITE_WIDTH / 4 * LARGE_SPRITE_HEIGHT    ; bytes, four pixels each
SMALL_SPRITE_WIDTH  = 8
SMALL_SPRITE_HEIGHT = 16
SMALL_SPRITE_SIZE   = SMALL_SPRITE_WIDTH / 4 * SMALL_SPRITE_HEIGHT

; The objects: kinds 0-14, each with an icon (a small slot) and a name, space
; padded. Icon 15, after them, is the exit's, and has no name.
OBJECT_KINDS       = 15
OBJECT_NAME_LENGTH = 12
EXIT_ICON          = OBJECT_KINDS

SET_LOAD_ADDRESS = &4000        ; where the Graphics Designer keeps a set, and saves it from

SET_LARGE      = &000           ; large slots &00-&0F
SET_SMALL      = &800           ; small slots &10-&1F
SET_MORE_LARGE = &A00           ; large slots &20-&28
SET_NAMES      = &E80           ; the names of icons 0-14
SET_SIZE       = &F34

FIRST_SMALL_SLOT = &10
MORE_LARGE_SLOT  = &20
LAST_SLOT        = &28

; What the game makes of the slots (a mission holds slots &00-&27, the set's
; first &E00 bytes, as its graphics, and slot &28 apart). Slots &00-&0F are
; the map's cell types, &10-&1F the objects' icons.
SLOT_FLOOR     = &00            ; cell type 0; the game also fills the floor round an
                                ; icon from its first character cell, so it repeats that
SLOT_MONSTER   = &0E            ; &0E and &0F: the flame monsters' two pictures
SLOT_EXIT      = FIRST_SMALL_SLOT + EXIT_ICON
SLOT_PLAYER    = &20            ; &20-&23: the player facing left, right, up and down
SLOT_ALTERNATE = &24            ; &24-&27: second pictures for cell types 5, 7, 8 and A
SLOT_NO_OBJECT = &28            ; for an object cell with no object in it

ASSERT SET_SMALL = SET_LARGE + FIRST_SMALL_SLOT * LARGE_SPRITE_SIZE
ASSERT SET_MORE_LARGE = SET_SMALL + (MORE_LARGE_SLOT - FIRST_SMALL_SLOT) * SMALL_SPRITE_SIZE
ASSERT SET_NAMES = SET_MORE_LARGE + (LAST_SLOT + 1 - MORE_LARGE_SLOT) * LARGE_SPRITE_SIZE
ASSERT SET_SIZE = SET_NAMES + OBJECT_KINDS * OBJECT_NAME_LENGTH
ASSERT SLOT_EXIT = MORE_LARGE_SLOT - 1 AND SLOT_PLAYER = MORE_LARGE_SLOT

; ---------------------------------------------------------------------------
; Sprites written as pictures. A picture is a list of strings, one per row of
; pixels, each character a logical colour: . 1 2 3. The bytes come out the
; way PIPELINE stores sprites (and MODE 5 lays out the screen inside a
; character cell): a column four pixels wide at a time, top to bottom, then
; the next column to the right.

; The MODE 5 byte for four pixels: pixel n (0 leftmost) keeps its colour's
; high bit in bit 7-n and its low bit in bit 3-n.
FUNCTION mode5_byte(pixels)
    p = FIND(CODES(".123"), CODES(pixels))
= SUM((p DIV 2) * {128, 64, 32, 16} + (p MOD 2) * {8, 4, 2, 1})

; The game's pictures (src/default.6502inc) are drawn two characters a pixel,
; as a MODE 5 pixel is twice as wide as it is tall, so they look in the
; source as they do on the screen. mode5_pictures turns a list of same-sized
; pictures into their bytes, one picture after another, in one go: as a
; FUNCTION over whole lists rather than a FOR over bytes, it adds a handful of
; entries to the symbol dump rather than one per byte.

; Where each byte's leftmost pixel starts in count pictures of height rows
; of width characters, run together: picture by picture, then a column of
; four pixels (eight characters) at a time, then down the rows.
FUNCTION picture_byte_starts(count, height, width)
    pictures = (0..count-1) * height * width
    columns = (0..width DIV 8 - 1) * 8
    rows = (0..height-1) * width
= FLATTEN(ZIP(ZIP(pictures)) + ZIP(columns) + rows)

; Pixel n's bits in a byte (n = 0 leftmost), for each pixel's character in
; chars: the colour's high bit in bit 7-n and its low bit in bit 3-n.
FUNCTION pixel_bits(chars, n) = {0, 8, 128, 136}[FIND(CODES(".123"), CODES(chars))] >> n

; The bytes of a list of pictures, all the same size, one after another.
FUNCTION mode5_pictures(pictures)
    text = CHR(CODES(pictures))         ; every row of every picture, run together
    ASSERT text[0..2..] = text[1..3..], "a pixel is two characters the same"
    height = LEN(pictures[0])
    width = LEN(pictures[0][0])
    ASSERT LEN(text) = LEN(pictures) * height * width, "pictures of different sizes"
    starts = picture_byte_starts(LEN(pictures), height, width)
= SUM({
    pixel_bits(text[starts], 0),
    pixel_bits(text[starts + 2], 1),
    pixel_bits(text[starts + 4], 2),
    pixel_bits(text[starts + 6], 3)
}, 0)

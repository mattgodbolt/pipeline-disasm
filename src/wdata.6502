    WINDOW 11, 5, 20, 5
    LINE "Files:"
    LINE "Load level"
    LINE "Save level"
    LINE "Edit code"
    LINE "Exit"
    LINE "<< OK >>"

.win_sure
    WINDOW 13, 7, 16, 2
    LINE "SURE ?"
    LINE "Press Y"
    LINE "or N"


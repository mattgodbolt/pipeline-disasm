; $.WDATA: the Level Designer's windows and messages, loaded at &7000
; (format and numbering in wdata.6502inc).
INCLUDE "levdes.6502inc"
INCLUDE "wdata.6502inc"

; Window lines are glyph codes, by position in wdata_glyphs.
FUNCTION glyph_codes(s) = FIND(CODES(wdata_glyphs), CODES(s))
FIXED = &80                     ; in x: the window stays put
SPACE_STAYS = &80               ; in y: Space picks the item the menu
                                ; started on, not the last
MACRO WINDOW x, y, width, height
    EQUB x, y, width, height
ENDMACRO
MACRO LINE s                    ; centred
    EQUB LEN(s), glyph_codes(s)
ENDMACRO
MACRO LEFT s                    ; from the left
    EQUB LEN(s) OR &80, glyph_codes(s)
ENDMACRO
; A pointer in the table, checked against its number.
MACRO ENTRY number, address
    ASSERT * == wdata + (number - 1) * 2
    EQUW address
ENDMACRO

SECTION wdata, filename="WDATA", org=wdata, load=wdata, exec=0
.wdata_table
    ENTRY W_SELECT_BLOCK, win_select_block
    ENTRY W_OPTIONS, win_options
    ENTRY W_OPTIONS_LOCATION, win_options_location
    ENTRY M_WHICH_OBJECT, msg_which_object
    ENTRY W_OBJECT, win_object
    ENTRY M_RECORD_NUMBER, msg_record_number
    ENTRY M_OLD_SPRITE, msg_old_sprite
    ENTRY M_CHARGES, msg_charges
    ENTRY M_ERROR, msg_error
    ENTRY M_PRESS_ANY_KEY, msg_press_any_key
    ENTRY M_WHICH_MONSTER, msg_which_monster
    ENTRY W_MONSTER, win_monster
    ENTRY W_DIRECTION, win_direction
    ENTRY W_PRIORITIES, win_priorities
    ENTRY W_RELATIVE_DIRECTION, win_relative_direction
    ENTRY M_PATTERN_AT, msg_pattern_at
    ENTRY M_INITIAL_TIME, msg_initial_time
    ENTRY M_ENTER_NEW_VALUE, msg_enter_new_value
    ENTRY M_COLLECTABLES, msg_collectables
    ENTRY M_REQUIRED, msg_required
    ENTRY W_GRAPHICS, win_graphics
    ENTRY W_SPRITES, win_sprites
    ENTRY W_COLOURS, win_colours
    ENTRY M_WHICH_PUZZLE, msg_which_puzzle
    ENTRY W_PUZZLE, win_puzzle
    ENTRY M_PUZZLE_NAME_AT, msg_puzzle_name_at
    ENTRY M_OLD_NAME, msg_old_name
    ENTRY M_PUZZLE_NAME, msg_puzzle_name
    ENTRY W_PUZZLE_TYPES, win_puzzle_types
    ENTRY W_OBJECT_LOCATION, win_object_location
    ENTRY W_MONSTER_LOCATION, win_monster_location
    ENTRY W_PUZZLE_STATUS, win_puzzle_status
    ENTRY M_STATUS_NUMBER_AT, msg_status_number_at
    ENTRY W_CONDITIONS, win_conditions
    ENTRY W_COMPASS, win_compass
    ENTRY W_PUZZLE_LOCATION, win_puzzle_location
    ENTRY W_FILES, win_files
    ENTRY W_SURE, win_sure
    ENTRY M_LOADING, msg_loading
    ENTRY M_SAVING, msg_saving
    ENTRY M_ENTER_FILENAME, msg_enter_filename
    ENTRY W_DISORIENTATE, win_disorientate
    ENTRY W_PLACE_BLOCK, win_place_block
    ENTRY W_SET_LEVELS, win_set_levels
    ENTRY M_REVISED_TIME, msg_revised_time
    ENTRY M_COLLECTABLES_REQUIRED, msg_collectables_required
    ENTRY W_SWAP_NEXT, win_swap_next
    ENTRY W_MOVE_BLOCK, win_move_block
    ENTRY W_THROW_OBJECT, win_throw_object
    ENTRY M_OBJECT_NUMBER, msg_object_number
    ENTRY M_DISTANCE, msg_distance
    ENTRY W_CHARGE_OBJECT, win_charge_object
    ENTRY W_DEFINE_DISPLAY, win_define_display
    ENTRY W_SELECT_PUZZLES, win_select_puzzles
    ENTRY M_OLD_PUZZLE_NUMBER, msg_old_puzzle_number
    ENTRY M_NUMBER_OF_CRATES, msg_number_of_crates
    ENTRY W_MOVE_MONSTER, win_move_monster
    ENTRY M_MONSTER_NUMBER, msg_monster_number
    ENTRY W_PLACE_MONSTER, win_place_monster
    ENTRY M_NAME_QUOTE, msg_name_quote
    ENTRY M_QUOTE_PUZZLE, msg_quote_puzzle
    ENTRY W_HELP, win_help
    ENTRY W_ABOUT, win_about
    ENTRY M_ENTER_CODE, msg_enter_code
    ENTRY M_WRONG_CODE, msg_wrong_code
    ENTRY W_LOST_LIFE, win_lost_life
    ENTRY W_SIMULATE, win_simulate
    ENTRY M_ERROR_NUMBER_AT, msg_error_number_at
    ENTRY M_ERROR_TEXT_AT, msg_error_text_at
    ENTRY W_PATTERNS, win_patterns
    ENTRY M_FILING_WINDOW, msg_filing_window
    ENTRY M_TOO_MANY, msg_too_many
    ENTRY M_RESET_WINDOWS, msg_reset_windows
    ENTRY W_MONSTER_NUMBER, win_monster_number
    ENTRY M_INSERT_DISC, msg_insert_disc
    ENTRY M_NOTHING, msg_nothing
    EQUW 0
    ALIGN &100

.win_select_block
    WINDOW 2, SPACE_STAYS + 1, 22, 16
    LINE "Select:"
    LINE "Blank"
    LINE "SE curve"
    LINE "SW curve"
    LINE "NE curve"
    LINE "NW curve"
    LINE "Wall 1"
    LINE "Wall 2"
    LINE "Collectable"
    LINE "Fatal trap"
    LINE "S.Monster"
    LINE "Crate"
    LINE "Marker"
    LINE "Horz.Pipe"
    LINE "Vert.Pipe"
    LINE "Junction"
    LINE "Barricade"

.win_options
    WINDOW 24, 1, 18, 10
    LINE "Options:"
    LINE "Start"
    LINE "Finish"
    LINE "Object"
    LINE "M.Monster"
    LINE "Puzzle"
    LINE "Collects"
    LINE "Graphics"
    LINE "Time"
    LINE "Clear"
    LINE "<< OK >>"

.win_options_location
    WINDOW 6, 3, 18, 2
    LINE "OPTIONS"
    LINE "Select"
    LINE "location:"

.msg_which_object
    EQUS "Which object ?|"

.win_object
    WINDOW FIXED + 14, 3, 20, 8
    LINE "Object  "
    LEFT "Position"
    LEFT "Exists ?"
    LINE "Sprite no."
    LINE "Charge"
    LEFT "Charges:"
    LEFT "Vanish:"
    LEFT "Throw:"
    LINE "<< OK >>"

.msg_record_number
    EQUS os_tab(30, 3), HIGHLIGHT, "|"         ; after "Object" or "Monster"

.msg_old_sprite
    EQUS "Old sprite no.:|"

.msg_charges
    EQUS "No. of charges:|"

.msg_error
    ; (no "|": runs on into M_PRESS_ANY_KEY)
    EQUS "Error", os_tab(24, MESSAGE_LINE_1), "has occurred !"

.msg_press_any_key
    EQUS os_tab(8, MESSAGE_BOX_ROW + 3), "Press any key...|"

.msg_which_monster
    EQUS "Which monster ?|"

.win_monster
    WINDOW FIXED + 14, 3, 18, 6
    LEFT "Monster"
    LINE "Position"
    LINE "Direction"
    LINE "Pattern"
    LINE "Killed by"
    LINE "Result"
    LINE "<< OK >>"

.win_direction
    WINDOW 7, SPACE_STAYS + 18, 18, 5
    LINE "Direction"
    LINE "North"
    LINE "South"
    LINE "East"
    LINE "West"
    LINE "DEAD"

.win_priorities
    WINDOW FIXED + 16, 13, 30, 5
    LINE "Pattern:     "
    LINE "First priority"
    LINE "Second priority"
    LINE "Third priority"
    LINE "Fourth priority"
    LINE "<< OK >>"

.win_relative_direction
    WINDOW FIXED + 7, SPACE_STAYS + 18, 20, 4
    LINE "Direction:"
    LINE "Forwards"
    LINE "Backwards"
    LINE "Left"
    LINE "Right"

.msg_pattern_at
    EQUS os_tab(36, 13), HIGHLIGHT, "|"        ; after "Pattern:"

.msg_initial_time
    EQUS "Initial time:|"

.msg_enter_new_value
    EQUS "Enter new value:|"

.msg_collectables
    EQUS "Collectables:|"

.msg_required
    EQUS " Required:|"


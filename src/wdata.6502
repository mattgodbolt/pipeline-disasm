.win_move_monster
    WINDOW 16, 5, 24, 3
    LINE "Move monster"
    LINE "Monster no."
    LINE "Direction"
    LINE "<< OK >>"

.msg_monster_number
    EQUS "Monster number:|"

.win_place_monster
    WINDOW FIXED + 9, 6, 26, 5
    LINE "Place monster"
    LINE "Monster no."
    LINE "Position"
    LINE "Direction"
    LINE "Pattern"
    LINE "<< OK >>"

.msg_name_quote
    EQUS "Name: ""|"

.msg_quote_puzzle
    EQUS """ Puzzle |"

.win_help
    WINDOW 7, 1, 22, 3
    LINE "Help:"
    LINE "Find puzzle"
    LEFT "Simulate"
    LINE "<< OK >>"

.win_about
    WINDOW FIXED + 32, 1, 30, 8
    LINE "PIPELINE"
    LINE " "
    LINE "LEVEL DESIGNER"
    LINE " "
    LINE "By:"
    LINE "IAN HOLMES"
    LINE "And:"
    LINE "WILLIAM REEVE"
    LINE " "

.msg_enter_code
    EQUS "Enter editing code:|"

.msg_wrong_code
    EQUS "Sorry! Wrong code.|"

.win_lost_life
    WINDOW 7, 9, 16, 3
    LINE "Simulate"

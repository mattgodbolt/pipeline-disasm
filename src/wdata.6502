    WINDOW 12, 7, 24, 2
    LINE "Disorientate"
    LINE "Reverses"
    LINE "control keys"

.win_place_block
    WINDOW 15, 5, 28, 3
    LINE "Place block"
    LINE "Block position"
    LINE "Block type"
    LINE "<< OK >>"

.win_set_levels
    WINDOW 13, 6, 20, 5
    LINE "Set levels"
    LINE "Time"
    LEFT "Change:"
    LINE "Collects."
    LEFT "Change:"
    LINE "<< OK >>"

.msg_revised_time
    EQUS "Revised amount of time:|"

.msg_collectables_required
    EQUS "Collectables required:|"

.win_swap_next
    WINDOW 4, 8, 18, 3
    LINE "Swap next"
    LINE "Block A"
    LINE "Block B"
    LINE "<< OK >>"

.win_move_block
    WINDOW 17, 7, 28, 3
    LINE "Move block"
    LINE "Block position"
    LINE "Direction"
    LINE "<< OK >>"

.win_throw_object
    WINDOW 6, 4, 24, 3
    LINE "Throw object"
    LINE "Object no."
    LINE "Distance"
    LINE "<< OK >>"

.msg_object_number
    EQUS "Object number:|"

.msg_distance
    EQUS "Distance in blocks:|"

.win_charge_object
    WINDOW 5, 3, 26, 3
    LINE "Charge object"
    LINE "Object no."
    LINE "No.of charges"
    LINE "<< OK >>"

.win_define_display
    WINDOW 5, 11, 16, 3
    LINE "Options"
    LINE "Define"
    LINE "Display"
    LINE "<< OK >>"

.win_select_puzzles
    WINDOW 2, 19, 18, 5
    LINE "Select:"
    LINE "Puzzle A"
    LINE "Puzzle B"
    LINE "Puzzle C"
    LEFT "Single:"
    LINE "<< OK >>"

.msg_old_puzzle_number

    LINE "lost one"
    LINE "life."

.win_simulate
    WINDOW 1, 3, 16, 2
    LINE "Simulate"
    LINE "Move"
    LINE "cursor"

.msg_error_number_at
    EQUS os_tab(16, MESSAGE_LINE_1), "|"

.msg_error_text_at
    EQUS os_tab(6, MESSAGE_LINE_2), "|"

.win_patterns
    WINDOW FIXED + 1, SPACE_STAYS + 14, 28, 5
    LINE "Patterns:"
    LINE "Back and forth"
    LINE "Follow edges"
    LINE "Left wall"
    LINE "Right wall"
    LINE "Special"

.msg_filing_window
    ; After print_line2's TAB: blank the start of the line, then a text
    ; window of the rest, the OS's row 13, columns 0-22 (our row 16 from
    ; column 16), cleared.
    EQUS "       ", VDU_TEXT_WINDOW, 0, 13, 22, 13, VDU_CLS, "|"

.msg_too_many
    ; (no "|": runs on into M_RESET_WINDOWS)
    EQUS os_tab(MESSAGE_LEFT, MESSAGE_BOX_ROW + 1), "Too many collectables"

.msg_reset_windows
    EQUS VDU_RESET_WINDOWS, "|"

.win_monster_number
    WINDOW 13, SPACE_STAYS + 17, 24, 5
    LINE "Monster no."
    LINE "Monster 1"
    LINE "Monster 2"
    LINE "Monster 3"
    LINE "Monster 4"
    LINE "All monsters"

.msg_insert_disc
    ; (no "|": runs on into M_NOTHING)
    EQUS "Please insert PIPELINE disk"

.msg_nothing
    EQUS "|"

ENDSECTION

    LINE "Graphics:"
    LINE "Wall one"
    LINE "Wall two"
    LINE "Collectable"
    LINE "Fatal trap"
    LINE "First colour"
    LINE "Second colour"
    LINE "Third colour"
    LINE "Fourth colour"
    LINE "<< OK >>"

.win_sprites
    WINDOW 20, SPACE_STAYS + 17, 18, 3
    LINE "Sprites"
    LINE "Sprite A"
    LINE "Sprite B"
    LINE "Patterned"

.win_colours
    WINDOW 23, SPACE_STAYS + 16, 14, 8
    LINE "Colours"
    LINE "Black"
    LINE "Red"
    LINE "Green"
    LINE "Yellow"
    LINE "Blue"
    LINE "Magenta"
    LINE "Cyan"
    LINE "White"

.msg_which_puzzle
    EQUS "Which puzzle ?|"

.win_puzzle
    WINDOW FIXED + 14, 2, 20, 6
    LINE " "
    LINE "Name"
    LINE "Type"
    LINE "Status"
    LINE "Conditions"
    LINE "Effects"
    LINE "<< OK >>"

.msg_puzzle_name_at
    EQUS os_tab(14, 2), HIGHLIGHT, "|"         ; the puzzle window's title

.msg_old_name
    EQUS "Old name: |"

.msg_puzzle_name
    EQUS "Puzzle name:|"

.win_puzzle_types
    WINDOW 2, SPACE_STAYS + 11, 30, 16
    LINE "Puzzle types"
    LINE "Place block"
    LINE "Move block"
    LINE "Next block"
    LINE "Set levels"
    LINE "Throw object"
    LINE "Detonate object"
    LINE "Move monster"
    LINE "Place monster"
    LINE "Teleport"
    LINE "Swap next block"
    LINE "Turn on puzzle"
    LINE "Turn off puzzle"
    LINE "Charge object"
    LINE "Push crates"
    LINE "Move next block"
    LINE "Disorientate"

.win_object_location
    WINDOW 3, 2, 18, 2
    LINE "OBJECT"
    LINE "Select"
    LINE "location:"

.win_monster_location
    WINDOW 2, 3, 18, 2
    LINE "MONSTER"
    LINE "Select"
    LINE "location:"

.win_puzzle_status
    WINDOW FIXED + 18, 7, 30, 4
    LINE "Puzzle status:"
    LEFT "Use object 1:"
    LEFT "Turned on:"
    LEFT "Re-usable:"
    LINE "<< OK >>"

.msg_status_number_at
    EQUS os_tab(40, 8), "|"     ; over the 1 of "Use object 1:"

.win_conditions
    WINDOW 1, 3, 26, 9
    LINE "Conditions:"
    LINE "Position"
    LEFT "Check X:"
    LEFT "Check Y:"
    LINE "Next block"
    LEFT "Check next:"
    LINE "Direction"
    LEFT "Check dir.:"
    LEFT "Collects.:"
    LINE "<< OK >>"

.win_compass
    WINDOW 8, SPACE_STAYS + 5, 20, 4
    LINE "Direction"
    LINE "North"
    LINE "South"
    LINE "East"
    LINE "West"
    ; Four more, for when set_direction_menu_size makes it eight.
    LINE "North-west"
    LINE "North-east"
    LINE "South-west"
    LINE "South-east"

.win_puzzle_location
    WINDOW 2, 2, 18, 2
    LINE "PUZZLE"
    LINE "Select"
    LINE "location:"


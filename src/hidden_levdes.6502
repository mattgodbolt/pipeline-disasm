; Where the LEVDES stub jumps. Move the low code, the font and zero page to
; where they run, set the screen up (MODE 1 narrowed to 64 columns), load the
; windows and the title picture, wait for Space and start the editor. All of
; this, from &25A1 up, becomes the level once it's done.
.entry
    ; The low code, &0880-&0CFF; the loop runs the source from low_code_load
    ; less &80 so that Y starts at &80, and takes the font's first &40 bytes
    ; along with it.
    LDY #&80
    LDX #4                      ; half a page, then four pages
.entry_copy_code
    LDA low_code_load - &80, Y
.entry_copy_code_store
    STA low_code - &80, Y
    INY
    BNE entry_copy_code
    INC entry_copy_code+2
    INC entry_copy_code_store+2
    DEX
    BPL entry_copy_code
    LDX #(64 * 16) DIV 256 - 1  ; four pages
.entry_copy_font
    LDA font_load, Y
.entry_copy_font_store
    STA font, Y
    INY
    BNE entry_copy_font
    INC entry_copy_font+2
    INC entry_copy_font_store+2
    DEX
    BPL entry_copy_font
    LDX #&3F
.entry_copy_zero_page
    LDA zero_page_init_load, X
    STA menu_tables, X
    DEX
    BPL entry_copy_zero_page
    TXS
    LDA #&C0
    STA unused_66
    INX
    STX cursor_shown
    STX simulate_window
    STX simulating
    STX brush
    STX loading
    STX in_main_loop
    LDA #22                     ; MODE 1
    JSR OSWRCH
    INX
    TXA
    JSR OSWRCH
    LDA #64                     ; 64 columns displayed (R1)
    JSR vector_crtc_write
    INX
    LDA #90                     ; and the sync moved to centre them (R2)
    JSR vector_crtc_write
    JSR vector_cursor_off
    LDA #&0C                    ; *FX12,4: fast auto-repeat
    LDX #4
    JSR OSBYTE
    LDA #&C8                    ; *FX200,2: Break clears memory
    LDX #2
    JSR osbyte_y0
    LDA #&D6                    ; *FX214,2: a short beep
    LDX #2
    JSR osbyte_y0
    LDA #&E1                    ; *FX225,128: f0-f9 give &80-&89
    LDX #&80
    JSR osbyte_y0
    LDY #3
.entry_palette
    LDA title_palette, Y
    JSR vector_set_palette
    DEY
    BPL entry_palette
    ; Put the OS's RDCHV into rdchv_filter's JSR.
    LDA rdchv_filter_operand_address
    STA ptr
    LDA rdchv_filter_operand_address+1
    STA ptr+1
    LDA #31                     ; the cursor in the middle of the map
    STA cursor_x
    STA cursor_y
    LDY #1
    LDA RDCHV+1
    STA (ptr), Y
    DEY
    LDA RDCHV
    STA (ptr), Y
    LDA #&8B                    ; *OPT 1,0: no filing system messages
    LDX #1
    JSR OSBYTE
    LDA #&E5                    ; *FX229,1 (X is still 1): Escape is just a key
    JSR OSBYTE
    SEI
    LDX #LO(load_wdata_command)
    LDY #HI(load_wdata_command)
    JSR OSCLI
    LDX #LO(load_ldata_command) ; straight onto the screen
    LDY #HI(load_ldata_command)
    JSR OSCLI
    CLI
    LDA #&8B                    ; *OPT 0,0
    LDX #0
    LDY #0
    JSR OSBYTE
.entry_wait_space
    JSR OSRDCH
    CMP #asc(" ")
    BNE entry_wait_space
    LDA #&E5                    ; *FX229,0: Escape back on
    JSR OSBYTE
    JSR vector_text_colours
    LDA brk_handler_address
    STA BRKV
    LDA brk_handler_address+1
    STA BRKV+1
    JMP vector_main

; In: A, X = an OSBYTE call.
.osbyte_y0
    LDY #0
    JMP OSBYTE

; Black, blue, yellow and red for the title, as set_palette_entry wants them.
.title_palette
    EQUB 3 * 16 + 1, 2 * 16 + 3, 1 * 16 + 4, 0 * 16 + 0
.load_wdata_command
    EQUS "L.WDATA", 13
.load_ldata_command
    EQUS "L.LDATA", 13

; The rest of the last sector: bytes from H.GRAPH, the Graphics Designer, at
; the same place in its file (code that ran at &38CF there). The level
; designer's file was evidently written over a buffer that held it.
.junk
    EQUB &A2, &97, &20, &CA, &39, &E6, &74, &A2
    EQUB &B7, &20, &86, &21, &10, &0B, &A4, &74
    EQUB &F0, &07, &A2, &B7, &20, &CA, &39, &C6
    EQUB &74, &A2, &CF, &20, &86, &21, &10, &07
    EQUB &A9, &01, &85
    EQUS "w @+"
    EQUB &A2, &CE, &20, &86, &21, &10, &07, &A9
    EQUB &02, &85
    EQUS "w @+"
    EQUB &A2, &EE, &20, &86, &21, &10, &07, &A9
    EQUB &03, &85
    EQUS "w @+"
    EQUB &A2, &ED, &20, &86, &21, &30, &07, &A2
    EQUB &D8, &20, &86, &21, &10, &07, &A9, &00
    EQUB &85
    EQUS "w @+"
    EQUB &A5, &75, &45, &73, &D0, &06
    EQUS "EtEv"
    EQUB &F0, &1E, &A5, &78, &38, &E9, &0A, &C9
    EQUB &0A, &B0, &02, &A9, &0A, &85, &78, &A6
    EQUB &73, &A4, &74, &20, &EF, &34, &A6, &75
    EQUB &A4, &76, &20, &EF
    EQUS "4LU9"
    EQUB &A9, &B9, &85, &78, &A2, &A6, &20, &86
    EQUB &21, &10, &0D, &A5, &77, &48, &E8, &86
    EQUS "w p9h"
    EQUB &85, &77, &60, &A2, &B6, &20, &86, &21
    EQUB &10, &2B, &A6, &73, &A4, &74, &20, &CE
    EQUB &34, &A0, &03, &A6, &77, &BD, &42, &23
    EQUB &59, &FF, &34, &91, &50, &88, &10, &F5
    EQUB &A5, &71, &A6, &73, &A4, &74, &20, &14
    EQUB &3A, &A5, &71, &D0, &03, &20, &9C, &39
    EQUB &A5, &71, &20, &D4, &24, &60, &A5, &52
    EQUB &29, &F8, &85, &52, &A0, &07, &B1, &52
    EQUB &99, &C2, &39, &88, &10, &F8, &A0, &7F
    EQUB &A2, &07
ENDSECTION

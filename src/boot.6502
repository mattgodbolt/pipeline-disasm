; $.!BOOT: &94 bytes at sector &002. The disc's *OPT4,3 boot file, so
; SHIFT+BREAK *EXECs it: each line is typed in as if at the keyboard, first
; to the MOS command line, then (after *BASIC) to BASIC.
;
; - The *| lines are MOS comments: the credits, shown as they're typed.
; - *BASIC makes sure BASIC is the current language before the rest.
; - *FX200,3: Escape disabled, and memory cleared on BREAK, so BREAK can't
;   be used to stop the game and look at it.
; - ?&224=?(&24+!&FFB7) disconnects an Econet filing system (NFS) from
;   NETV, the network vector at &224. !&FFB7 is the address of the MOS's
;   table of default vector contents, laid out as page 2 is, so &24 bytes
;   in is NETV's default, and this copies back its low byte. A ROM claims a
;   vector through the MOS's extended vectors: it points the vector at an
;   entry in page &FF that jumps on through a table in page &0D. For NETV
;   that entry is &FF36, and MOS 1.20's default is &FFA6, so the low byte
;   is all that changes. Econet's NFS claims NETV this way at every reset.
;   Nothing else on the disc writes NETV. Presumably the worry is that
;   OSWORD 0 calls NETV after every line it reads, and the game's title
;   screen reads a mission's file name that way while the game's code fills
;   page &0D, the extended vectors' table.
;   The line makes no visible difference, though: the NFS ignores those
;   calls, MENU soon puts back every vector but BRKV anyway, and when the
;   game loads IO its own service calls make the NFS claim NETV again, so
;   its file name read goes through game code regardless
;   (docs/notes/loaders.md).
; - CHAIN"MENU" runs the BASIC menu.

INCLUDE "osconst.6502inc"   ; CR: *EXEC lines end with one, as typed

SECTION boot, filename="!BOOT", org=0, load=&FFFFFFFF, exec=&FFFFFFFF
    EQUS "*| PIPELINE/B 1.01", CR
    EQUS "*|   Copyright (c) 1988", CR
    EQUS "*|   William Reeve & Ian Holmes", CR
    EQUS "*| For Superior Software", CR
    EQUS "*BASIC", CR
    EQUS "*FX200,3", CR
    EQUS "?&224=?(&24+!&FFB7)", CR
    EQUS "CHAIN""MENU""", CR
ENDSECTION

; Level 4: the last of IO's four. Written as leveldata.6502inc describes;
; src/io.6502 makes its bytes from this. A mission doesn't keep its levels'
; trigger names (MISSION names them "Puzzle 1" to "Puzzle 32" when it saves
; one as a level file), so these have none.
level_4 = {
    ; The editing code: MISSION wants it before it saves a locked mission's
    ; level, and the game shows it once the level's done.
    "114226",
    ; The palette: logical colours 0-3.
    {COLOUR_BLACK, COLOUR_BLUE, COLOUR_CYAN, COLOUR_RED},
    ; The setup.
    {
        39, 37,                         ; the player starts here
        85,                             ; sulphur to collect before the exit opens
        180,                            ; the clock
        14, 10,                         ; the exit
        CELL_SULPHUR * 16 + CELL_LAVA,  ; a monster reaching lava (~) goes out, leaving sulphur (o)
        %11110100                       ; second pictures: # on all, = on all, o on odd squares
    },
    ; The objects: x, y, icon, uses and flags.
    {
        {37, 39, 2, OBJECT_NO_CHARGES + OBJECT_NO_THROW + 1},  ; 0: Remote C.D.3
        {27, 32, 1, OBJECT_NO_CHARGES + OBJECT_NO_THROW},      ; 1: Remote C.D.2
        {33, 55, 0, OBJECT_NO_CHARGES + OBJECT_NO_THROW},      ; 2: Remote C.D.1
        {55, 56, 6, OBJECT_NO_THROW + 7},                      ; 3: Screwdriver
        {2, 44, 9, OBJECT_VANISHES + 9},                       ; 4: Jovian Wine
        {45, 13, 4, 3},                                        ; 5: Mallet
        {10, 37, 14, OBJECT_VANISHES + 1},                     ; 6: Explosives
        {11, 63, 11, OBJECT_NO_CHARGES + OBJECT_NO_THROW + 6}  ; 7: Laser Gun
    },
    ; The monsters: x, y, the way they're going, and which ways they try.
    {
        {37, 54, DIRECTION_UP, PATTERN_RIGHT_WALL},  ; 0
        {35, 17, DIRECTION_DOWN, %00101101},         ; 1: tries on, left, right, back
        {10, 19, DIRECTION_UP, %00111101},           ; 2: tries on, left, left, back
        {12, 38, DIRECTION_UP, PATTERN_RIGHT_WALL}   ; 3
    },
    ; The triggers: name, action and flags, where, the action's A, X and Y,
    ; and a condition.
    {
        ; 0: the cell in front becomes the floor (.); when facing left at a barricade (@)
        {"", PUZZLE_NEXT_BLOCK + PUZZLE_USES_OBJECT, 47, 49, &00, &00, &00, &C9},
        ; 1: the cell in front becomes an object ($); when facing down at a barricade (@)
        {"", PUZZLE_NEXT_BLOCK + PUZZLE_USES_OBJECT, 37, 50, &0F, &00, &00, &F9},
        ; 2: the cell in front becomes a pipe across (-); when facing right at a barricade (@)
        {"", PUZZLE_NEXT_BLOCK + PUZZLE_USES_OBJECT, 32, 19, &0C, &00, &00, &D9},
        ; 3: the cell in front swaps between a pipe across (-) and a pipe down (|)
        {"", PUZZLE_SWAP_NEXT + PUZZLE_USES_OBJECT + PUZZLE_REUSABLE, IGNORE, IGNORE, &0C, &0D, &00, &00},
        ; 4: sets the clock to 80; when facing the floor (.)
        {"", PUZZLE_SET_LEVELS + PUZZLE_USES_OBJECT + PUZZLE_REUSABLE, IGNORE, IGNORE, &01, &50, &00, &40},
        ; 5: the cell in front becomes the floor (.); when facing a crate (c)
        {"", PUZZLE_NEXT_BLOCK + PUZZLE_USES_OBJECT + PUZZLE_REUSABLE, IGNORE + 7, IGNORE + 26, &00, &00, &00, &46},
        ; 6: blows up object 6
        {"", PUZZLE_DETONATE_OBJECT + PUZZLE_USES_OBJECT, IGNORE, IGNORE, &06, &00, &18, &00},
        ; 7: puts monster 0 at (58, 1) going down, trying on, on, on, on; when facing down at lava (~)
        {"", PUZZLE_PLACE_MONSTER + PUZZLE_USES_OBJECT + PUZZLE_REUSABLE, 58, IGNORE + 8, &E8, &55, &07, &FA},
        ; 8: the cell in front becomes the floor (.); when facing right at a barricade (@)
        {"", PUZZLE_NEXT_BLOCK + PUZZLE_USES_OBJECT, 1, 3, &00, &0A, &0B, &D9},
        ; 9: turns on triggers 10, 11 and 30
        {"", PUZZLE_TURN_ON + PUZZLE_COUNTS_COLLECTS, IGNORE + 29, IGNORE + 12, &0A, &0B, &1E, &0F},
        ; 10: sets the clock to 250 and 39 to collect
        {"", PUZZLE_SET_LEVELS + PUZZLE_OFF, IGNORE + 29, IGNORE + 12, &00, &FA, &27, &0F},
        ; 11: turns on triggers 12 and 13
        {"", PUZZLE_TURN_ON + PUZZLE_COUNTS_COLLECTS + PUZZLE_OFF, IGNORE, IGNORE, &0C, &0D, &0C, &00},
        ; 12: (22, 12) becomes the floor (.)
        {"", PUZZLE_PLACE_BLOCK + PUZZLE_OFF, IGNORE, IGNORE, &00, &16, &0C, &00},
        ; 13: sets the clock to 250 and 160 to collect
        {"", PUZZLE_SET_LEVELS + PUZZLE_OFF, IGNORE, IGNORE, &00, &FA, &A0, &00},
        ; 14: (27, 31) becomes sulphur (o); when facing left at the floor (.)
        {"", PUZZLE_PLACE_BLOCK, 28, 32, &07, &1B, &1F, &C0},
        ; 15: (27, 23) becomes a pipe down (|); when facing up at lava (~)
        {"", PUZZLE_PLACE_BLOCK, 27, 24, &0D, &1B, &17, &EA},
        ; 16: the cell in front becomes the floor (.); when facing a wall (=)
        {"", PUZZLE_NEXT_BLOCK + PUZZLE_OFF + PUZZLE_REUSABLE, IGNORE, IGNORE, &00, &00, &00, &48},
        ; 17: turns on trigger 16; when facing down
        {"", PUZZLE_TURN_ON, 20, 21, &10, &10, &10, &BD},
        ; 18: turns off trigger 16; when facing left
        {"", PUZZLE_TURN_OFF, 22, 12, &10, &10, &10, &80},
        ; 19: sets the clock to 15; when facing up
        {"", PUZZLE_SET_LEVELS, 5, 22, &01, &0F, &00, &A0},
        ; 20: (9, 18) becomes a pipe down (|); when facing right
        {"", PUZZLE_PLACE_BLOCK, 10, 18, &0D, &09, &12, &90},
        ; 21: puts monster 0 at (7, 7) going right, keeping to the left wall; when facing down at fire (*)
        {"", PUZZLE_PLACE_MONSTER + PUZZLE_COUNTS_COLLECTS, 14, 9, &1C, &27, &1D, &FE},
        ; 22: (63, 29) becomes a pipe across (-); when facing up at a pipe down (|)
        {"", PUZZLE_PLACE_BLOCK, 63, 28, &0C, &3F, &1D, &ED},
        ; 23: lets the player push 54 crates; when facing up
        {"", PUZZLE_PUSH_CRATES, 63, 25, &36, &00, &00, &A0},
        ; 24: the cell in front becomes the floor (.); when facing up at a barricade (@)
        {"", PUZZLE_NEXT_BLOCK + PUZZLE_USES_OBJECT, 61, 40, &00, &00, &00, &E9},
        ; 25: the cell in front becomes the floor (.); when facing left at a barricade (@)
        {"", PUZZLE_NEXT_BLOCK + PUZZLE_USES_OBJECT, 47, 52, &00, &00, &00, &C9},
        ; 26: the cell in front becomes the floor (.); when facing right at a barricade (@)
        {"", PUZZLE_NEXT_BLOCK + PUZZLE_USES_OBJECT, 59, 38, &00, &00, &00, &D9},
        ; 27: lets the player push 0 crates
        {"", PUZZLE_PUSH_CRATES + PUZZLE_OFF, 39, IGNORE + 37, &00, &00, &00, &00},
        ; 28: the cell in front becomes the floor (.); when facing fire (*)
        {"", PUZZLE_NEXT_BLOCK + PUZZLE_USES_OBJECT + PUZZLE_REUSABLE, IGNORE, IGNORE, &00, &00, &00, &4E},
        ; 29: turns on trigger 27; when facing up at a pipe down (|)
        {"", PUZZLE_TURN_ON, 63, 28, &1B, &1B, &1B, &ED},
        ; 30: (28, 12) becomes the floor (.)
        {"", PUZZLE_PLACE_BLOCK + PUZZLE_OFF, IGNORE + 22, IGNORE + 43, &00, &1C, &0C, &38},
        ; 31: the cell at (49, 42) moves left; when facing right at a pipe down (|)
        {"", PUZZLE_MOVE_BLOCK, 50, 41, &00, &31, &2A, &DD}
    },
    ; The map.
    {

; $.LEVEL1: the first level, as the Level Designer saves a level (layout in
; level.6502inc). The level itself is src/level1.6502inc, which IO's first
; level is made from too. Its editing code is 677636.
INCLUDE "level.6502inc"
INCLUDE "level1.6502inc"

SECTION level1, filename="LEVEL1", org=level, load=level, exec=&8380

    EQUB level_names_bytes(level_1)
    ASSERT P% = level_code
    EQUB level_fields(level_1)
    ASSERT P% = level_map
    EQUB level_map_bytes(level_1)
    ASSERT P% = level_end

ENDSECTION

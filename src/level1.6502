map_row_52 = ".o.B.|7...r#.###oo#.#.#7.r%###ooo####..xm.r|7L#||#|M-|-M|rJL7|||"
map_row_53 = "..B..|L7.rJ#.#o.##%.%.#.mmxxxxx.#####..xmrJ.L7L|M-M|#M----..--M|"
map_row_54 = "B.B.B|7o.or#.##...#.J.#J.L%####.#####..xrJ...L7M-M-M#|%||L7rJ|%|"
map_row_55 = "B...B|L7.rJ#..#.o.#...J...L####.#####..rJ..o..L7L|#M-|-M|%LJ%|%|"
map_row_56 = ".BB..|.L.J.##.#.#.#o#J.ro7.####.#####.rJ.......L7|#|#M-M|%M--Mr|"
map_row_57 = ".BBB.|7o.or#..o.#.o############.xxxxx......o....-M#M-M%||M|%%rJ."
map_row_58 = "..o..M######o#..##........xxxxx.################JM---|-|||M%rJ.."
map_row_59 = "%-%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%........M-M-MM-M-M--o..."
map_row_60 = "%|%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%........|||M|---|---.|||"
map_row_61 = "%|%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%|.......||M||%%%M----M||"
map_row_62 = "%|%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%M-|--|--MM-MM---------M|"
map_row_63 = "%M-------------------------------------------------------------M"
map_rows_00 = {map_row_00, map_row_01, map_row_02, map_row_03, map_row_04, map_row_05, map_row_06, map_row_07}
map_rows_08 = {map_row_08, map_row_09, map_row_10, map_row_11, map_row_12, map_row_13, map_row_14, map_row_15}
map_rows_16 = {map_row_16, map_row_17, map_row_18, map_row_19, map_row_20, map_row_21, map_row_22, map_row_23}
map_rows_24 = {map_row_24, map_row_25, map_row_26, map_row_27, map_row_28, map_row_29, map_row_30, map_row_31}
map_rows_32 = {map_row_32, map_row_33, map_row_34, map_row_35, map_row_36, map_row_37, map_row_38, map_row_39}
map_rows_40 = {map_row_40, map_row_41, map_row_42, map_row_43, map_row_44, map_row_45, map_row_46, map_row_47}
map_rows_48 = {map_row_48, map_row_49, map_row_50, map_row_51, map_row_52, map_row_53, map_row_54, map_row_55}
map_rows_56 = {map_row_56, map_row_57, map_row_58, map_row_59, map_row_60, map_row_61, map_row_62, map_row_63}
map_rows = CONCAT(map_rows_00, map_rows_08, map_rows_16, map_rows_24, map_rows_32, map_rows_40, map_rows_48, map_rows_56)
    ASSERT * == level_map
    MAP map_rows
    ASSERT * == level_end

ENDSECTION

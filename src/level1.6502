map_row_13 = "c.LJ.%%%.%...o...ccc.c.ccc.cccc.c.|7r..M----M.......|...r..7.|.|"
map_row_14 = "c....c%%|c.............ooc........|..|.|..M---------M..rJ..L7M-M"
map_row_15 = "%c..co%%|%.%%%%..cccocccccccooo.ccM--Mx|xx|||..r.7....rJr+.7L7.."
map_row_16 = "%oo.mo%%|%.o..c.................cc...|....|||.rJ|L7..rJrJ..L7L7."
map_row_17 = "%...%%%%|%%%%%%coc%%%%c.co-----Mcc.M-M.o..--Mr.-M-o##JrJr..7L7L7"
map_row_18 = "%%%%%%M-M|-------------|----------M|M-....||r###|####.JrJ..L7L.#"
map_row_19 = "%M----|----------M%%%M-|----------|M|x....||#J..|L###..........#"
map_row_20 = "%|%%%%|.....|%%%%|%%%|.....|-..-.-|-Mx|x-x||#7....##c.cccccc.cc%"
map_row_21 = "%.----M.---|-----|---M.M---------.M---|--M||#####.##c.c......c.%"
map_row_22 = "%ccccc%cccc.|--------M.|.......|..M---M.||||#.ox#.##c.c.oooo.c.%"
map_row_23 = "c..o..c.c..c....c|J.L|.M-------|--|----M||||#.x...##c.c.o..o.c.%"
map_row_24 = "c.ccc.c....c..c.c|...|.|BBBB.......cccc|||||#...#.##c.c.oooo.c.%"

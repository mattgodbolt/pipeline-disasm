    ; 8 9 : ; < = > ?
    SPRITE_COLUMNS {
        "333.333...........3......3...33.",
        "3.3.3.3..........3.......3..3.3.",
        "3.3.3.3..3...3...3..333...3...3.",
        "333.333..3...3..3.........3..3..",
        "3.3...3..........3..333...3..3..",
        "3.3...3..3...3...3.......3......",
        "333.333..3...3....3......3...3..",
        ".............3..................",
    }
    ; @ A B C D E F G
    SPRITE_COLUMNS {
        ".33.333.33..333.33..333.333.333.",
        "3.3.3.3.3.3.3...3.3.3...3...3...",
        "3.3.3.3.3.3.3...3.3.3...3...3...",
        "3...333.33..3...3.3.33..33..3...",
        "3.3.3.3.3.3.3...3.3.3...3...3.3.",
        "3...3.3.3.3.3...3.3.3...3...3.3.",
        ".33.3.3.33..333.33..333.3...333.",
        "................................",
    }
    ; H I J K L M N O
    SPRITE_COLUMNS {
        "3.3.333.333.3.3.3...3.3.3.3.333.",
        "3.3..3....3.3.3.3...333.3.3.3.3.",
        "3.3..3....3.33..3...3.3.333.3.3.",
        "333..3....3.33..3...3.3.333.3.3.",
        "3.3..3..3.3.3.3.3...3.3.333.3.3.",
        "3.3..3..3.3.3.3.3...3.3.3.3.3.3.",
        "3.3.333.333.3.3.333.3.3.3.3.333.",
        "................................",
    }
    ; P Q R S T U V W
    SPRITE_COLUMNS {
        "333.333.333.333.333.3.3.3.3.3.3.",
        "3.3.3.3.3.3.3....3..3.3.3.3.3.3.",
        "3.3.3.3.3.3.3....3..3.3.3.3.3.3.",
        "333.3.3.333.333..3..3.3.3.3.3.3.",
        "3...3.3.33....3..3..3.3.333.333.",
        "3...33..3.3...3..3..3.3..3..333.",
        "3.....3.3.3.333..3..333..3..3.3.",
        "................................",
    }
    ; X Y Z [ \ ] ^ _
    SPRITE_COLUMNS {
        "3.3.3.3.333.333......33...33....",
        "3.3.3.3...3.3...3.....3..3......",
        ".3..333...3.3....3....3.3.33....",
        ".3...3...3..3....3....3.3.3.....",
        ".3...3..3...3.....3...3.3.33....",

.error_message
    EQUB &0D
    EQUS "                                                             "
    EQUB &FF
    EQUS "Escape?"
    EQUB &0D, &4E, &6F, &0D, &59, &65, &73, &0D
    EQUB &FF, &00
    EQUS " Return to menu"
    EQUB &0D
    EQUS " Please insert"
    EQUB &0D
    EQUS " Pipeline disc"
    EQUB &0D
    EQUS "and press SPACE"
    EQUB &0D, &FF

.draw_sheet
{
    LDA #&28
.loop
    PHA
    JSR draw_sheet_sprite
    PLA
    SEC
    SBC #&01
    BCS loop
    RTS
}

.show_selection
{
    JSR sprite_class
    JSR sheet_address
    LDY #&00
    JSR selection_edge
    LDA sprite_width
    STA count_y
.column
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    TAY
    LDX #&07
.left
    DEY
    LDA (screen_ptr), Y
    AND #&EE
    ORA #&10
    STA (screen_ptr), Y
    DEX
    BPL left
    LDY #&07
.right
    LDA (screen_ptr), Y
    AND #&77
    ORA #&80
    STA (screen_ptr), Y
    DEY
    BPL right
    DEC count_y
    LDA count_y
    BEQ bottom
    LDA screen_ptr
    CLC
    ADC #&40
    STA screen_ptr
    LDA screen_ptr+1
    ADC #&01
    STA screen_ptr+1
    BCC column
.bottom
    LDY #&07
    JSR selection_edge
    LDA sprite_width
    CMP #&02
    BEQ small
    TXA
    LDY #&77
.clear_name
    STA name_box, Y
    DEY
    BPL clear_name
    RTS
.small
    LDA #&E0
    STA screen_ptr
    LDA #&6F
    STA screen_ptr+1
    LDX #&20
    LDA sprite
    CMP #&19
    BCC tens
    LDX #&31
.tens
    SEC
    TXA
    JSR print_char_advance
    LDA sprite
    SEC
    SBC #&0F
    CMP #&0A
    BCC units
    SBC #&0A
.units
    SEC
    ORA #&30
    JSR print_char_advance
    LDA #&3A
    SEC
    JSR print_char_advance
    JSR name_offset
    LDX #&0B
.name
    LDA object_names, Y
    SEC
    JSR print_char_advance
    INY
    DEX
    BPL name
    RTS
}

.selection_edge
{
    LDX sprite_width
.loop
    LDA #&F0
    STA (screen_ptr), Y
    TYA
    CLC
    ADC #&08
    TAY
    DEX
    BNE loop
    RTS
}

.name_offset
{
    LDA sprite
.of_a
    AND #&0F
    ASL A
    ASL A
    STA times_4
    ASL A
    ADC times_4
    TAY
    RTS
.times_4
    EQUB &00
}

.unused_down_a_row
{
    LDA screen_ptr
    CLC
    ADC #&40
    STA screen_ptr
    LDA screen_ptr+1
    ADC #&01
    STA screen_ptr+1
    RTS
}

.unused_width_times_32
{
    LDA sprite_width
    LSR A
    ROR A
    ROR A
    ROR A
    RTS
}

.unused_clear_rows
{
    STA count_y
.row
    LDY #&47
    LDA #&00
.byte
    STA (screen_ptr), Y
    DEY
    BPL byte
    JSR unused_down_a_row
    DEC count_y
    BNE row
    RTS
}

.show_colour
{
    LDX colour
    LDA colour_byte, X
    LDY #&0F
.loop
    STA colour_swatch, Y
    DEY
    BPL loop
    RTS
}

.stack_pointer
    EQUB &00

.graphics_loaded
    EQUB &00

.disc_fs
    EQUB &00, &04, &03, &01

.default_name
    EQUB &44
    EQUS "EFAULT"
    EQUB &0D

.mrun_command
    EQUS "/MRUN"
    EQUB &0D

.error_handler
{
    LDY #&00
    LDX #&00
.copy
    INY
    INX
    TXA
    AND #&0F
    CMP #&0F
    BNE store
    LDA #&0D
    STA error_message, X
    INX
.store
    LDA (ERROR_PTR), Y
    STA error_message, X
    BNE copy
    LDA #&0D
    STA error_message, X
    LDA #&FF
    STA error_message+1, X
    JSR close_all_windows
    LDX #&B2
    LDY #&29
    LDA #&07
    JSR open_window
    LDA #&0F
    LDX #&00
    LDY #&00
    JSR OSBYTE
.wait
    JSR OSRDCH
    BCC restart
    LDA #&7E
    JSR OSBYTE
    JMP wait
.restart
    JSR close_all_windows
    JSR close_files
}

.start
{
    LDA #&04
    LDX #&01
    JSR OSBYTE
    LDA BRKV+1
    BPL installed
    LDX #&62
    LDY #&2B
    LDA EVNTV
    STA IND2V
    LDA EVNTV+1
    STA IND2V+1
    LDA BRKV
    STA IND1V
    LDA BRKV+1
    STA IND1V+1
    LDA #&95
    SEI
    STX BRKV
    STY BRKV+1
    STA EVNTV
    LDA #&25
    STA EVNTV+1
    CLI
    LDA #&0E
    STA escape_latch
    LDX #&06
    JSR OSBYTE
.installed
    LDA #&87
    JSR OSBYTE
    CPY #&05
    BEQ setup
    LDA #&16
    JSR OSWRCH
    LDA #&05
    JSR OSWRCH
    LDA #&03
.palette
    PHA
    TAX
    LDA disc_fs, X
    JSR write_palette
    PLA
    SEC
    SBC #&01
    BNE palette
.setup
    LDA #&97
    LDX #&00
    LDY #&0A
    JSR OSBYTE
    LDY #&20
    INX
    JSR OSBYTE
    LDA #&00
    TAY
    JSR OSARGS
    CMP #&04
    LDA #&00
    STA by_slot
    TAY
    ROR A
    STA disc_fs
    BMI opt
    INY
.opt
    LDA #&00
    LDX #&01
    JSR fscv
    JSR reset_timer
    TSX
    BIT stack_pointer
    BMI saved_sp
    STX stack_pointer
.saved_sp
    LDY #&FF
.layout
    INY
    LDA screen_layout, Y
    CMP #&EA
    BEQ layout_done
    JSR OSWRCH
    JMP layout
.layout_done
    LDX #&13
    LDA #&00
.clear_windows
    STA window_open, X
    DEX
    BPL clear_windows
    LDA #&0A
    STA CRTC_ADDR
    LDA #&20
    STA CRTC_DATA
    LDA #&B0
    STA data_ptr
    LDA #&1A
    STA data_ptr+1
    LDY #&00
.logo_copy
    LDA logo, Y
    STA logo_screen, Y
    LDA logo+&B0, Y
    STA logo_screen+ROW, Y
    LDA logo+2*&B0, Y
    STA logo_screen+2*ROW, Y
    INY
    CPY #&B0
    BCC logo_copy
    BIT graphics_loaded
    BMI redraw
    LDA #&00
    TAY
    STA screen_ptr
    LDX #&40
    STX screen_ptr+1
    LDX #&10
.clear
    STA (screen_ptr), Y
    INY
    BNE clear
    INC screen_ptr+1
    DEX
    BNE clear
    DEX
    STX graphics_loaded
    LDA disc_fs
    BMI load_default
    LDX #&06
.tape_name
    STA default_name, X
    DEX
    BPL tape_name
    LDA #&22
    STA default_name
    STA default_name+1
    BNE redraw
.load_default
    LDA #&54
    STA osfile_block
    LDA #&2B
    STA osfile_block+1
    LDA #&FF
    STA graphics_loaded
    JSR osfile_graphics
.redraw
    BIT disc_fs
    BMI cls_done
    LDA #&0C
    JSR OSWRCH
.cls_done
    LDX #&0B
.mark_end
    LDA finish_block, X
    STA graphics_end, X
    DEX
    BPL mark_end
    JSR draw_sheet
    LDA #&00
    STA sprite
    JSR show_selection
    LDA #&00
    STA cursor_x
    STA cursor_y
    SEC
    JSR redraw_grid
    LDA #&03
    STA colour
    JSR show_colour
.main_loop
    LDX stack_pointer
    TXS
    JSR close_all_windows
    LDA #&00
    JSR select_sprite
    BMI edit
    LDX cursor_x
    LDY cursor_y
    JSR toggle_cursor
.edit
    JSR edit_pixels
    LDA colour
    STA saved_colour
    JSR read_command
    ASL A
    BCS command_done
    TAY
    LDA command_table, Y
    STA dispatch+1
    LDA command_table+1, Y
    STA dispatch+2
.dispatch
    JSR &1234
    LDX #&B6
    JSR wait_key_release
.command_done
    LDA saved_colour
    STA colour
    LDA #&13
    JSR OSBYTE
    STA by_slot
    LDA ESCAPE_FLAG
    ORA escape_latch
    BPL loop
    LSR escape_latch
    LDA #&7E
    JSR OSBYTE
    JSR close_all_windows
    LDX #&02
    LDY #&2A
    LDA #&05
    JSR menu
    CMP #&02
    BNE loop
    LDX #&13
    LDY #&2A
    LDA #&06
    JSR open_window
    LDA #&0F
    JSR OSBYTE
.wait_key
    JSR OSRDCH
    PHP
    LDA #&7E
    JSR OSBYTE
    PLP
    BCS wait_key
    LDA IND1V
    STA BRKV
    LDA IND1V+1
    STA BRKV+1
    LDA IND2V
    STA EVNTV
    LDA IND2V+1
    STA EVNTV+1
    LDA #&04
    INX
    JSR OSBYTE
    LDA #&E1
    LDX #&01
    JSR OSBYTE
    BIT disc_fs
    BMI run_mrun
    LDA #&C8
    LDX #&03
    JSR OSBYTE
    JMP (RESET_VECTOR)
.run_mrun
    LDX #&5C
    LDY #&2B
    JMP OSCLI
.loop
    JMP main_loop
}

.finish_block
    EQUS "Finish Block"

.saved_colour
    EQUB &00

.command_table
    EQUB &3E
    EQUB &2D, &46, &2E, &C5, &2E, &FE, &2D, &05
    EQUB &2F, &6E, &32, &CA
    EQUS "7>->-"
    EQUB &15, &30, &02
    EQUS "0G/./"
    EQUB &B0
    EQUS "/</>->-e6q5"
    EQUB &1F
    EQUS "7&5A1>->->-"

.cmd_delete
{
    LDA sprite
    JSR sprite_address
    JSR sprite_last_byte
    LDA #&00
.clear
    STA (data_ptr), Y
    DEY
    BPL clear
    LDX sprite_width
    CPX #&02
    BNE redraw
    LDA sprite
    CMP #&1F
    BEQ redraw
    JSR name_offset
    LDA #&00
    LDX #&0B
.name
    STA object_names, Y
    INY
    DEX
    BPL name
.redraw
    LDA sprite
    JSR show_selection
    LDA sprite
    JSR draw_sheet_sprite
    LDA sprite
    JMP redraw_grid
}

.redraw_grid
{
    LDA sprite
    BCC draw
    ORA #&80
.draw
    JSR draw_grid
    LDX cursor_x
    LDY cursor_y
    JMP toggle_cursor
}

.cmd_flip_x
{
    LDA sprite
    JSR sprite_address
    LDA sprite_width
    ASL A
    STA item
    ASL A
    STA aux_ptr
    ASL A
    STA count_y
    DEC aux_ptr
    DEC count_y
.row
    LDA #&00
    STA count_x
.pixel
    LDA aux_ptr
    SEC
    SBC count_x
    TAX
    LDY count_y
    STX flip_x
    STY flip_y
    LDA sprite
    JSR read_pixel
    PHA
    LDX count_x
    LDY count_y
    LDA sprite
    JSR read_pixel
    STA colour
    LDX flip_x
    LDY flip_y
    LDA sprite
    JSR plot_pixel
    LDX count_x
    LDY count_y
    PLA
    STA colour
    LDA sprite
    JSR plot_pixel
    INC count_x
    LDA count_x
    CMP item
    BCC pixel
    DEC count_y
    BPL row
    LDX #&BD
.redraw
    TXA
    PHA
    LDA sprite
    PHA
    JSR draw_sheet_sprite
    PLA
    JSR redraw_grid
    PLA
    TAX
    JMP wait_key_release
}

.flip_x
    EQUB &00

.flip_y
    EQUB &00

.gbpb_block
    EQUB &00
    EQUB &00
    EQUB &00, &00, &00
    EQUB &00
    EQUB &00, &00, &00
    EQUB &00
    EQUB &00, &00, &00, &00, &00, &00

.cmd_flip_y
{
    JSR flip_vertically
    LDX #&BB
    JMP cmd_flip_x.redraw
}

.flip_vertically
{
    LDA sprite
    JSR sprite_address
    LDA sprite_width
    STA count_x
    ASL A
    ASL A
    ASL A
    STA count_y
.column
    LDY count_y
    DEY
.swap
    LDX #&00
    LDA (data_ptr, X)
    PHA
    LDA (data_ptr), Y
    STA (data_ptr, X)
    PLA
    STA (data_ptr), Y
    INC data_ptr
    BNE next
    INC data_ptr+1
.next
    DEY
    DEY
    BPL swap
    LDA count_y
    LSR A
    CLC
    ADC data_ptr
    STA data_ptr
    BCC next_column
    INC data_ptr+1
.next_column
    DEC count_x
    BNE column
    RTS
}

.cmd_undo
{
    LDA sprite
    JSR sprite_address
    JSR sprite_last_byte
.swap
    LDX undo_buffer, Y
    LDA (data_ptr), Y
    STA undo_buffer, Y
    TXA
    STA (data_ptr), Y
    DEY
    BPL swap
    LDA sprite
    JSR draw_sheet_sprite
    LDA sprite
    JSR show_selection
    CLC
    JSR redraw_grid
    LDX #&CA
    JMP wait_key_release
}

.cmd_underlay
{
    LDX #&B8
    LDY #&28
    JSR pick_second_sprite
    STX combine_test
    CLC
    JMP combine_sprites
}

.cmd_backing
{
    LDX sprite
    STX combine_test
    LDA #&00
    CLC
    JMP combine_sprites
}

.cmd_overlay
{
    LDX #&5B
    LDY #&26
    JSR pick_second_sprite
    STA combine_test
    SEC
}

.combine_sprites
{
    STX combine_target
    STA combine_source
    LDA #&00
    ROR A
    STA combine_over
    LDA sprite_width
    ASL A
    ASL A
    SBC #&00
    STA count_x
.column
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    SBC #&00
    STA count_y
.pixel
    LDA combine_test
    LDX count_x
    LDY count_y
    JSR read_pixel
    BIT combine_over
    BPL under
    CMP #&00
    BEQ next
    BNE plot
.under
    CMP #&00
    BNE next
    LDA combine_source
    LDX count_x
    LDY count_y
    JSR read_pixel
.plot
    STA colour
    LDA combine_target
    LDX count_x
    LDY count_y
    JSR plot_pixel
.next
    DEC count_y
    BPL pixel
    DEC count_x
    BPL column
    LDA combine_source
    JMP redraw_pair
}

.combine_target
    EQUB &00

.combine_source
    EQUB &00

.combine_test
    EQUB &00

.combine_over
    EQUB &00

.cmd_remove
{
    LDX #&95
    LDY #&28
    JSR pick_second_sprite
    STX combine_target
    STA combine_source
    LDA sprite_width
    ASL A
    ASL A
    SBC #&00
    STA count_x
.column
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    SBC #&00
    STA count_y
.pixel
    LDA combine_target
    LDX count_x
    LDY count_y
    JSR read_pixel
    STA temp
    LDA combine_source
    LDX count_x
    LDY count_y
    JSR read_pixel
    EOR temp
    BNE next
    STA colour
    LDA combine_target
    LDX count_x
    LDY count_y
    JSR plot_pixel
.next
    DEC count_y
    BPL pixel
    DEC count_x
    BPL column
    LDA combine_source
    JMP redraw_pair
}

.cmd_copy
{
    LDX #&38
    LDY #&26
    JSR pick_second_sprite
    PHA
.copy
    LDA (aux_ptr), Y
    STA (data_ptr), Y
    DEY
    BPL copy
    PLA
    JMP redraw_pair
}

.cmd_swap
{
    LDX #&0B
    LDY #&28
    JSR pick_second_sprite
    PHA
.swap
    LDA (data_ptr), Y
    PHA
    LDA (aux_ptr), Y
    STA (data_ptr), Y
    PLA
    STA (aux_ptr), Y
    DEY
    BPL swap
    LDA sprite_width
    CMP #&02
    BNE done
    CPX #&1F
    BEQ done
    PLA
    PHA
    CMP #&1F
    BEQ done
    JSR name_offset
    STA data_ptr
    PLA
    PHA
    JSR name_offset.of_a
    STA aux_ptr
    LDX #&0B
    STX data_ptr+1
.names
    LDY aux_ptr
    LDA object_names, Y
    LDY data_ptr
    LDX object_names, Y
    STA object_names, Y
    LDY aux_ptr
    TXA
    STA object_names, Y
    INC aux_ptr
    INC data_ptr
    DEC data_ptr+1
    BPL names
.done
    PLA
}

.redraw_pair
{
    JSR draw_sheet_sprite
    LDA sprite
    JSR draw_sheet_sprite
    LDA sprite
    JSR show_selection
    LDA sprite
    CLC
    JSR redraw_grid
    LDA #&04
    JMP close_window
}

.pick_second_sprite
{
    LDA #&04
    JSR open_window
    LDX #&B6
    JSR wait_key_release
    LDA sprite
    PHA
    JSR sprite_address
    LDA data_ptr
    STA first_address
    LDA data_ptr+1
    STA first_address+1
    LDA window_address+2*4
    CLC
    ADC #&C0
    STA screen_ptr
    LDA window_address+2*4+1
    ADC #&02
    STA screen_ptr+1
    JSR draw_sheet_sprite.at_screen_ptr
    LDA sprite_width
    STA first_width
.select
    LDA #&01
    JSR select_sprite
    BIT ESCAPE_FLAG
    BMI abandon
    LDX #&B6
    JSR key_pressed
    BPL select
    LDA sprite
    JSR sprite_address
    JSR sprite_last_byte
    LDA first_address
    STA aux_ptr
    LDA first_address+1
    STA aux_ptr+1
    LDX sprite
    LDA sprite_width
    CMP first_width
    BNE wrong_type
    PLA
    RTS
.wrong_type
    LDA #&07
    LDX #&EF
    LDY #&27
    JSR open_window
    LDA #&0F
    LDX #&00
    JSR OSBYTE
.wait_space
    JSR OSRDCH
    BCS close
    CMP #&20
    BNE wait_space
.close
    LDA #&07
    JSR close_window
.abandon
    PLA
    PLA
    PLA
.abandon_menu
    LDA #&04
    JSR close_window
    LDA #&7E
    JSR OSBYTE
    JMP start.command_done
}

.show_error
{
    STX error_text
    STY error_text+1
.show
    LDA #&7E
    JSR OSBYTE
    LDA #&07
    LDX error_text
    LDY error_text+1
    JSR open_window
    JSR OSRDCH
    BIT ESCAPE_FLAG
    BMI show
    JMP start.main_loop
}

.first_address
    EQUB &00
    EQUB &00

.first_width
    EQUB &00

.error_text
    EQUB &00
    EQUB &00

.read_palette
{
    STA osfile_block
    LDX #&2B
    LDY #&32
    LDA #&0B
    JSR OSWORD
    LDA osfile_block+1
    RTS
}

.empty_text
    EQUB &FF, &FF

.cmd_def_colour
{
    LDA #&05
    LDX #&3F
    LDY #&31
    JSR open_window
    LDA #&04
    LDX #&01
    JSR OSBYTE
    LDA #&E1
    LDX #&E0
    LDY #&00
    JSR OSBYTE
    LDA #&0F
    LDX #&00
    JSR OSBYTE
    LDA #&00
    STA item
    JSR palette_highlight
.redraw
    JSR show_palette
.read_key
    JSR OSRDCH
    BCC got_key
    LDA #&7E
    JSR OSBYTE
.done
    JMP show_palette.done
.got_key
    LDY item
    CMP #&E0
    BCS done
    CMP #&0D
    BEQ done
    CMP #&20
    BEQ done
    CMP #&8A
    BNE not_down
    LDX item
    CPX #&03
    BEQ not_down
    INC item
.not_down
    CMP #&8B
    BNE moved
    LDX item
    BEQ moved
    DEC item
.moved
    PHA
    JSR palette_highlight.toggle
    JSR palette_highlight
    PLA
    LDX #&01
    CMP #&89
    BEQ change
    LDX #&FF
    CMP #&88
    BNE read_key
.change
    STX colour_step
    LDA item
    JSR read_palette
    CLC
    ADC colour_step
    AND #&07
    PHA
    JSR show_palette
    PLA
    LDX item
    JSR write_palette
    JMP redraw
}

.write_palette
{
    STA osfile_block+1
    STX osfile_block
    LDX #&2B
    LDY #&32
    LDA #&0C
    JMP OSWORD
}

.colour_step
    EQUB &00

.show_palette
{
    LDA #&03
    STA osfile_block
    LDA #&8C
    STA save_ptr
    LDA #&28
    STA save_ptr+1
.entry
    LDA osfile_block
    JSR read_palette
    ASL A
    ASL A
    ASL A
    ORA #&06
    TAX
    LDY #&06
.name
    LDA colour_names, X
    STA (save_ptr), Y
    DEX
    DEY
    BPL name
    LDA save_ptr
    SEC
    SBC #&08
    STA save_ptr
    BCS next
    DEC save_ptr+1
.next
    DEC osfile_block
    BPL entry
    LDA window_address+2*5
    STA save_ptr
    STA screen_ptr
    LDA window_address+2*5+1
    STA save_ptr+1
    STA screen_ptr+1
    LDX #&6B
    LDY #&28
    STX data_ptr
    STY data_ptr+1
    LDA #&05
    JMP print_window_text
.done
    RTS
}

.osfile_block
    EQUB &00
    EQUB &00
    EQUB &00
    EQUB &00, &00, &00
    EQUB &00, &00, &00, &00, &00
    EQUB &00, &00, &00
    EQUB &00
    EQUB &00, &00, &00, &00, &00

.palette_row_offset
    EQUB &40
    EQUB &01, &80, &02, &C0, &03, &00, &05

.palette_highlight
{
    LDA item
    ASL A
    TAY
    LDA palette_row_offset, Y
    CLC
    ADC window_address+2*5
    STA highlight_address
    LDA palette_row_offset+1, Y
    ADC window_address+2*5+1
    STA highlight_address+1
.toggle
    LDA highlight_address
    STA screen_ptr
    LDA highlight_address+1
    STA screen_ptr+1
    JMP invert_menu_row
}

.highlight_address
    EQUB &00
    EQUB &00

.animate_sprite
    EQUB &00

.cmd_animate
{
    LDA #&FF
    STA by_slot
    LDA sprite
    STA animate_sprite
    TAX
    AND #&10
    BNE none
    TXA
    JSR slot_index
    TAX
    LDA slot_of_position, X
    CMP #&24
    BCS none
    CMP #&20
    BCS second_of_pair
    CMP #&0E
    BEQ first_of_pair
    CMP #&0F
    BEQ first_of_pair
.none
    RTS
.first_of_pair
    PHA
    AND #&FE
    BNE pair
.second_of_pair
    PHA
.pair
    CMP #&22
    BCC even
    AND #&FE
.even
    JSR sprite_address
    LDY #&00
.copy
    LDA (data_ptr), Y
    STA frame_a, Y
    DEY
    BNE copy
    LDA #&04
    LDX #&DB
    LDY #&28
    JSR open_window
    LDA sprite
    JSR slot_index
    TAX
    LDA slot_of_position, X
    CMP #&10
    BCS large
    LDA #&08
    BNE chosen
.large
    AND #&03
    ASL A
.chosen
    STA frame_index
.show
    TAX
    LDA #&06
    STA frame_delay
    LDA animation_frames, X
    STA sprite
    BPL draw
    JSR flip_vertically
    LDA #&06
    STA frame_delay
.draw
    LDA sprite
    AND #&7F
    STA sprite
    JSR draw_grid
    LDA sprite
    JSR draw_sheet_sprite
.wait
    JSR flush_menu_keys
    BIT ESCAPE_FLAG
    BMI stop
    LDX #&9D
    JSR key_pressed
    BMI stop
    LDA #&13
    JSR OSBYTE
    DEC frame_delay
    BNE wait
    LDA frame_index
    TAX
    EOR #&01
    STA frame_index
    PHA
    LDA animation_frames, X
    BPL other_frame
    JSR flip_vertically
.other_frame
    PLA
    JMP show
.stop
    PLA
    LDX animate_sprite
    STX sprite
    LDA #&7E
    JSR OSBYTE
    LDA #&04
    STA by_slot
    JSR close_window
    JMP redraw_grid
}

.slot_index
{
    CMP #&10
    BCC repeat_key.done
    CMP #&20
    BCC repeat_key.done
    SBC #&10
    RTS
}

.frame_index
    EQUB &00

.frame_delay
    EQUB &00

.animation_frames
    EQUB &57, &D7, &57, &D7, &57, &D8, &58, &D7
    EQUB &58, &57

.repeat_key
{
    JSR key_pressed
    BPL not_now
    STX key_held
    LDY repeat_count
    BEQ move
    STY key_repeating
    CPY #&14
    BEQ move
.not_now
    LDY #&00
.done
    RTS
.move
    LDY #&FF
    RTS
}

.repeat_count
    EQUB &00

.select_sprite
{
    STA select_mode
    LDX #&FE
    JSR key_pressed
    BMI repeat_key.done
    LDA sprite
    STA old_sprite
    LDA #&00
    STA key_held
    STA key_repeating
    LDX #&86
    JSR repeat_key
    BPL left
    JSR sheet_column
    CMP last_column
    BEQ left
    INC sprite
    LDA sprite
    CMP #&10
    BNE wrap_right
    LDA #&20
.wrap_right
    STA sprite
.left
    LDX #&E6
    JSR repeat_key
    BPL left_done
    JSR sheet_column
    CMP #&00
    BEQ left_done
    DEC sprite
    LDA sprite
    CMP #&1F
    BNE wrap_left
    LDA #&0F
.wrap_left
    STA sprite
.left_done
    LDX #&D6
    JSR repeat_key
    BPL down_done
    JSR sheet_row
    CPX #&08
    BEQ down_done
    LDA sprite
    CMP #&28
    BEQ down_done
    CMP #&0F
    BNE not_a
    LDA #&24
    BNE store_down
.not_a
    CMP #&0A
    BNE step_down
    LDA #&0F
    BNE store_down
.step_down
    CLC
    ADC row_down_step, X
.store_down
    STA sprite
.down_done
    LDX #&C6
    JSR repeat_key
    BPL up_done
    JSR sheet_row
    CPX #&00
    BEQ up_done
    LDA sprite
    CMP #&0F
    BNE not_f
    LDA #&0A
    BNE store_up
.not_f
    CMP #&24
    BNE step_up
    LDA #&0F
    BNE store_up
.step_up
    SEC
    LDA sprite
    SBC row_down_step-1, X
.store_up
    STA sprite
.up_done
    LDA repeat_count
    BNE delay
    LDA #&04
    STA repeat_count
.delay
    LDX #&14
    LDA key_held
    BEQ store_delay
    LDX repeat_count
    LDA key_repeating
    BEQ store_delay
    DEX
.store_delay
    STX repeat_count
    LDA select_mode
    BEQ wait
    JSR flush_menu_keys
.wait
    LDA #&03
    JSR reset_timer.timer
    LDX #&04
    LDA #&00
.check
    ORA timer_value, X
    DEX
    BNE check
    CMP #&00
    BNE waited
    LDA timer_value
    CMP #&02
    BCC wait
.waited
    LDA #&00
    STA timer_value
    JSR reset_timer
    LDA old_sprite
    CMP sprite
    BEQ sheet_row.small_row
    JSR draw_sheet_sprite
    LDA sprite
    JSR show_selection
    LDA sprite_width
    CMP #&02
    BNE changed
    LDX cursor_x
    CPX #&08
    BCC clamp_y
    LDX #&07
    STX cursor_x
.clamp_y
    LDY cursor_y
    CPY #&10
    BCC changed
    LDY #&0F
    STY cursor_y
.changed
    LDA sprite
    ORA #&80
    JSR draw_grid
    LDA #&00
    RTS
}

.row_down_step
    EQUB &05, &05, &15, &05, &EC, &04, &04, &04

.reset_timer
{
    LDX #&04
    LDA #&00
.clear
    STA timer_value, X
    DEX
    BPL clear
    LDA #&04
.timer
    LDX #&BF
    LDY #&3A
    JMP OSWORD
}

.key_repeating
    EQUB &00

.sheet_row
{
    LDX #&04
    STX last_column
    LDA sprite
    CMP #&10
    BCC sheet_column.large
    CMP #&20
    BCS large
    LSR A
    LSR A
    AND #&03
    CLC
    ADC #&05
    TAX
.small_row
    LDA #&80
    RTS
.large
    SBC #&10
    BCS sheet_column.large
}

.sheet_column
{
    LDA #&04
    STA last_column
    LDA sprite
    CMP #&10
    BCC large
    CMP #&20
    BCS small
    AND #&03
    LDX #&03
    STX last_column
    RTS
.small
    SBC #&10
.large
    JMP divide_by_5
}

.grid_address
{
    TYA
    PHA
    AND #&FE
    TAY
    TXA
    ASL A
    ASL A
    ASL A
    CLC
    ADC grid_row_address, Y
    STA screen_ptr
    LDA grid_row_address+1, Y
    ADC #&00
    STA screen_ptr+1
    PLA
    LSR A
    BCC done
    LDA screen_ptr
    ORA #&04
    STA screen_ptr
.done
    RTS
}

.toggle_cursor
{
    JSR grid_address
    LDY #&03
.loop
    LDA cursor_shape, Y
    EOR (screen_ptr), Y
    STA (screen_ptr), Y
    DEY
    BPL loop
    RTS
}

.cursor_shape
    EQUB &90, &00, &00, &90

.ask_save_name
{
    LDA #&06
    LDX #&29
    LDY #&29
    JSR open_window
    JSR input_line
    LDA #&06
    JSR close_window
    JSR file_info
    BCS done
    CMP #&01
    BNE new
    JMP file_exists
.new
    LDA #&00
    STA io_file
.done
    RTS
}

.cmd_save_file
{
    LDX #&03
    JSR check_filing_system
    JSR ask_save_name
    BIT io_file
    BMI io
    LDY #&0F
    LDA #&00
.clear
    STA osfile_block+2, Y
    DEY
    BPL clear
    LDA #&40
    STA osfile_block+3
    STA osfile_block+11
    CLC
    ADC #&0F
    STA osfile_block+15
    LDA #&34
    STA osfile_block+14
    LDA #&00
    JSR osfile_graphics
.return_
    RTS
.io
    JSR open_file.update
    LDA #&00
.segment
    PHA
    TAX
    JSR set_segment
    JSR read_block.write
    PLA
    CLC
    ADC #&06
    CMP #&12
    BCC segment
    JSR close_files
    JMP return_
}

.cmd_save_sprite
{
    LDX #&01
    JSR check_filing_system
    JSR ask_save_name
    JSR open_file.update
    LDA sprite
    JSR sprite_address
    JSR sprite_file_offset
    JSR sprite_last_byte
    INY
    STY gbpb_block+5
    LDA data_ptr
    STA gbpb_block+1
    LDA data_ptr+1
    STA gbpb_block+2
    JSR read_block.write
    LDA sprite_width
    CMP #&02
    BNE not_small
    JSR write_name
.not_small
    JSR close_files
    JMP start.redraw
}

.file_exists
{
    JSR ask_load_name.found
    LDX #&EA
    LDY #&28
    LDA #&05
    JSR menu
    CMP #&02
    BNE cancel
    JMP ask_save_name.done
.cancel
    PLA
    PLA
    JMP cmd_save_file.return_
}

.fscv
{
    JMP (FSCV)
}

.sprite_file_offset
{
    LDA data_ptr
    SEC
    SBC #&00
    STA gbpb_block+9
    LDA data_ptr+1
    SBC #&40
    STA gbpb_block+10
    BIT io_file
    BMI io
    RTS
.io
    LDA gbpb_block+10
    CMP #&0E
    BNE io_graphics
    LDA #&00
    STA gbpb_block+10
    RTS
.io_graphics
    LDA gbpb_block+9
    CLC
    ADC #&D3
    STA gbpb_block+9
    LDA gbpb_block+10
    ADC #&25
    STA gbpb_block+10
    RTS
}

.name_file_offset
{
    JSR name_offset
    LDX #&00
    BIT io_file
    BMI io
    LDX #&0E
.io
    TYA
    CLC
    ADC #&80
    BCC store
    INX
.store
    STA gbpb_block+9
    STX gbpb_block+10
    RTS
}

.unused_read_ptr
{
    LDY gbpb_block
    LDX #&8B
    JMP OSARGS
}

.check_filing_system
{
    LDY #&0F
    LDA #&00
.clear
    STA gbpb_block, Y
    DEY
    BPL clear
    BIT disc_fs
    BPL tape
.done
    RTS
.tape
    CPX #&02
    BCS done
    LDX #&78
    LDY #&29
    JMP show_error
}

.unused_not_implemented
{
    LDX #&3A
    LDY #&36
    JMP show_error
    EQUB &00, &0D
    EQUS "Not implemented"
    EQUB &0D, &FF
}

.open_file
{
    LDA #&40
    BITABS
.update
    LDA #&C0
    LDX osfile_block
    LDY osfile_block+1
    JSR OSFIND
    TAX
    BNE opened
    JMP bad_file
.opened
    STX gbpb_block
    RTS
}

.cmd_load_sprite
{
    LDX #&00
    JSR check_filing_system
    JSR ask_load_name
    JSR open_file
    LDA sprite
    JSR sprite_address
    JSR sprite_file_offset
    JSR sprite_last_byte
    INY
    STY gbpb_block+5
    LDA data_ptr
    STA gbpb_block+1
    LDA data_ptr+1
    STA gbpb_block+2
    JSR read_block
    LDA sprite_width
    CMP #&02
    BNE not_small
    JSR read_name
.not_small
    JSR close_files
    JMP start.redraw
}

.write_name
{
    JSR name_transfer
    BCC read_block.write
    RTS
}

.name_transfer
{
    LDA sprite
    CMP #&1F
    BNE named
    RTS
.named
    JSR name_file_offset
    LDA #&0C
    STA gbpb_block+5
    JSR name_offset
    TYA
    CLC
    ADC #&80
    STA gbpb_block+1
    LDA #&4E
    ADC #&00
    STA gbpb_block+2
    CLC
.done
    RTS
}

.read_name
{
    JSR name_transfer
    BCS name_transfer.done
}

.read_block
{
    LDA #3
    BITABS
.write
    LDA #1
    LDX #&B5
    LDY #&2E
    JMP OSGBPB
}

.close_files
{
    LDA #&00
    TAY
    JMP OSFIND
}

.ask_load_name
{
    LDA #&06
    LDX #&02
    LDY #&29
    JSR open_window
    JSR input_line
    LDA #&06
    JSR close_window
    JSR file_info
    BCS found
    CMP #&01
    BNE cmd_load_file.no_file
.found
    LDA #&00
    STA io_file
    BIT disc_fs
    BMI disc
    RTS
.disc
    LDA osfile_block+3
    CMP #&40
    BNE not_graphics
    LDA osfile_block+11
    CMP #&0F
    BNE not_graphics
    RTS
}

.io_file
    EQUB &00
.not_graphics
    LDA osfile_block+11
    CMP #&33
    BEQ io
    JMP bad_file
.io
    LDA #&FF
    STA io_file
    RTS

.cmd_load_file
{
    LDX #&02
    JSR check_filing_system
    JSR ask_load_name
    BIT io_file
    BMI load_io
    LDA #&FF
    JSR osfile_graphics
    JMP start.redraw
.no_file
    LDX #&B4
    LDY #&27
    JMP show_error
}

.set_segment
{
    LDA io_segments, X
    STA gbpb_block+1
    LDA io_segments+1, X
    STA gbpb_block+2
    LDA io_segments+2, X
    STA gbpb_block+9
    LDA io_segments+3, X
    STA gbpb_block+10
    LDA io_segments+4, X
    STA gbpb_block+5
    LDA io_segments+5, X
    STA gbpb_block+6
    RTS
}

.load_io
{
    JSR open_file
    LDA #&00
.segment
    PHA
    TAX
    JSR set_segment
    JSR read_block
    PLA
    CLC
    ADC #&06
    CMP #&12
    BCC segment
    JSR close_files
    JMP start.redraw
}

.io_segments
    EQUB &00
    EQUB &4E
    EQUB &00
    EQUB &00
    EQUB &80
    EQUB &00, &80, &4E, &80, &00, &B4, &00, &00
    EQUB &40, &D3, &25, &00, &0E

.file_info
{
    LDX #&FE
    STX osfile_block
    LDY #&37
    STY osfile_block+1
    SEC
    BIT disc_fs
    BPL cmd_obj_name.done
    LDA #&05
}

.osfile_graphics
{
    LDX #&00
    STX osfile_block+6
    LDX #&00
    STX osfile_block+2
    LDX #&40
    STX osfile_block+3
    BIT disc_fs
    BMI call
    PHA
    LDA #&0C
    JSR OSWRCH
    PLA
.call
    LDX #&2B
    LDY #&32
    JSR OSFILE
    CLC
    RTS
}

.bad_file
{
    LDX #&D2
    LDY #&27
    JMP show_error
}

.cmd_obj_name
{
    LDA sprite_width
    CMP #&02
    BEQ small
.done
    RTS
.small
    LDA sprite
    CMP #&1F
    BEQ done
    LDA #&06
    LDX #&51
    LDY #&29
    JSR open_window
    JSR input_line
    JSR name_offset
    LDX #&00
.copy
    LDA input_buffer, X
    STA object_names, Y
    INY
    INX
    CPX #&0C
    BCC copy
    LDA #&06
    JSR close_window
    LDA sprite
.show
    JMP show_selection
}

.input_buffer
    EQUB &00, &00, &00, &00, &00, &00, &00, &00
    EQUB &00, &00, &00, &00, &0D, &0D, &0D, &0D
    EQUB &0D

.input_line
{
    LDY #&0C
    STY input_limit
    LDY #&00
    LDA #&0F
    JSR OSBYTE
    LDY #&0F
    LDA #&20
.blank
    STA input_buffer, Y
    DEY
    BPL blank
    INY
.read
    LDA #&20
    STA input_buffer, Y
    JSR OSRDCH
    BCC got_key
.abandon
    JMP pick_second_sprite.abandon_menu
.got_key
    CMP #&E0
    BCS abandon
    CMP #&0D
    BNE edit
    RTS
.edit
    AND #&7F
    CMP #&15
    BNE not_wipe
    TYA
    TAX
    BNE rub_out
    BEQ read
.not_wipe
    CMP #&7F
    BNE add
    CPY #&00
    BEQ read
    LDX #&01
.rub_out
    LDA screen_ptr
    SEC
    SBC #&08
    STA screen_ptr
    BCS erase
    DEC screen_ptr+1
.erase
    CLC
    LDA input_buffer-1, Y
    JSR print_char
    DEY
    DEX
    BNE rub_out
    JMP read
.add
    CMP #&20
    BCC read
    CPY input_limit
    BCS read
    STA input_buffer, Y
    INY
    JSR print_char_advance
    JMP read
}

.input_limit
    EQUB &00

.edit_pixels
{
    LDX #&FE
    JSR key_pressed
    BPL move
    RTS
.move
    LDX cursor_x
    LDY cursor_y
    STX old_cursor_x
    STY old_cursor_y
    LDA sprite_width
    ASL A
    ASL A
    STA count_x
    ASL A
    STA count_y
    DEC count_x
    DEC count_y
    LDX #&BD
    JSR key_pressed
    BPL not_right
    LDX cursor_x
    CPX count_x
    BCS not_right
    LDX #&BD
    JSR key_delay
    INC cursor_x
.not_right
    LDX #&9E
    JSR key_pressed
    BPL not_left
    LDX cursor_x
    BEQ not_left
    LDX #&9E
    JSR key_delay
    DEC cursor_x
.not_left
    LDX #&97
    JSR key_pressed
    BPL not_down
    LDY cursor_y
    CPY count_y
    BCS not_down
    LDX #&97
    JSR key_delay
    INC cursor_y
.not_down
    LDX #&B7
    JSR key_pressed
    BPL not_up
    LDY cursor_y
    BEQ not_up
    LDX #&B7
    JSR key_delay
    DEC cursor_y
.not_up
    LDX #&CF
    JSR key_pressed
    BPL not_1
    LDA #&01
    STA colour
    JSR show_colour
.not_1
    LDX #&CE
    JSR key_pressed
    BPL not_2
    LDA #&02
    STA colour
    JSR show_colour
.not_2
    LDX #&EE
    JSR key_pressed
    BPL not_3
    LDA #&03
    STA colour
    JSR show_colour
.not_3
    LDX #&ED
    JSR key_pressed
    BMI colour_0
    LDX #&D8
    JSR key_pressed
    BPL not_0
.colour_0
    LDA #&00
    STA colour
    JSR show_colour
.not_0
    LDA old_cursor_x
    EOR cursor_x
    BNE moved
    EOR cursor_y
    EOR old_cursor_y
    BEQ still
.moved
    LDA repeat_delay
    SEC
    SBC #&0A
    CMP #&0A
    BCS delay_ok
    LDA #&0A
.delay_ok
    STA repeat_delay
    LDX cursor_x
    LDY cursor_y
    JSR toggle_cursor
    LDX old_cursor_x
    LDY old_cursor_y
    JSR toggle_cursor
    JMP plot_keys
.still
    LDA #&B9
    STA repeat_delay
.plot_keys
    LDX #&A6
    JSR key_pressed
    BPL not_delete
    LDA colour
    PHA
    INX
    STX colour
    JSR plot
    PLA
    STA colour
    RTS
.not_delete
    LDX #&B6
    JSR key_pressed
    BPL done
.plot
    LDX cursor_x
    LDY cursor_y
    JSR grid_address
    LDY #&03
    LDX colour
.block
    LDA colour_byte, X
    EOR cursor_shape, Y
    STA (screen_ptr), Y
    DEY
    BPL block
    LDA sprite
    LDX cursor_x
    LDY cursor_y
    JSR plot_pixel
    LDA sprite
    BNE not_background
    JSR repeat_background
.not_background
    LDA sprite
    JSR draw_sheet_sprite
.done
    RTS
}

.repeat_background
{
    LDA data_ptr
    AND #&F8
    STA data_ptr
    LDY #&07
.read
    LDA (data_ptr), Y
    STA background_tile, Y
    DEY
    BPL read
    LDY #&7F
    LDX #&07
.fill
    LDA background_tile, X
    STA graphics, Y
    DEX
    TXA
    AND #&07
    TAX
    DEY
    BPL fill
    CLC
    JMP redraw_grid
}

.background_tile
    EQUB &00, &00, &00, &00, &00, &00, &00, &00

.key_delay
{
    STX temp
    LDA repeat_delay
    STA count_x
.poll
    LDX temp
    JSR key_pressed
    BMI held
    RTS
.held
    LDX #&00
.spin
    DEX
    BNE spin
    DEC count_x
    BNE poll
    RTS
}

.pixel_mask
    EQUB &88, &44, &22, &11

.pixel_address
{
    STX pixel_x
    STY pixel_y
    JSR sprite_address
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    TAY
    LDA pixel_x
    LSR A
    LSR A
    TAX
.column
    DEX
    BMI got_column
    TYA
    CLC
    ADC data_ptr
    STA data_ptr
    BCC column
.got_column
    LDA pixel_y
    ORA data_ptr
    STA data_ptr
    LDA pixel_x
    AND #&03
    TAX
    LDA pixel_mask, X
    STA mask
    RTS
}

.plot_pixel
{
    JSR pixel_address
    EOR #&FF
    LDY #&00
    AND (data_ptr), Y
    STA temp
    LDX colour
    LDA colour_byte, X
    AND mask
    ORA temp
    STA (data_ptr), Y
    RTS
}

.read_pixel
{
    JSR pixel_address
    LDY #&00
    AND (data_ptr), Y
.find_bit
    LSR mask
    BCS got_bit
    LSR A
    BCC find_bit
.got_bit
    LSR A
    PHP
    LSR A
    LSR A
    LSR A
    PLP
    ROL A
    RTS
}

.menu_text
    EQUB &81
    EQUB &26, &B7, &26, &EC, &26, &32, &27

.menu_keys
    EQUB &DF, &8E, &8D, &8C

.read_command
{
    LDX #&FE
    JSR key_pressed
    BPL menus
    LDA #&17
    STA temp
.shortcut
    LDY temp
    LDX shortcut_keys, Y
    BPL next_shortcut
    JSR key_pressed
    BMI found
.next_shortcut
    DEC temp
    BPL shortcut
    LDA #&FF
    RTS
.found
    INC temp
    LDA temp
    RTS
.menus
    LDA #&03
.menu_key
    PHA
    TAY
    LDX menu_keys, Y
    JSR key_pressed
    BPL next_menu
    PLA
    PHA
    ASL A
    TAY
    LDX menu_text, Y
    LDA menu_text+1, Y
    TAY
    PLA
    PHA
    JSR menu
    CMP #&00
    BNE picked
    PLA
    LDA #&00
    RTS
.picked
    STA temp
    PLA
    ASL A
    ASL A
    ASL A
    ORA temp
    RTS
.next_menu
    PLA
    SEC
    SBC #&01
    BCS menu_key
    RTS
}

.shortcut_keys
    EQUB &BD, &BB, &A6, &CA, &BE, &AA, &57, &57
    EQUB &AE, &96, &C9, &57, &CC, &9B, &57, &57
    EQUB &89, &88, &8A, &E9, &AD, &00, &00, &00

.key_held
    EQUB &00, &00

.select_mode
    EQUB &00

.timer_value
    EQUB &00, &00, &00, &00, &00

.flush_menu_keys
{
    LDA #&03
.loop
    PHA
    TAY
    LDX menu_keys, Y
    JSR key_pressed
    BPL next
    LDA #&7D
    JSR OSBYTE
.next
    PLA
    SEC
    SBC #&01
    BCS loop
    RTS
}

.leftover
    EQUB &FF, &9A, &4C, &C3, &12, &FC, &1F, &01
    EQUB &1F, &44, &1F, &CD, &1F, &D7, &20, &56
    EQUB &1F, &8A, &20, &19, &1A, &F5, &20, &B7
    EQUS " H s & "
    EQUB &05, &20, &10, &1F, &0E, &20, &0A, &15
    EQUB &8B, &1C, &C2, &1C, &1E, &18, &75, &16
    EQUB &F5, &1C, &FC, &1D, &A9, &18, &A9, &18
    EQUB &A9, &18, &A9, &18, &0A, &15, &08, &07
    EQUB &0A, &09, &0C, &0C, &19, &F0, &C0, &80
    EQUB &33, &77, &FF, &FF, &FF, &00, &00, &FF
    EQUB &FF, &FF, &CC, &88, &88, &00, &00, &FF
    EQUB &FF, &FF, &33, &11, &11, &0F, &03, &01
    EQUB &CC, &EE, &EE, &FF, &FF, &F0, &F0, &F0
    EQUB &F0
    EQUS "pp00"
    EQUB &F0, &F0, &F0, &E0, &C0, &C0, &91, &C0
    EQUB &E0, &80, &11, &77, &FF, &FF, &FF, &FF
    EQUB &00, &00, &FF, &FF, &FF, &88, &88, &88
    EQUB &00, &00, &FF, &FF, &FF, &00, &00, &00
    EQUB &00, &00, &FF, &FF, &FF, &00, &00, &10
    EQUB &F0, &70, &30, &98, &30, &70, &F0, &F0
    EQUB &F0, &F0, &F0, &F0, &F0, &F0, &F0, &F0
    EQUB &F0, &F0, &F0, &E0, &E0, &F0, &F0, &F0
    EQUB &C0, &80
    EQUS "3ww333"
    EQUB &10, &10, &CC, &EE, &EE, &EE, &EE, &EE
    EQUB &F0, &F0, &F0
    EQUS "ppppp"
    EQUB &00, &00, &F0, &F0, &F0, &F0, &F0, &F0
    EQUB &FF, &FF, &F0, &E0, &C0, &C0, &91, &91
ENDSECTION

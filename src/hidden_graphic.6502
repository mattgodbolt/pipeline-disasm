; H.GRAPH: the PIPELINE Graphics Designer.
;
; The GRAPHIC stub reads this from sectors &145-&165, which no catalogue entry
; mentions, to &1AB0 and jumps to start. It edits a graphics set - the game's
; sprites and the names of its objects - kept at &4000 (DEFAULT.6502 shows
; the format), and goes back to the menu by *RUNning MRUN.
;
; The screen is MODE 5 at &5800. On the left, the selected sprite magnified
; four times into an editing grid, and under it the current colour and, for an
; object, its number and name. On the right, the sprite sheet: a 5x5 grid of
; large sprites (16x32 pixels) and under it a 4x4 grid of small ones (8x16),
; then the PIPELINE logo. Menus, prompts and errors pop up in windows that
; keep what they cover at &5000.
;
; Keys: Z X : / move the pixel cursor, 0-3 pick a colour (4 is 0 again),
; Return plots and Delete clears; the cursor keys pick a sprite; f0-f3 open
; the menus (OptionsA, OptionsB, Environment and the credits) and CTRL with a
; letter is a shortcut for a menu item; Escape offers to leave.
;
; Memory, besides the screen:
;   &1AB0-&3ADB  this program; the rest, to &3BAF, is whatever was in memory
;                after it when it was saved
;   &3E00, &3E80 two sprite buffers: Animate's frames
;   &3F80        the undo copy of the sprite being edited
;   &4000-&4F33  the graphics set, with "Finish Block" after it
;   &5000-&57FF  what the pop-up windows cover

INCLUDE "os.6502inc"
INCLUDE "osconst.6502inc"
INCLUDE "io.6502inc"
INCLUDE "sprites.6502inc"
INCLUDE "graphics_designer.6502inc"

; In shortcut_keys, an entry below &80 isn't a key (an INKEY_TEST() value is
; &80 or more).
NO_KEY = &57

; The code f0 gives while a menu runs (OSBYTE_FUNCTION_KEY_BASE), f1-f9 the
; codes after it.
CODE_F0 = &E0

; Window text: a flag byte (MENU makes the lines after the first a list to
; pick from), then lines ending in CR, then TEXT_END.
TEXT_END = &FF
MENU     = &FF
PLAIN    = 0

; Windows, numbered as window_address and window_size list them.
WINDOW_OPTIONS_A   = 0
WINDOW_OPTIONS_B   = 1
WINDOW_ENVIRONMENT = 2
WINDOW_CREDITS     = 3
WINDOW_PICK        = 4          ; "Select sprite to..." with a picture of it; Animate's
WINDOW_QUESTION    = 5          ; Escape?, Exists, the palette
WINDOW_INPUT       = 6          ; file and object names
WINDOW_ERROR       = 7

; Sprite numbers: &00-&0F and &20-&28 are the large sprites' sheet positions,
; &10-&1F the small ones; the last small one is the man, who has no name.
FIRST_SMALL = &10
LAST_SMALL  = &1F
THE_MAN     = LAST_SMALL
AFTER_SMALL = &20
SMALL_WIDTH = 2                 ; sprite_width, in bytes
LARGE_WIDTH = 4

; Sprite numbers beyond the sheet: the two buffers Animate shows frames in.
SPRITE_FRAME_A = &57
SPRITE_FRAME_B = &58
UPSIDE_DOWN    = &80            ; in animation_frames: show the frame turned over

; Screen layout: MODE 5, 20 character cells of 8 bytes across each row.
SCREEN = &5800
CELL   = 8
ROW    = &140

graphics      = &4000           ; the graphics set
; Where its pieces are in an IO file (see io_segments).
IO_SLOT_28    = &0000
IO_NAMES      = &0080
IO_GRAPHICS   = &25D3
object_names  = graphics + &E80
graphics_end  = graphics + &F34
frame_a       = &3E00
frame_b       = &3E80
undo_buffer   = &3F80
window_store  = &5000
edit_grid     = SCREEN + ROW + 2*CELL
colour_swatch = SCREEN + 19*ROW + 1*CELL
name_box      = SCREEN + 19*ROW + 4*CELL
large_sheet   = SCREEN + 20*CELL
small_sheet   = SCREEN + 20*ROW + 21*CELL
frame_preview = SCREEN + 23*ROW + 9*CELL
logo_screen   = SCREEN + 28*ROW + 18*CELL
; Two bytes of the editing grid's frame that tell whether it is drawn for a
; large sprite or a small one.
grid_frame_top   = SCREEN + 10*CELL + 7
grid_frame_right = SCREEN + ROW + 18*CELL

; Zero page.
screen_ptr   = &50              ; where on the screen
data_ptr     = &52              ; a sprite's bytes; window text
save_ptr     = &54              ; where a window's background is kept
pixel_x      = &56
pixel_y      = &57
aux_ptr      = &58              ; a glyph; a window's corner; a second sprite
line_count   = &60              ; lines of window text, less one
temp         = &61
count_x      = &62
count_y      = &63
item         = &64              ; the highlighted menu line, from 0
mask         = &65              ; one pixel of a byte; window text's flag byte
sprite_width = &70              ; in bytes: 4 large, 2 small (8 lines tall per byte)
sprite       = &71              ; the selected sheet position
old_sprite   = &72
cursor_x     = &73              ; the pixel cursor in the editing grid
cursor_y     = &74
old_cursor_x = &75
old_cursor_y = &76
colour       = &77              ; for plotting, 0-3
repeat_delay = &78              ; the pixel cursor's key repeat, shortening as it repeats
last_column  = &7A              ; of the selected sprite's row in the sheet
by_slot      = &7B              ; bit 7: sprite numbers are slots, not sheet positions
border_ptr   = &7C
escape_latch = &7E              ; bit 7: SHIFT-Escape was pressed

SECTION hidden_graphic, filename="H.GRAPH", org=&1AB0

; The PIPELINE logo at the bottom right: 88x24 pixels, which start copies
; to the screen a character row at a time.
.logo
    SCREEN_PICTURE {
        ".33333333....33333333...3333333.....33333333...3.........33333333...3......3....3333333.",
        "3333333333..3333333333.333333333...3333333333.333.......3333333333.333....333..333333333",
        "33333333333..33333333..3333333333..333333333..333........33333333..333....333..33333333.",
        "3333....333.....33.....333....333..333........333...........33.....333....333..333......",
        "333......333....33.....33......33..333........333...........33.....333....333..333......",
        "333......333....33.....33......333.333........333...........33.....3333...333..333......",
        "333......333....33.....33......333.333........333...........33.....33333..333..333......",
        "333......33.....33.....33......333.333........333...........33.....33333..333..333......",
        "3333....333.....33.....333....333..333........333...........33.....333333.333..333......",
        "33333333333.....33.....3333333333..3333333....333...........33.....3333333333..333333...",
        "3333333333......33.....333333333...33333333...333...........33.....3333333333..3333333..",
        "333333333.......33.....33333333....3333333....333...........33.....333.333333..333333...",
        "333.............33.....333.........333........333...........33.....333..33333..333......",
        "333.............33.....333.........333........333...........33.....333..33333..333......",
        "333.............33.....333.........333........333...........33.....333...3333..333......",
        "333.............33.....333.........333........333...........33.....333....333..333......",
        "333.............33.....333.........333........333...........33.....333....333..333......",
        "333.............33.....333.........333........333...........33.....333....333..333......",
        "333..........33333333..333.........333333333..33333333...33333333..333....333..33333333.",
        "333.........3333333333.333.........3333333333.333333333.3333333333.333....333..333333333",
        ".3...........33333333...3...........33333333...3333333...33333333...3......3....3333333.",
        "........................................................................................",
        "........................................................................................",
        "........................................................................................",
    }

; The slot each position of the large sprite sheet shows, positions in
; reading order (5 to a row). Sprite numbers &00-&0F are positions 0-15 and
; &20-&28 positions 16-24; &10-&1F are the small sprites, which show their own
; slots.
.slot_of_position
    EQUB &00, &01, &02, &03, &04
    EQUB &05, &08, &07, &0A, &0E
    EQUB &24, &26, &25, &27, &0F
    EQUB &06, &28, &0C, &0D, &0B
    EQUB &09, &20, &21, &22, &23
    SKIP 39                         ; unused

; A font of 4x8 characters, &20-&7F, eight to a picture: each four pixels
; across is a character, stored as a column of eight bytes. print_char
; exclusive-ORs them on in colour 3. "^~" is a copyright sign.
.font
    ; space ! " # $ % & '
    SPRITE_COLUMNS {
        ".....3..3.3..33...3.3....3....3.",
        ".....3..3.3..33..3333.3.3.3..3..",
        ".....3..3.3.33333.....3.3.3..3..",
        ".....3.......33..33..3...3......",
        ".....3......3333...3.3..3.33....",
        ".............33.333.3.3.3.3.....",
        ".....3.......33..3....3..3.3....",
        "................................",
    }
    ; ( ) * + , - . /
    SPRITE_COLUMNS {
        "..3..3..........................",
        ".3...3...3...3................3.",
        ".3....3.333..3................3.",
        ".3....3..33.333.....333......3..",
        ".3....3.333..3...............3..",
        ".3...3...3...3...3.......3..3...",
        "..3..3...........3.......3......",
        ".................3..............",
    }
    ; 0 1 2 3 4 5 6 7
    SPRITE_COLUMNS {
        ".3...3..333.333.3...333.333.333.",
        "3.3.33....3...3.3...3...3.....3.",
        "3.3..3....3...3.3...3...3.....3.",
        "3.3..3..333..33.3.3.333.333..33.",
        "3.3..3..3.....3.3.3...3.3.3..3..",
        "3.3..3..3.....3.333...3.3.3..3..",
        ".3..333.333.333...3.333.333..3..",

.window_open
    EQUB &00, &00, &00, &00, &00, &00, &00, &00
    EQUB &00, &00, &00, &00, &00, &00, &00, &00
    EQUB &00, &00, &00, &00

.grid_row_address
    EQUB &50
    EQUB &59, &90, &5A, &D0, &5B, &10, &5D, &50
    EQUB &5E, &90, &5F, &D0, &60, &10, &62, &50
    EQUB &63, &90, &64, &D0, &65, &10, &67, &50
    EQUB &68, &90, &69, &D0, &6A, &10, &6C

.window_address
    EQUB &00
    EQUB &58, &40, &58, &80, &58, &C0, &58
    EQUB &60
    EQUB &72
    EQUB &A0
    EQUB &73, &90, &73, &E0, &69

.window_size
    EQUB &3F
    EQUB &08, &3F, &08, &57, &08, &7F, &06, &6F
    EQUB &07, &3F, &06, &7F, &07, &7F, &06

.window_setup
{
    AND #&07
    ASL A
    TAY
    LDA #&50
    STA save_ptr+1
    LDA window_address, Y
    STA screen_ptr
    STA aux_ptr
    LDA window_address+1, Y
    STA screen_ptr+1
    STA aux_ptr+1
    LDA #&00
    STA save_ptr
    LDA window_size, Y
    STA count_x
    LDA window_size+1, Y
    STA count_y
    RTS
}

.open_window
{
    STX data_ptr
    STY data_ptr+1
    AND #&7F
    PHA
    LDA #&07
.close_others
    PHA
    TAX
    JSR close_window
    PLA
    SEC
    SBC #&01
    BCS close_others
    PLA
    PHA
    TAX
    ORA #&80
    STA window_open, X
    JSR window_setup
    LDX #&0F
.fill_row
    LDY count_x
.fill_byte
    LDA (screen_ptr), Y
    STA (save_ptr), Y
    TXA
    STA (screen_ptr), Y
    DEY
    BPL fill_byte
    LDX #&FF
    JSR next_window_row
    DEC count_y
    BNE fill_row
    LDA aux_ptr
    STA save_ptr
    STA screen_ptr
    LDA aux_ptr+1
    STA save_ptr+1
    STA screen_ptr+1
    PLA
}

.print_window_text
{
    PHA
    LDY #&FF
    STY line_count
    INY
    LDA (data_ptr), Y
    STA mask
.next_char
    INC data_ptr
    BNE read_char
    INC data_ptr+1
.read_char
    LDY #&00
    LDA (data_ptr), Y
    CMP #&FF
    BEQ frame
    CMP #&0D
    BEQ new_line
    CLC
    JSR print_char_advance
    BNE next_char
.new_line
    INC line_count
    LDA save_ptr
    CLC
    ADC #&40
    STA save_ptr
    STA screen_ptr
    LDA save_ptr+1
    ADC #&01
    STA save_ptr+1
    STA screen_ptr+1
    BCC next_char
.frame
    PLA
    AND #&07
    ASL A
    TAY
    LDA window_address, Y
    STA border_ptr
    LDA window_address+1, Y
    STA border_ptr+1
    LDA window_size+1, Y
    SBC #&00
    STA count_y
.frame_row
    LDY count_x
    LDX #&07
    LDA border_ptr
    CLC
    ADC #&40
    STA border_ptr
    LDA border_ptr+1
    ADC #&01
    STA border_ptr+1
.frame_right
    LDA (border_ptr), Y
    AND #&EE
    ORA #&10
    STA (border_ptr), Y
    DEY
    DEX
    BPL frame_right
    DEC count_y
    BNE frame_row
    LDY count_x
.frame_bottom
    LDA #&F0
    STA (border_ptr), Y
    TYA
    SEC
    SBC #&08
    TAY
    BCS frame_bottom
    RTS
}

.next_window_row
{
    LDA save_ptr
    SEC
    ADC count_x
    STA save_ptr
    BCC next_screen_row
    INC save_ptr+1
.next_screen_row
    LDA screen_ptr
    CLC
    ADC #&40
    STA screen_ptr
    LDA screen_ptr+1
    ADC #&01
    STA screen_ptr+1
    RTS
}

.close_all_windows
{
    LDX #&07
.loop
    TXA
    PHA
    JSR close_window
    PLA
    TAX
    DEX
    BPL loop
    RTS
}

.close_window
{
    AND #&7F
    PHA
    TAY
    LDA window_open, Y
    BMI open
    PLA
    RTS
.open
    PLA
    PHA
    JSR window_setup
.row
    LDY count_x
.byte
    LDA (save_ptr), Y
    STA (screen_ptr), Y
    DEY
    BPL byte
    JSR next_window_row
    DEC count_y
    BNE row
    PLA
    TAX
    LDA #&00
    STA window_open, X
    RTS
}

.key_pressed
{
    LDA #&81
    TAY
    JSR OSBYTE
    TXA
    RTS
}

.wait_key_release
{
    TXA
    PHA
    JSR key_pressed
    TAY
    PLA
    TAX
    INY
    BEQ wait_key_release
    RTS
}

.print_char_advance
{
    JSR print_char
    LDA screen_ptr
    CLC
    ADC #&08
    STA screen_ptr
    BCC done
    INC screen_ptr+1
.done
    RTS
}

.print_char
{
    PHP
    STY saved_y
    STX saved_x
    LDY #&00
    STY aux_ptr+1
    LDX #&00
    CMP #&20
    BCS printable
    LDA #&21
.printable
    SBC #&20
    ASL A
    ASL A
    ROL aux_ptr+1
    ASL A
    ROL aux_ptr+1
    TAX
    LDA aux_ptr+1
    ADC #&1D
    TAY
    STX aux_ptr
    STY aux_ptr+1
    PLP
    LDY #&07
.row
    LDA (aux_ptr), Y
    BCS store
    EOR (screen_ptr), Y
.store
    STA (screen_ptr), Y
    DEY
    BPL row
    LDX saved_x
    LDY saved_y
    RTS
.saved_x
    EQUB &00
.saved_y
    EQUB &00
}

.menu
{
    PHA
    JSR open_window
    PLA
    PHA
    AND #&07
    STA count_y
    ASL A
    TAY
    LDA window_address, Y
    STA screen_ptr
    LDA window_address+1, Y
    STA screen_ptr+1
    JSR next_window_row.next_screen_row
    LDA #&FF
    STA item
    BIT mask
    BPL no_list
    JSR invert_menu_row
    INC item
.no_list
    LDA #&04
    LDX #&01
    JSR OSBYTE
    LDA #&E1
    LDX #&E0
    LDY #&00
    JSR OSBYTE
.read_key
    LDA #&0F
    LDX #&00
    JSR OSBYTE
    JSR OSRDCH
    BCC got_key
.cancel
    LDA #&7E
    JSR OSBYTE
    LDA #&E1
    LDX #&01
    LDY #&00
    JSR OSBYTE
    PLA
    JSR close_window
    LDX #&FF
    TXA
    RTS
.got_key
    CMP #&C8
    BCC not_fkey
    AND #&03
    CMP count_y
    BNE cancel
.not_fkey
    CMP #&20
    BEQ cancel
    CMP #&0D
    BEQ chosen
    BIT mask
    BPL read_key
    CMP #&8A
    BEQ down
    CMP #&8B
    BNE read_key
    LDA item
    BEQ read_key
    JSR invert_menu_row
    DEC item
    LDA screen_ptr
    SBC #&40
    STA screen_ptr
    LDA screen_ptr+1
    SBC #&01
    STA screen_ptr+1
    BCS highlight
.down
    LDA item
    CLC
    ADC #&01
    CMP line_count
    BEQ read_key
    JSR invert_menu_row
    INC item
    JSR next_window_row.next_screen_row
.highlight
    JSR invert_menu_row
    JMP read_key
.chosen
    PLA
    JSR close_window
    LDA #&0F
    LDX #&00
    JSR OSBYTE
    LDX #&B6
    JSR wait_key_release
    LDX item
    INX
    TXA
    RTS
}

.invert_menu_row
{
    LDY count_x
.invert
    LDA (screen_ptr), Y
    EOR #&0F
    STA (screen_ptr), Y
    DEY
    BPL invert
    LDY count_x
    LDX #&07
.border
    LDA (screen_ptr), Y
    AND #&EE
    ORA #&10
    STA (screen_ptr), Y
    DEY
    DEX
    BPL border
    RTS
}

.sprite_class
{
    LDX #&00
    STX data_ptr
    LDX #&40
    STX data_ptr+1
    LDX #&04
    CMP #&10
    BCC store
    CMP #&20
    BCS store
    LDX #&02
.store
    STX sprite_width
    RTS
}

.sprite_address
{
    TAY
    JSR sprite_class
    CMP #&57
    BCS frame
    TAY
    AND #&10
    BNE small
    TYA
    BIT by_slot
    BMI slot
    CMP #&20
    BCC mapped
    SBC #&10
.mapped
    TAX
    LDA slot_of_position, X
.slot
    CMP #&20
    BCS high_slot
    LSR A
    TAX
    LDA #&00
    ROR A
    STA data_ptr
    TXA
    ADC data_ptr+1
    STA data_ptr+1
    TYA
    RTS
.frame
    AND #&7F
    CMP #&58
    LDA #&00
    ROR A
    STA data_ptr
    LDA #&3E
    STA data_ptr+1
    TYA
    RTS
.high_slot
    AND #&0F
    TAX
    LDA data_ptr+1
    CLC
    ADC #&0A
    STA data_ptr+1
    TXA
    JMP slot
.small
    TYA
    PHA
    LDA data_ptr+1
    CLC
    ADC #&08
    STA data_ptr+1
    PLA
    ASL A
    ASL A
    ASL A
    ASL A
    ASL A
    BCC small_done
    INC data_ptr+1
.small_done
    CLC
    ADC data_ptr
    STA data_ptr
    TYA
    RTS
}

.sprite_last_byte
{
    LDY #&7F
    LDX sprite_width
    CPX #&02
    BNE done
    LDY #&1F
.done
    RTS
}

.colour_byte
    EQUB &00, &0F, &F0, &FF
.grid_back_step
    EQUW 2*4*ROW - 4*CELL
    EQUW 4*4*ROW - 4*CELL

.draw_grid
{
    ASL A
    PHP
    LSR A
    JSR sprite_address
    PLP
    BCC draw
    JSR sprite_last_byte
.keep
    LDA (data_ptr), Y
    STA undo_buffer, Y
    DEY
    BPL keep
.draw
    LDA #&50
    STA screen_ptr
    LDA #&59
    STA screen_ptr+1
    LDA sprite_width
    STA count_x
.column
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    STA count_y
.byte
    LDY #&00
    LDA (data_ptr), Y
    STA temp
    LDX #&88
    STX mask
.pixel
    LDA mask
    STA item
    LDA temp
    AND mask
.find_bit
    LSR item
    BCS got_bit
    LSR A
    BCC find_bit
.got_bit
    LSR A
    PHP
    LSR A
    LSR A
    LSR A
    PLP
    ROL A
    TAX
    LDY #&03
    LDA #&01
    BIT count_y
    BEQ block
    LDY #&07
.block
    LDA colour_byte, X
    LDX #&03
.block_line
    STA (screen_ptr), Y
    DEY
    DEX
    BPL block_line
    LDA screen_ptr
    ADC #&08
    STA screen_ptr
    BCC next_pixel
    INC screen_ptr+1
.next_pixel
    LSR mask
    BCC pixel
    LDA screen_ptr
    SBC #&20
    STA screen_ptr
    BCS pixel_done
    DEC screen_ptr+1
.pixel_done
    LDA #&01
    AND count_y
    BEQ next_byte
    LDA screen_ptr
    CLC
    ADC #&40
    STA screen_ptr
    LDA screen_ptr+1
    ADC #&01
    STA screen_ptr+1
.next_byte
    INC data_ptr
    DEC count_y
    BNE byte
    LDX sprite_width
    LDA screen_ptr
    SEC
    SBC grid_back_step-2, X
    STA screen_ptr
    LDA screen_ptr+1
    SBC grid_back_step-1, X
    STA screen_ptr+1
    DEC count_x
    BEQ frame
    JMP column
.frame
    LDA sprite_width
    CMP #&04
    BEQ check_large
    LDA grid_frame_top
    CMP #&08
    BNE to_small
    RTS
.to_small
    LDA #&50
    STA screen_ptr
    LDA #&58
    STA screen_ptr+1
    LDA #&12
    JSR clear_rows
    LDA #&48
    STA screen_ptr
    LDA #&63
    STA screen_ptr+1
    LDA #&09
    JSR clear_rows
.check_large
    LDA sprite_width
    CMP #&04
    BNE draw_large
    LDA grid_frame_right
    CMP #&08
    BNE draw_large
    RTS
.draw_large
    LDA #&08
    STA screen_ptr
    LDA #&58
    STA screen_ptr+1
    LDY #&07
    JSR grid_frame_line
    LDA #&01
    STA (screen_ptr), Y
    JSR down_a_row
    LDA sprite_width
    ASL A
    ASL A
    STA count_y
.left_column
    LDA #&01
    LDY #&07
.left_line
    STA (screen_ptr), Y
    DEY
    BPL left_line
    JSR down_a_row
    DEC count_y
    BNE left_column
    LDA #&01
    INY
    STA (screen_ptr), Y
    JSR grid_frame_line
    JSR width_times_32
    ADC #&08
    ADC screen_ptr
    STA screen_ptr
    BCC right_side
    INC screen_ptr+1
.right_side
    LDA sprite_width
    ASL A
    ASL A
    STA count_y
.right_column
    LDA screen_ptr
    SEC
    SBC #&40
    STA screen_ptr
    LDA screen_ptr+1
    SBC #&01
    STA screen_ptr+1
    LDY #&07
    LDA #&08
.right_line
    STA (screen_ptr), Y
    DEY
    BPL right_line
    DEC count_y
    BNE right_column
    RTS
}

.grid_frame_line
{
    STY temp
    JSR width_times_32
    ORA temp
    ADC #&08
    TAY
    LDX #&08
.loop
    TXA
    STA (screen_ptr), Y
    LDX #&0F
    TYA
    SEC
    SBC #&08
    TAY
    CMP #&08
    BCS loop
    RTS
}

.down_a_row
{
    LDA screen_ptr
    CLC
    ADC #&40
    STA screen_ptr
    LDA screen_ptr+1
    ADC #&01
    STA screen_ptr+1
    RTS
}

.width_times_32
{
    LDA sprite_width
    LSR A
    ROR A
    ROR A
    ROR A
    RTS
}

.clear_rows
{
    STA count_y
.row
    LDY #&47
    LDA #&00
.byte
    STA (screen_ptr), Y
    DEY
    BPL byte
    JSR down_a_row
    DEC count_y
    BNE row
}

.divide_by_5
{
    LDX #&00
.loop
    CMP #&05
    BCC done
    INX
    SBC #&05
    BCS loop
.done
    RTS
}

.draw_sheet_sprite
{
    JSR sprite_address
    JSR sheet_address
.at_screen_ptr
    LDX sprite_width
    STX count_y
.row
    LDX sprite_width
    STX count_x
.column
    LDY #&07
.byte
    LDA (data_ptr), Y
    STA (screen_ptr), Y
    DEY
    BPL byte
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    ADC data_ptr
    STA data_ptr
    BCC next_screen
    INC data_ptr+1
.next_screen
    LDA #&08
    CLC
    ADC screen_ptr
    STA screen_ptr
    BCC next_column
    INC screen_ptr+1
.next_column
    DEC count_x
    BNE column
    LDA sprite_width
    LSR A
    TAX
    LDA data_ptr
    SEC
    SBC column_rewind-1, X
    STA data_ptr
    BCS next_row
    DEC data_ptr+1
.next_row
    LDA screen_ptr
    CLC
    ADC row_step-1, X
    STA screen_ptr
    LDA screen_ptr+1
    ADC #&01
    STA screen_ptr+1
    DEC count_y
    BNE row
    RTS
.column_rewind
    EQUB 2*16-8, 4*32-8
.row_step
    EQUB LO(ROW-2*CELL), LO(ROW-4*CELL)
    EQUB 0
}

.sheet_address
{
    TAY
    LDX #&00
    STX screen_ptr+1
    CPY #&10
    BCC large
    CPY #&20
    BCC small
    SBC #&10
    CMP #&47
    BCS preview
.large
    JSR divide_by_5
    LSR A
    ROR A
    ROR A
    ROR A
    ADC #&A0
    STA screen_ptr
    LDA screen_ptr+1
    ADC #&58
.add_rows
    DEX
    BMI done
    ADC #&05
    BCC add_rows
.done
    STA screen_ptr+1
    TYA
    RTS
.small
    AND #&03
    LSR A
    ROR A
    ROR A
    ROR A
    STA screen_ptr
    TYA
    LSR A
    LSR A
    AND #&03
    TAX
.small_rows
    DEX
    BMI small_base
    LDA screen_ptr
    CLC
    ADC #&80
    STA screen_ptr
    LDA screen_ptr+1
    ADC #&02
    STA screen_ptr+1
    BCC small_rows
.small_base
    LDA screen_ptr
    CLC
    ADC #&A8
    STA screen_ptr
    LDA screen_ptr+1
    ADC #&71
    STA screen_ptr+1
    RTS
.preview
    LDA #&08
    STA screen_ptr
    LDA #&75
    STA screen_ptr+1
    TYA
    RTS
}

.stray_rts
{
    RTS
}

.escape_event
{
    PHP
    CMP #&06
    BNE other_event
    ROR ESCAPE_FLAG
    TXA
    PHA
    TYA
    PHA
    LDX #&FF
    JSR key_pressed
    BPL not_ctrl
    STA escape_latch
.not_ctrl
    PLA
    TAY
    PLA
    TAX
    LDA #&06
.other_event
    PLP
    RTS
}

.screen_layout
    EQUB &1A, &0C, &12, &00, &01, &19, &04, &18
    EQUB &00, &7C, &01, &19, &01, &00, &00, &24
    EQUB &00, &19, &01, &48, &00, &00, &00, &19
    EQUB &01, &00, &00, &DC, &FF, &19, &01, &B8
    EQUB &FF, &00, &00, &1C, &00, &11, &13, &00
    EQUB &19, &00, &60, &00, &04, &00, &19, &01
    EQUB &00, &00, &20, &00, &19, &01, &E8, &01
    EQUB &00, &00, &19, &01, &00, &00, &DC, &FF
    EQUB &19, &01, &18, &FE, &00, &00, &EA


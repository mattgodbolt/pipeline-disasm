; H.GRAPH: the PIPELINE Graphics Designer.
;
; The GRAPHIC stub reads this from sectors &145-&165, which no catalogue entry
; mentions, to &1AB0 and jumps to start. It edits a graphics set - the game's
; pictures and the names of its objects - kept at &4000 (src/default.6502 is
; one; sprites.6502inc names its layout), and goes back to the menu
; by running /MRUN (on tape it resets the machine instead).
;
; The screen is MODE 5 at &5800. On the left, the selected sprite magnified
; four times into an editing grid, and under it the current colour and, for
; an object, its number and name. On the right, the sprite sheet: a 5x5 grid
; of large sprites (16x32 pixels) and under it a 4x4 grid of small ones
; (8x16), then the PIPELINE logo. Menus, prompts and errors pop up in windows
; that keep what they cover at &5000.
;
; Keys: Z X : / move the pixel cursor, 0-3 pick a colour (4 is 0 again),
; Return plots and Delete clears; the cursor keys pick a sprite; f0-f3 open
; the menus (OptionsA, OptionsB, Environment and the credits) and CTRL with a
; key is a shortcut for a menu item; Escape offers to leave.
;
; Memory, besides the screen:
;   &1AB0-&3ADB  this program; the rest, to &3BAF, is whatever was in memory
;                after it when it was saved
;   &3E00, &3E80 two sprite buffers: Animate's frames
;   &3F80        the undo copy of the sprite being edited
;   &4000-&4F33  the graphics set, with "Finish Block" after it (start clears
;                &4000-&4FFF the first time)
;   &5000-&537F  what a pop-up window covers (the biggest is &380 bytes)

INCLUDE "os.6502inc"
INCLUDE "osconst.6502inc"
INCLUDE "io.6502inc"                    ; and sprites.6502inc, the graphics set's format

; In shortcut_keys, an entry below &80 isn't a key (any INKEY_TEST() value is
; &80 or more).
NO_KEY = &57

; The code f0 gives while a menu runs (OSBYTE_FUNCTION_KEY_BASE), f1-f9 the
; codes after it. menu counts any code from FUNCTION_KEY_CODES up as one.
KEYCODE_F0         = &E0
FUNCTION_KEY_CODES = &C8

; Window text: a flag byte (MENU makes the lines after the first a list to
; pick from), then lines ending in CR, then TEXT_END.
TEXT_END = &FF
MENU     = &FF
PLAIN    = 0

; Windows, numbered as window_address and window_size list them. A menu's
; window number is also its function key's number.
WINDOW_OPTIONS_A   = 0
WINDOW_OPTIONS_B   = 1
WINDOW_ENVIRONMENT = 2
WINDOW_CREDITS     = 3
WINDOW_PICK        = 4          ; "Select sprite to...", and Animate's
WINDOW_QUESTION    = 5          ; Escape?, Exists, the palette
WINDOW_INPUT       = 6          ; file and object names; "insert disc"
WINDOW_ERROR       = 7
WINDOWS            = 8

; Sprite numbers. On the sheet, &00-&0F and &20-&28 are the large sprites'
; places in reading order (slot_of_position gives the slot each shows), and
; &10-&1F the small ones, which show their own slots. While by_slot is set,
; the code takes sprite numbers as slots instead.
FIRST_SMALL = FIRST_SMALL_SLOT
LAST_SMALL  = FIRST_SMALL + 15
AFTER_SMALL = MORE_LARGE_SLOT   ; the large places after &0F
LAST_SPRITE = LAST_SLOT
SMALL_WIDTH = SMALL_SPRITE_WIDTH / 4    ; sprite_width: bytes across
LARGE_WIDTH = LARGE_SPRITE_WIDTH / 4
ASSERT SLOT_EXIT = LAST_SMALL

; The sheet: 5 rows of 5 large sprites, then 4 rows of 4 small ones.
LARGE_COLUMNS = 5
LARGE_ROWS    = 5
SMALL_COLUMNS = 4
SMALL_ROWS    = 4

; Sprite numbers beyond the sheet: the two buffers Animate shows frames in.
SPRITE_FRAME_A = &57
SPRITE_FRAME_B = &58
UPSIDE_DOWN    = &80            ; in animation_frames: show the frame turned over

; The screen: MODE 5, where a character row is 40 cells of 8 bytes, each cell
; four pixels (a byte) across and eight lines down. A MODE 5 text character
; is two cells wide; the designer's own font is one.
SCREEN = MODE5_SCREEN
CELL   = 8
ROW    = MODE5_ROW_BYTES
ASSERT ROW = 40 * CELL

graphics      = &4000           ; the graphics set
object_names  = graphics + SET_NAMES
graphics_end  = graphics + SET_SIZE
slot_28       = graphics + SET_NAMES - LARGE_SPRITE_SIZE    ; the last slot, which IO keeps apart

; Where the set's pieces are in an IO file (see io_segments).
IO_SLOT_28_OFFSET  = io_no_object_picture - io_start
IO_NAMES_OFFSET    = io_object_names - io_start
IO_GRAPHICS_OFFSET = io_graphics - io_start
IO_LENGTH          = IO_END - io_start
ASSERT LO(IO_SLOT_28_OFFSET) = LO(slot_28 - graphics)
ASSERT LO(IO_NAMES_OFFSET) = LO(SET_NAMES)
ASSERT IO_GRAPHICS_SIZE = slot_28 - graphics

frame_a       = &3E00           ; SPRITE_FRAME_A
frame_b       = frame_a + LARGE_SPRITE_SIZE
undo_buffer   = &3F80
window_store  = &5000

; Places on the screen.
edit_grid     = SCREEN + ROW + 2*CELL           ; a cell per pixel, two pixel rows to a row
colour_swatch = SCREEN + 19*ROW + 1*CELL
name_box      = SCREEN + 19*ROW + 4*CELL
large_sheet   = SCREEN + 20*CELL                ; 5 sprites across, each 4 cells by 4 rows
small_sheet   = SCREEN + 20*ROW + 21*CELL       ; 4 across, 4 cells apart, each 2 by 2
frame_preview = SCREEN + 23*ROW + 9*CELL        ; Animate's frame, in its window
logo_screen   = SCREEN + 28*ROW + 18*CELL
; Two bytes of the editing grid's frame that tell whether it is drawn for a
; large sprite or a small one: the small frame's top right corner, and the
; top of the large frame's right edge. Each is &08 (a pixel of colour 1 at
; the cell's left) only when that frame is drawn.
grid_frame_top   = SCREEN + 10*CELL + 7
grid_frame_right = SCREEN + ROW + 18*CELL

; Zero page.
screen_ptr   = &50              ; where on the screen
data_ptr     = &52              ; a sprite's bytes; window text
save_ptr     = &54              ; where a window's background is kept; a line of its text
pixel_x      = &56
pixel_y      = &57
aux_ptr      = &58              ; a glyph; a window's corner; a second sprite
line_count   = &60              ; lines of window text, less one
temp         = &61
count_x      = &62
count_y      = &63
item         = &64              ; the highlighted menu line, from 0
mask         = &65              ; one pixel of a byte; window text's flag byte
sprite_width = &70              ; in bytes: 4 large, 2 small (a sprite is 8 lines tall per byte)
sprite       = &71              ; the selected sprite
old_sprite   = &72
cursor_x     = &73              ; the pixel cursor in the editing grid
cursor_y     = &74
old_cursor_x = &75
old_cursor_y = &76
colour       = &77              ; for plotting, 0-3
repeat_delay = &78              ; the pixel cursor's key repeat, shortening as it repeats
last_column  = &7A              ; of the selected sprite's row in the sheet
by_slot      = &7B              ; bit 7: sprite numbers are slots, not sheet places
border_ptr   = &7C              ; a window's frame
escape_latch = &7E              ; bit 7: SHIFT-Escape was pressed

SECTION hidden_graphic, filename="H.GRAPH", org=&1AB0

; The PIPELINE logo at the bottom right: 88x24 pixels, drawn two characters
; a pixel (as default.6502inc draws the game's pictures) in its three bands of
; eight rows, which start copies to the screen a band (a character row) at a
; time. mode5_pictures lays each band out as the screen does.
LOGO_BAND = 22*CELL
.logo
    EQUB mode5_pictures({
        {
            "..3333333333333333........3333333333333333......33333333333333..........3333333333333333......33..................3333333333333333......33............33........33333333333333..",
            "33333333333333333333....33333333333333333333..333333333333333333......33333333333333333333..333333..............33333333333333333333..333333........333333....333333333333333333",
            "3333333333333333333333....3333333333333333....33333333333333333333....333333333333333333....333333................3333333333333333....333333........333333....3333333333333333..",
            "33333333........333333..........3333..........333333........333333....333333................333333......................3333..........333333........333333....333333............",
            "333333............333333........3333..........3333............3333....333333................333333......................3333..........333333........333333....333333............",
            "333333............333333........3333..........3333............333333..333333................333333......................3333..........33333333......333333....333333............",
            "333333............333333........3333..........3333............333333..333333................333333......................3333..........3333333333....333333....333333............",
            "333333............3333..........3333..........3333............333333..333333................333333......................3333..........3333333333....333333....333333............"
        },
        {
            "33333333........333333..........3333..........333333........333333....333333................333333......................3333..........333333333333..333333....333333............",
            "3333333333333333333333..........3333..........33333333333333333333....33333333333333........333333......................3333..........33333333333333333333....333333333333......",
            "33333333333333333333............3333..........333333333333333333......3333333333333333......333333......................3333..........33333333333333333333....33333333333333....",
            "333333333333333333..............3333..........3333333333333333........33333333333333........333333......................3333..........333333..333333333333....333333333333......",
            "333333..........................3333..........333333..................333333................333333......................3333..........333333....3333333333....333333............",
            "333333..........................3333..........333333..................333333................333333......................3333..........333333....3333333333....333333............",
            "333333..........................3333..........333333..................333333................333333......................3333..........333333......33333333....333333............",
            "333333..........................3333..........333333..................333333................333333......................3333..........333333........333333....333333............"
        },
        {
            "333333..........................3333..........333333..................333333................333333......................3333..........333333........333333....333333............",
            "333333..........................3333..........333333..................333333................333333......................3333..........333333........333333....333333............",
            "333333....................3333333333333333....333333..................333333333333333333....3333333333333333......3333333333333333....333333........333333....3333333333333333..",
            "333333..................33333333333333333333..333333..................33333333333333333333..333333333333333333..33333333333333333333..333333........333333....333333333333333333",
            "..33......................3333333333333333......33......................3333333333333333......33333333333333......3333333333333333......33............33........33333333333333..",
            "................................................................................................................................................................................",
            "................................................................................................................................................................................",
            "................................................................................................................................................................................"
        }
    })
ASSERT P% - logo = 3 * LOGO_BAND

; The slot each large position on the sheet shows, positions in reading
; order (5 to a row): sprite numbers &00-&0F are positions 0-15 and &20-&28
; positions 16-24. The small sprites, &10-&1F, show their own slots.
.slot_of_position
    EQUB &00, &01, &02, &03, &04
    EQUB &05, &08, &07, &0A, &0E
    EQUB &24, &26, &25, &27, &0F
    EQUB &06, &28, &0C, &0D, &0B
    EQUB &09, &20, &21, &22, &23

; print_char finds a glyph by its high byte alone, so the font starts a page.
    ALIGN &100

; A font of 4x8 characters, &20-&7F, eight to a picture (drawn two
; characters a pixel, so each character is eight across), each stored as a
; cell: a column of eight bytes. print_char draws them in colour 3. "^~" is a
; copyright sign.
.font
    EQUB mode5_pictures({
        ; space ! " # $ % & '
        {
            "..........33....33..33....3333......33..33........33........33..",
            "..........33....33..33....3333....33333333..33..33..33....33....",
            "..........33....33..33..3333333333..........33..33..33....33....",
            "..........33..............3333....3333....33......33............",
            "..........33............33333333......33..33....33..3333........",
            "..........................3333..333333..33..33..33..33..........",
            "..........33..............3333....33........33....33..33........",
            "................................................................"
        },
        ; ( ) * + , - . /
        {
            "....33....33....................................................",
            "..33......33......33......33................................33..",
            "..33........33..333333....33................................33..",
            "..33........33....3333..333333..........333333............33....",
            "..33........33..333333....33..............................33....",
            "..33......33......33......33......33..............33....33......",
            "....33....33......................33..............33............",
            "..................................33............................"
        },
        ; 0 1 2 3 4 5 6 7
        {
            "..33......33....333333..333333..33......333333..333333..333333..",
            "33..33..3333........33......33..33......33......33..........33..",
            "33..33....33........33......33..33......33......33..........33..",
            "33..33....33....333333....3333..33..33..333333..333333....3333..",
            "33..33....33....33..........33..33..33......33..33..33....33....",
            "33..33....33....33..........33..333333......33..33..33....33....",
            "..33....333333..333333..333333......33..333333..333333....33....",
            "................................................................"
        },
        ; 8 9 : ; < = > ?
        {
            "333333..333333......................33............33......3333..",
            "33..33..33..33....................33..............33....33..33..",
            "33..33..33..33....33......33......33....333333......33......33..",
            "333333..333333....33......33....33..................33....33....",
            "33..33......33....................33....333333......33....33....",
            "33..33......33....33......33......33..............33............",
            "333333..333333....33......33........33............33......33....",
            "..........................33...................................."
        },
        ; @ A B C D E F G
        {
            "..3333..333333..3333....333333..3333....333333..333333..333333..",
            "33..33..33..33..33..33..33......33..33..33......33......33......",
            "33..33..33..33..33..33..33......33..33..33......33......33......",
            "33......333333..3333....33......33..33..3333....3333....33......",
            "33..33..33..33..33..33..33......33..33..33......33......33..33..",
            "33......33..33..33..33..33......33..33..33......33......33..33..",
            "..3333..33..33..3333....333333..3333....333333..33......333333..",
            "................................................................"
        },
        ; H I J K L M N O
        {
            "33..33..333333..333333..33..33..33......33..33..33..33..333333..",
            "33..33....33........33..33..33..33......333333..33..33..33..33..",
            "33..33....33........33..3333....33......33..33..333333..33..33..",
            "333333....33........33..3333....33......33..33..333333..33..33..",
            "33..33....33....33..33..33..33..33......33..33..333333..33..33..",
            "33..33....33....33..33..33..33..33......33..33..33..33..33..33..",
            "33..33..333333..333333..33..33..333333..33..33..33..33..333333..",
            "................................................................"
        },
        ; P Q R S T U V W
        {
            "333333..333333..333333..333333..333333..33..33..33..33..33..33..",
            "33..33..33..33..33..33..33........33....33..33..33..33..33..33..",
            "33..33..33..33..33..33..33........33....33..33..33..33..33..33..",
            "333333..33..33..333333..333333....33....33..33..33..33..33..33..",
            "33......33..33..3333........33....33....33..33..333333..333333..",
            "33......3333....33..33......33....33....33..33....33....333333..",
            "33..........33..33..33..333333....33....333333....33....33..33..",
            "................................................................"
        },
        ; X Y Z [ \ ] ^ _
        {
            "33..33..33..33..333333..333333............3333......3333........",
            "33..33..33..33......33..33......33..........33....33............",
            "..33....333333......33..33........33........33..33..3333........",
            "..33......33......33....33........33........33..33..33..........",
            "..33......33....33......33..........33......33..33..3333........",
            "33..33....33....33......33..........33......33....33............",
            "33..33....33....333333..333333............3333......3333........",
            "........................................................33333333"
        },
        ; ` a b c d e f g
        {
            "..3333..........33..................33............3333..........",
            "..3333..........33..................33............33............",
            "..33....333333..333333..333333..333333..333333....33....333333..",
            "333333......33..33..33..33......33..33..33..33..333333..33..33..",
            "..33....333333..33..33..33......33..33..333333....33....33..33..",
            "..33....33..33..33..33..33......33..33..33........33....333333..",
            "333333..333333..333333..333333..333333..333333....33........33..",
            "........................................................333333.."
        },
        ; h i j k l m n o
        {
            "33........33......33....33......3333............................",
            "33......................33........33............................",
            "333333..3333......33....33..33....33....33..33..333333..333333..",
            "33..33....33......33....33..33....33....333333..33..33..33..33..",
            "33..33....33......33....3333......33....33..33..33..33..33..33..",
            "33..33....33......33....33..33....33....33..33..33..33..33..33..",
            "33..33..333333....33....33..33..333333..33..33..33..33..333333..",
            "................3333............................................"
        },
        ; p q r s t u v w
        {
            "..................................33............................",
            "..................................33............................",
            "333333..333333..333333..333333..333333..33..33..33..33..33..33..",
            "33..33..33..33..33......33........33....33..33..33..33..33..33..",
            "33..33..33..33..33......333333....33....33..33..33..33..33..33..",
            "333333..333333..33..........33....33....33..33..33..33..333333..",
            "33..........33..33......333333....3333..333333....33....33..33..",
            "33..........33.................................................."
        },
        ; x y z { | } ~ DEL
        {
            "............................33....33......33....33..............",
            "..........................33......33......33......33............",
            "33..33..33..33..333333....33......33......33....33..33..........",
            "33..33..33..33......33..3333................33......33..........",
            "..33....33..33....33......33......33......33....33..33..........",
            "33..33..333333....33......33......33......33......33............",
            "33..33......33..333333......33....33......33....33..............",
            "........333333.................................................."
        }
    })

; Bit 7 set while each window is open (and its background saved). start
; clears all twenty bytes; only WINDOWS exist.
.window_open
    SKIP 20

; The screen address of each pair of pixel rows of the editing grid.
.grid_row_address
    EQUW edit_grid + (0..15) * ROW

; Each window's top left corner on the screen...
.window_address
    EQUW SCREEN                     ; OptionsA
    EQUW SCREEN + 8*CELL            ; OptionsB
    EQUW SCREEN + 16*CELL           ; Environment
    EQUW SCREEN + 24*CELL           ; credits
    EQUW SCREEN + 21*ROW + 4*CELL   ; pick a sprite; Animate
    EQUW SCREEN + 22*ROW + 4*CELL   ; questions
    EQUW SCREEN + 22*ROW + 2*CELL   ; names
    EQUW SCREEN + 14*ROW + 12*CELL  ; errors

; ...and its width in bytes less one, and its height in character rows.
.window_size
    EQUB 8*CELL-1, 8
    EQUB 8*CELL-1, 8
    EQUB 11*CELL-1, 8
    EQUB 16*CELL-1, 6
    EQUB 14*CELL-1, 7
    EQUB 8*CELL-1, 6
    EQUB 16*CELL-1, 7
    EQUB 16*CELL-1, 6
ASSERT window_size - window_address = 2 * WINDOWS

; Point at a window.
; In:  A = window number (only bits 0-2 count)
; Out: screen_ptr and aux_ptr = its corner on the screen, save_ptr =
;      window_store, count_x = width in bytes less one, count_y = height in
;      rows, Y = window number * 2
; Clobbers: A
.window_setup
{
    AND #WINDOWS - 1
    ASL A
    TAY
    LDA #HI(window_store)
    STA save_ptr+1
    LDA window_address, Y
    STA screen_ptr
    STA aux_ptr
    LDA window_address+1, Y
    STA screen_ptr+1
    STA aux_ptr+1
    LDA #LO(window_store)
    STA save_ptr
    LDA window_size, Y
    STA count_x
    LDA window_size+1, Y
    STA count_y
    RTS
}

; Open a window and write its text in it. Any open window is closed first,
; so they never overlap; what the window covers is kept at window_store, and
; it is filled with colour 1 for the title row and colour 3 below, then
; print_window_text writes the text and draws the frame.
; In:  A = window number (bit 7 ignored), X/Y = its text (see TEXT_END)
; Out: screen_ptr = just after the text's last character, line_count =
;      lines in the text less one, mask = the text's flag byte
; Clobbers: A, X, Y, data_ptr, save_ptr, aux_ptr, border_ptr, count_x,
;      count_y
.open_window
{
    STX data_ptr
    STY data_ptr+1
    AND #&7F
    PHA
    LDA #WINDOWS - 1

    ; Close every window, the last first.
.close_others
    PHA
    TAX
    JSR close_window
    PLA
    SEC
    SBC #&01
    BCS close_others
    PLA
    PHA
    TAX
    ORA #&80                        ; bit 7: open
    STA window_open, X
    JSR window_setup
    LDX #mode5_byte("1111")         ; the title row in colour 1
.fill_row
    LDY count_x
.fill_byte
    LDA (screen_ptr), Y
    STA (save_ptr), Y
    TXA
    STA (screen_ptr), Y
    DEY
    BPL fill_byte
    LDX #mode5_byte("3333")         ; and the rest in colour 3
    JSR next_window_row
    DEC count_y
    BNE fill_row
    LDA aux_ptr
    STA save_ptr
    STA screen_ptr
    LDA aux_ptr+1
    STA save_ptr+1
    STA screen_ptr+1
    PLA
}

; Write a window's text (open_window's second half), exclusive-ORing it on
; in colour 3, so that writing it again rubs it out; then draw the window's
; frame in colour 2: a line down its right edge below the title row, and
; along its bottom.
; In:  A = window number, data_ptr = the text, screen_ptr and save_ptr = its
;      corner, count_x = its width in bytes less one
; Out: screen_ptr = just after the text's last character, line_count =
;      lines less one, mask = the flag byte
; Clobbers: A, X, Y, data_ptr, save_ptr, aux_ptr, border_ptr, count_y
.print_window_text
{
    PHA
    LDY #&FF
    STY line_count
    INY
    LDA (data_ptr), Y
    STA mask
.next_char
    INC data_ptr
    BNE read_char
    INC data_ptr+1
.read_char
    LDY #&00
    LDA (data_ptr), Y
    CMP #TEXT_END
    BEQ frame
    CMP #CR
    BEQ new_line
    CLC
    JSR print_char_advance          ; carry clear: exclusive-OR the glyph on
    BNE next_char                   ; always: the pointer's last change left it non-zero
.new_line
    INC line_count
    LDA save_ptr                    ; save_ptr: the start of the line
    CLC
    ADC #LO(ROW)
    STA save_ptr
    STA screen_ptr
    LDA save_ptr+1
    ADC #HI(ROW)
    STA save_ptr+1
    STA screen_ptr+1
    BCC next_char

    ; The frame: the rightmost pixel of each row, then the bottom line.
.frame
    PLA
    AND #WINDOWS - 1
    ASL A
    TAY
    LDA window_address, Y
    STA border_ptr
    LDA window_address+1, Y
    STA border_ptr+1
    LDA window_size+1, Y
    SBC #&00                        ; carry clear from the ASL, so count_y = rows - 1
    STA count_y
.frame_row
    LDY count_x
    LDX #&07
    LDA border_ptr
    CLC
    ADC #LO(ROW)
    STA border_ptr
    LDA border_ptr+1
    ADC #HI(ROW)
    STA border_ptr+1
.frame_right
    LDA (border_ptr), Y
    AND #mode5_byte("333.")         ; pixel 3 becomes colour 2
    ORA #mode5_byte("...2")
    STA (border_ptr), Y
    DEY
    DEX
    BPL frame_right
    DEC count_y
    BNE frame_row
    LDY count_x                     ; the bottom line of each cell of the last row
.frame_bottom
    LDA #mode5_byte("2222")
    STA (border_ptr), Y
    TYA
    SEC
    SBC #CELL
    TAY
    BCS frame_bottom
    RTS
}

; Step both of a window's pointers down a row: save_ptr past the bytes
; just kept, screen_ptr to the next character row. Also entered at
; next_screen_row to step screen_ptr alone.
; In:  count_x = the window's width in bytes less one
; Clobbers: A
.next_window_row
{
    LDA save_ptr
    SEC
    ADC count_x
    STA save_ptr
    BCC next_screen_row
    INC save_ptr+1
.next_screen_row
    LDA screen_ptr
    CLC
    ADC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(ROW)
    STA screen_ptr+1
    RTS
}

; Close every window.
; Clobbers: A, X, Y, screen_ptr, save_ptr, aux_ptr, count_x, count_y
.close_all_windows
{
    LDX #WINDOWS - 1
.loop
    TXA
    PHA
    JSR close_window
    PLA
    TAX
    DEX
    BPL loop
    RTS
}

; Close a window, if it is open, putting back what it covered.
; In:  A = window number (bit 7 ignored)
; Clobbers: A, X, Y, screen_ptr, save_ptr, aux_ptr, count_x, count_y
.close_window
{
    AND #&7F
    PHA
    TAY
    LDA window_open, Y
    BMI open
    PLA
    RTS
.open
    PLA
    PHA
    JSR window_setup
.row
    LDY count_x
.byte
    LDA (save_ptr), Y
    STA (screen_ptr), Y
    DEY
    BPL byte
    JSR next_window_row
    DEC count_y
    BNE row
    PLA
    TAX
    LDA #&00
    STA window_open, X
    RTS
}

; Is a key pressed?
; In:  X = INKEY_TEST() of the key
; Out: A = X = &FF and N set if it is, 0 and N clear if not
; Clobbers: Y
.key_pressed
{
    LDA #OSBYTE_INKEY
    TAY                             ; Y >= &80: scan for one key
    JSR OSBYTE
    TXA
    RTS
}

; Wait until a key is released, so one press does one thing.
; In:  X = INKEY_TEST() of the key
; Clobbers: A, Y
.wait_key_release
{
    TXA
    PHA
    JSR key_pressed
    TAY
    PLA
    TAX
    INY
    BEQ wait_key_release
    RTS
}

; Draw a character and step screen_ptr on to the next cell.
; In:  A = character, carry set to store it, clear to exclusive-OR it
; Out: Z clear
; Clobbers: A, aux_ptr
.print_char_advance
{
    JSR print_char
    LDA screen_ptr
    CLC
    ADC #CELL
    STA screen_ptr
    BCC done
    INC screen_ptr+1
.done
    RTS
}

; Draw a character from the font at screen_ptr, a cell of it.
; In:  A = character (a control code draws a space), carry set to store it
;      (in colour 3 on black), clear to exclusive-OR it with the screen (on
;      a window, so drawing it again rubs it out)
; Clobbers: A, aux_ptr
.print_char
{
    PHP
    STY saved_y
    STX saved_x
    LDY #&00
    STY aux_ptr+1
    LDX #&00
    CMP #ascii(" ")
    BCS printable
    LDA #ascii("!")                 ; a control code: a space (carry is clear)
.printable
    SBC #ascii(" ")                 ; aux_ptr = font + 8 * (A - " ")
    ASL A
    ASL A
    ROL aux_ptr+1
    ASL A
    ROL aux_ptr+1
    TAX
    LDA aux_ptr+1
    ADC #HI(font)                   ; the font starts a page
    TAY
    STX aux_ptr
    STY aux_ptr+1
    PLP
    LDY #&07
.row
    LDA (aux_ptr), Y
    BCS store
    EOR (screen_ptr), Y
.store
    STA (screen_ptr), Y
    DEY
    BPL row
    LDX saved_x
    LDY saved_y
    RTS
.saved_x
    EQUB &00
.saved_y
    EQUB &00
}

; Open a window and let the user pick from it: a menu. While it runs, the
; cursor keys give codes and the function keys KEYCODE_F0 up; leaving with Space,
; Escape or another function key puts the function keys back to strings, but
; picking with Return doesn't.
; In:  A = window number, X/Y = its text; if the text's flag is MENU the lines
;      after the title are a list to move along with the cursor keys
; Out: A = X = the line picked with Return (1 = the first after the title,
;      0 if the text has no list), or &FF if left with Space, Escape or
;      another menu's function key
; Clobbers: Y, and as open_window
.menu
{
    PHA
    JSR open_window
    PLA
    PHA
    AND #WINDOWS - 1                ; count_y = this window's number, for the function key test
    STA count_y
    ASL A
    TAY
    LDA window_address, Y
    STA screen_ptr
    LDA window_address+1, Y
    STA screen_ptr+1
    JSR next_window_row.next_screen_row
    LDA #&FF
    STA item
    BIT mask
    BPL no_list
    JSR invert_menu_row
    INC item
.no_list
    LDA #OSBYTE_CURSOR_EDITING      ; the cursor keys give codes
    LDX #CURSOR_KEYS_CODES
    JSR OSBYTE
    LDA #OSBYTE_FUNCTION_KEY_BASE   ; f0-f9 give KEYCODE_F0 up
    LDX #KEYCODE_F0
    LDY #&00
    JSR OSBYTE
.read_key
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    LDX #&00
    JSR OSBYTE
    JSR OSRDCH
    BCC got_key
.cancel
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE  ; if there was an Escape
    JSR OSBYTE
    LDA #OSBYTE_FUNCTION_KEY_BASE   ; function keys back to strings
    LDX #FUNCTION_KEYS_STRINGS
    LDY #&00
    JSR OSBYTE
    PLA
    JSR close_window
    LDX #&FF
    TXA
    RTS
.got_key
    CMP #FUNCTION_KEY_CODES         ; a function key (f4-f9 repeat f0-f3)...
    BCC not_fkey
    AND #&03
    CMP count_y                     ; ...other than this menu's own closes it
    BNE cancel
.not_fkey
    CMP #ascii(" ")
    BEQ cancel
    CMP #CR
    BEQ chosen
    BIT mask
    BPL read_key
    CMP #KEYCODE_DOWN
    BEQ down
    CMP #KEYCODE_UP
    BNE read_key
    LDA item
    BEQ read_key
    JSR invert_menu_row
    DEC item
    LDA screen_ptr                  ; carry is set from the CMP
    SBC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    SBC #HI(ROW)
    STA screen_ptr+1
    BCS highlight                   ; always
.down
    LDA item
    CLC
    ADC #&01
    CMP line_count
    BEQ read_key
    JSR invert_menu_row
    INC item
    JSR next_window_row.next_screen_row
.highlight
    JSR invert_menu_row
    JMP read_key
.chosen
    PLA
    JSR close_window
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    LDX #&00
    JSR OSBYTE
    LDX #INKEY_TEST(KEY_RETURN)
    JSR wait_key_release
    LDX item
    INX
    TXA
    RTS
}

; Highlight or unhighlight a line of a window by exclusive-ORing colour 1
; into every pixel (red and yellow, black and blue change places), then
; put back the frame's right edge, which that changed too.
; In:  screen_ptr = the line, count_x = the window's width in bytes less one
; Clobbers: A, X, Y
.invert_menu_row
{
    LDY count_x
.invert
    LDA (screen_ptr), Y
    EOR #mode5_byte("1111")
    STA (screen_ptr), Y
    DEY
    BPL invert
    LDY count_x
    LDX #&07
.border
    LDA (screen_ptr), Y
    AND #mode5_byte("333.")         ; pixel 3 becomes colour 2
    ORA #mode5_byte("...2")
    STA (screen_ptr), Y
    DEY
    DEX
    BPL border
    RTS
}

; A sprite's size from its number.
; In:  A = sprite number
; Out: sprite_width = SMALL_WIDTH for the small sprites (&10-&1F), else
;      LARGE_WIDTH; data_ptr = graphics (where sprite_address starts from)
; Clobbers: X
.sprite_class
{
    LDX #LO(graphics)
    STX data_ptr
    LDX #HI(graphics)
    STX data_ptr+1
    LDX #LARGE_WIDTH
    CMP #FIRST_SMALL
    BCC store
    CMP #AFTER_SMALL
    BCS store
    LDX #SMALL_WIDTH
.store
    STX sprite_width
    RTS
}

; Find a sprite's bytes.
; In:  A = sprite number: a sheet position (see slot_of_position), or a slot
;      while by_slot has bit 7 set; SPRITE_FRAME_A and SPRITE_FRAME_B (with
;      or without bit 7) are the two frame buffers
; Out: data_ptr = its first byte, sprite_width = its width in bytes, A = Y =
;      the sprite number
; Clobbers: X
.sprite_address
{
    TAY
    JSR sprite_class
    CMP #SPRITE_FRAME_A             ; a frame buffer
    BCS frame
    TAY
    AND #&10                        ; &10-&1F: small
    BNE small
    TYA
    BIT by_slot
    BMI slot
    CMP #AFTER_SMALL                ; positions &20-&28 follow &00-&0F in the table
    BCC mapped
    SBC #AFTER_SMALL - FIRST_SMALL
.mapped
    TAX
    LDA slot_of_position, X

    ; Large slots &00-&0F are at graphics + slot * LARGE_SPRITE_SIZE, half a
    ; page each; &20-&28 the same from SET_MORE_LARGE.
.slot
    CMP #MORE_LARGE_SLOT
    BCS high_slot
    LSR A
    TAX
    LDA #&00                        ; the odd half page
    ROR A
    STA data_ptr
    TXA
    ADC data_ptr+1
    STA data_ptr+1
    TYA
    RTS
.frame
    AND #&7F
    CMP #SPRITE_FRAME_B             ; carry set for the second buffer...
    LDA #&00
    ROR A                           ; ...the half page after the first
    STA data_ptr
    LDA #HI(frame_a)
    STA data_ptr+1
    TYA
    RTS
.high_slot
    AND #&0F
    TAX
    LDA data_ptr+1
    CLC
    ADC #HI(SET_MORE_LARGE)
    STA data_ptr+1
    TXA
    JMP slot

    ; Small slots are at graphics + SET_SMALL + (slot AND &0F) *
    ; SMALL_SPRITE_SIZE.
.small
    TYA
    PHA
    LDA data_ptr+1
    CLC
    ADC #HI(SET_SMALL)
    STA data_ptr+1
    PLA
    ASL A                           ; times SMALL_SPRITE_SIZE (the &10 bit falls off)
    ASL A
    ASL A
    ASL A
    ASL A
    BCC small_done
    INC data_ptr+1
.small_done
    CLC
    ADC data_ptr
    STA data_ptr
    TYA
    RTS
}
ASSERT LO(graphics) = 0 AND LO(frame_a) = 0
ASSERT LARGE_SPRITE_SIZE = &80 AND SMALL_SPRITE_SIZE = 1 << 5
ASSERT LO(SET_SMALL) = 0 AND LO(SET_MORE_LARGE) = 0

; The offset of the last byte of a sprite of sprite_width.
; In:  sprite_width
; Out: Y = LARGE_SPRITE_SIZE - 1 or SMALL_SPRITE_SIZE - 1
; Clobbers: X
.sprite_last_byte
{
    LDY #LARGE_SPRITE_SIZE - 1
    LDX sprite_width
    CPX #SMALL_WIDTH
    BNE done
    LDY #SMALL_SPRITE_SIZE - 1
.done
    RTS
}

; The byte that fills four MODE 5 pixels with each colour, 0-3.
.colour_byte
    EQUB mode5_byte("...."), mode5_byte("1111"), mode5_byte("2222"), mode5_byte("3333")

; How far draw_grid steps back on the screen after a column of sprite bytes:
; up to the top of the grid and four cells (pixels) right. Indexed by
; sprite_width: small, then large.
.grid_back_step
    EQUW SMALL_SPRITE_HEIGHT/2 * ROW - 4*CELL
    EQUW LARGE_SPRITE_HEIGHT/2 * ROW - 4*CELL

; Draw a sprite magnified in the editing grid: each pixel a cell wide and
; four lines tall, two sprite rows to a character row. Then draw the grid's
; frame, unless the frame for this size is there already.
; In:  A = sprite number, bit 7 set to copy the sprite to undo_buffer first
;      (a new sprite to edit)
; Clobbers: A, X, Y, screen_ptr, data_ptr, temp, count_x, count_y, item,
;      mask, sprite_width
.draw_grid
{
    ASL A
    PHP
    LSR A
    JSR sprite_address
    PLP
    BCC draw
    JSR sprite_last_byte
.keep
    LDA (data_ptr), Y
    STA undo_buffer, Y
    DEY
    BPL keep
.draw
    LDA #LO(edit_grid)
    STA screen_ptr
    LDA #HI(edit_grid)
    STA screen_ptr+1
    LDA sprite_width
    STA count_x
.column
    LDA sprite_width                ; count_y = the column's bytes, one a row
    ASL A
    ASL A
    ASL A
    STA count_y
.byte
    LDY #&00
    LDA (data_ptr), Y
    STA temp
    LDX #mode5_byte("3...")         ; the first pixel's bits
    STX mask

    ; Shift this pixel's two bits down to make its colour, 0-3.
.pixel
    LDA mask
    STA item
    LDA temp
    AND mask
.find_bit
    LSR item
    BCS got_bit
    LSR A
    BCC find_bit
.got_bit
    LSR A
    PHP
    LSR A
    LSR A
    LSR A
    PLP
    ROL A
    TAX
    LDY #&03                        ; the top four lines of the character row...
    LDA #&01
    BIT count_y
    BEQ block
    LDY #&07                        ; ...or, for every second sprite row, the bottom four
.block
    LDA colour_byte, X
    LDX #&03
.block_line
    STA (screen_ptr), Y
    DEY
    DEX
    BPL block_line
    LDA screen_ptr                  ; carry clear from the ROL
    ADC #CELL
    STA screen_ptr
    BCC next_pixel
    INC screen_ptr+1
.next_pixel
    LSR mask
    BCC pixel
    LDA screen_ptr                  ; carry set from the LSR: back to this byte's
    SBC #4*CELL                     ; first cell
    STA screen_ptr
    BCS pixel_done
    DEC screen_ptr+1
.pixel_done
    LDA #&01                        ; after a bottom half, down a row
    AND count_y
    BEQ next_byte
    LDA screen_ptr
    CLC
    ADC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(ROW)
    STA screen_ptr+1
.next_byte
    INC data_ptr
    DEC count_y
    BNE byte

    ; Up to the top of the grid, one column of sprite bytes to the right.
    LDX sprite_width
    LDA screen_ptr
    SEC
    SBC grid_back_step-2, X
    STA screen_ptr
    LDA screen_ptr+1
    SBC grid_back_step-1, X
    STA screen_ptr+1
    DEC count_x
    BEQ frame
    JMP column

    ; The frame: a large sprite's grid is 16 cells by 16 rows, a small one's
    ; 8 by 8 in the top left of that, with the rest blanked. A byte of each
    ; frame tells which one is on the screen already.
.frame
    LDA sprite_width
    CMP #LARGE_WIDTH
    BEQ large
    LDA grid_frame_top
    CMP #mode5_byte("1...")
    BNE to_small
    RTS
.to_small
    LDA #LO(SCREEN + 10*CELL)       ; blank the large grid's right half...
    STA screen_ptr
    LDA #HI(SCREEN + 10*CELL)
    STA screen_ptr+1
    LDA #18                         ; rows
    JSR clear_rows
    LDA #LO(SCREEN + 9*ROW + CELL)  ; ...and the rest of its left half
    STA screen_ptr
    LDA #HI(SCREEN + 9*ROW + CELL)
    STA screen_ptr+1
    LDA #9
    JSR clear_rows
.large
    LDA sprite_width
    CMP #LARGE_WIDTH
    BNE draw_frame
    LDA grid_frame_right
    CMP #mode5_byte("1...")
    BNE draw_frame
    RTS

    ; The top line, the left edge, the bottom line, then the right edge, in
    ; colour 1.
.draw_frame
    LDA #LO(SCREEN + CELL)          ; the row above the grid, a cell left of it
    STA screen_ptr
    LDA #HI(SCREEN + CELL)
    STA screen_ptr+1
    LDY #&07                        ; its last line
    JSR grid_frame_line
    LDA #mode5_byte("...1")         ; the top left corner
    STA (screen_ptr), Y
    JSR down_a_row
    LDA sprite_width                ; count_y = the grid's rows
    ASL A
    ASL A
    STA count_y
.left_column
    LDA #mode5_byte("...1")         ; the left edge
    LDY #&07
.left_line
    STA (screen_ptr), Y
    DEY
    BPL left_line
    JSR down_a_row
    DEC count_y
    BNE left_column
    LDA #mode5_byte("...1")         ; the bottom left corner, on the row's first line
    INY
    STA (screen_ptr), Y
    JSR grid_frame_line
    JSR width_times_32              ; across to the cell after the grid
    ADC #CELL
    ADC screen_ptr
    STA screen_ptr
    BCC right_side
    INC screen_ptr+1
.right_side
    LDA sprite_width
    ASL A
    ASL A
    STA count_y
.right_column
    LDA screen_ptr                  ; up a row
    SEC
    SBC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    SBC #HI(ROW)
    STA screen_ptr+1
    LDY #&07
    LDA #mode5_byte("1...")         ; the right edge
.right_line
    STA (screen_ptr), Y
    DEY
    BPL right_line
    DEC count_y
    BNE right_column
    RTS
}

; Draw a horizontal line of the editing grid's frame in colour 1: the corner,
; a pixel at the left of the cell after the grid, then back along every cell
; over (or under) the grid.
; In:  Y = the line within the character row, screen_ptr = the row, at the
;      cell left of the grid
; Out: Y = that line in the cell left of the grid
; Clobbers: A, X, temp
.grid_frame_line
{
    STY temp
    JSR width_times_32              ; the cell after the grid
    ORA temp
    ADC #CELL
    TAY
    LDX #mode5_byte("1...")         ; the corner first...
.loop
    TXA
    STA (screen_ptr), Y
    LDX #mode5_byte("1111")         ; ...then the line
    TYA
    SEC
    SBC #CELL
    TAY
    CMP #CELL
    BCS loop
    RTS
}

; Move screen_ptr down a character row.
; Clobbers: A
.down_a_row
{
    LDA screen_ptr
    CLC
    ADC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(ROW)
    STA screen_ptr+1
    RTS
}

; sprite_width times 32: the editing grid's width in bytes, 128 for a large
; sprite (16 cells), 64 for a small one.
; In:  sprite_width
; Out: A = the result, carry clear
; Clobbers: nothing else
.width_times_32
{
    LDA sprite_width
    LSR A
    ROR A
    ROR A
    ROR A
    RTS
}

; Blank nine cells (72 bytes) of each of A character rows from screen_ptr.
; It has no RTS of its own: it runs on into divide_by_5, which does no harm
; (it just divides the last A), and returns from there.
; In:  A = rows, screen_ptr = where
; Clobbers: A, X, Y, screen_ptr, count_y
.clear_rows
{
    STA count_y
.row
    LDY #9*CELL-1
    LDA #&00
.byte
    STA (screen_ptr), Y
    DEY
    BPL byte
    JSR down_a_row
    DEC count_y
    BNE row
}

; Divide by five: a large sprite's row and column in the sheet.
; In:  A = an index into slot_of_position (a position &00-&0F, or &20-&28
;      less &10)
; Out: X = A DIV 5, A = A MOD 5
; Clobbers: nothing else
.divide_by_5
{
    LDX #&00
.loop
    CMP #LARGE_COLUMNS
    BCC done
    INX
    SBC #LARGE_COLUMNS
    BCS loop
.done
    RTS
}

; Draw a sprite in its place on the sheet, copying its bytes straight to the
; screen a cell (eight bytes of a column) at a time. Also entered at
; at_screen_ptr, with data_ptr, sprite_width and screen_ptr set, to draw one
; somewhere else.
; In:  A = sprite number
; Out: carry clear
; Clobbers: A, X, Y, screen_ptr, data_ptr, count_x, count_y, sprite_width
.draw_sheet_sprite
{
    JSR sprite_address
    JSR sheet_address
.at_screen_ptr
    LDX sprite_width
    STX count_y
.row
    LDX sprite_width
    STX count_x
.column
    LDY #&07
.byte
    LDA (data_ptr), Y
    STA (screen_ptr), Y
    DEY
    BPL byte
    LDA sprite_width                ; the same eight rows of the next column
    ASL A
    ASL A
    ASL A
    ADC data_ptr
    STA data_ptr
    BCC next_screen
    INC data_ptr+1
.next_screen
    LDA #CELL
    CLC
    ADC screen_ptr
    STA screen_ptr
    BCC next_column
    INC screen_ptr+1
.next_column
    DEC count_x
    BNE column

    ; Back to the first column, eight rows down; on the screen, down a row.
    LDA sprite_width
    LSR A
    TAX                             ; 1 small, 2 large
    LDA data_ptr
    SEC
    SBC column_rewind-1, X
    STA data_ptr
    BCS next_row
    DEC data_ptr+1
.next_row
    LDA screen_ptr
    CLC
    ADC row_step-1, X
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(ROW - SMALL_WIDTH*CELL) ; the same for both
    STA screen_ptr+1
    DEC count_y
    BNE row
    RTS
; How far draw_sheet_sprite steps back through a sprite after a row of
; cells, and on through the screen to the start of the next row (the low
; byte), indexed by sprite_width / 2: small, then large.
.column_rewind
    EQUB SMALL_SPRITE_SIZE - CELL, LARGE_SPRITE_SIZE - CELL
.row_step
    EQUB LO(ROW - SMALL_WIDTH*CELL), LO(ROW - LARGE_WIDTH*CELL)
    EQUB 0                          ; unused
}
ASSERT HI(ROW - SMALL_WIDTH*CELL) = HI(ROW - LARGE_WIDTH*CELL)

; Where a sprite goes on the screen.
; In:  A = sprite number: a sheet position, or a frame buffer (which shows
;      in Animate's window)
; Out: screen_ptr = the top left of its place, A = Y = the sprite number
; Clobbers: X
.sheet_address
{
    TAY
    LDX #&00
    STX screen_ptr+1
    CPY #FIRST_SMALL
    BCC large
    CPY #AFTER_SMALL
    BCC small
    SBC #AFTER_SMALL - FIRST_SMALL  ; (carry set) an index into slot_of_position...
    CMP #SPRITE_FRAME_A - (AFTER_SMALL - FIRST_SMALL)   ; ...unless a frame buffer
    BCS preview

    ; Large sprites: 5 to a row, each 4 cells by 4 rows.
.large
    JSR divide_by_5
    LSR A                           ; the column times 32: four cells
    ROR A
    ROR A
    ROR A
    ADC #LO(large_sheet)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(large_sheet)
.add_rows
    DEX
    BMI done
    ADC #HI(LARGE_SPRITE_HEIGHT/8 * ROW)    ; a row of sprites
    BCC add_rows                    ; always
.done
    STA screen_ptr+1
    TYA
    RTS

    ; Small sprites: 4 to a row, each 2 cells by 2 rows, 4 cells apart.
.small
    AND #&03                        ; the column times 32
    LSR A
    ROR A
    ROR A
    ROR A
    STA screen_ptr
    TYA
    LSR A
    LSR A
    AND #&03
    TAX                             ; the row
.small_rows
    DEX
    BMI small_base
    LDA screen_ptr
    CLC
    ADC #LO(SMALL_SPRITE_HEIGHT/8 * ROW)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(SMALL_SPRITE_HEIGHT/8 * ROW)
    STA screen_ptr+1
    BCC small_rows                  ; always
.small_base
    LDA screen_ptr
    CLC
    ADC #LO(small_sheet)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(small_sheet)
    STA screen_ptr+1
    RTS
.preview
    LDA #LO(frame_preview)
    STA screen_ptr
    LDA #HI(frame_preview)
    STA screen_ptr+1
    TYA
    RTS
}
ASSERT LO(LARGE_SPRITE_HEIGHT/8 * ROW) = 0

; An RTS nothing uses.
.stray_rts
{
    RTS
}

; The event handler, for Escape (event 6). With the event enabled the MOS
; leaves setting the Escape flag to the handler (it sets it itself only
; when the event is disabled), so this sets it; and when SHIFT is held, the
; latch too. A menu or prompt that sees the Escape acknowledges it, so plain
; Escape there just cancels; the latch makes SHIFT-Escape cancel and then
; offer to leave as well. Other events aren't passed on.
; In:  A = event number
; Clobbers: nothing
.escape_event
{
    PHP
    CMP #EVENT_ESCAPE
    BNE other_event
    ROR MOS_ESCAPE_FLAG             ; carry is set from the CMP: bit 7 of the flag
    TXA
    PHA
    TYA
    PHA
    LDX #INKEY_TEST(KEY_SHIFT)
    JSR key_pressed
    BPL not_shift
    STA escape_latch                ; A = &FF
.not_shift
    PLA
    TAY
    PLA
    TAX
    LDA #EVENT_ESCAPE
.other_event
    PLP
    RTS
}

; VDU codes for the screen's furniture: clear it, and draw boxes in blue
; round the colour swatch and the name box under the editing grid.
; LAYOUT_END ends the list.
LAYOUT_END = &EA
.screen_layout
    EQUB VDU_RESET_WINDOWS, VDU_CLS
    EQUB VDU_GCOL, 0, 1                             ; draw in colour 1
    EQUB VDU_PLOT, PLOT_MOVE : EQUW 24, 380         ; round the colour swatch
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW 0, 36
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW 72, 0
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW 0, -36
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW -72, 0
    ; Text only in the top 18 rows, so that the CLS on tape (for the filing
    ; system's messages) leaves these boxes and the logo alone.
    EQUB VDU_TEXT_WINDOW, 0, 17, 19, 0
    EQUB VDU_PLOT, PLOT_MOVE_RELATIVE : EQUW 96, 4  ; round the name box
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW 0, 32
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW 488, 0
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW 0, -36
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW -488, 0
    EQUB LAYOUT_END

; The names of the physical colours, eight characters each, for the palette
; window (it shows seven of each).
.colour_names
    EQUS "Black   Red     Green   Yellow  Blue    Magenta Cyan    White   "

; Window text. The first byte is the flag (MENU or PLAIN), then lines ending
; CR; TEXT_END ends it. The windows that ask for a second sprite leave their
; title line empty, and pick_second_sprite draws the first sprite to the
; right of the short lines below it.
.text_copy
    EQUB PLAIN, CR
    EQUS "Select sprite", CR, "to", CR, "copy", CR, "this", CR, "onto", CR
    EQUB TEXT_END
.text_overlay
    EQUB PLAIN, CR
    EQUS "Select sprite", CR, "to", CR, "overlay", CR, "this", CR, "onto", CR
    EQUB TEXT_END
.text_options_a
    EQUB MENU
    EQUS "OptionsA", CR
    EQUS "Flip X", CR, "Flip Y", CR, "Delete", CR, "Undo", CR, "Animate", CR, "Obj name", CR
    EQUB TEXT_END
.text_options_b
    EQUB MENU
    EQUS "OptionsB", CR
    EQUS "Swap", CR, "Copy", CR, "Overlay", CR, "Underlay", CR, "Remove", CR, "Backing", CR
    EQUB TEXT_END
.text_environment
    EQUB MENU
    EQUS "Environment", CR
    EQUS "Load Sprite", CR, "Save Sprite", CR, "Load File", CR, "Save File", CR, "Def. Colour", CR
    EQUB TEXT_END
.text_credits                       ; "^~" is a copyright sign in this font
    EQUB PLAIN
    EQUS "    PIPELINE", CR
    EQUS " ---===++===--- ", CR
    EQUS "Written by & ^~", CR
    EQUS "  WILLIAM REEVE", CR
    EQUS "and  IAN HOLMES", CR
    EQUS " ---===++===---", CR
    EQUB TEXT_END
.text_escape_error                  ; unused
    EQUB PLAIN
    EQUS "E  R  R  O  R", CR, CR, "E  S  C  A  P  E", CR
    EQUB TEXT_END
.text_no_such_file
    EQUB PLAIN
    EQUS "E  R  R  O  R", CR, CR, "No Such File", CR
    EQUB TEXT_END
.text_bad_file
    EQUB PLAIN
    EQUS "E  R  R  O  R", CR, CR, "   Bad File", CR
    EQUB TEXT_END
.text_wrong_types
    EQUB PLAIN
    EQUS "E  R  R  O  R", CR, "Wrong Types", CR
    EQUB TEXT_END
.text_swap
    EQUB PLAIN, CR
    EQUS "Select sprite", CR, "to", CR, "swap", CR, "with", CR
    EQUB TEXT_END
.text_active_colour                 ; unused
    EQUB MENU
    EQUS "ActiCol", CR
    EQUS REPEATED(7, "       " + CHR(CR))
    EQUB TEXT_END
; The palette window: show_palette writes the colour names into the blank
; lines, PALETTE_LINE bytes apart.
PALETTE_LINE = 8
.text_palette
    EQUB MENU
    EQUS "Colour ", CR
.palette_lines
    EQUS REPEATED(4, "       " + CHR(CR))
    EQUB TEXT_END
.text_remove
    EQUB PLAIN, CR
    EQUS "Select sprite", CR, "to", CR, "take", CR, "this", CR, "from", CR
    EQUB TEXT_END
.text_underlay
    EQUB PLAIN, CR
    EQUS "Select sprite", CR, "to", CR, "put", CR, "this", CR, "under", CR
    EQUB TEXT_END
.text_animation
    EQUB PLAIN
    EQUS "   ANIMATION", CR
    EQUB TEXT_END
.text_exists
    EQUB MENU
    EQUS "Exists", CR, "Cancel", CR, "Replace", CR
    EQUB TEXT_END
; The prompts for a file name (whole files and single sprites alike) and an
; object's name; input_line echoes the reply after the colon.
.text_load_name
    EQUB PLAIN
    EQUS "Load Sprite File", CR, CR, " Enter Filename", CR, CR, " :"
    EQUB TEXT_END
.text_save_name
    EQUB PLAIN
    EQUS "Save Sprite File", CR, CR, " Enter Filename", CR, CR, "  :"
    EQUB TEXT_END
.text_object_name
    EQUB PLAIN
    EQUS "Edit object name", CR, CR, " Enter new name", CR, CR, " :"
    EQUB TEXT_END
.text_not_available
    EQUB PLAIN
    EQUS "E  R  R  O  R  !", CR, CR, "Not available", CR, "with this", CR, "filing system", CR
    EQUB TEXT_END
; error_handler copies the error's message into the error window's text,
; breaking its lines and ending it. Until an error has, the text runs on to
; text_escape's flag byte, which is also TEXT_END. (A message too long for
; the buffer would run on over text_escape; the filing systems' are short.)
.text_error
    EQUB PLAIN
    EQUS "E  R  R  O  R  !", CR, CR
.error_message
    EQUB REPEATED(61, ascii(" "))
.text_escape
    EQUB MENU
    EQUS "Escape?", CR, "No", CR, "Yes", CR
    EQUB TEXT_END
.text_insert_disc
    EQUB PLAIN
    EQUS " Return to menu", CR, " Please insert", CR, " Pipeline disc", CR, "and press SPACE", CR
    EQUB TEXT_END

; Draw every sprite in the sheet, from the last position down to 0 (the
; small sprites, &10-&1F, among them).
; Clobbers: A, X, Y, screen_ptr, data_ptr, count_x, count_y, sprite_width
.draw_sheet
{
    LDA #LAST_SPRITE
.loop
    PHA
    JSR draw_sheet_sprite
    PLA
    SEC
    SBC #&01
    BCS loop
    RTS
}

; Mark the selected sprite in the sheet with a box in colour 2, drawn over
; the sprite (drawing the sprite again removes it); and under the editing
; grid show its number and name if it is an object (a small sprite), or
; blank them if not. The exit's "name" is the "Finish Block" that start
; writes after the names.
; In:  A = sprite = the selected sprite (the name comes from sprite)
; Clobbers: A, X, Y, screen_ptr, data_ptr, aux_ptr, count_y, sprite_width
.show_selection
{
    JSR sprite_class
    JSR sheet_address
    LDY #&00
    JSR selection_edge
    LDA sprite_width
    STA count_y

    ; Down each character row: the rightmost pixel of the last cell, the
    ; leftmost of the first.
.column
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    TAY
    LDX #&07
.right_edge
    DEY
    LDA (screen_ptr), Y
    AND #mode5_byte("333.")         ; pixel 3 becomes colour 2
    ORA #mode5_byte("...2")
    STA (screen_ptr), Y
    DEX
    BPL right_edge
    LDY #&07
.left_edge
    LDA (screen_ptr), Y
    AND #mode5_byte(".333")         ; pixel 0 becomes colour 2
    ORA #mode5_byte("2...")
    STA (screen_ptr), Y
    DEY
    BPL left_edge
    DEC count_y
    LDA count_y
    BEQ bottom
    LDA screen_ptr
    CLC
    ADC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(ROW)
    STA screen_ptr+1
    BCC column
.bottom
    LDY #&07
    JSR selection_edge
    LDA sprite_width
    CMP #SMALL_WIDTH
    BEQ small
    TXA                             ; X is 0 here: blank the name box
    LDY #NAME_BOX_CELLS*CELL-1
.clear_name
    STA name_box, Y
    DEY
    BPL clear_name
    RTS

    ; An object: its number, 1-16 (the small sprite less &0F), then ":" and
    ; its name.
.small
    LDA #LO(name_box)
    STA screen_ptr
    LDA #HI(name_box)
    STA screen_ptr+1
    LDX #ascii(" ")                 ; objects 1-9: no tens
    LDA sprite
    CMP #FIRST_SMALL + 9
    BCC tens
    LDX #ascii("1")
.tens
    SEC
    TXA
    JSR print_char_advance
    LDA sprite
    SEC
    SBC #FIRST_SMALL - 1
    CMP #10
    BCC units
    SBC #10
.units
    SEC                             ; carry set: store the characters
    ORA #ascii("0")
    JSR print_char_advance
    LDA #ascii(":")
    SEC
    JSR print_char_advance
    JSR name_offset
    LDX #OBJECT_NAME_LENGTH - 1
.name
    LDA object_names, Y
    SEC
    JSR print_char_advance
    INY
    DEX
    BPL name
    RTS
}
NAME_BOX_CELLS = 3 + OBJECT_NAME_LENGTH     ; "16:" and the name

; Draw a horizontal edge of the selection box in colour 2: line Y of each
; cell across the sprite.
; In:  Y = the line within the character row, screen_ptr = the row
; Out: X = 0
; Clobbers: A, Y
.selection_edge
{
    LDX sprite_width
.loop
    LDA #mode5_byte("2222")
    STA (screen_ptr), Y
    TYA
    CLC
    ADC #CELL
    TAY
    DEX
    BNE loop
    RTS
}

; Where an object's name is in object_names. Also entered at of_a with the
; sprite in A.
; In:  sprite = the small sprite
; Out: A = Y = (sprite AND &0F) * OBJECT_NAME_LENGTH
; Clobbers: nothing else
.name_offset
{
    LDA sprite
.of_a
    AND #&0F
    ASL A
    ASL A
    STA times_4
    ASL A
    ADC times_4
    TAY
    RTS
.times_4
    EQUB &00
}
ASSERT OBJECT_NAME_LENGTH = 12

; Unused copies of down_a_row, width_times_32 and clear_rows: nothing
; calls these three. This clear_rows has its RTS.
.unused_down_a_row
{
    LDA screen_ptr
    CLC
    ADC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(ROW)
    STA screen_ptr+1
    RTS
}

; Unused: as width_times_32.
.unused_width_times_32
{
    LDA sprite_width
    LSR A
    ROR A
    ROR A
    ROR A
    RTS
}

; Unused: as clear_rows.
.unused_clear_rows
{
    STA count_y
.row
    LDY #9*CELL-1
    LDA #&00
.byte
    STA (screen_ptr), Y
    DEY
    BPL byte
    JSR unused_down_a_row
    DEC count_y
    BNE row
    RTS
}

; Fill the colour swatch, two cells, with the current colour.
; In:  colour
; Clobbers: A, X, Y
.show_colour
{
    LDX colour
    LDA colour_byte, X
    LDY #2*CELL-1
.loop
    STA colour_swatch, Y
    DEY
    BPL loop
    RTS
}

; The stack pointer when the designer first started, for the main loop to
; reset the stack to. It starts 0, and a stack pointer is never that low,
; so bit 7 set also says it has been saved.
.stack_pointer
    EQUB &00

; Bit 7 set once the graphics area has been cleared (and on disc DEFAULT
; loaded), so starting again after an error keeps the user's work.
.graphics_loaded
    EQUB &00

; Bit 7 set if the filing system is a disc one (FS_DISC up).
.disc_fs
    EQUB 0

; The physical colours for logical 1-3 (blue, yellow, red); 0 stays black.
.palette_colours
    EQUB COLOUR_BLUE, COLOUR_YELLOW, COLOUR_RED

; The graphics set to start with, and the command that goes back to the menu.
.default_name
    EQUS "DEFAULT", CR
.mrun_command
    EQUS "/MRUN", CR

; BRKV points here: show the error's message in the error window, wait for
; a key, close any open files and start again.
; In:  MOS_ERROR_PTR = the error, as the OS leaves it
; Out: doesn't return: it runs on into start
.error_handler
{
    LDY #&00
    LDX #&00

    ; Copy the message, breaking it into lines: a CR after the first 14
    ; characters, then after every 15.
.copy
    INY
    INX
    TXA
    AND #&0F
    CMP #&0F
    BNE store
    LDA #CR
    STA error_message-1, X
    INX
.store
    LDA (MOS_ERROR_PTR), Y
    STA error_message-1, X
    BNE copy
    LDA #CR
    STA error_message-1, X
    LDA #TEXT_END
    STA error_message, X
    JSR close_all_windows
    LDX #LO(text_error)
    LDY #HI(text_error)
    LDA #WINDOW_ERROR
    JSR open_window
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    LDX #&00
    LDY #&00
    JSR OSBYTE
.wait
    JSR OSRDCH                      ; wait for a key, acknowledging any Escape
    BCC restart
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
    JMP wait
.restart
    JSR close_all_windows
    JSR close_files                 ; and fall into start
}

; The entry point, from the GRAPHIC stub, and where errors start again. The
; first time (BRKV still pointing into the ROMs) it takes over BRKV and the
; event vector, keeping the old ones in IND1V and IND2V to put back on
; leaving, and enables the Escape event. Unless the screen is in MODE 5
; already (as it is after an error, so a changed palette survives), it sets
; MODE 5 and the palette. Then it draws the screen, the first time clears
; the graphics area and (on disc) loads DEFAULT, and draws the sheet and the
; first sprite; main_loop follows.
; Out: doesn't return
.start
{
    LDA #OSBYTE_CURSOR_EDITING      ; the cursor keys give codes
    LDX #CURSOR_KEYS_CODES
    JSR OSBYTE
    LDA BRKV+1                      ; BRKV still in the ROMs: not ours yet
    BPL installed
    LDX #LO(error_handler)
    LDY #HI(error_handler)
    LDA EVNTV
    STA IND2V
    LDA EVNTV+1
    STA IND2V+1
    LDA BRKV
    STA IND1V
    LDA BRKV+1
    STA IND1V+1
    LDA #LO(escape_event)
    SEI
    STX BRKV
    STY BRKV+1
    STA EVNTV
    LDA #HI(escape_event)
    STA EVNTV+1
    CLI
    LDA #OSBYTE_ENABLE_EVENT        ; the Escape event; and the latch clear
    STA escape_latch                ; (the call number has bit 7 clear)
    LDX #EVENT_ESCAPE
    JSR OSBYTE
.installed
    LDA #OSBYTE_READ_CHAR_AND_MODE  ; the screen mode, into Y
    JSR OSBYTE
    CPY #5
    BEQ setup
    LDA #VDU_MODE                   ; MODE 5
    JSR OSWRCH
    LDA #5
    JSR OSWRCH
    LDA #&03                        ; logical colours 3 to 1
.palette
    PHA
    TAX
    LDA palette_colours-1, X
    JSR write_palette
    PLA
    SEC
    SBC #&01
    BNE palette
.setup
    LDA #OSBYTE_WRITE_SHEILA        ; no cursor
    LDX #LO(CRTC_ADDR)
    LDY #CRTC_CURSOR_START
    JSR OSBYTE
    LDY #CRTC_CURSOR_OFF
    INX                             ; LO(CRTC_DATA)
    JSR OSBYTE
    LDA #OSARGS_READ_FS             ; the filing system's number
    TAY
    JSR OSARGS
    CMP #FS_DISC                    ; carry set for a disc filing system
    LDA #&00
    STA by_slot
    TAY
    ROR A                           ; into disc_fs bit 7
    STA disc_fs
    BMI opt
    INY
.opt
    LDA #FSCV_OPT                   ; *OPT 1,Y: messages off on disc (Y = 0), on for tape
    LDX #&01
    JSR fscv
    JSR reset_timer
    TSX
    BIT stack_pointer
    BMI saved_sp
    STX stack_pointer

    ; Draw the screen's furniture.
.saved_sp
    LDY #&FF
.layout
    INY
    LDA screen_layout, Y
    CMP #LAYOUT_END
    BEQ layout_done
    JSR OSWRCH
    JMP layout
.layout_done
    LDX #20-1                       ; all twenty
    LDA #&00
.clear_windows
    STA window_open, X
    DEX
    BPL clear_windows
    LDA #CRTC_CURSOR_START          ; the cursor off again, after the CLS
    STA CRTC_ADDR
    LDA #CRTC_CURSOR_OFF
    STA CRTC_DATA
    LDA #LO(logo)                   ; not needed: the copy below is indexed
    STA data_ptr
    LDA #HI(logo)
    STA data_ptr+1
    LDY #&00
.logo_copy
    LDA logo, Y
    STA logo_screen, Y
    LDA logo + LOGO_BAND, Y
    STA logo_screen + ROW, Y
    LDA logo + 2*LOGO_BAND, Y
    STA logo_screen + 2*ROW, Y
    INY
    CPY #LOGO_BAND
    BCC logo_copy

    ; The first time only: clear the graphics area and load DEFAULT into it.
    BIT graphics_loaded
    BMI redraw
    LDA #&00
    TAY
    STA screen_ptr                  ; A is 0 for the low byte and to clear with
    LDX #HI(graphics)
    STX screen_ptr+1
    LDX #&10                        ; 16 pages, to &4FFF
.clear
    STA (screen_ptr), Y
    INY
    BNE clear
    INC screen_ptr+1
    DEX
    BNE clear
    DEX
    STX graphics_loaded             ; X = &FF
    LDA disc_fs
    BMI load_default

    ; On tape nothing is loaded: the set starts empty. The name is made ""
    ; (the next file on the tape) first, but nothing reads it after this.
    LDX #6
.tape_name
    STA default_name, X             ; A = 0
    DEX
    BPL tape_name
    LDA #ascii("""")
    STA default_name
    STA default_name+1
    BNE redraw                      ; always
.load_default
    LDA #LO(default_name)
    STA osfile_block
    LDA #HI(default_name)
    STA osfile_block+1
    LDA #OSFILE_LOAD                ; &FF, as graphics_loaded wants too
    STA graphics_loaded
    JSR osfile_graphics

    ; Redraw everything, with the selection back at position 0: also where
    ; the file commands come back to.
.redraw
    BIT disc_fs                     ; on tape, clear away the filing system's messages
    BMI cls_done
    LDA #VDU_CLS
    JSR OSWRCH
.cls_done
    LDX #LEN(FINISH_BLOCK) - 1
.mark_end
    LDA finish_block, X
    STA graphics_end, X
    DEX
    BPL mark_end
    JSR draw_sheet
    LDA #&00
    STA sprite
    JSR show_selection
    LDA #&00                        ; the pixel cursor to the top left
    STA cursor_x
    STA cursor_y
    SEC                             ; carry set: and take an undo copy
    JSR redraw_grid
    LDA #&03                        ; start in colour 3
    STA colour
    JSR show_colour
}

; The main loop, a pass at a time, each at least two centiseconds after the
; last (select_sprite waits for that, unless CTRL is held) and ending at a
; vsync: move the selection, paint, run a command from a menu or shortcut,
; and on Escape (or a latched SHIFT-Escape) ask whether to leave. Each pass
; starts with the stack as start found it, so a command can give up with a
; plain JMP to main_loop or command_done.
; Out: doesn't return (leaving the designer, it runs /MRUN or resets)
.main_loop
{
    LDX stack_pointer
    TXS
    JSR close_all_windows
    LDA #&00                        ; move the selection
    JSR select_sprite
    BMI edit                        ; nothing moved (or CTRL held)
    LDX cursor_x                    ; the grid was drawn again: put the pixel
    LDY cursor_y                    ; cursor back on it
    JSR toggle_cursor
.edit
    JSR edit_pixels
    LDA colour                      ; commands may use colour as a scratch value
    STA saved_colour
    JSR read_command
    ASL A                           ; &FF: no command
    BCS command_done
    TAY
    LDA command_table, Y
    STA dispatch+1
    LDA command_table+1, Y
    STA dispatch+2
.dispatch
    JSR &1234                       ; the command (self-modified; the original's placeholder)
    LDX #INKEY_TEST(KEY_RETURN)     ; so a menu choice made with Return doesn't plot too
    JSR wait_key_release
.command_done
    LDA saved_colour
    STA colour
    LDA #OSBYTE_WAIT_VSYNC          ; wait for the vsync, which leaves A = &13...
    JSR OSBYTE
    STA by_slot                     ; ...so by_slot bit 7 is clear again
    LDA MOS_ESCAPE_FLAG             ; Escape, or SHIFT-Escape latched
    ORA escape_latch
    BPL loop
    LSR escape_latch
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
    JSR close_all_windows
    LDX #LO(text_escape)
    LDY #HI(text_escape)
    LDA #WINDOW_QUESTION
    JSR menu                        ; Escape? No/Yes
    CMP #2                          ; Yes
    BNE loop
    LDX #LO(text_insert_disc)
    LDY #HI(text_insert_disc)
    LDA #WINDOW_INPUT
    JSR open_window
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    JSR OSBYTE
.wait_key
    JSR OSRDCH                      ; wait for a key, acknowledging any Escape
    PHP
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
    PLP
    BCS wait_key

    ; Leave: put the vectors back and return to the menu.
    LDA IND1V
    STA BRKV
    LDA IND1V+1
    STA BRKV+1
    LDA IND2V
    STA EVNTV
    LDA IND2V+1
    STA EVNTV+1
    LDA #OSBYTE_CURSOR_EDITING      ; X = 0 from the last OSBYTE_ACKNOWLEDGE_ESCAPE (no
    INX                             ; Escape was pending), so this is OSBYTE 4,1 and the
    JSR OSBYTE                      ; cursor keys stay codes; MENU sets that anyway
    LDA #OSBYTE_FUNCTION_KEY_BASE   ; function keys back to strings
    LDX #FUNCTION_KEYS_STRINGS
    JSR OSBYTE
    BIT disc_fs
    BMI run_mrun
    LDA #OSBYTE_BREAK_EFFECT        ; *FX200,3: on tape, BREAK clears memory...
    LDX #&03
    JSR OSBYTE
    JMP (CPU_RESET_VECTOR)          ; ...and here is a BREAK
.run_mrun
    LDX #LO(mrun_command)           ; */MRUN, which goes back to the menu
    LDY #HI(mrun_command)
    JMP OSCLI
.loop
    JMP main_loop
}

; Written after the graphics set in memory, at graphics_end, which is where
; the exit's name would be (SET_NAMES + 15 * OBJECT_NAME_LENGTH): so the
; name box shows the exit as "16:Finish Block".
FINISH_BLOCK = "Finish Block"
.finish_block
    EQUS FINISH_BLOCK
ASSERT LEN(FINISH_BLOCK) = OBJECT_NAME_LENGTH
ASSERT graphics_end = object_names + (SLOT_EXIT - FIRST_SMALL_SLOT) * OBJECT_NAME_LENGTH

; The colour, kept while a command runs.
.saved_colour
    EQUB &00

; The commands, by read_command's number: a menu item is menu * 8 + item
; (items from 1), a CTRL shortcut its place in shortcut_keys plus one.
; Numbers with no command go to the main loop's own tail, command_done,
; which is harmless to call because the main loop resets the stack. A
; command takes the selected sprite from `sprite`, and may clobber every
; register and most of zero page.
.command_table
    EQUW main_loop.command_done     ; 0: none (the credits)
    EQUW cmd_flip_x                 ; OptionsA
    EQUW cmd_flip_y
    EQUW cmd_delete
    EQUW cmd_undo
    EQUW cmd_animate
    EQUW cmd_obj_name
    EQUW main_loop.command_done
    EQUW main_loop.command_done
    EQUW cmd_swap                   ; OptionsB
    EQUW cmd_copy
    EQUW cmd_overlay
    EQUW cmd_underlay
    EQUW cmd_remove
    EQUW cmd_backing
    EQUW main_loop.command_done
    EQUW main_loop.command_done
    EQUW cmd_load_sprite            ; Environment
    EQUW cmd_save_sprite
    EQUW cmd_load_file
    EQUW cmd_save_file
    EQUW cmd_def_colour
    EQUW main_loop.command_done
    EQUW main_loop.command_done
    EQUW main_loop.command_done

; OptionsA Delete (CTRL-Delete): clear the sprite to colour 0, and an
; object's name to zeros. Drawing the sprite again after show_selection
; rubs out the selection box, which stays off until the selection moves.
; In:  sprite
; Clobbers: everything
.cmd_delete
{
    LDA sprite
    JSR sprite_address
    JSR sprite_last_byte
    LDA #&00
.clear
    STA (data_ptr), Y
    DEY
    BPL clear
    LDX sprite_width
    CPX #SMALL_WIDTH
    BNE redraw
    LDA sprite                      ; the exit has no name to clear
    CMP #SLOT_EXIT
    BEQ redraw
    JSR name_offset
    LDA #&00
    LDX #OBJECT_NAME_LENGTH - 1
.name
    STA object_names, Y
    INY
    DEX
    BPL name
.redraw
    LDA sprite
    JSR show_selection
    LDA sprite
    JSR draw_sheet_sprite
    LDA sprite
    JMP redraw_grid
}

; Draw the selected sprite in the editing grid and put the pixel cursor
; back on it.
; In:  sprite, carry set to take an undo copy of the sprite first
; Clobbers: A, X, Y, and as draw_grid
.redraw_grid
{
    LDA sprite
    BCC draw
    ORA #&80                        ; bit 7: take an undo copy
.draw
    JSR draw_grid
    LDX cursor_x
    LDY cursor_y
    JMP toggle_cursor
}

; OptionsA Flip X (CTRL-X): mirror the sprite left to right, pixel by pixel,
; swapping each pixel in the left half of a row with its opposite. colour
; carries the pixels across (main_loop puts it back).
; In:  sprite
; Clobbers: everything
.cmd_flip_x
{
    LDA sprite
    JSR sprite_address
    LDA sprite_width                ; item = pixels in half a row
    ASL A
    STA item
    ASL A                           ; aux_ptr = the last pixel's x
    STA aux_ptr
    ASL A                           ; count_y = the last row
    STA count_y
    DEC aux_ptr
    DEC count_y
.row
    LDA #&00
    STA count_x
.pixel
    LDA aux_ptr
    SEC
    SBC count_x
    TAX
    LDY count_y
    STX mirror_x
    STY mirror_y
    LDA sprite
    JSR read_pixel
    PHA
    LDX count_x
    LDY count_y
    LDA sprite
    JSR read_pixel
    STA colour
    LDX mirror_x
    LDY mirror_y
    LDA sprite
    JSR plot_pixel
    LDX count_x
    LDY count_y
    PLA
    STA colour
    LDA sprite
    JSR plot_pixel
    INC count_x
    LDA count_x
    CMP item
    BCC pixel
    DEC count_y
    BPL row
    LDX #INKEY_TEST(KEY_X)          ; the shortcut, to wait for

    ; Show the sprite as changed, then wait for the key in X to be released so
    ; a shortcut acts once.
.redraw
    TXA
    PHA
    LDA sprite
    PHA
    JSR draw_sheet_sprite
    PLA
    JSR redraw_grid                 ; carry is clear from draw_sheet_sprite: no undo copy
    PLA
    TAX
    JMP wait_key_release
}

; Flip X's mirrored pixel.
.mirror_x
    EQUB &00

.mirror_y
    EQUB &00

; The OSGBPB block for moving sprites and names to and from files: the
; handle, the address in memory, the byte count, the pointer in the file;
; then three spare bytes, which check_filing_system clears with it.
.gbpb_block                         ; the handle
    EQUB 0
.gbpb_address
    EQUD 0
.gbpb_count
    EQUD 0
.gbpb_pointer
    EQUD 0
    EQUB 0, 0, 0

; OptionsA Flip Y (CTRL-Y): turn the sprite upside down.
; In:  sprite
; Clobbers: everything
.cmd_flip_y
{
    JSR flip_vertically
    LDX #INKEY_TEST(KEY_Y)
    JMP cmd_flip_x.redraw
}

; Turn the selected sprite upside down, by reversing each column of bytes.
; In:  sprite (Animate uses this on its frame buffers)
; Clobbers: A, X, Y, data_ptr, count_x, count_y, sprite_width
.flip_vertically
{
    LDA sprite
    JSR sprite_address
    LDA sprite_width
    STA count_x
    ASL A
    ASL A
    ASL A
    STA count_y                     ; a column's bytes
.column
    LDY count_y
    DEY
.swap
    LDX #&00
    LDA (data_ptr, X)
    PHA
    LDA (data_ptr), Y
    STA (data_ptr, X)
    PLA
    STA (data_ptr), Y
    INC data_ptr
    BNE next
    INC data_ptr+1
.next
    DEY
    DEY
    BPL swap
    LDA count_y                     ; on to the next column
    LSR A
    CLC
    ADC data_ptr
    STA data_ptr
    BCC next_column
    INC data_ptr+1
.next_column
    DEC count_x
    BNE column
    RTS
}

; OptionsA Undo (CTRL-U): swap the sprite with the copy taken when it was
; selected, so a second Undo puts the changes back.
; In:  sprite
; Clobbers: everything
.cmd_undo
{
    LDA sprite
    JSR sprite_address
    JSR sprite_last_byte
.swap
    LDX undo_buffer, Y
    LDA (data_ptr), Y
    STA undo_buffer, Y
    TXA
    STA (data_ptr), Y
    DEY
    BPL swap
    LDA sprite
    JSR draw_sheet_sprite
    LDA sprite
    JSR show_selection
    CLC
    JSR redraw_grid
    LDX #INKEY_TEST(KEY_U)
    JMP wait_key_release
}

; OptionsB Underlay (no shortcut): put this sprite under another - fill the
; other's colour 0 pixels from this one.
; In:  sprite
; Clobbers: everything
.cmd_underlay
{
    LDX #LO(text_underlay)
    LDY #HI(text_underlay)
    JSR pick_second_sprite
    STX combine_test
    CLC
    JMP combine_sprites
}

; OptionsB Backing (CTRL-B): fill the sprite's colour 0 pixels from the
; floor (sheet position 0). No second sprite to pick: it goes straight on.
; In:  sprite
; Clobbers: everything
.cmd_backing
{
    LDX sprite
    STX combine_test
    LDA #&00                        ; the floor
    CLC
    JMP combine_sprites
}

; OptionsB Overlay (CTRL-O): put this sprite over another - copy its
; pixels other than colour 0 onto the other.
; In:  sprite
; Clobbers: everything
.cmd_overlay
{
    LDX #LO(text_overlay)
    LDY #HI(text_overlay)
    JSR pick_second_sprite
    STA combine_test
    SEC
}

; Combine two sprites a pixel at a time, then show them both again
; (redraw_pair).
; In:  X = the sprite to change, A = the sprite to take pixels from,
;      combine_test = the sprite whose pixels decide, carry set to copy
;      combine_test's pixels where they aren't colour 0 (overlay), clear to
;      copy A's pixels where combine_test's are colour 0 (underlay, backing)
; Clobbers: everything
.combine_sprites
{
    STX combine_target
    STA combine_source
    LDA #&00                        ; carry into bit 7
    ROR A
    STA combine_over
    LDA sprite_width                ; count_x = the last pixel across
    ASL A
    ASL A
    SBC #&00                        ; (carry clear from the ASL)
    STA count_x
.column
    LDA sprite_width                ; count_y = the last row
    ASL A
    ASL A
    ASL A
    SBC #&00                        ; (carry clear from the ASL)
    STA count_y
.pixel
    LDA combine_test
    LDX count_x
    LDY count_y
    JSR read_pixel
    BIT combine_over
    BPL under                       ; overlay: copy the pixel where it isn't 0
    CMP #&00
    BEQ next
    BNE plot
.under
    CMP #&00                        ; underlay: where it's 0...
    BNE next
    LDA combine_source              ; ...copy the source's
    LDX count_x
    LDY count_y
    JSR read_pixel
.plot
    STA colour
    LDA combine_target
    LDX count_x
    LDY count_y
    JSR plot_pixel
.next
    DEC count_y
    BPL pixel
    DEC count_x
    BPL column
    LDA combine_source
    JMP redraw_pair
}

; Combine's sprites: the one to change, the one to take pixels from, the
; one whose pixels decide, and bit 7 set to overlay rather than underlay.
.combine_target
    EQUB &00

.combine_source
    EQUB &00

.combine_test
    EQUB &00

.combine_over
    EQUB &00

; OptionsB Remove (CTRL-R): take this sprite from another - clear to 0 the
; other's pixels that match this one's.
; In:  sprite
; Clobbers: everything
.cmd_remove
{
    LDX #LO(text_remove)
    LDY #HI(text_remove)
    JSR pick_second_sprite
    STX combine_target
    STA combine_source
    LDA sprite_width                ; count_x = the last pixel across
    ASL A
    ASL A
    SBC #&00                        ; (carry clear from the ASL)
    STA count_x
.column
    LDA sprite_width                ; count_y = the last row
    ASL A
    ASL A
    ASL A
    SBC #&00
    STA count_y
.pixel
    LDA combine_target
    LDX count_x
    LDY count_y
    JSR read_pixel
    STA temp
    LDA combine_source
    LDX count_x
    LDY count_y
    JSR read_pixel
    EOR temp                        ; the same colour in both...
    BNE next
    STA colour                      ; ...becomes 0
    LDA combine_target
    LDX count_x
    LDY count_y
    JSR plot_pixel
.next
    DEC count_y
    BPL pixel
    DEC count_x
    BPL column
    LDA combine_source
    JMP redraw_pair
}

; OptionsB Copy (CTRL-COPY): copy this sprite onto another.
; In:  sprite
; Clobbers: everything
.cmd_copy
{
    LDX #LO(text_copy)
    LDY #HI(text_copy)
    JSR pick_second_sprite
    PHA
.copy
    LDA (aux_ptr), Y
    STA (data_ptr), Y
    DEY
    BPL copy
    PLA
    JMP redraw_pair
}

; OptionsB Swap (CTRL-S): swap this sprite with another, and two objects'
; names with them (unless one is the exit, which has none).
; In:  sprite
; Clobbers: everything
.cmd_swap
{
    LDX #LO(text_swap)
    LDY #HI(text_swap)
    JSR pick_second_sprite
    PHA
.swap
    LDA (data_ptr), Y
    PHA
    LDA (aux_ptr), Y
    STA (data_ptr), Y
    PLA
    STA (aux_ptr), Y
    DEY
    BPL swap
    LDA sprite_width
    CMP #SMALL_WIDTH
    BNE done
    CPX #SLOT_EXIT
    BEQ done
    PLA
    PHA
    CMP #SLOT_EXIT
    BEQ done

    ; Swap the names: data_ptr and aux_ptr hold the two names' offsets now.
    JSR name_offset
    STA data_ptr
    PLA
    PHA
    JSR name_offset.of_a
    STA aux_ptr
    LDX #OBJECT_NAME_LENGTH - 1     ; count the name's bytes in data_ptr+1
    STX data_ptr+1
.names
    LDY aux_ptr
    LDA object_names, Y
    LDY data_ptr
    LDX object_names, Y
    STA object_names, Y
    LDY aux_ptr
    TXA
    STA object_names, Y
    INC aux_ptr
    INC data_ptr
    DEC data_ptr+1
    BPL names
.done
    PLA
}

; Show both sprites of a two-sprite command as they are now and close the
; picking window. The selection stays on the second sprite, the one picked.
; In:  A = the first sprite (or, for Backing, the floor), sprite = the second
; Clobbers: A, X, Y, and as draw_grid
.redraw_pair
{
    JSR draw_sheet_sprite
    LDA sprite
    JSR draw_sheet_sprite
    LDA sprite
    JSR show_selection
    LDA sprite
    CLC
    JSR redraw_grid
    LDA #WINDOW_PICK
    JMP close_window
}

; Ask for the second sprite of a two-sprite command: show the question with
; a picture of this sprite, and let the selection move until Return. If the
; two are different sizes it says "Wrong Types"; then, as on Escape (or
; f0-f3), it abandons the command and goes back to the main loop.
; In:  sprite, X/Y = the question
; Out: sprite = X = the sprite picked, A = the first one, data_ptr = the
;      picked one's bytes, aux_ptr = the first one's, Y = the offset of
;      their last byte, carry set
; Clobbers: everything else
.pick_second_sprite
{
    LDA #WINDOW_PICK
    JSR open_window
    LDX #INKEY_TEST(KEY_RETURN)     ; the Return that chose the command
    JSR wait_key_release
    LDA sprite
    PHA
    JSR sprite_address
    LDA data_ptr
    STA first_address
    LDA data_ptr+1
    STA first_address+1
    LDA window_address + 2*WINDOW_PICK      ; the picture goes on the right, two rows down
    CLC
    ADC #LO(2*ROW + 8*CELL)
    STA screen_ptr
    LDA window_address + 2*WINDOW_PICK + 1
    ADC #HI(2*ROW + 8*CELL)
    STA screen_ptr+1
    JSR draw_sheet_sprite.at_screen_ptr
    LDA sprite_width
    STA first_width
.select
    LDA #&01
    JSR select_sprite               ; move the selection; f0-f3 raise an Escape
    BIT MOS_ESCAPE_FLAG
    BMI abandon
    LDX #INKEY_TEST(KEY_RETURN)
    JSR key_pressed
    BPL select
    LDA sprite
    JSR sprite_address
    JSR sprite_last_byte
    LDA first_address
    STA aux_ptr
    LDA first_address+1
    STA aux_ptr+1
    LDX sprite
    LDA sprite_width
    CMP first_width                 ; the same size?
    BNE wrong_type
    PLA
    RTS
.wrong_type
    LDA #WINDOW_ERROR
    LDX #LO(text_wrong_types)
    LDY #HI(text_wrong_types)
    JSR open_window
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    LDX #&00
    JSR OSBYTE
.wait_space
    JSR OSRDCH
    BCS close
    CMP #ascii(" ")
    BNE wait_space
.close
    LDA #WINDOW_ERROR
    JSR close_window
.abandon
    PLA                             ; drop the first sprite and the return into the command
    PLA
    PLA

    ; Give up a command: also where input_line goes on Escape.
.abandon_command
    LDA #WINDOW_PICK
    JSR close_window
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
    JMP main_loop.command_done
}

; Show an error in the error window until a key other than Escape is
; pressed, then go back to the main loop.
; In:  X/Y = the error's text
; Out: doesn't return
.show_error
{
    STX error_text
    STY error_text+1
.show
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
    LDA #WINDOW_ERROR
    LDX error_text
    LDY error_text+1
    JSR open_window
    JSR OSRDCH
    BIT MOS_ESCAPE_FLAG
    BMI show
    JMP main_loop
}

; pick_second_sprite's first sprite: its address and width.
.first_address
    EQUB &00, &00

.first_width
    EQUB &00

; show_error's text, kept while it waits.
.error_text
    EQUB &00, &00

; Read the palette.
; In:  A = logical colour
; Out: A = the physical colour it shows
; Clobbers: X, Y, osfile_block
.read_palette
{
    STA osfile_block
    LDX #LO(osfile_block)
    LDY #HI(osfile_block)
    LDA #OSWORD_READ_PALETTE
    JSR OSWORD
    LDA osfile_block+1
    RTS
}

; A menu with nothing in it: the palette window opens empty and
; show_palette fills it.
.empty_text
    EQUB MENU, TEXT_END

; Environment Def. Colour (CTRL-C): change the palette. Up and down pick a
; logical colour, left and right step its physical colour through the eight;
; Return, Space, Escape or a function key finish. The change lasts until
; the designer next sets MODE 5 (not after an error: see start).
; Clobbers: everything
.cmd_def_colour
{
    LDA #WINDOW_QUESTION
    LDX #LO(empty_text)
    LDY #HI(empty_text)
    JSR open_window
    LDA #OSBYTE_CURSOR_EDITING      ; the cursor keys give codes
    LDX #CURSOR_KEYS_CODES
    JSR OSBYTE
    LDA #OSBYTE_FUNCTION_KEY_BASE   ; f0-f9 give KEYCODE_F0 up
    LDX #KEYCODE_F0
    LDY #&00
    JSR OSBYTE
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    LDX #&00
    JSR OSBYTE
    LDA #&00
    STA item
    JSR palette_highlight
.redraw
    JSR show_palette
.read_key
    JSR OSRDCH
    BCC got_key
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
.done
    JMP show_palette.done
.got_key
    LDY item
    CMP #KEYCODE_F0
    BCS done
    CMP #CR
    BEQ done
    CMP #ascii(" ")
    BEQ done
    CMP #KEYCODE_DOWN
    BNE not_down
    LDX item
    CPX #&03                        ; logical colours 0-3
    BEQ not_down
    INC item
.not_down
    CMP #KEYCODE_UP
    BNE moved
    LDX item
    BEQ moved
    DEC item
.moved
    PHA
    JSR palette_highlight.toggle    ; off the old line, on the new (or the same)
    JSR palette_highlight
    PLA
    LDX #&01                        ; right: the next physical colour
    CMP #KEYCODE_RIGHT
    BEQ change
    LDX #&FF                        ; left: the one before
    CMP #KEYCODE_LEFT
    BNE read_key
.change
    STX colour_step
    LDA item
    JSR read_palette
    CLC
    ADC colour_step
    AND #&07
    PHA
    JSR show_palette                ; rub out the old names...
    PLA
    LDX item
    JSR write_palette
    JMP redraw                      ; ...and show the new
}

; Set the palette.
; In:  X = logical colour, A = physical colour
; Clobbers: A, X, Y, osfile_block
.write_palette
{
    STA osfile_block+1
    STX osfile_block
    LDX #LO(osfile_block)
    LDY #HI(osfile_block)
    LDA #OSWORD_WRITE_PALETTE
    JMP OSWORD
}

; +1 or -1: the way Def. Colour steps.
.colour_step
    EQUB &00

; Write each logical colour's physical colour's name into the palette
; window's text, then exclusive-OR the text onto the window again without
; opening it: so one call shows the names and the next rubs them out, and
; Def. Colour calls it before and after each change.
; In:  the palette window open, so count_x = its width less one
; Clobbers: A, X, Y, screen_ptr, data_ptr, save_ptr, aux_ptr, border_ptr,
;      count_y, osfile_block (its first byte counts the colours)
.show_palette
{
    LDA #&03                        ; logical colours 3 to 0
    STA osfile_block
    LDA #LO(palette_lines + 3*PALETTE_LINE)
    STA save_ptr
    LDA #HI(palette_lines + 3*PALETTE_LINE)
    STA save_ptr+1
.entry
    LDA osfile_block
    JSR read_palette
    ASL A                           ; eight characters to each name...
    ASL A
    ASL A
    ORA #PALETTE_LINE - 2           ; ...of which a line takes seven
    TAX
    LDY #PALETTE_LINE - 2
.name
    LDA colour_names, X
    STA (save_ptr), Y
    DEX
    DEY
    BPL name
    LDA save_ptr
    SEC
    SBC #PALETTE_LINE
    STA save_ptr
    BCS next
    DEC save_ptr+1
.next
    DEC osfile_block
    BPL entry

    ; Write the window's text again, without opening it.
    LDA window_address + 2*WINDOW_QUESTION
    STA save_ptr
    STA screen_ptr
    LDA window_address + 2*WINDOW_QUESTION + 1
    STA save_ptr+1
    STA screen_ptr+1
    LDX #LO(text_palette)
    LDY #HI(text_palette)
    STX data_ptr
    STY data_ptr+1
    LDA #WINDOW_QUESTION
    JMP print_window_text
.done
    RTS
}

; The parameter block for OSFILE: the filename's address, then the load and
; exec addresses, the start address (from OSFILE_READ_INFO, the length) and
; the end address (the attributes), four bytes each; then two spare bytes.
; The palette routines use its first two bytes for OSWORD's block, and
; show_palette its first as a counter.
.osfile_block                       ; the filename's address
    EQUW 0
.osfile_load
    EQUD 0
.osfile_exec
    EQUD 0
.osfile_start                       ; or the length
    EQUD 0
.osfile_end                         ; or the attributes
    EQUD 0
    EQUB 0, 0

; Where each line of the palette window is, from its corner.
.palette_row_offset
    EQUW 1*ROW, 2*ROW, 3*ROW, 4*ROW

; Highlight the palette window's line for a logical colour. Also entered at
; toggle, to highlight or unhighlight the line highlighted last.
; In:  item = the logical colour, 0-3
; Clobbers: A, X, Y, screen_ptr
.palette_highlight
{
    LDA item
    ASL A
    TAY
    LDA palette_row_offset, Y
    CLC
    ADC window_address + 2*WINDOW_QUESTION
    STA highlight_address
    LDA palette_row_offset+1, Y
    ADC window_address + 2*WINDOW_QUESTION + 1
    STA highlight_address+1
.toggle
    LDA highlight_address
    STA screen_ptr
    LDA highlight_address+1
    STA screen_ptr+1
    JMP invert_menu_row
}

; The palette line highlighted.
.highlight_address
    EQUB &00, &00

; The selection, kept while Animate runs.
.animate_sprite
    EQUB &00

; How long Animate shows each frame, in vsyncs.
FRAME_VSYNCS = 6

; OptionsA Animate (CTRL-A): preview how the game animates a picture, a
; frame every six vsyncs, in the animation window and the editing grid,
; until Space or Escape (f0-f3 count as Escape). The monster (slots &0E and
; &0F) alternates its two pictures; the player facing left or right (&20,
; &21) alternates with itself upside down; facing up or down, &22 alternates
; with &23 upside down, and &23 with &22 upside down. Nothing happens for
; other sprites. The frames are copied to frame_a and frame_b first, so
; turning them over leaves the set alone.
; In:  sprite
; Clobbers: everything
.cmd_animate
{
    LDA #&FF
    STA by_slot                     ; sprite numbers are slots from here
    LDA sprite
    STA animate_sprite
    TAX
    AND #&10                        ; a small sprite: no
    BNE none
    TXA
    JSR slot_index
    TAX
    LDA slot_of_position, X
    CMP #SLOT_ALTERNATE             ; slots &24-&28: no
    BCS none
    CMP #SLOT_PLAYER
    BCS player
    CMP #SLOT_MONSTER
    BEQ flames
    CMP #SLOT_MONSTER + 1
    BEQ flames
.none
    RTS
.flames
    PHA
    AND #&FE                        ; copy both pictures, from the first
    BNE copy_pair                   ; always
.player
    PHA
.copy_pair
    CMP #SLOT_PLAYER + 2            ; up and down copy both, from the first;
    BCC copy_from                   ; left and right copy themselves (and the next)
    AND #&FE
.copy_from
    JSR sprite_address
    LDY #&00
.copy
    LDA (data_ptr), Y               ; two sprites' worth: this slot and the next
    STA frame_a, Y
    DEY
    BNE copy
    LDA #WINDOW_PICK
    LDX #LO(text_animation)
    LDY #HI(text_animation)
    JSR open_window
    LDA sprite
    JSR slot_index
    TAX
    LDA slot_of_position, X
    CMP #&10                        ; the monster's slots are below, the player's above
    BCS player_frames
    LDA #monster_frames - animation_frames
    BNE chosen                      ; always
.player_frames
    AND #&03                        ; the player's: a pair each
    ASL A
.chosen
    STA frame_index
.show
    TAX
    LDA #FRAME_VSYNCS
    STA frame_delay
    LDA animation_frames, X
    STA sprite
    BPL draw                        ; upside down?
    JSR flip_vertically
    LDA #FRAME_VSYNCS
    STA frame_delay
.draw
    LDA sprite
    AND #&7F
    STA sprite
    JSR draw_grid
    LDA sprite
    JSR draw_sheet_sprite
.wait
    JSR menu_keys_escape
    BIT MOS_ESCAPE_FLAG
    BMI stop
    LDX #INKEY_TEST(KEY_SPACE)
    JSR key_pressed
    BMI stop
    LDA #OSBYTE_WAIT_VSYNC
    JSR OSBYTE
    DEC frame_delay
    BNE wait
    LDA frame_index
    TAX
    EOR #&01
    STA frame_index
    PHA
    LDA animation_frames, X         ; back the right way up before it's shown again
    BPL other_frame
    JSR flip_vertically
.other_frame
    PLA
    JMP show
.stop
    PLA                             ; drop the slot pushed at the start
    LDX animate_sprite
    STX sprite
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
    LDA #WINDOW_PICK                ; by_slot bit 7 clear: sheet positions again
    STA by_slot
    JSR close_window
    JMP redraw_grid                 ; carry clear from close_window: no undo copy
}

; Turn a sheet position into an index into slot_of_position: positions
; &20-&28 follow &00-&0F. It borrows repeat_key's RTS.
; In:  A = a large sprite's position
; Out: A = the index
; Clobbers: nothing else
.slot_index
{
    CMP #FIRST_SMALL
    BCC repeat_key.done
    CMP #AFTER_SMALL
    BCC repeat_key.done
    SBC #AFTER_SMALL - FIRST_SMALL
    RTS
}

; Animate's place in animation_frames, and its countdown to the next
; frame.
.frame_index
    EQUB &00

.frame_delay
    EQUB &00

; Animate's frames, a pair for each animated slot: SPRITE_FRAME_A or _B,
; with UPSIDE_DOWN to show it turned over.
.animation_frames
    EQUB SPRITE_FRAME_A, SPRITE_FRAME_A + UPSIDE_DOWN    ; &20, the player facing left
    EQUB SPRITE_FRAME_A, SPRITE_FRAME_A + UPSIDE_DOWN    ; &21, facing right
    EQUB SPRITE_FRAME_A, SPRITE_FRAME_B + UPSIDE_DOWN    ; &22, facing up
    EQUB SPRITE_FRAME_B, SPRITE_FRAME_A + UPSIDE_DOWN    ; &23, facing down
.monster_frames
    EQUB SPRITE_FRAME_B, SPRITE_FRAME_A                  ; &0E and &0F, the monster

; The selection's auto-repeat, in passes of the main loop: a press moves it
; at once, then after REPEAT_DELAY passes, then every REPEAT_RATE.
REPEAT_DELAY = 20
REPEAT_RATE  = 5

; Read one of the cursor keys that move the selection, with auto-repeat.
; In:  X = INKEY_TEST() of the key
; Out: Y = &FF (N set) to move now, else 0
; Clobbers: A, X
.repeat_key
{
    JSR key_pressed
    BPL not_now
    STX key_held                    ; a key is held this pass
    LDY repeat_count                ; 0: time to repeat
    BEQ move
    STY key_repeating
    CPY #REPEAT_DELAY               ; a fresh press
    BEQ move
.not_now
    LDY #&00
.done
    RTS
.move
    LDY #&FF
    RTS
}

; The selection's auto-repeat countdown: REPEAT_DELAY while no key is held.
.repeat_count
    EQUB &00

; The main loop's pace: a pass takes at least this long.
PASS_CENTISECONDS = 2

; Move the selection with the cursor keys, and pace the main loop: unless
; CTRL is held, it waits until PASS_CENTISECONDS have passed since the
; last call. If the selection moves, the old sprite is drawn again without
; its box, and the new one boxed and drawn in the editing grid (with an
; undo copy).
; In:  A = 0 normally; else, picking a second sprite, f0-f3 raise an Escape
; Out: N set if nothing moved (or CTRL is held: then nothing is done)
; Clobbers: A, X, Y, and as draw_grid
.select_sprite
{
    STA select_mode
    LDX #INKEY_TEST(KEY_CTRL)
    JSR key_pressed
    BMI repeat_key.done             ; CTRL held: return N set (repeat_key's RTS)
    LDA sprite
    STA old_sprite
    LDA #&00
    STA key_held
    STA key_repeating
    LDX #INKEY_TEST(KEY_RIGHT)
    JSR repeat_key
    BPL left
    JSR sheet_column                ; the last column of the row?
    CMP last_column
    BEQ left
    INC sprite
    LDA sprite
    CMP #FIRST_SMALL
    BNE wrap_right
    LDA #AFTER_SMALL                ; after &0F comes &20
.wrap_right
    STA sprite
.left
    LDX #INKEY_TEST(KEY_LEFT)
    JSR repeat_key
    BPL left_done
    JSR sheet_column
    CMP #&00
    BEQ left_done
    DEC sprite
    LDA sprite
    CMP #LAST_SMALL
    BNE wrap_left
    LDA #FIRST_SMALL - 1            ; before &20 comes &0F
.wrap_left
    STA sprite
.left_done
    LDX #INKEY_TEST(KEY_DOWN)
    JSR repeat_key
    BPL down_done
    JSR sheet_row
    CPX #LARGE_ROWS + SMALL_ROWS - 1    ; the bottom row of small sprites
    BEQ down_done
    LDA sprite
    CMP #LAST_SPRITE                ; no small sprite below the last large one
    BEQ down_done
    CMP #&0F                        ; &0F, at the start of row 3, has &24 below it...
    BNE not_a
    LDA #&24
    BNE store_down
.not_a
    CMP #&0A                        ; ...and &0A has &0F
    BNE step_down
    LDA #&0F
    BNE store_down
.step_down
    CLC
    ADC row_down_step, X
.store_down
    STA sprite
.down_done
    LDX #INKEY_TEST(KEY_UP)
    JSR repeat_key
    BPL up_done
    JSR sheet_row
    CPX #&00
    BEQ up_done
    LDA sprite
    CMP #&0F                        ; the same two, upwards
    BNE not_f
    LDA #&0A
    BNE store_up
.not_f
    CMP #&24
    BNE step_up
    LDA #&0F
    BNE store_up
.step_up
    SEC
    LDA sprite
    SBC row_down_step-1, X          ; the row above's step (X is 1 or more)
.store_up
    STA sprite

    ; The auto-repeat: back to REPEAT_DELAY while no key is held, else
    ; count down, and after a repeat start again from REPEAT_RATE.
.up_done
    LDA repeat_count
    BNE delay
    LDA #REPEAT_RATE - 1
    STA repeat_count
.delay
    LDX #REPEAT_DELAY
    LDA key_held
    BEQ store_delay
    LDX repeat_count
    LDA key_repeating
    BEQ store_delay
    DEX
.store_delay
    STX repeat_count
    LDA select_mode
    BEQ wait
    JSR menu_keys_escape

    ; Wait until the interval timer reaches PASS_CENTISECONDS.
.wait
    LDA #OSWORD_READ_INTERVAL_TIMER
    JSR reset_timer.osword
    LDX #&04
    LDA #&00
.check
    ORA timer_value, X
    DEX
    BNE check
    CMP #&00
    BNE waited
    LDA timer_value
    CMP #PASS_CENTISECONDS
    BCC wait
.waited
    LDA #&00
    STA timer_value
    JSR reset_timer
    LDA old_sprite                  ; moved?
    CMP sprite
    BEQ sheet_row.return_negative
    JSR draw_sheet_sprite           ; the old sprite, without its box
    LDA sprite
    JSR show_selection

    ; A small sprite's grid is 8x16: keep the cursor in it.
    LDA sprite_width
    CMP #SMALL_WIDTH
    BNE changed
    LDX cursor_x
    CPX #SMALL_SPRITE_WIDTH
    BCC clamp_y
    LDX #SMALL_SPRITE_WIDTH - 1
    STX cursor_x
.clamp_y
    LDY cursor_y
    CPY #SMALL_SPRITE_HEIGHT
    BCC changed
    LDY #SMALL_SPRITE_HEIGHT - 1
    STY cursor_y
.changed
    LDA sprite                      ; and take an undo copy
    ORA #&80
    JSR draw_grid
    LDA #&00
    RTS
}

; How far down a step moves the selection from each row of the sheet (but
; the last), large rows 0-4 and then small rows 0-2. Up uses the row
; above's. (Some moves are special cases in select_sprite.)
.row_down_step
    EQUB 5, 5, &15, 5               ; large rows: &0B-&0E go to &20-&23
    EQUB LO(-&14)                   ; from the bottom large row to the small sprites
    EQUB 4, 4, 4                    ; small rows

; Set the interval timer to zero, the start of the main loop's pacing. Also
; entered at osword, with A = an OSWORD number, to read or write the timer
; from timer_value.
; Clobbers: A, X, Y
.reset_timer
{
    LDX #&04
    LDA #&00
.clear
    STA timer_value, X
    DEX
    BPL clear
    LDA #OSWORD_WRITE_INTERVAL_TIMER
.osword
    LDX #LO(timer_value)
    LDY #HI(timer_value)
    JMP OSWORD
}

; Set while a held cursor key is counting down to its next repeat.
.key_repeating
    EQUB &00

; The selected sprite's row in the sheet. Its last two bytes are also
; select_sprite's exit with nothing moved.
; In:  sprite
; Out: X = row (0-4 for the large sprites, 5-8 for the small ones),
;      last_column = 4; A = its column for a large sprite, &80 for a small
; Clobbers: nothing else
.sheet_row
{
    LDX #LARGE_COLUMNS - 1
    STX last_column
    LDA sprite
    CMP #FIRST_SMALL
    BCC sheet_column.large
    CMP #AFTER_SMALL
    BCS high
    LSR A
    LSR A
    AND #&03
    CLC
    ADC #LARGE_ROWS
    TAX
.return_negative
    LDA #&80
    RTS
.high
    SBC #AFTER_SMALL - FIRST_SMALL  ; positions &20-&28 follow &00-&0F
    BCS sheet_column.large          ; always
}

; The selected sprite's column in the sheet.
; In:  sprite
; Out: A = column, last_column = the last in its row (4 large, 3 small)
; Clobbers: X
.sheet_column
{
    LDA #LARGE_COLUMNS - 1
    STA last_column
    LDA sprite
    CMP #FIRST_SMALL
    BCC large
    CMP #AFTER_SMALL
    BCS high
    AND #&03
    LDX #SMALL_COLUMNS - 1
    STX last_column
    RTS
.high
    SBC #AFTER_SMALL - FIRST_SMALL  ; positions &20-&28 follow &00-&0F
.large
    JMP divide_by_5
}

; Where a pixel of the editing grid is on the screen.
; In:  X = pixel x, Y = pixel y
; Out: screen_ptr = its top line (four lines tall, one byte wide)
; Clobbers: A, Y
.grid_address
{
    TYA
    PHA
    AND #&FE                        ; a word a pair of rows
    TAY
    TXA
    ASL A                           ; a cell a pixel
    ASL A
    ASL A
    CLC
    ADC grid_row_address, Y
    STA screen_ptr
    LDA grid_row_address+1, Y
    ADC #&00
    STA screen_ptr+1
    PLA
    LSR A                           ; odd rows are the bottom half of the character row
    BCC done
    LDA screen_ptr
    ORA #&04
    STA screen_ptr
.done
    RTS
}

; Draw or rub out the pixel cursor: dots in the corners of a grid pixel,
; exclusive-ORed on.
; In:  X = pixel x, Y = pixel y
; Clobbers: A, Y, screen_ptr
.toggle_cursor
{
    JSR grid_address
    LDY #&03
.loop
    LDA cursor_shape, Y
    EOR (screen_ptr), Y
    STA (screen_ptr), Y
    DEY
    BPL loop
    RTS
}

; The pixel cursor's four lines: colour 2 in the outer pixels, top and bottom
; (exclusive-ORed, so it shows on any colour).
.cursor_shape
    EQUB mode5_byte("2..2"), 0, 0, mode5_byte("2..2")

; Ask for the name of a file to save to. If it exists it must be a graphics
; set or an IO file (setting io_file), and the user is asked whether to
; replace it: Cancel abandons the command.
; Out: input_buffer = the name; osfile_block filled (file_info); io_file
;      bit 7 set for an IO file
; Clobbers: A, X, Y, and as open_window
.ask_save_name
{
    LDA #WINDOW_INPUT
    LDX #LO(text_save_name)
    LDY #HI(text_save_name)
    JSR open_window
    JSR input_line
    LDA #WINDOW_INPUT
    JSR close_window
    JSR file_info
    BCS done
    CMP #OSFILE_TYPE_FILE           ; it exists
    BNE new
    JMP file_exists
.new
    LDA #&00                        ; a new file is a graphics set
    STA io_file
.done
    RTS
}

; check_filing_system's X: each file command's place in the Environment
; menu. The sprite commands need random access, which tape hasn't.
FILE_LOAD_SPRITE = 0
FILE_SAVE_SPRITE = 1
FILE_LOAD_FILE   = 2
FILE_SAVE_FILE   = 3

; Environment Save File (CTRL-f7): save the graphics set, &4000-&4F33, or
; write its three pieces into an IO file in place.
; Clobbers: everything
.cmd_save_file
{
    LDX #FILE_SAVE_FILE
    JSR check_filing_system
    JSR ask_save_name
    BIT io_file
    BMI io
    LDY #&0F                        ; clear the block after the name
    LDA #&00
.clear
    STA osfile_load, Y
    DEY
    BPL clear
    LDA #HI(graphics)               ; load and start address &4000...
    STA osfile_load+1
    STA osfile_start+1
    CLC
    ADC #HI(SET_SIZE)               ; ...end &4F34
    STA osfile_end+1
    LDA #LO(graphics_end)
    STA osfile_end
    LDA #OSFILE_SAVE
    JSR osfile_graphics
.done
    RTS

    ; An IO file: write the three pieces in.
.io
    JSR open_file.update
    LDA #&00
.segment
    PHA
    TAX
    JSR set_segment
    JSR read_block.write
    PLA
    CLC
    ADC #IO_SEGMENT
    CMP #io_segments_end - io_segments
    BCC segment
    JSR close_files
    JMP done
}
ASSERT LO(graphics) = 0 AND HI(graphics) + HI(SET_SIZE) = HI(graphics_end)

; Environment Save Sprite (CTRL-f9): write the selected sprite (and an
; object's name) into its place in an existing graphics set or IO file,
; then redraw everything (start.redraw, so the selection goes back to
; position 0).
; In:  sprite
; Clobbers: everything
.cmd_save_sprite
{
    LDX #FILE_SAVE_SPRITE
    JSR check_filing_system
    JSR ask_save_name
    JSR open_file.update
    LDA sprite
    JSR sprite_address
    JSR sprite_file_offset
    JSR sprite_last_byte
    INY
    STY gbpb_count
    LDA data_ptr
    STA gbpb_address
    LDA data_ptr+1
    STA gbpb_address+1
    JSR read_block.write
    LDA sprite_width
    CMP #SMALL_WIDTH
    BNE not_small
    JSR write_name
.not_small
    JSR close_files
    JMP start.redraw
}

; The file to save to exists: check what it is, and ask whether to replace
; it. Cancel returns from the command that asked (ask_save_name's caller).
; Out: as ask_save_name
; Clobbers: A, X, Y, and as menu
.file_exists
{
    JSR ask_load_name.found
    LDX #LO(text_exists)
    LDY #HI(text_exists)
    LDA #WINDOW_QUESTION
    JSR menu
    CMP #2                          ; Replace
    BNE cancel
    JMP ask_save_name.done
.cancel
    PLA                             ; drop ask_save_name's return
    PLA
    JMP cmd_save_file.done
}

; Call the filing system control vector.
; In:  A, X and Y for FSCV
; Clobbers: as the filing system does
.fscv
{
    JMP (FSCV)
}

; Point gbpb_block's file pointer at the sprite's place in the file.
; In:  data_ptr = the sprite's bytes; io_file
; Clobbers: A
.sprite_file_offset
{
    LDA data_ptr
    SEC
    SBC #LO(graphics)
    STA gbpb_pointer
    LDA data_ptr+1
    SBC #HI(graphics)
    STA gbpb_pointer+1
    BIT io_file
    BMI io
    RTS
.io
    LDA gbpb_pointer+1
    CMP #HI(slot_28 - graphics)     ; the slot IO keeps apart
    BNE io_graphics
    LDA #HI(IO_SLOT_28_OFFSET)      ; (the low byte is the same)
    STA gbpb_pointer+1
    RTS
.io_graphics
    LDA gbpb_pointer
    CLC
    ADC #LO(IO_GRAPHICS_OFFSET)
    STA gbpb_pointer
    LDA gbpb_pointer+1
    ADC #HI(IO_GRAPHICS_OFFSET)
    STA gbpb_pointer+1
    RTS
}

; Point gbpb_block's file pointer at the object's name in the file.
; In:  sprite = the object; io_file
; Out: Y = the name's offset in object_names
; Clobbers: A, X
.name_file_offset
{
    JSR name_offset
    LDX #&00
    BIT io_file
    BMI io
    LDX #HI(object_names - graphics)
.io
    TYA
    CLC
    ADC #LO(IO_NAMES_OFFSET)        ; the same low byte as SET_NAMES
    BCC store
    INX
.store
    STA gbpb_pointer
    STX gbpb_pointer+1
    RTS
}

; Unused: read a file's pointer into &8B-&8E (A isn't set here, though
; OSARGS needs it 0 for that).
.unused_read_ptr
{
    LDY gbpb_block
    LDX #&8B
    JMP OSARGS
}

; Clear gbpb_block, and refuse a command the filing system can't do.
; In:  X = the command, FILE_LOAD_SPRITE to FILE_SAVE_FILE
; Clobbers: A, Y
.check_filing_system
{
    LDY #&0F
    LDA #&00
.clear
    STA gbpb_block, Y
    DEY
    BPL clear
    BIT disc_fs
    BPL tape
.done
    RTS
.tape
    CPX #FILE_LOAD_FILE             ; whole files will do
    BCS done
    LDX #LO(text_not_available)
    LDY #HI(text_not_available)
    JMP show_error
}

; Unused: an error saying "Not implemented".
.unused_not_implemented
{
    LDX #LO(text)
    LDY #HI(text)
    JMP show_error
.text
    EQUB PLAIN, CR
    EQUS "Not implemented", CR
    EQUB TEXT_END
}

; Open the file named by osfile_block for reading; at update, for reading
; and writing. A missing file is "Bad File".
; In:  osfile_block = the filename's address
; Out: gbpb_block's handle
; Clobbers: A, X, Y
.open_file
{
    LDA #OSFIND_OPEN_INPUT
    BITABS
.update
    LDA #OSFIND_OPEN_UPDATE
    LDX osfile_block
    LDY osfile_block+1
    JSR OSFIND
    TAX
    BNE opened
    JMP bad_file
.opened
    STX gbpb_block
    RTS
}

; Environment Load Sprite (CTRL-f8): read the selected sprite (and an
; object's name) from its place in a graphics set or IO file, then redraw
; everything (start.redraw, so the selection goes back to position 0).
; In:  sprite
; Clobbers: everything
.cmd_load_sprite
{
    LDX #FILE_LOAD_SPRITE
    JSR check_filing_system
    JSR ask_load_name
    JSR open_file
    LDA sprite
    JSR sprite_address
    JSR sprite_file_offset
    JSR sprite_last_byte
    INY
    STY gbpb_count
    LDA data_ptr
    STA gbpb_address
    LDA data_ptr+1
    STA gbpb_address+1
    JSR read_block
    LDA sprite_width
    CMP #SMALL_WIDTH
    BNE not_small
    JSR read_name
.not_small
    JSR close_files
    JMP start.redraw
}

; Write the selected object's name to the file, unless it's the exit.
; In:  sprite, gbpb_block's handle
; Clobbers: A, X, Y
.write_name
{
    JSR name_transfer
    BCC read_block.write
    RTS
}

; Point gbpb_block at the selected object's name, in memory and in the file.
; In:  sprite
; Out: carry set (and nothing done) for the exit, which has no name
; Clobbers: A, X, Y
.name_transfer
{
    LDA sprite
    CMP #SLOT_EXIT
    BNE named
    RTS
.named
    JSR name_file_offset
    LDA #OBJECT_NAME_LENGTH
    STA gbpb_count
    JSR name_offset
    TYA
    CLC
    ADC #LO(object_names)
    STA gbpb_address
    LDA #HI(object_names)
    ADC #&00
    STA gbpb_address+1
    CLC
.done
    RTS
}

; Read the selected object's name from the file, unless it's the exit.
; In:  sprite, gbpb_block's handle
; Clobbers: A, X, Y
.read_name
{
    JSR name_transfer
    BCS name_transfer.done
}

; Read the block gbpb_block describes from the file; at write, write it.
; In:  gbpb_block: handle, address, count and pointer
; Clobbers: A, X, Y
.read_block
{
    LDA #OSGBPB_READ_AT
    BITABS
.write
    LDA #OSGBPB_WRITE_AT
    LDX #LO(gbpb_block)
    LDY #HI(gbpb_block)
    JMP OSGBPB
}

; Close all open files.
; Clobbers: A, Y
.close_files
{
    LDA #OSFIND_CLOSE
    TAY                             ; all of them
    JMP OSFIND
}

; Ask for the name of a file to load from: it must exist ("No Such File")
; and, on disc, be a graphics set (loading at &40xx, &Fxx long) or an IO
; file (&33xx long); anything else is "Bad File". Also entered at found, to
; check what an existing file is.
; Out: osfile_block filled (file_info); io_file bit 7 set for an IO file
; Clobbers: A, X, Y, and as open_window
.ask_load_name
{
    LDA #WINDOW_INPUT
    LDX #LO(text_load_name)
    LDY #HI(text_load_name)
    JSR open_window
    JSR input_line
    LDA #WINDOW_INPUT
    JSR close_window
    JSR file_info
    BCS found
    CMP #OSFILE_TYPE_FILE           ; not there
    BNE cmd_load_file.no_file
.found
    LDA #&00
    STA io_file
    BIT disc_fs
    BMI disc
    RTS
.disc
    LDA osfile_load+1
    CMP #HI(graphics)
    BNE check_io_file
    LDA osfile_start+1              ; the length's
    CMP #HI(SET_SIZE)
    BNE check_io_file
    RTS
}

; Bit 7 set when the file being loaded or saved is IO, not a graphics set.
; (It sits in the middle of ask_load_name.)
.io_file
    EQUB &00

; ask_load_name's end: a file that isn't a graphics set had better be IO.
; Out: as ask_load_name (or "Bad File", not returning)
; Clobbers: A
.check_io_file
{
    LDA osfile_start+1              ; the length's
    CMP #HI(IO_LENGTH)
    BEQ io
    JMP bad_file
.io
    LDA #&FF
    STA io_file
    RTS
}

; Environment Load File (CTRL-f6): load a graphics set, or the three pieces
; of one from an IO file, then redraw everything (start.redraw).
; Clobbers: everything
.cmd_load_file
{
    LDX #FILE_LOAD_FILE
    JSR check_filing_system
    JSR ask_load_name
    BIT io_file
    BMI load_io
    LDA #OSFILE_LOAD
    JSR osfile_graphics
    JMP start.redraw
.no_file
    LDX #LO(text_no_such_file)
    LDY #HI(text_no_such_file)
    JMP show_error
}

; Point gbpb_block at one of the pieces of an IO file.
; In:  X = the piece's entry's offset in io_segments: 0, IO_SEGMENT or
;      2 * IO_SEGMENT
; Clobbers: A
.set_segment
{
    LDA io_segments, X
    STA gbpb_address
    LDA io_segments+1, X
    STA gbpb_address+1
    LDA io_segments+2, X
    STA gbpb_pointer
    LDA io_segments+3, X
    STA gbpb_pointer+1
    LDA io_segments+4, X
    STA gbpb_count
    LDA io_segments+5, X
    STA gbpb_count+1
    RTS
}

; Load the graphics set's three pieces from an IO file, then redraw
; everything (start.redraw).
; Clobbers: everything
.load_io
{
    JSR open_file
    LDA #&00                        ; the first entry
.segment
    PHA
    TAX
    JSR set_segment
    JSR read_block
    PLA
    CLC
    ADC #IO_SEGMENT
    CMP #io_segments_end - io_segments
    BCC segment
    JSR close_files
    JMP start.redraw
}

; Where the graphics set is in an IO file (as MISSION builds it): each piece's
; address in the set, its offset in the file and its length.
IO_SEGMENT = 6                  ; bytes an entry
.io_segments
    EQUW slot_28, IO_SLOT_28_OFFSET, LARGE_SPRITE_SIZE
    EQUW object_names, IO_NAMES_OFFSET, OBJECT_KINDS * OBJECT_NAME_LENGTH
    EQUW graphics, IO_GRAPHICS_OFFSET, IO_GRAPHICS_SIZE         ; slots &00-&27
.io_segments_end

; Read the catalogue entry of the file named in input_buffer
; (OSFILE_READ_INFO). On tape it does nothing, returning through
; cmd_obj_name's RTS.
; In:  input_buffer = the name
; Out: carry set if the filing system isn't a disc one (nothing read); else
;      carry clear, A = the object type (OSFILE_TYPE_FILE for a file),
;      osfile_block filled
; Clobbers: X, Y
.file_info
{
    LDX #LO(input_buffer)
    STX osfile_block
    LDY #HI(input_buffer)
    STY osfile_block+1
    SEC
    BIT disc_fs
    BPL cmd_obj_name.done
    LDA #OSFILE_READ_INFO
}

; OSFILE on the graphics set at &4000.
; In:  A = OSFILE_SAVE, OSFILE_LOAD or OSFILE_READ_INFO; osfile_block's name
;      and, to save, its start and end
; Out: carry clear; A as OSFILE leaves it (for OSFILE_READ_INFO, the
;      object type)
; Clobbers: X, Y
.osfile_graphics
{
    LDX #&00
    STX osfile_exec                 ; exec address 0: load where we say
    LDX #LO(graphics)
    STX osfile_load
    LDX #HI(graphics)
    STX osfile_load+1
    BIT disc_fs
    BMI call
    PHA
    LDA #VDU_CLS                    ; on tape, clear the screen for the filing system's messages
    JSR OSWRCH
    PLA
.call
    LDX #LO(osfile_block)
    LDY #HI(osfile_block)
    JSR OSFILE
    CLC
    RTS
}

; The "Bad File" error.
; Out: doesn't return
.bad_file
{
    LDX #LO(text_bad_file)
    LDY #HI(text_bad_file)
    JMP show_error
}

; OptionsA Obj name (CTRL-N): rename the selected object (not the exit).
; In:  sprite
; Clobbers: everything
.cmd_obj_name
{
    LDA sprite_width
    CMP #SMALL_WIDTH
    BEQ small
.done
    RTS
.small
    LDA sprite
    CMP #SLOT_EXIT
    BEQ done
    LDA #WINDOW_INPUT
    LDX #LO(text_object_name)
    LDY #HI(text_object_name)
    JSR open_window
    JSR input_line
    JSR name_offset
    LDX #&00
.copy
    LDA input_buffer, X
    STA object_names, Y
    INY
    INX
    CPX #OBJECT_NAME_LENGTH
    BCC copy
    LDA #WINDOW_INPUT
    JSR close_window
    LDA sprite
    JMP show_selection
}

; The line input_line edits: twelve characters, padded with spaces, and a
; CR after the sixteen bytes it clears (which a filename stops at).
.input_buffer
    SKIP OBJECT_NAME_LENGTH
    EQUB CR, CR, CR, CR, CR

; Read a line of up to input_limit characters into input_buffer, echoing
; it at screen_ptr. Delete rubs out a character, CTRL-U the lot; Return
; ends it; Escape or a function key abandons the command
; (pick_second_sprite.abandon_command).
; In:  screen_ptr = where to echo it (open_window leaves it after the text)
; Out: input_buffer, padded with spaces; Y = its length
; Clobbers: A, X, screen_ptr, aux_ptr
.input_line
{
    LDY #OBJECT_NAME_LENGTH         ; the longest a name can be, file or object
    STY input_limit
    LDY #&00
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    JSR OSBYTE
    LDY #&0F
    LDA #ascii(" ")
.blank
    STA input_buffer, Y
    DEY
    BPL blank
    INY
.read
    LDA #ascii(" ")                 ; a space after the line: what a rub-out leaves
    STA input_buffer, Y
    JSR OSRDCH
    BCC got_key
.abandon
    JMP pick_second_sprite.abandon_command
.got_key
    CMP #KEYCODE_F0
    BCS abandon
    CMP #CR
    BNE edit
    RTS
.edit
    AND #&7F                        ; the cursor keys' codes become control codes, ignored
    CMP #ctrl("U")
    BNE not_wipe
    TYA
    TAX
    BNE rub_out
    BEQ read
.not_wipe
    CMP #DEL
    BNE add
    CPY #&00
    BEQ read
    LDX #&01
.rub_out
    LDA screen_ptr
    SEC
    SBC #CELL
    STA screen_ptr
    BCS erase
    DEC screen_ptr+1
.erase
    CLC                             ; exclusive-OR it off again
    LDA input_buffer-1, Y
    JSR print_char
    DEY
    DEX
    BNE rub_out
    JMP read
.add
    CMP #ascii(" ")
    BCC read
    CPY input_limit
    BCS read
    STA input_buffer, Y
    INY
    JSR print_char_advance          ; carry clear: exclusive-OR it on
    JMP read
}

; The longest line input_line takes (always OBJECT_NAME_LENGTH).
.input_limit
    EQUB &00

; The pixel cursor's key repeat, in trips round key_delay's loop: it starts
; at CURSOR_DELAY, and each move shortens it by CURSOR_DELAY_STEP down to
; CURSOR_DELAY_MIN.
CURSOR_DELAY      = &B9
CURSOR_DELAY_STEP = 10
CURSOR_DELAY_MIN  = 10

; Paint: move the pixel cursor with Z X : /, faster as a key is held;
; choose the colour with 0-4; plot with Return or clear with Delete. Does
; nothing while CTRL is held, for the shortcuts. Plotting draws the sprite
; again on the sheet, which rubs out its selection box until it moves.
; In:  sprite, cursor_x, cursor_y, colour
; Clobbers: A, X, Y, and as draw_sheet_sprite
.edit_pixels
{
    LDX #INKEY_TEST(KEY_CTRL)
    JSR key_pressed
    BPL move
    RTS
.move
    LDX cursor_x
    LDY cursor_y
    STX old_cursor_x
    STY old_cursor_y
    LDA sprite_width                ; count_x = width*4 - 1, the last pixel across
    ASL A
    ASL A
    STA count_x
    ASL A                           ; count_y = width*8 - 1, the last row
    STA count_y
    DEC count_x
    DEC count_y
    LDX #INKEY_TEST(KEY_X)
    JSR key_pressed
    BPL not_right
    LDX cursor_x
    CPX count_x
    BCS not_right
    LDX #INKEY_TEST(KEY_X)
    JSR key_delay
    INC cursor_x
.not_right
    LDX #INKEY_TEST(KEY_Z)
    JSR key_pressed
    BPL not_left
    LDX cursor_x
    BEQ not_left
    LDX #INKEY_TEST(KEY_Z)
    JSR key_delay
    DEC cursor_x
.not_left
    LDX #INKEY_TEST(KEY_SLASH)
    JSR key_pressed
    BPL not_down
    LDY cursor_y
    CPY count_y
    BCS not_down
    LDX #INKEY_TEST(KEY_SLASH)
    JSR key_delay
    INC cursor_y
.not_down
    LDX #INKEY_TEST(KEY_COLON)
    JSR key_pressed
    BPL not_up
    LDY cursor_y
    BEQ not_up
    LDX #INKEY_TEST(KEY_COLON)
    JSR key_delay
    DEC cursor_y
.not_up
    LDX #INKEY_TEST(KEY_1)
    JSR key_pressed
    BPL not_1
    LDA #&01
    STA colour
    JSR show_colour
.not_1
    LDX #INKEY_TEST(KEY_2)
    JSR key_pressed
    BPL not_2
    LDA #&02
    STA colour
    JSR show_colour
.not_2
    LDX #INKEY_TEST(KEY_3)
    JSR key_pressed
    BPL not_3
    LDA #&03
    STA colour
    JSR show_colour
.not_3
    LDX #INKEY_TEST(KEY_4)
    JSR key_pressed
    BMI colour_0
    LDX #INKEY_TEST(KEY_0)
    JSR key_pressed
    BPL not_0

    ; 4 and 0 both give colour 0.
.colour_0
    LDA #&00
    STA colour
    JSR show_colour

    ; Moved: shorten the repeat delay and move the cursor.
.not_0
    LDA old_cursor_x
    EOR cursor_x
    BNE moved
    EOR cursor_y
    EOR old_cursor_y
    BEQ still
.moved
    LDA repeat_delay
    SEC
    SBC #CURSOR_DELAY_STEP
    CMP #CURSOR_DELAY_MIN
    BCS delay_ok
    LDA #CURSOR_DELAY_MIN
.delay_ok
    STA repeat_delay
    LDX cursor_x
    LDY cursor_y
    JSR toggle_cursor               ; draw it at the new place...
    LDX old_cursor_x
    LDY old_cursor_y
    JSR toggle_cursor               ; ...and rub it out at the old
    JMP plot_keys
.still
    LDA #CURSOR_DELAY
    STA repeat_delay
.plot_keys
    LDX #INKEY_TEST(KEY_DELETE)
    JSR key_pressed
    BPL not_delete
    LDA colour
    PHA
    INX                             ; X = &FF + 1: colour 0
    STX colour
    JSR plot
    PLA
    STA colour
    RTS
.not_delete
    LDX #INKEY_TEST(KEY_RETURN)
    JSR key_pressed
    BPL done

    ; Plot: fill the grid pixel (keeping the cursor on it), set the pixel in
    ; the sprite, and show the sprite in the sheet.
.plot
    LDX cursor_x
    LDY cursor_y
    JSR grid_address
    LDY #&03
    LDX colour
.block
    LDA colour_byte, X
    EOR cursor_shape, Y
    STA (screen_ptr), Y
    DEY
    BPL block
    LDA sprite
    LDX cursor_x
    LDY cursor_y
    JSR plot_pixel
    LDA sprite
    BNE not_background
    JSR repeat_background           ; position 0 repeats its 4x8 cell
.not_background
    LDA sprite
    JSR draw_sheet_sprite
.done
    RTS
}

; Sheet position 0 shows slot 0, the floor; the game fills the floor round an
; object's icon from that picture's first cell alone, so the designer keeps
; it one 4x8 pixel cell repeated. Copy the cell just changed through the
; whole sprite, and draw the grid again.
; In:  data_ptr = the byte plot_pixel changed
; Clobbers: A, X, Y, and as redraw_grid
.repeat_background
{
    LDA data_ptr
    AND #&F8                        ; the start of its cell
    STA data_ptr
    LDY #&07
.read
    LDA (data_ptr), Y
    STA background_tile, Y
    DEY
    BPL read
    LDY #LARGE_SPRITE_SIZE - 1
    LDX #&07
.fill
    LDA background_tile, X
    STA graphics + SET_LARGE, Y     ; slot 0
    DEX
    TXA
    AND #&07
    TAX
    DEY
    BPL fill
    CLC
    JMP redraw_grid
}

; The background tile's eight bytes: the cell repeat_background repeats.
.background_tile
    EQUB &00, &00, &00, &00, &00, &00, &00, &00

; The pixel cursor's key repeat: wait while the key is held, for up to
; repeat_delay polls of it with a 256-trip spin between them.
; In:  X = INKEY_TEST() of the key
; Clobbers: A, X, Y, temp, count_x
.key_delay
{
    STX temp
    LDA repeat_delay
    STA count_x
.poll
    LDX temp
    JSR key_pressed
    BMI held
    RTS
.held
    LDX #&00
.spin
    DEX
    BNE spin
    DEC count_x
    BNE poll
    RTS
}

; The bits of each of the four pixels in a MODE 5 byte.
.pixel_mask
    EQUB mode5_byte("3..."), mode5_byte(".3.."), mode5_byte("..3."), mode5_byte("...3")

; Find a pixel of a sprite.
; In:  A = sprite, X = pixel x, Y = pixel y
; Out: data_ptr = its byte, A = mask = its bits
; Clobbers: X, Y, pixel_x, pixel_y, sprite_width
.pixel_address
{
    STX pixel_x
    STY pixel_y
    JSR sprite_address
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    TAY                             ; a column's bytes
    LDA pixel_x
    LSR A
    LSR A
    TAX
.column
    DEX                             ; a column of bytes for each four pixels across
    BMI got_column
    TYA
    CLC
    ADC data_ptr
    STA data_ptr
    BCC column                      ; always: no sprite crosses a page
.got_column
    LDA pixel_y                     ; columns start at multiples of their size
    ORA data_ptr
    STA data_ptr
    LDA pixel_x
    AND #&03
    TAX
    LDA pixel_mask, X
    STA mask
    RTS
}

; Set a pixel of a sprite to colour.
; In:  A = sprite, X = pixel x, Y = pixel y, colour
; Clobbers: A, X, Y, data_ptr, temp, mask, pixel_x, pixel_y, sprite_width
.plot_pixel
{
    JSR pixel_address
    EOR #&FF
    LDY #&00
    AND (data_ptr), Y
    STA temp
    LDX colour
    LDA colour_byte, X
    AND mask
    ORA temp
    STA (data_ptr), Y
    RTS
}

; Read a pixel of a sprite.
; In:  A = sprite, X = pixel x, Y = pixel y
; Out: A = its colour, 0-3
; Clobbers: X, Y, data_ptr, mask, pixel_x, pixel_y, sprite_width
.read_pixel
{
    JSR pixel_address
    LDY #&00
    AND (data_ptr), Y

    ; Shift the pixel's two bits down to make its colour.
.find_bit
    LSR mask
    BCS got_bit
    LSR A
    BCC find_bit
.got_bit
    LSR A
    PHP
    LSR A
    LSR A
    LSR A
    PLP
    ROL A
    RTS
}

; Each menu's text, and the function key that opens it, by window number.
.menu_text
    EQUW text_options_a, text_options_b, text_environment, text_credits
.menu_keys
    EQUB INKEY_TEST({KEY_F0, KEY_F1, KEY_F2, KEY_F3})

; Read a command: a CTRL shortcut, or a choice from the menu whose function
; key is pressed.
; Out: A = the command's number in command_table (menu * 8 + item), 0 for
;      the credits, or &FF for none
; Clobbers: X, Y, temp, and as menu
.read_command
{
    LDX #INKEY_TEST(KEY_CTRL)
    JSR key_pressed
    BPL menus
    LDA #SHORTCUTS - 1              ; from the last of shortcut_keys
    STA temp
.shortcut
    LDY temp
    LDX shortcut_keys, Y
    BPL next_shortcut               ; not a key: an unused entry
    JSR key_pressed
    BMI found
.next_shortcut
    DEC temp
    BPL shortcut
    LDA #&FF
    RTS
.found
    INC temp                        ; the shortcut's command is one more than its place
    LDA temp
    RTS
.menus
    LDA #WINDOW_CREDITS             ; from the last menu, the credits
.menu_key
    PHA
    TAY
    LDX menu_keys, Y
    JSR key_pressed
    BPL next_menu
    PLA
    PHA
    ASL A
    TAY
    LDX menu_text, Y
    LDA menu_text+1, Y
    TAY
    PLA
    PHA
    JSR menu
    CMP #&00                        ; the credits: nothing to pick
    BNE picked
    PLA
    LDA #&00
    RTS
.picked
    STA temp
    PLA
    ASL A                           ; menu * 8 + item, or &FF if nothing was picked
    ASL A
    ASL A
    ORA temp
    RTS
.next_menu
    PLA
    SEC
    SBC #&01
    BCS menu_key
    RTS
}

; The CTRL shortcuts, in command order from command 1; entries that aren't
; keys (below &80) have none.
.shortcut_keys
    EQUB INKEY_TEST({KEY_X, KEY_Y, KEY_DELETE, KEY_U, KEY_A, KEY_N}), NO_KEY, NO_KEY ; OptionsA
    EQUB INKEY_TEST({KEY_S, KEY_COPY, KEY_O}), NO_KEY, INKEY_TEST({KEY_R, KEY_B}), NO_KEY, NO_KEY ; OptionsB
    EQUB INKEY_TEST({KEY_F8, KEY_F9, KEY_F6, KEY_F7, KEY_C}), 0, 0, 0                ; Environment
SHORTCUTS = P% - shortcut_keys

; Which cursor key the selection last saw held (INKEY_TEST() of it, or 0),
; and a byte nothing uses.
.key_held
    EQUB 0, 0
; Non-zero while picking a second sprite.
.select_mode
    EQUB 0
; The interval timer, as OSWORD_READ_INTERVAL_TIMER reads it.
.timer_value
    EQUB 0, 0, 0, 0, 0

; While picking a second sprite or animating, f0-f3 count as Escape: raise
; one if any of them is pressed.
; Clobbers: A, X, Y
.menu_keys_escape
{
    LDA #WINDOW_CREDITS             ; f3 down to f0
.loop
    PHA
    TAY
    LDX menu_keys, Y
    JSR key_pressed
    BPL next
    LDA #OSBYTE_RAISE_ESCAPE
    JSR OSBYTE
.next
    PLA
    SEC
    SBC #&01
    BCS loop
    RTS
}

; Not part of the program: what was in memory after it when it was saved
; (a pointer table and graphics, from the look of it).
.leftover
    EQUB &FF, &9A, &4C, &C3, &12, &FC, &1F, &01
    EQUB &1F, &44, &1F, &CD, &1F, &D7, &20, &56
    EQUB &1F, &8A, &20, &19, &1A, &F5, &20, &B7
    EQUS " H s & "
    EQUB &05, &20, &10, &1F, &0E, &20, &0A, &15
    EQUB &8B, &1C, &C2, &1C, &1E, &18, &75, &16
    EQUB &F5, &1C, &FC, &1D, &A9, &18, &A9, &18
    EQUB &A9, &18, &A9, &18, &0A, &15, &08, &07
    EQUB &0A
    EQUB &09, &0C, &0C, &19, &F0, &C0, &80, &33
    EQUB &77, &FF, &FF, &FF, &00, &00, &FF, &FF
    EQUB &FF, &CC, &88, &88, &00, &00, &FF, &FF
    EQUB &FF, &33, &11, &11, &0F, &03, &01, &CC
    EQUB &EE, &EE, &FF, &FF, &F0, &F0, &F0, &F0
    EQUS "pp00"
    EQUB &F0, &F0, &F0, &E0, &C0, &C0, &91, &C0
    EQUB &E0, &80, &11, &77, &FF, &FF, &FF, &FF
    EQUB &00, &00, &FF, &FF
    EQUB &FF, &88, &88, &88, &00, &00, &FF, &FF
    EQUB &FF, &00, &00, &00, &00, &00, &FF, &FF
    EQUB &FF, &00, &00, &10, &F0, &70, &30, &98
    EQUB &30, &70, &F0, &F0, &F0, &F0, &F0, &F0
    EQUB &F0, &F0, &F0, &F0, &F0, &F0, &F0, &E0
    EQUB &E0, &F0, &F0, &F0, &C0, &80
    EQUS "3ww333"
    EQUB &10, &10, &CC, &EE, &EE, &EE, &EE, &EE
    EQUB &F0, &F0, &F0, &70
    EQUS "pppp"
    EQUB &00, &00, &F0, &F0, &F0, &F0, &F0, &F0
    EQUB &FF, &FF, &F0, &E0, &C0, &C0, &91, &91
ENDSECTION

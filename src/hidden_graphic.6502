        ".3..333.333.333.333.333..3..333.",
        "333...3.3.3.3...3.3.3.3.333.3.3.",
        ".3..333.3.3.3...3.3.333..3..3.3.",
        ".3..3.3.3.3.3...3.3.3....3..333.",
        "333.333.333.333.333.333..3....3.",
        "............................333.",
    }
    ; h i j k l m n o
    SPRITE_COLUMNS {
        "3....3...3..3...33..............",
        "3...........3....3..............",
        "333.33...3..3.3..3..3.3.333.333.",
        "3.3..3...3..3.3..3..333.3.3.3.3.",
        "3.3..3...3..33...3..3.3.3.3.3.3.",
        "3.3..3...3..3.3..3..3.3.3.3.3.3.",
        "3.3.333..3..3.3.333.3.3.3.3.333.",
        "........33......................",
    }
    ; p q r s t u v w
    SPRITE_COLUMNS {
        ".................3..............",
        ".................3..............",
        "333.333.333.333.333.3.3.3.3.3.3.",
        "3.3.3.3.3...3....3..3.3.3.3.3.3.",
        "3.3.3.3.3...333..3..3.3.3.3.3.3.",
        "333.333.3.....3..3..3.3.3.3.333.",
        "3.....3.3...333..33.333..3..3.3.",
        "3.....3.........................",
    }
    ; x y z { | } ~ DEL
    SPRITE_COLUMNS {
        "..............3..3...3..3.......",
        ".............3...3...3...3......",
        "3.3.3.3.333..3...3...3..3.3.....",
        "3.3.3.3...3.33........3...3.....",
        ".3..3.3..3...3...3...3..3.3.....",
        "3.3.333..3...3...3...3...3......",
        "3.3...3.333...3..3...3..3.......",
        "....333.........................",
    }

; Bit 7 set while each window is open (and its background saved). start
; clears all twenty bytes; only eight windows exist.
.window_open
    SKIP 20

; The screen address of each pair of pixel rows of the editing grid.
.grid_row_address
    FOR r = 0..15
        EQUW edit_grid + r*ROW
    NEXT

; Each window's top left corner on the screen...
.window_address
    EQUW SCREEN                     ; OptionsA
    EQUW SCREEN + 8*CELL            ; OptionsB
    EQUW SCREEN + 16*CELL           ; Environment
    EQUW SCREEN + 24*CELL           ; credits
    EQUW SCREEN + 21*ROW + 4*CELL   ; select a sprite
    EQUW SCREEN + 22*ROW + 4*CELL   ; questions
    EQUW SCREEN + 22*ROW + 2*CELL   ; names
    EQUW SCREEN + 14*ROW + 12*CELL  ; errors

; ...and its width in bytes less one, and its height in character rows.
.window_size
    EQUB 8*CELL-1, 8
    EQUB 8*CELL-1, 8
    EQUB 11*CELL-1, 8
    EQUB 16*CELL-1, 6
    EQUB 14*CELL-1, 7
    EQUB 8*CELL-1, 6
    EQUB 16*CELL-1, 7
    EQUB 16*CELL-1, 6

; Point at a window.
; In:  A = window number (only bits 0-2 count)
; Out: screen_ptr and aux_ptr = its corner on the screen, save_ptr =
;      window_store, count_x = width in bytes less one, count_y = height in
;      rows, Y = window number * 2
; Clobbers: A
.window_setup
{
    AND #&07
    ASL A
    TAY
    LDA #HI(window_store)
    STA save_ptr+1
    LDA window_address, Y
    STA screen_ptr
    STA aux_ptr
    LDA window_address+1, Y
    STA screen_ptr+1
    STA aux_ptr+1
    LDA #LO(window_store)
    STA save_ptr
    LDA window_size, Y
    STA count_x
    LDA window_size+1, Y
    STA count_y
    RTS
}

; Open a window and write text in it.
; In:  A = window number (bit 7 ignored), X/Y = its text (see CR, TEXT_END)
; Out: line_count = lines in the text less one, mask = the text's flag byte
; Clobbers: A, X, Y, screen_ptr, data_ptr, save_ptr, aux_ptr, border_ptr,
;      count_x, count_y
; Any open window is closed first, so they never overlap. The window is
; filled in colour 1 for the title row and colour 3 below, keeping what it
; covers at window_store.
.open_window
{
    STX data_ptr
    STY data_ptr+1
    AND #&7F
    PHA
    LDA #7                          ; the last window

    ; Close every window, 7 to 0.
.close_others
    PHA
    TAX
    JSR close_window
    PLA
    SEC
    SBC #&01
    BCS close_others
    PLA
    PHA
    TAX
    ORA #&80
    STA window_open, X
    JSR window_setup
    LDX #&0F                        ; the title row is colour 1
.fill_row
    LDY count_x
.fill_byte
    LDA (screen_ptr), Y
    STA (save_ptr), Y
    TXA
    STA (screen_ptr), Y
    DEY
    BPL fill_byte
    LDX #&FF                        ; and the rest colour 3
    JSR next_window_row
    DEC count_y
    BNE fill_row
    LDA aux_ptr
    STA save_ptr
    STA screen_ptr
    LDA aux_ptr+1
    STA save_ptr+1
    STA screen_ptr+1
    PLA
}

; Write a window's text; open_window's second half.
; In:  A = window number, data_ptr = the text, screen_ptr and save_ptr = its
;      corner
; Out: line_count = lines less one, mask = the flag byte
; Clobbers: A, X, Y, data_ptr, screen_ptr, save_ptr, border_ptr, count_y
; Then draws the window's frame in colour 2: a line down its right edge and
; along its bottom.
.print_window_text
{
    PHA
    LDY #&FF
    STY line_count
    INY
    LDA (data_ptr), Y
    STA mask
.next_char
    INC data_ptr
    BNE read_char
    INC data_ptr+1
.read_char
    LDY #&00
    LDA (data_ptr), Y
    CMP #TEXT_END
    BEQ frame
    CMP #CR
    BEQ new_line
    CLC
    JSR print_char_advance          ; carry clear: exclusive-OR the glyph on
    BNE next_char                   ; always: screen_ptr is never zero
.new_line
    INC line_count
    LDA save_ptr
    CLC
    ADC #&40
    STA save_ptr
    STA screen_ptr
    LDA save_ptr+1
    ADC #&01
    STA save_ptr+1
    STA screen_ptr+1
    BCC next_char

    ; The frame: the rightmost pixel of each row, then the bottom line.
.frame
    PLA
    AND #&07
    ASL A
    TAY
    LDA window_address, Y
    STA border_ptr
    LDA window_address+1, Y
    STA border_ptr+1
    LDA window_size+1, Y
    SBC #&00                        ; carry clear here, so count_y = rows - 1
    STA count_y
.frame_row
    LDY count_x
    LDX #&07
    LDA border_ptr
    CLC
    ADC #LO(ROW)
    STA border_ptr
    LDA border_ptr+1
    ADC #HI(ROW)
    STA border_ptr+1
.frame_right
    LDA (border_ptr), Y
    AND #&EE                        ; pixel 3 becomes colour 2
    ORA #&10
    STA (border_ptr), Y
    DEY
    DEX
    BPL frame_right
    DEC count_y
    BNE frame_row
    LDY count_x
.frame_bottom
    LDA #&F0
    STA (border_ptr), Y
    TYA
    SEC
    SBC #&08
    TAY
    BCS frame_bottom
    RTS
}

; Step both of a window's pointers down a row: save_ptr past the bytes
; just kept, screen_ptr to the next character row.
; In:  count_x = the window's width in bytes less one
; Clobbers: A
.next_window_row
{
    LDA save_ptr
    SEC
    ADC count_x
    STA save_ptr
    BCC next_screen_row
    INC save_ptr+1
.next_screen_row
    LDA screen_ptr
    CLC
    ADC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(ROW)
    STA screen_ptr+1
    RTS
}

; Close every window.
; Clobbers: A, X, Y, screen_ptr, save_ptr, aux_ptr, count_x, count_y
.close_all_windows
{
    LDX #&07
.loop
    TXA
    PHA
    JSR close_window
    PLA
    TAX
    DEX
    BPL loop
    RTS
}

; Close a window, putting back what it covered, if it is open.
; In:  A = window number (bit 7 ignored)
; Clobbers: A, X, Y, screen_ptr, save_ptr, aux_ptr, count_x, count_y
.close_window
{
    AND #&7F
    PHA
    TAY
    LDA window_open, Y
    BMI open
    PLA
    RTS
.open
    PLA
    PHA
    JSR window_setup
.row
    LDY count_x
.byte
    LDA (save_ptr), Y
    STA (screen_ptr), Y
    DEY
    BPL byte
    JSR next_window_row
    DEC count_y
    BNE row
    PLA
    TAX
    LDA #&00
    STA window_open, X
    RTS
}

; Is a key pressed?
; In:  X = INKEY_TEST() of the key
; Out: A = X = &FF and N set if it is, 0 and N clear if not
; Clobbers: Y
.key_pressed
{
    LDA #OSBYTE_INKEY
    TAY                             ; Y >= &80: scan for one key
    JSR OSBYTE
    TXA
    RTS
}

; Wait until a key is released, so one press does one thing.
; In:  X = INKEY_TEST() of the key
; Clobbers: A, Y
.wait_key_release
{
    TXA
    PHA
    JSR key_pressed
    TAY
    PLA
    TAX
    INY
    BEQ wait_key_release
    RTS
}

; Print a character and step screen_ptr on a cell.
; In:  A = character, carry set to store it, clear to exclusive-OR it
; Clobbers: A, aux_ptr
.print_char_advance
{
    JSR print_char
    LDA screen_ptr
    CLC
    ADC #CELL
    STA screen_ptr
    BCC done
    INC screen_ptr+1
.done
    RTS
}

; Draw a character at screen_ptr from the font.
; In:  A = character (below &20 prints as a space), carry set to store it
;      (in colour 3 on black), clear to exclusive-OR it with the screen
;      (on a window, so drawing it again rubs it out)
; Clobbers: A, aux_ptr
.print_char
{
    PHP
    STY saved_y
    STX saved_x
    LDY #&00
    STY aux_ptr+1
    LDX #&00
    CMP #ascii(" ")
    BCS printable
    LDA #ascii("!")                 ; a control code: a space (carry is clear)
.printable
    SBC #ascii(" ")
    ASL A
    ASL A
    ROL aux_ptr+1
    ASL A
    ROL aux_ptr+1
    TAX
    LDA aux_ptr+1
    ADC #&1D
    TAY
    STX aux_ptr
    STY aux_ptr+1
    PLP
    LDY #&07
.row
    LDA (aux_ptr), Y
    BCS store
    EOR (screen_ptr), Y
.store
    STA (screen_ptr), Y
    DEY
    BPL row
    LDX saved_x
    LDY saved_y
    RTS
.saved_x
    EQUB &00
.saved_y
    EQUB &00
}

; Open a window and let the user pick from it: a menu.
; In:  A = window number, X/Y = its text; if the text's flag is MENU the lines
;      after the title are a list to move along with the cursor keys
; Out: A = X = the line picked with Return (1 = the first after the title,
;      0 if the text has no list), or &FF if left with Space, Escape or a
;      different function key
; Clobbers: Y, and as open_window
; The cursor keys are made to give codes while it runs, and the function keys
; to give CODE_F0 upwards.
.menu
{
    PHA
    JSR open_window
    PLA
    PHA
    AND #&07                        ; count_y = this window's number, for the function key test
    STA count_y
    ASL A
    TAY
    LDA window_address, Y
    STA screen_ptr
    LDA window_address+1, Y
    STA screen_ptr+1
    JSR next_window_row.next_screen_row
    LDA #&FF
    STA item
    BIT mask
    BPL no_list
    JSR invert_menu_row
    INC item
.no_list
    LDA #OSBYTE_CURSOR_EDITING      ; the cursor keys give codes
    LDX #&01
    JSR OSBYTE
    LDA #OSBYTE_FUNCTION_KEY_BASE   ; f0-f9 give CODE_F0 up
    LDX #CODE_F0
    LDY #&00
    JSR OSBYTE
.read_key
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    LDX #&00
    JSR OSBYTE
    JSR OSRDCH
    BCC got_key
.cancel
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE  ; if there was an Escape
    JSR OSBYTE
    LDA #OSBYTE_FUNCTION_KEY_BASE   ; function keys back to strings
    LDX #&01
    LDY #&00
    JSR OSBYTE
    PLA
    JSR close_window
    LDX #&FF
    TXA
    RTS
.got_key
    CMP #&C8                        ; a function key...
    BCC not_fkey
    AND #&03
    CMP count_y                     ; ...other than this menu's own closes it
    BNE cancel
.not_fkey
    CMP #ascii(" ")
    BEQ cancel
    CMP #CR
    BEQ chosen
    BIT mask
    BPL read_key
    CMP #CODE_DOWN
    BEQ down
    CMP #CODE_UP
    BNE read_key
    LDA item
    BEQ read_key
    JSR invert_menu_row
    DEC item
    LDA screen_ptr
    SBC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    SBC #HI(ROW)
    STA screen_ptr+1
    BCS highlight
.down
    LDA item
    CLC
    ADC #&01
    CMP line_count
    BEQ read_key
    JSR invert_menu_row
    INC item
    JSR next_window_row.next_screen_row
.highlight
    JSR invert_menu_row
    JMP read_key
.chosen
    PLA
    JSR close_window
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    LDX #&00
    JSR OSBYTE
    LDX #INKEY_TEST(KEY_RETURN)
    JSR wait_key_release
    LDX item
    INX
    TXA
    RTS
}

; Highlight or unhighlight a line of a window, by exclusive-ORing
; colours 1 and 2 in and redrawing the right edge of the frame.
; In:  screen_ptr = the line, count_x = the window's width less one
; Clobbers: A, X, Y
.invert_menu_row
{
    LDY count_x
.invert
    LDA (screen_ptr), Y
    EOR #&0F
    STA (screen_ptr), Y
    DEY
    BPL invert
    LDY count_x
    LDX #&07
.border
    LDA (screen_ptr), Y
    AND #&EE
    ORA #&10
    STA (screen_ptr), Y
    DEY
    DEX
    BPL border
    RTS
}

; A sprite's size class from its number.
; In:  A = sprite number
; Out: sprite_width = 2 for the small sprites (&10-&1F), else 4; data_ptr =
;      graphics (where sprite_address starts from)
; Clobbers: X
.sprite_class
{
    LDX #LO(graphics)
    STX data_ptr
    LDX #HI(graphics)
    STX data_ptr+1
    LDX #LARGE_WIDTH
    CMP #FIRST_SMALL
    BCC store
    CMP #AFTER_SMALL
    BCS store
    LDX #SMALL_WIDTH
.store
    STX sprite_width
    RTS
}

; Find a sprite's bytes.
; In:  A = sprite number: a sheet position (see slot_of_position), or a slot
;      when by_slot has bit 7 set; SPRITE_FRAME_A and SPRITE_FRAME_B (with or
;      without bit 7) are the two frame buffers
; Out: data_ptr = its first byte, sprite_width = its width in bytes, A = Y =
;      the sprite number
; Clobbers: X
.sprite_address
{
    TAY
    JSR sprite_class
    CMP #&57                        ; &57 up: a frame buffer
    BCS frame
    TAY
    AND #&10
    BNE small
    TYA
    BIT by_slot
    BMI slot
    CMP #AFTER_SMALL                ; positions &20-&28 follow &00-&0F in the table
    BCC mapped
    SBC #&10
.mapped
    TAX
    LDA slot_of_position, X

    ; Large slots &00-&0F are at graphics + slot*&80, &20-&28 from +&A00.
.slot
    CMP #&20                        ; slots &20 up
    BCS high_slot
    LSR A
    TAX
    LDA #&00                        ; the odd half page
    ROR A
    STA data_ptr
    TXA
    ADC data_ptr+1
    STA data_ptr+1
    TYA
    RTS
.frame
    AND #&7F
    CMP #&58
    LDA #&00
    ROR A
    STA data_ptr
    LDA #HI(frame_a)
    STA data_ptr+1
    TYA
    RTS
.high_slot
    AND #&0F
    TAX
    LDA data_ptr+1
    CLC
    ADC #HI(&A00)                   ; slots &20 on are at +&A00
    STA data_ptr+1
    TXA
    JMP slot

    ; Small slots &10-&1F are at graphics + &800 + (slot AND &0F)*&20.
.small
    TYA
    PHA
    LDA data_ptr+1
    CLC
    ADC #HI(&800)                   ; small sprites start at +&800
    STA data_ptr+1
    PLA
    ASL A
    ASL A
    ASL A
    ASL A
    ASL A
    BCC small_done
    INC data_ptr+1
.small_done
    CLC
    ADC data_ptr
    STA data_ptr
    TYA
    RTS
}

; The offset of the last byte of the sprite sprite_width describes.
; Out: Y = &7F for a large sprite, &1F for a small one
; Clobbers: X
.sprite_last_byte
{
    LDY #LARGE_WIDTH*32-1
    LDX sprite_width
    CPX #SMALL_WIDTH
    BNE done
    LDY #SMALL_WIDTH*16-1
.done
    RTS
}

; The byte that fills four MODE 5 pixels with each colour, 0-3.
.colour_byte
    EQUB &00, &0F, &F0, &FF
.grid_back_step
    EQUW 2*4*ROW - 4*CELL
    EQUW 4*4*ROW - 4*CELL

; Draw a sprite magnified in the editing grid, each pixel four screen
; pixels wide and four lines tall, two sprite rows to a character row; then
; the grid's frame, if the last sprite drawn was the other size.
; In:  A = sprite number, bit 7 set to copy it to undo_buffer first (a new
;      sprite to edit)
; Clobbers: A, X, Y, screen_ptr, data_ptr, temp, count_x, count_y, item,
;      mask, sprite_width
.draw_grid
{
    ASL A
    PHP
    LSR A
    JSR sprite_address
    PLP
    BCC draw
    JSR sprite_last_byte
.keep
    LDA (data_ptr), Y
    STA undo_buffer, Y
    DEY
    BPL keep
.draw
    LDA #LO(edit_grid)
    STA screen_ptr
    LDA #HI(edit_grid)
    STA screen_ptr+1
    LDA sprite_width
    STA count_x
.column
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    STA count_y
.byte
    LDY #&00
    LDA (data_ptr), Y
    STA temp
    LDX #&88                        ; the first pixel's bits
    STX mask

    ; Shift this pixel's two bits down to make its colour, 0-3.
.pixel
    LDA mask
    STA item
    LDA temp
    AND mask
.find_bit
    LSR item
    BCS got_bit
    LSR A
    BCC find_bit
.got_bit
    LSR A
    PHP
    LSR A
    LSR A
    LSR A
    PLP
    ROL A
    TAX
    LDY #&03                        ; the top four lines of the character row...
    LDA #&01
    BIT count_y
    BEQ block
    LDY #&07                        ; ...or, for every second sprite row, the bottom four
.block
    LDA colour_byte, X
    LDX #&03
.block_line
    STA (screen_ptr), Y
    DEY
    DEX
    BPL block_line
    LDA screen_ptr
    ADC #CELL
    STA screen_ptr
    BCC next_pixel
    INC screen_ptr+1
.next_pixel
    LSR mask
    BCC pixel
    LDA screen_ptr                  ; back to the grid's left edge
    SBC #4*CELL                     ; carry is set from the LSR: back to the grid's left edge
    STA screen_ptr
    BCS pixel_done
    DEC screen_ptr+1
.pixel_done
    LDA #&01
    AND count_y
    BEQ next_byte
    LDA screen_ptr
    CLC
    ADC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(ROW)
    STA screen_ptr+1
.next_byte
    INC data_ptr
    DEC count_y
    BNE byte

    ; Up to the top of the grid, one column of sprite bytes to the right.
    LDX sprite_width
    LDA screen_ptr
    SEC
    SBC grid_back_step-2, X
    STA screen_ptr
    LDA screen_ptr+1
    SBC grid_back_step-1, X
    STA screen_ptr+1
    DEC count_x
    BEQ frame
    JMP column

    ; The frame: a large sprite's is 16 cells by 16 rows, a small one's 8 by 8
    ; in the top left of that, with the rest blanked. A byte of each frame tells
    ; which one is on the screen already.
.frame
    LDA sprite_width
    CMP #LARGE_WIDTH
    BEQ large
    LDA grid_frame_top              ; the small frame's top right corner
    CMP #&08
    BNE to_small
    RTS
.to_small
    LDA #LO(SCREEN + 10*CELL)       ; blank the right half...
    STA screen_ptr
    LDA #HI(SCREEN + 10*CELL)
    STA screen_ptr+1
    LDA #&12
    JSR clear_rows
    LDA #LO(SCREEN + 9*ROW + CELL)  ; ...and the bottom half
    STA screen_ptr
    LDA #HI(SCREEN + 9*ROW + CELL)
    STA screen_ptr+1
    LDA #&09
    JSR clear_rows
.large
    LDA sprite_width
    CMP #LARGE_WIDTH
    BNE draw_frame
    LDA grid_frame_right            ; the large frame's right edge
    CMP #&08
    BNE draw_frame
    RTS

    ; The top line, the left edge, the bottom line, then the right edge.
.draw_frame
    LDA #LO(SCREEN + CELL)
    STA screen_ptr
    LDA #HI(SCREEN + CELL)
    STA screen_ptr+1
    LDY #&07
    JSR grid_frame_line
    LDA #&01                        ; the frame is colour 1 in the cell left of the grid's rightmost pixel
    STA (screen_ptr), Y
    JSR down_a_row
    LDA sprite_width
    ASL A
    ASL A
    STA count_y
.left_column
    LDA #&01                        ; the left edge
    LDY #&07
.left_line
    STA (screen_ptr), Y
    DEY
    BPL left_line
    JSR down_a_row
    DEC count_y
    BNE left_column
    LDA #&01
    INY
    STA (screen_ptr), Y
    JSR grid_frame_line
    JSR width_times_32
    ADC #&08
    ADC screen_ptr
    STA screen_ptr
    BCC right_side
    INC screen_ptr+1
.right_side
    LDA sprite_width
    ASL A
    ASL A
    STA count_y
.right_column
    LDA screen_ptr
    SEC
    SBC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    SBC #HI(ROW)
    STA screen_ptr+1
    LDY #&07
    LDA #&08                        ; the right edge: the leftmost pixel of the cell after the grid
.right_line
    STA (screen_ptr), Y
    DEY
    BPL right_line
    DEC count_y
    BNE right_column
    RTS
}

; Draw a horizontal line of the editing grid's frame, from its right
; corner (the leftmost pixel of a cell) back to the cell after the left edge.
; In:  Y = the line within the character row, screen_ptr = the row, one cell
;      left of the grid
; Out: Y = the line in the cell left of the grid
; Clobbers: A, X, temp
.grid_frame_line
{
    STY temp
    JSR width_times_32
    ORA temp
    ADC #&08
    TAY
    LDX #&08                        ; the corner first, then the line
.loop
    TXA
    STA (screen_ptr), Y
    LDX #&0F                        ; colour 1 across the whole byte
    TYA
    SEC
    SBC #CELL
    TAY
    CMP #CELL
    BCS loop
    RTS
}

; screen_ptr down a character row.
; Clobbers: A
.down_a_row
{
    LDA screen_ptr
    CLC
    ADC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(ROW)
    STA screen_ptr+1
    RTS
}

; sprite_width times 32: 128 for a large sprite (its grid is 16 cells,
; 128 bytes, across), 64 for a small one.
; Out: A = the result, carry clear
.width_times_32
{
    LDA sprite_width
    LSR A
    ROR A
    ROR A
    ROR A
    RTS
}

; Blank part of the screen: 72 bytes (nine cells) of each of A character
; rows from screen_ptr. It has no RTS of its own: it runs on into
; divide_by_5, which does no harm, and returns from there.
; Clobbers: A, X, Y, screen_ptr, count_y
.clear_rows
{
    STA count_y
.row
    LDY #9*CELL-1
    LDA #&00
.byte
    STA (screen_ptr), Y
    DEY
    BPL byte
    JSR down_a_row
    DEC count_y
    BNE row
}

; Divide by five: a large sprite's row and column in the sheet.
; In:  A = sheet index (positions &00-&0F, then &20-&28 less &10)
; Out: X = A DIV 5, A = A MOD 5
.divide_by_5
{
    LDX #&00
.loop
    CMP #&05
    BCC done
    INX
    SBC #&05
    BCS loop
.done
    RTS
}

; Draw a sprite in its place on the sheet: copy its bytes straight to the
; screen, a character cell (eight bytes of a column) at a time.
; In:  A = sprite number
; Entry at_screen_ptr: data_ptr and sprite_width set, screen_ptr = where
; Clobbers: A, X, Y, screen_ptr, data_ptr, count_x, count_y, sprite_width
.draw_sheet_sprite
{
    JSR sprite_address
    JSR sheet_address
.at_screen_ptr
    LDX sprite_width
    STX count_y
.row
    LDX sprite_width
    STX count_x
.column
    LDY #&07
.byte
    LDA (data_ptr), Y
    STA (screen_ptr), Y
    DEY
    BPL byte
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    ADC data_ptr
    STA data_ptr
    BCC next_screen
    INC data_ptr+1
.next_screen
    LDA #&08
    CLC
    ADC screen_ptr
    STA screen_ptr
    BCC next_column
    INC screen_ptr+1
.next_column
    DEC count_x
    BNE column

    ; Back to the next eight rows of the sprite; down a row on the screen.
    LDA sprite_width
    LSR A
    TAX
    LDA data_ptr
    SEC
    SBC column_rewind-1, X
    STA data_ptr
    BCS next_row
    DEC data_ptr+1
.next_row
    LDA screen_ptr
    CLC
    ADC row_step-1, X
    STA screen_ptr
    LDA screen_ptr+1
    ADC #&01
    STA screen_ptr+1
    DEC count_y
    BNE row
    RTS
; How far draw_sheet_sprite steps back through a sprite after a row of
; cells, and on the screen to the start of the next row (less a page),
; indexed by sprite_width / 2: small, then large.
.column_rewind
    EQUB 2*16-8, 4*32-8
.row_step
    EQUB LO(ROW-2*CELL), LO(ROW-4*CELL)
    EQUB 0
}

; Where a sprite goes on the screen.
; In:  A = sprite number (a sheet position, or a frame buffer: those are shown
;      in the animation window)
; Out: screen_ptr = the top left of its place, A = Y = the sprite number
; Clobbers: X
.sheet_address
{
    TAY
    LDX #&00
    STX screen_ptr+1
    CPY #FIRST_SMALL
    BCC large
    CPY #AFTER_SMALL
    BCC small
    SBC #&10
    CMP #&47
    BCS preview

    ; Large sprites: 5 to a row, four cells and four character rows each.
.large
    JSR divide_by_5
    LSR A                           ; column * 4 cells
    ROR A
    ROR A
    ROR A
    ADC #LO(large_sheet)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(large_sheet)
.add_rows
    DEX
    BMI done
    ADC #HI(4*ROW)                  ; four character rows a row of sprites
    BCC add_rows
.done
    STA screen_ptr+1
    TYA
    RTS

    ; Small sprites: 4 to a row, two cells and two rows each, four cells apart.
.small
    AND #&03
    LSR A
    ROR A
    ROR A
    ROR A
    STA screen_ptr
    TYA
    LSR A
    LSR A
    AND #&03
    TAX
.small_rows
    DEX
    BMI small_base
    LDA screen_ptr
    CLC
    ADC #LO(2*ROW)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(2*ROW)
    STA screen_ptr+1
    BCC small_rows
.small_base
    LDA screen_ptr
    CLC
    ADC #LO(small_sheet)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(small_sheet)
    STA screen_ptr+1
    RTS
.preview
    LDA #LO(frame_preview)
    STA screen_ptr
    LDA #HI(frame_preview)
    STA screen_ptr+1
    TYA
    RTS
}

; An RTS nothing uses.
.stray_rts
{
    RTS
}

; The event handler, for Escape (event 6): sets the Escape flag, and the
; latch too when SHIFT is held, so that a SHIFT-Escape is still seen after
; the OS acknowledges it.
; In:  A = event number
; Clobbers: nothing
.escape_event
{
    PHP
    CMP #EVENT_ESCAPE
    BNE other_event
    ROR MOS_ESCAPE_FLAG                 ; carry is set (A >= 6): bit 7 of the Escape flag
    TXA
    PHA
    TYA
    PHA
    LDX #INKEY_TEST(KEY_SHIFT)
    JSR key_pressed
    BPL not_ctrl
    STA escape_latch                ; A = &FF
.not_ctrl
    PLA
    TAY
    PLA
    TAX
    LDA #EVENT_ESCAPE
.other_event
    PLP
    RTS
}

; VDU codes for the screen's furniture: clear it, and draw boxes in blue
; round the colour swatch and the name box under the editing grid.
; LAYOUT_END ends the list.
LAYOUT_END = &EA
.screen_layout
    EQUB VDU_RESET_WINDOWS, VDU_CLS
    EQUB VDU_GCOL, 0, 1                             ; draw in colour 1
    EQUB VDU_PLOT, PLOT_MOVE : EQUW 24, 380         ; round the colour swatch
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW 0, 36
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW 72, 0
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW 0, -36
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW -72, 0
    ; Text only in the top 18 rows, so that the CLS on tape (for the filing
    ; system's messages) leaves these boxes and the logo alone.
    EQUB VDU_TEXT_WINDOW, 0, 17, 19, 0
    EQUB VDU_PLOT, PLOT_MOVE_RELATIVE : EQUW 96, 4  ; round the name box
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW 0, 32
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW 488, 0
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW 0, -36
    EQUB VDU_PLOT, PLOT_DRAW_RELATIVE : EQUW -488, 0
    EQUB LAYOUT_END

; The names of the physical colours, eight characters each, for the palette
; window (seven are shown).
.colour_names
    EQUS "Black   Red     Green   Yellow  Blue    Magenta Cyan    White   "

; Window text. The first byte is the flag (MENU or PLAIN), then lines ending
; CR; TEXT_END ends it. The windows that ask for a second sprite leave their
; title line empty: pick_second_sprite draws the first sprite there.
.text_copy
    EQUB PLAIN, CR
    EQUS "Select sprite", CR, "to", CR, "copy", CR, "this", CR, "onto", CR
    EQUB TEXT_END
.text_overlay
    EQUB PLAIN, CR
    EQUS "Select sprite", CR, "to", CR, "overlay", CR, "this", CR, "onto", CR
    EQUB TEXT_END
.text_options_a
    EQUB MENU
    EQUS "OptionsA", CR
    EQUS "Flip X", CR, "Flip Y", CR, "Delete", CR, "Undo", CR, "Animate", CR, "Obj name", CR
    EQUB TEXT_END
.text_options_b
    EQUB MENU
    EQUS "OptionsB", CR
    EQUS "Swap", CR, "Copy", CR, "Overlay", CR, "Underlay", CR, "Remove", CR, "Backing", CR
    EQUB TEXT_END
.text_environment
    EQUB MENU
    EQUS "Environment", CR
    EQUS "Load Sprite", CR, "Save Sprite", CR, "Load File", CR, "Save File", CR, "Def. Colour", CR
    EQUB TEXT_END
.text_credits                       ; "^~" is a copyright sign in this font
    EQUB PLAIN
    EQUS "    PIPELINE", CR
    EQUS " ---===++===--- ", CR
    EQUS "Written by & ^~", CR
    EQUS "  WILLIAM REEVE", CR
    EQUS "and  IAN HOLMES", CR
    EQUS " ---===++===---", CR
    EQUB TEXT_END
.text_escape_error                  ; unused
    EQUB PLAIN
    EQUS "E  R  R  O  R", CR, CR, "E  S  C  A  P  E", CR
    EQUB TEXT_END
.text_no_such_file
    EQUB PLAIN
    EQUS "E  R  R  O  R", CR, CR, "No Such File", CR
    EQUB TEXT_END
.text_bad_file
    EQUB PLAIN
    EQUS "E  R  R  O  R", CR, CR, "   Bad File", CR
    EQUB TEXT_END
.text_wrong_types
    EQUB PLAIN
    EQUS "E  R  R  O  R", CR, "Wrong Types", CR
    EQUB TEXT_END
.text_swap
    EQUB PLAIN, CR
    EQUS "Select sprite", CR, "to", CR, "swap", CR, "with", CR
    EQUB TEXT_END
.text_active_colour                 ; unused
    EQUB MENU
    EQUS "ActiCol", CR
    FOR i = 1..7
        EQUS "       ", CR
    NEXT
    EQUB TEXT_END
; The palette window: show_palette writes the colour names into the blank
; lines.
.text_palette
    EQUB MENU
    EQUS "Colour ", CR
.palette_lines
    FOR i = 0..3
        EQUS "       ", CR
    NEXT
    EQUB TEXT_END
.text_remove
    EQUB PLAIN, CR
    EQUS "Select sprite", CR, "to", CR, "take", CR, "this", CR, "from", CR
    EQUB TEXT_END
.text_underlay
    EQUB PLAIN, CR
    EQUS "Select sprite", CR, "to", CR, "put", CR, "this", CR, "under", CR
    EQUB TEXT_END
.text_animation
    EQUB PLAIN
    EQUS "   ANIMATION", CR
    EQUB TEXT_END
.text_exists
    EQUB MENU
    EQUS "Exists", CR, "Cancel", CR, "Replace", CR
    EQUB TEXT_END
.text_load_name
    EQUB PLAIN
    EQUS "Load Sprite File", CR, CR, " Enter Filename", CR, CR, " :"
    EQUB TEXT_END
.text_save_name
    EQUB PLAIN
    EQUS "Save Sprite File", CR, CR, " Enter Filename", CR, CR, "  :"
    EQUB TEXT_END
.text_object_name
    EQUB PLAIN
    EQUS "Edit object name", CR, CR, " Enter new name", CR, CR, " :"
    EQUB TEXT_END
.text_not_available
    EQUB PLAIN
    EQUS "E  R  R  O  R  !", CR, CR, "Not available", CR, "with this", CR, "filing system", CR
    EQUB TEXT_END
; error_handler copies the error's message into the error window's text,
; breaking its lines and ending it.
.text_error
    EQUB PLAIN
    EQUS "E  R  R  O  R  !", CR, CR
.error_message
    EQUB REPEATED(61, ascii(" "))
; The Escape window's flag byte doubles as the end of the error message.
.text_escape
    EQUB MENU
    EQUS "Escape?", CR, "No", CR, "Yes", CR
    EQUB TEXT_END
.text_insert_disc
    EQUB PLAIN
    EQUS " Return to menu", CR, " Please insert", CR, " Pipeline disc", CR, "and press SPACE", CR
    EQUB TEXT_END

; Draw every sprite in the sheet, positions &28 down to 0 (&10-&1F being the
; small sprites).
; Clobbers: A, X, Y, screen_ptr, data_ptr, count_x, count_y, sprite_width
.draw_sheet
{
    LDA #&28                        ; the last sheet position
.loop
    PHA
    JSR draw_sheet_sprite
    PLA
    SEC
    SBC #&01
    BCS loop
    RTS
}

; Mark the selected sprite in the sheet with a box in colour 2, and show its
; number and name under the editing grid if it is an object (a small sprite),
; or blank them if not.
; In:  A = sprite number (the selection box is drawn over the sprite; drawing
;      the sprite again removes it)
; Clobbers: A, X, Y, screen_ptr, aux_ptr, count_y, sprite_width
.show_selection
{
    JSR sprite_class
    JSR sheet_address
    LDY #&00
    JSR selection_edge
    LDA sprite_width
    STA count_y

    ; Down each character row: the rightmost pixel of the last cell, the leftmost of the first.
.column
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    TAY
    LDX #&07
.left
    DEY
    LDA (screen_ptr), Y
    AND #&EE                        ; pixel 3 becomes colour 2
    ORA #&10
    STA (screen_ptr), Y
    DEX
    BPL left
    LDY #&07
.right
    LDA (screen_ptr), Y
    AND #&77                        ; pixel 0 becomes colour 2
    ORA #&80
    STA (screen_ptr), Y
    DEY
    BPL right
    DEC count_y
    LDA count_y
    BEQ bottom
    LDA screen_ptr
    CLC
    ADC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(ROW)
    STA screen_ptr+1
    BCC column
.bottom
    LDY #&07
    JSR selection_edge
    LDA sprite_width
    CMP #SMALL_WIDTH
    BEQ small
    TXA                             ; X is 0 here: blank the name box
    LDY #15*CELL-1
.clear_name
    STA name_box, Y
    DEY
    BPL clear_name
    RTS

    ; An object: its number, 1-16 (the small sprite less &0F), then ":" and
    ; its name.
.small
    LDA #LO(name_box)
    STA screen_ptr
    LDA #HI(name_box)
    STA screen_ptr+1
    LDX #ascii(" ")              ; objects 1-9: no tens
    LDA sprite
    CMP #&19
    BCC tens
    LDX #ascii("1")
.tens
    SEC
    TXA
    JSR print_char_advance
    LDA sprite
    SEC
    SBC #&0F
    CMP #&0A
    BCC units
    SBC #&0A
.units
    SEC                             ; carry set: store the characters
    ORA #ascii("0")
    JSR print_char_advance
    LDA #ascii(":")
    SEC
    JSR print_char_advance
    JSR name_offset
    LDX #12-1
.name
    LDA object_names, Y
    SEC
    JSR print_char_advance
    INY
    DEX
    BPL name
    RTS
}

; Draw a horizontal edge of the selection box: line Y of each cell across
; the sprite, in colour 2.
; In:  Y = line within the character row, screen_ptr = the row
; Out: X = 0
; Clobbers: A, Y
.selection_edge
{
    LDX sprite_width
.loop
    LDA #&F0
    STA (screen_ptr), Y
    TYA
    CLC
    ADC #CELL
    TAY
    DEX
    BNE loop
    RTS
}

; Where an object's name is in object_names.
; In:  sprite = the small sprite (or, at of_a, A)
; Out: A = Y = (sprite AND &0F) * 12
; Clobbers: nothing else
.name_offset
{
    LDA sprite
.of_a
    AND #&0F
    ASL A
    ASL A
    STA times_4
    ASL A
    ADC times_4
    TAY
    RTS
.times_4
    EQUB &00
}

; Unused copies of down_a_row, width_times_32 and clear_rows: nothing
; calls these three.
.unused_down_a_row
{
    LDA screen_ptr
    CLC
    ADC #LO(ROW)
    STA screen_ptr
    LDA screen_ptr+1
    ADC #HI(ROW)
    STA screen_ptr+1
    RTS
}

; Unused: as width_times_32.
.unused_width_times_32
{
    LDA sprite_width
    LSR A
    ROR A
    ROR A
    ROR A
    RTS
}

; Unused: as clear_rows.
.unused_clear_rows
{
    STA count_y
.row
    LDY #&47
    LDA #&00
.byte
    STA (screen_ptr), Y
    DEY
    BPL byte
    JSR unused_down_a_row
    DEC count_y
    BNE row
    RTS
}

; Fill the colour swatch with the current colour.
; Clobbers: A, X, Y
.show_colour
{
    LDX colour
    LDA colour_byte, X
    LDY #2*CELL-1                   ; two cells
.loop
    STA colour_swatch, Y
    DEY
    BPL loop
    RTS
}

; The stack pointer when the designer first started (bit 7 set once it has
; been saved), for the main loop to reset the stack to.
.stack_pointer
    EQUB &00

; Bit 7 set once the graphics area has been cleared and DEFAULT loaded,
; so starting again after an error keeps the user's work.
.graphics_loaded
    EQUB &00

; Bit 7 set if the filing system is a disc one (number 4 or more); the
; other three bytes are the physical colours for logical 1-3 (blue, yellow,
; red).
.disc_fs
    EQUB 0
    EQUB COLOUR_BLUE, COLOUR_YELLOW, COLOUR_RED

; The graphics set to start with, and the command that goes back to the menu.
.default_name
    EQUS "DEFAULT", CR
.mrun_command
    EQUS "/MRUN", CR

; BRKV points here: show the error's message in the error window, wait for
; a key, close any open files and start again.
; In:  MOS_ERROR_PTR = the error (as the OS leaves it)
.error_handler
{
    LDY #&00
    LDX #&00

    ; Copy the message, breaking it into lines of 14 characters.
.copy
    INY
    INX
    TXA
    AND #&0F
    CMP #&0F
    BNE store
    LDA #CR
    STA error_message-1, X
    INX
.store
    LDA (MOS_ERROR_PTR), Y
    STA error_message-1, X
    BNE copy
    LDA #CR
    STA error_message-1, X
    LDA #TEXT_END
    STA error_message, X
    JSR close_all_windows
    LDX #LO(text_error)
    LDY #HI(text_error)
    LDA #WINDOW_ERROR
    JSR open_window
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    LDX #&00
    LDY #&00
    JSR OSBYTE
.wait
    JSR OSRDCH                      ; wait for a key, acknowledging any Escape
    BCC restart
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
    JMP wait
.restart
    JSR close_all_windows
    JSR close_files                 ; and fall into start
}

; The entry point, from the GRAPHIC stub; and where errors start again.
; On first entry it takes over BRKV and the event vector (keeping the old ones
; in IND1V and IND2V to put back at the end) and enables the Escape event; then
; sets up MODE 5 and the palette, draws the screen, clears the graphics area and
; loads DEFAULT (only the first time), and draws the sheet and the first
; sprite. main_loop then runs until Escape.
.start
{
    LDA #OSBYTE_CURSOR_EDITING      ; the cursor keys give codes
    LDX #&01
    JSR OSBYTE
    LDA BRKV+1                      ; BRKV still in the ROMs: not ours yet
    BPL installed
    LDX #LO(error_handler)
    LDY #HI(error_handler)
    LDA EVNTV
    STA IND2V
    LDA EVNTV+1
    STA IND2V+1
    LDA BRKV
    STA IND1V
    LDA BRKV+1
    STA IND1V+1
    LDA #LO(escape_event)
    SEI
    STX BRKV
    STY BRKV+1
    STA EVNTV
    LDA #HI(escape_event)
    STA EVNTV+1
    CLI
    LDA #OSBYTE_ENABLE_EVENT        ; the Escape event
    STA escape_latch
    LDX #EVENT_ESCAPE
    JSR OSBYTE
.installed
    LDA #OSBYTE_READ_CHAR_AND_MODE  ; the screen mode, into Y
    JSR OSBYTE
    CPY #&05
    BEQ setup
    LDA #VDU_MODE                   ; MODE 5
    JSR OSWRCH
    LDA #5
    JSR OSWRCH
    LDA #&03                        ; logical colours 3 to 1
.palette
    PHA
    TAX
    LDA disc_fs, X                  ; the physical colour for logical colour X
    JSR write_palette
    PLA
    SEC
    SBC #&01
    BNE palette
.setup
    LDA #OSBYTE_WRITE_SHEILA        ; no cursor
    LDX #LO(CRTC_ADDR)
    LDY #CRTC_CURSOR_START
    JSR OSBYTE
    LDY #CRTC_CURSOR_OFF
    INX                             ; LO(CRTC_DATA)
    JSR OSBYTE
    LDA #OSARGS_READ_FS             ; the filing system's number
    TAY
    JSR OSARGS
    CMP #FS_DISC                    ; carry set for a disc filing system
    LDA #&00
    STA by_slot
    TAY
    ROR A                           ; into disc_fs bit 7
    STA disc_fs
    BMI opt
    INY
.opt
    LDA #FSCV_OPT                   ; *OPT 1,Y: messages off on disc (Y = 0), on for tape
    LDX #&01
    JSR fscv
    JSR reset_timer
    TSX
    BIT stack_pointer
    BMI saved_sp
    STX stack_pointer

    ; Draw the screen's furniture.
.saved_sp
    LDY #&FF
.layout
    INY
    LDA screen_layout, Y
    CMP #LAYOUT_END
    BEQ layout_done
    JSR OSWRCH
    JMP layout
.layout_done
    LDX #20-1                       ; all twenty
    LDA #&00
.clear_windows
    STA window_open, X
    DEX
    BPL clear_windows
    LDA #&0A                        ; the cursor off again, after the CLS
    STA CRTC_ADDR
    LDA #&20
    STA CRTC_DATA
    LDA #LO(logo)                   ; not needed: the copy below is indexed
    STA data_ptr
    LDA #HI(logo)
    STA data_ptr+1
    LDY #&00
.logo_copy
    LDA logo, Y
    STA logo_screen, Y
    LDA logo+&B0, Y
    STA logo_screen+ROW, Y
    LDA logo+2*&B0, Y
    STA logo_screen+2*ROW, Y
    INY
    CPY #&B0                        ; a band of 22 cells
    BCC logo_copy

    ; The first time only: clear the graphics area and load DEFAULT into it.
    BIT graphics_loaded
    BMI redraw
    LDA #&00
    TAY
    STA screen_ptr                  ; A is 0 for the low byte and to clear with
    LDX #HI(graphics)
    STX screen_ptr+1
    LDX #&10                        ; 16 pages, to &4FFF
.clear
    STA (screen_ptr), Y
    INY
    BNE clear
    INC screen_ptr+1
    DEX
    BNE clear
    DEX
    STX graphics_loaded
    LDA disc_fs                     ; on tape there's no DEFAULT to load: the name becomes ""
    BMI load_default
    LDX #&06
.tape_name
    STA default_name, X
    DEX
    BPL tape_name
    LDA #ascii("""")
    STA default_name
    STA default_name+1
    BNE redraw
.load_default
    LDA #LO(default_name)
    STA osfile_block
    LDA #HI(default_name)
    STA osfile_block+1
    LDA #OSFILE_LOAD                ; &FF, as graphics_loaded wants too
    STA graphics_loaded
    JSR osfile_graphics

    ; Redraw everything; the file commands come back here after loading.
.redraw
    BIT disc_fs
    BMI cls_done
    LDA #VDU_CLS
    JSR OSWRCH
.cls_done
    LDX #12-1                       ; "Finish Block"
.mark_end
    LDA finish_block, X
    STA graphics_end, X
    DEX
    BPL mark_end
    JSR draw_sheet
    LDA #&00
    STA sprite
    JSR show_selection
    LDA #&00                        ; the pixel cursor to the top left
    STA cursor_x
    STA cursor_y
    SEC                             ; carry set: and take an undo copy
    JSR redraw_grid
    LDA #&03                        ; start in colour 3
    STA colour
    JSR show_colour
}

; The main loop: one pass each time round, at least two centiseconds apart
; (select_sprite waits): move the selection, blink the pixel cursor, paint,
; run a command from a menu or shortcut, and offer to leave on Escape.
.main_loop
{
    LDX stack_pointer
    TXS
    JSR close_all_windows
    LDA #&00                        ; move the selection
    JSR select_sprite
    BMI edit                        ; CTRL held: no blinking
    LDX cursor_x
    LDY cursor_y
    JSR toggle_cursor               ; blink the pixel cursor
.edit
    JSR edit_pixels
    LDA colour                      ; commands may use colour as a scratch value
    STA saved_colour
    JSR read_command
    ASL A                           ; &FF: no command
    BCS command_done
    TAY
    LDA command_table, Y
    STA dispatch+1
    LDA command_table+1, Y
    STA dispatch+2
.dispatch
    JSR &1234                       ; the command (self-modified)
    LDX #INKEY_TEST(KEY_RETURN)                 ; so a menu choice made with Return doesn't plot too
    JSR wait_key_release
.command_done
    LDA saved_colour
    STA colour
    LDA #OSBYTE_WAIT_VSYNC          ; wait for the vsync, which leaves A = &13...
    JSR OSBYTE
    STA by_slot                     ; ...so by_slot bit 7 is clear again
    LDA MOS_ESCAPE_FLAG                 ; Escape, or SHIFT-Escape latched
    ORA escape_latch
    BPL loop
    LSR escape_latch
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
    JSR close_all_windows
    LDX #LO(text_escape)
    LDY #HI(text_escape)
    LDA #WINDOW_QUESTION
    JSR menu                        ; Escape? No/Yes
    CMP #&02                        ; Yes
    BNE loop
    LDX #LO(text_insert_disc)
    LDY #HI(text_insert_disc)
    LDA #WINDOW_INPUT
    JSR open_window
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    JSR OSBYTE
.wait_key
    JSR OSRDCH                      ; wait for a key, acknowledging any Escape
    PHP
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
    PLP
    BCS wait_key

    ; Leave: put the vectors back and return to the menu.
    LDA IND1V
    STA BRKV
    LDA IND1V+1
    STA BRKV+1
    LDA IND2V
    STA EVNTV
    LDA IND2V+1
    STA EVNTV+1
    LDA #OSBYTE_CURSOR_EDITING      ; X = &FF from open_window, so OSBYTE 4,0: cursor keys edit again
    INX
    JSR OSBYTE
    LDA #OSBYTE_FUNCTION_KEY_BASE   ; function keys back to strings
    LDX #&01
    JSR OSBYTE
    BIT disc_fs
    BMI run_mrun
    LDA #OSBYTE_BREAK_EFFECT        ; *FX200,3: on tape, BREAK clears memory...
    LDX #&03
    JSR OSBYTE
    JMP (CPU_RESET_VECTOR)              ; ...and here is a BREAK
.run_mrun
    LDX #LO(mrun_command)           ; *RUN MRUN, which goes back to the menu
    LDY #HI(mrun_command)
    JMP OSCLI
.loop
    JMP main_loop
}

; Written after the graphics set in memory, at graphics_end.
.finish_block
    EQUS "Finish Block"

; The colour, kept while a command runs.
.saved_colour
    EQUB &00

; The commands: read_command's number for each menu item (menu * 8 + item)
; and CTRL shortcut, and where it goes. no_command is the main loop's own
; tail (command_done), harmless to call because main_loop resets the
; stack.
.command_table
    EQUW main_loop.command_done     ; 0: none
    EQUW cmd_flip_x                 ; OptionsA
    EQUW cmd_flip_y
    EQUW cmd_delete
    EQUW cmd_undo
    EQUW cmd_animate
    EQUW cmd_obj_name
    EQUW main_loop.command_done
    EQUW main_loop.command_done
    EQUW cmd_swap                   ; OptionsB
    EQUW cmd_copy
    EQUW cmd_overlay
    EQUW cmd_underlay
    EQUW cmd_remove
    EQUW cmd_backing
    EQUW main_loop.command_done
    EQUW main_loop.command_done
    EQUW cmd_load_sprite            ; Environment
    EQUW cmd_save_sprite
    EQUW cmd_load_file
    EQUW cmd_save_file
    EQUW cmd_def_colour
    EQUW main_loop.command_done
    EQUW main_loop.command_done
    EQUW main_loop.command_done

; OptionsA Delete (CTRL-Delete): clear the sprite to colour 0, and an
; object's name to zeros.
.cmd_delete
{
    LDA sprite
    JSR sprite_address
    JSR sprite_last_byte
    LDA #&00
.clear
    STA (data_ptr), Y
    DEY
    BPL clear
    LDX sprite_width
    CPX #SMALL_WIDTH
    BNE redraw
    LDA sprite                      ; the man has no name to clear
    CMP #THE_MAN
    BEQ redraw
    JSR name_offset
    LDA #&00
    LDX #12-1
.name
    STA object_names, Y
    INY
    DEX
    BPL name
.redraw
    LDA sprite
    JSR show_selection
    LDA sprite
    JSR draw_sheet_sprite
    LDA sprite
    JMP redraw_grid
}

; Draw the selected sprite in the editing grid and put the pixel cursor
; back on it.
; In:  carry set to take an undo copy of the sprite first
; Clobbers: A, X, Y, and as draw_grid
.redraw_grid
{
    LDA sprite
    BCC draw
    ORA #&80
.draw
    JSR draw_grid
    LDX cursor_x
    LDY cursor_y
    JMP toggle_cursor
}

; OptionsA Flip X (CTRL-X): mirror the sprite left to right, pixel by pixel,
; swapping each pixel in the left half of a row with its opposite. colour
; carries the pixels across (main_loop puts it back).
.cmd_flip_x
{
    LDA sprite
    JSR sprite_address
    LDA sprite_width                ; item = pixels in half a row
    ASL A
    STA item
    ASL A                           ; aux_ptr = the last pixel's x
    STA aux_ptr
    ASL A                           ; count_y = the last row
    STA count_y
    DEC aux_ptr
    DEC count_y
.row
    LDA #&00
    STA count_x
.pixel
    LDA aux_ptr
    SEC
    SBC count_x
    TAX
    LDY count_y
    STX flip_x
    STY flip_y
    LDA sprite
    JSR read_pixel
    PHA
    LDX count_x
    LDY count_y
    LDA sprite
    JSR read_pixel
    STA colour
    LDX flip_x
    LDY flip_y
    LDA sprite
    JSR plot_pixel
    LDX count_x
    LDY count_y
    PLA
    STA colour
    LDA sprite
    JSR plot_pixel
    INC count_x
    LDA count_x
    CMP item
    BCC pixel
    DEC count_y
    BPL row
    LDX #INKEY_TEST(KEY_X)          ; the shortcut, to wait for

    ; Show the sprite as changed, then wait for the key in X to be released so
    ; a shortcut acts once.
.redraw
    TXA
    PHA
    LDA sprite
    PHA
    JSR draw_sheet_sprite
    PLA
    JSR redraw_grid                 ; carry is clear from draw_sheet_sprite: no undo copy
    PLA
    TAX
    JMP wait_key_release
}

; Flip X's mirrored pixel.
.flip_x
    EQUB &00

.flip_y
    EQUB &00

; The OSGBPB block for moving sprites and names to and from files: the
; handle, the address in memory, the byte count, the pointer in the file.
.gbpb_block
    EQUB 0                          ; handle
    EQUD 0                          ; address
    EQUD 0                          ; count
    EQUD 0                          ; pointer
    EQUB 0, 0, 0

; OptionsA Flip Y (CTRL-Y): turn the sprite upside down.
.cmd_flip_y
{
    JSR flip_vertically
    LDX #INKEY_TEST(KEY_Y)
    JMP cmd_flip_x.redraw
}

; Turn the selected sprite upside down, by reversing each column of bytes.
; In:  sprite = the sprite (Animate uses this on its frame buffers)
; Clobbers: A, X, Y, data_ptr, count_x, count_y, sprite_width
.flip_vertically
{
    LDA sprite
    JSR sprite_address
    LDA sprite_width
    STA count_x
    ASL A
    ASL A
    ASL A
    STA count_y
.column
    LDY count_y
    DEY
.swap
    LDX #&00
    LDA (data_ptr, X)
    PHA
    LDA (data_ptr), Y
    STA (data_ptr, X)
    PLA
    STA (data_ptr), Y
    INC data_ptr
    BNE next
    INC data_ptr+1
.next
    DEY
    DEY
    BPL swap
    LDA count_y                     ; on to the next column
    LSR A
    CLC
    ADC data_ptr
    STA data_ptr
    BCC next_column
    INC data_ptr+1
.next_column
    DEC count_x
    BNE column
    RTS
}

; OptionsA Undo (CTRL-U): swap the sprite with the copy taken when it was
; selected, so a second Undo puts the changes back.
.cmd_undo
{
    LDA sprite
    JSR sprite_address
    JSR sprite_last_byte
.swap
    LDX undo_buffer, Y
    LDA (data_ptr), Y
    STA undo_buffer, Y
    TXA
    STA (data_ptr), Y
    DEY
    BPL swap
    LDA sprite
    JSR draw_sheet_sprite
    LDA sprite
    JSR show_selection
    CLC
    JSR redraw_grid
    LDX #INKEY_TEST(KEY_U)
    JMP wait_key_release
}

; OptionsB Underlay: put this sprite under another - fill the other's
; colour 0 pixels from this one.
.cmd_underlay
{
    LDX #LO(text_underlay)
    LDY #HI(text_underlay)
    JSR pick_second_sprite
    STX combine_test
    CLC
    JMP combine_sprites
}

; OptionsB Backing (CTRL-B): fill the sprite's colour 0 pixels from the
; background tile (sheet position 0).
.cmd_backing
{
    LDX sprite
    STX combine_test
    LDA #&00                        ; the background tile
    CLC
    JMP combine_sprites
}

; OptionsB Overlay (CTRL-O): put this sprite over another - copy its
; pixels other than colour 0 onto the other.
.cmd_overlay
{
    LDX #LO(text_overlay)
    LDY #HI(text_overlay)
    JSR pick_second_sprite
    STA combine_test
    SEC
}

; Combine two sprites a pixel at a time.
; In:  X = the sprite to change, A = the sprite to take pixels from,
;      combine_test = the sprite whose pixels decide, carry set to copy
;      combine_test's pixels where they aren't colour 0 (overlay), clear to
;      copy A's pixels where combine_test's are colour 0 (underlay, backing)
; Then shows both sprites again, through redraw_pair.
.combine_sprites
{
    STX combine_target
    STA combine_source
    LDA #&00                        ; carry into bit 7
    ROR A
    STA combine_over
    LDA sprite_width                ; count_x = the last pixel across
    ASL A
    ASL A
    SBC #&00
    STA count_x
.column
    LDA sprite_width                ; count_y = the last row
    ASL A
    ASL A
    ASL A
    SBC #&00
    STA count_y
.pixel
    LDA combine_test
    LDX count_x
    LDY count_y
    JSR read_pixel
    BIT combine_over
    BPL under                       ; overlay: copy the pixel where it isn't 0
    CMP #&00
    BEQ next
    BNE plot
.under
    CMP #&00                        ; underlay: where it's 0...
    BNE next
    LDA combine_source              ; ...copy the source's
    LDX count_x
    LDY count_y
    JSR read_pixel
.plot
    STA colour
    LDA combine_target
    LDX count_x
    LDY count_y
    JSR plot_pixel
.next
    DEC count_y
    BPL pixel
    DEC count_x
    BPL column
    LDA combine_source
    JMP redraw_pair
}

; Combine's sprites: the one to change, the one to take pixels from, the
; one whose pixels decide, and bit 7 set to overlay rather than underlay.
.combine_target
    EQUB &00

.combine_source
    EQUB &00

.combine_test
    EQUB &00

.combine_over
    EQUB &00

; OptionsB Remove (CTRL-R): take this sprite from another - clear to 0 the
; other's pixels that match this one's.
.cmd_remove
{
    LDX #LO(text_remove)
    LDY #HI(text_remove)
    JSR pick_second_sprite
    STX combine_target
    STA combine_source
    LDA sprite_width
    ASL A
    ASL A
    SBC #&00
    STA count_x
.column
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    SBC #&00
    STA count_y
.pixel
    LDA combine_target
    LDX count_x
    LDY count_y
    JSR read_pixel
    STA temp
    LDA combine_source
    LDX count_x
    LDY count_y
    JSR read_pixel
    EOR temp                        ; the same colour in both...
    BNE next
    STA colour                      ; ...becomes 0
    LDA combine_target
    LDX count_x
    LDY count_y
    JSR plot_pixel
.next
    DEC count_y
    BPL pixel
    DEC count_x
    BPL column
    LDA combine_source
    JMP redraw_pair
}

; OptionsB Copy (CTRL-COPY): copy this sprite onto another.
.cmd_copy
{
    LDX #LO(text_copy)
    LDY #HI(text_copy)
    JSR pick_second_sprite
    PHA
.copy
    LDA (aux_ptr), Y
    STA (data_ptr), Y
    DEY
    BPL copy
    PLA
    JMP redraw_pair
}

; OptionsB Swap (CTRL-S): swap this sprite with another, and two objects'
; names with them (not the man's: he has none).
.cmd_swap
{
    LDX #LO(text_swap)
    LDY #HI(text_swap)
    JSR pick_second_sprite
    PHA
.swap
    LDA (data_ptr), Y
    PHA
    LDA (aux_ptr), Y
    STA (data_ptr), Y
    PLA
    STA (aux_ptr), Y
    DEY
    BPL swap
    LDA sprite_width
    CMP #SMALL_WIDTH
    BNE done
    CPX #THE_MAN
    BEQ done
    PLA
    PHA
    CMP #THE_MAN
    BEQ done

    ; Swap the names: data_ptr and aux_ptr hold the two names' offsets now.
    JSR name_offset
    STA data_ptr
    PLA
    PHA
    JSR name_offset.of_a
    STA aux_ptr
    LDX #12-1                       ; count the name's bytes in data_ptr+1
    STX data_ptr+1
.names
    LDY aux_ptr
    LDA object_names, Y
    LDY data_ptr
    LDX object_names, Y
    STA object_names, Y
    LDY aux_ptr
    TXA
    STA object_names, Y
    INC aux_ptr
    INC data_ptr
    DEC data_ptr+1
    BPL names
.done
    PLA
}

; Show both sprites of a two-sprite command as they are now, select the
; first again and close the picking window.
; In:  A = the other sprite
; Clobbers: A, X, Y, and as draw_grid
.redraw_pair
{
    JSR draw_sheet_sprite
    LDA sprite
    JSR draw_sheet_sprite
    LDA sprite
    JSR show_selection
    LDA sprite
    CLC
    JSR redraw_grid
    LDA #WINDOW_PICK
    JMP close_window
}

; Ask for the second sprite of a two-sprite command: show the question with
; a picture of this sprite, and let the selection move until Return.
; In:  X/Y = the question
; Out: X = the sprite picked, A = this sprite, data_ptr = the picked one's
;      bytes, aux_ptr = this one's, Y = the offset of their last byte
; If they are different sizes it says "Wrong Types"; then, as on Escape, it
; abandons the command and goes back to the main loop.
.pick_second_sprite
{
    LDA #WINDOW_PICK
    JSR open_window
    LDX #INKEY_TEST(KEY_RETURN)                 ; the Return that chose the command
    JSR wait_key_release
    LDA sprite
    PHA
    JSR sprite_address
    LDA data_ptr
    STA first_address
    LDA data_ptr+1
    STA first_address+1
    LDA window_address+2*4          ; the picture goes on the window's right, two rows down
    CLC
    ADC #LO(2*ROW + 8*CELL)
    STA screen_ptr
    LDA window_address+2*4+1
    ADC #HI(2*ROW + 8*CELL)
    STA screen_ptr+1
    JSR draw_sheet_sprite.at_screen_ptr
    LDA sprite_width
    STA first_width
.select
    LDA #&01
    JSR select_sprite               ; move the selection; function keys escape
    BIT MOS_ESCAPE_FLAG
    BMI abandon
    LDX #INKEY_TEST(KEY_RETURN)
    JSR key_pressed
    BPL select
    LDA sprite
    JSR sprite_address
    JSR sprite_last_byte
    LDA first_address
    STA aux_ptr
    LDA first_address+1
    STA aux_ptr+1
    LDX sprite
    LDA sprite_width
    CMP first_width                 ; the same size?
    BNE wrong_type
    PLA
    RTS
.wrong_type
    LDA #WINDOW_ERROR
    LDX #LO(text_wrong_types)
    LDY #HI(text_wrong_types)
    JSR open_window
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    LDX #&00
    JSR OSBYTE
.wait_space
    JSR OSRDCH
    BCS close
    CMP #ascii(" ")
    BNE wait_space
.close
    LDA #WINDOW_ERROR
    JSR close_window
.abandon
    PLA                             ; drop this sprite and our return address
    PLA
    PLA
.abandon_command
    LDA #WINDOW_PICK
    JSR close_window
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
    JMP main_loop.command_done
}

; Show an error in the error window until a key other than Escape is
; pressed, then go back to the main loop.
; In:  X/Y = the error's text
.show_error
{
    STX error_text
    STY error_text+1
.show
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
    LDA #WINDOW_ERROR
    LDX error_text
    LDY error_text+1
    JSR open_window
    JSR OSRDCH
    BIT MOS_ESCAPE_FLAG
    BMI show
    JMP main_loop
}

; pick_second_sprite's first sprite: its address and width.
.first_address
    EQUB &00, &00

.first_width
    EQUB &00

; show_error's text, kept while it waits.
.error_text
    EQUB &00, &00

; Read the palette.
; In:  A = logical colour
; Out: A = the physical colour it shows
; Clobbers: X, Y, osfile_block
.read_palette
{
    STA osfile_block
    LDX #LO(osfile_block)
    LDY #HI(osfile_block)
    LDA #OSWORD_READ_PALETTE
    JSR OSWORD
    LDA osfile_block+1
    RTS
}

; A menu with nothing in it: the palette window opens empty and
; show_palette fills it.
.empty_text
    EQUB &FF, &FF

; Environment Def. Colour (CTRL-C): change the palette. Up and down pick a
; logical colour, left and right step its physical colour through the eight;
; Return, Space, Escape or a function key finish.
.cmd_def_colour
{
    LDA #WINDOW_QUESTION
    LDX #LO(empty_text)
    LDY #HI(empty_text)
    JSR open_window
    LDA #OSBYTE_CURSOR_EDITING      ; the cursor keys give codes
    LDX #&01
    JSR OSBYTE
    LDA #OSBYTE_FUNCTION_KEY_BASE   ; f0-f9 give CODE_F0 up
    LDX #CODE_F0
    LDY #&00
    JSR OSBYTE
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    LDX #&00
    JSR OSBYTE
    LDA #&00
    STA item
    JSR palette_highlight
.redraw
    JSR show_palette
.read_key
    JSR OSRDCH
    BCC got_key
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
.done
    JMP show_palette.done
.got_key
    LDY item
    CMP #CODE_F0
    BCS done
    CMP #CR
    BEQ done
    CMP #ascii(" ")
    BEQ done
    CMP #CODE_DOWN
    BNE not_down
    LDX item
    CPX #&03
    BEQ not_down
    INC item
.not_down
    CMP #CODE_UP
    BNE moved
    LDX item
    BEQ moved
    DEC item
.moved
    PHA
    JSR palette_highlight.toggle
    JSR palette_highlight
    PLA
    LDX #&01                        ; right: the next physical colour
    CMP #CODE_RIGHT
    BEQ change
    LDX #&FF                        ; left: the one before
    CMP #CODE_LEFT
    BNE read_key
.change
    STX colour_step
    LDA item
    JSR read_palette
    CLC
    ADC colour_step
    AND #&07
    PHA
    JSR show_palette
    PLA
    LDX item
    JSR write_palette
    JMP redraw
}

; Set the palette.
; In:  X = logical colour, A = physical colour
; Clobbers: A, X, Y, osfile_block
.write_palette
{
    STA osfile_block+1
    STX osfile_block
    LDX #LO(osfile_block)
    LDY #HI(osfile_block)
    LDA #OSWORD_WRITE_PALETTE
    JMP OSWORD
}

; +1 or -1: the way Def. Colour steps.
.colour_step
    EQUB &00

; Write each logical colour's physical colour's name into the palette
; window's text, and show the text again in place.
; Clobbers: A, X, Y, screen_ptr, data_ptr, save_ptr, aux_ptr, border_ptr,
;      count_y, osfile_block
.show_palette
{
    LDA #&03
    STA osfile_block
    LDA #LO(palette_lines+3*8)
    STA save_ptr
    LDA #HI(palette_lines+3*8)
    STA save_ptr+1
.entry
    LDA osfile_block
    JSR read_palette
    ASL A                           ; eight characters to each name
    ASL A
    ASL A
    ORA #&06                        ; the end of the seventh
    TAX
    LDY #&06
.name
    LDA colour_names, X
    STA (save_ptr), Y
    DEX
    DEY
    BPL name
    LDA save_ptr
    SEC
    SBC #&08
    STA save_ptr
    BCS next
    DEC save_ptr+1
.next
    DEC osfile_block
    BPL entry

    ; Rewrite the window's text without opening it again.
    LDA window_address+2*5
    STA save_ptr
    STA screen_ptr
    LDA window_address+2*5+1
    STA save_ptr+1
    STA screen_ptr+1
    LDX #LO(text_palette)
    LDY #HI(text_palette)
    STX data_ptr
    STY data_ptr+1
    LDA #WINDOW_QUESTION
    JMP print_window_text
.done
    RTS
}

; The parameter block for OSFILE, also used for OSWORD 11 and 12: the
; filename's address, then load and exec addresses, start (or length) and
; end (or attributes), four bytes each.
.osfile_block
    EQUW 0                          ; filename
    EQUD 0                          ; load address
    EQUD 0                          ; exec address
    EQUD 0                          ; start address, or length
    EQUD 0                          ; end address, or attributes
    EQUB 0, 0

; Where each line of the palette window is, from its corner.
.palette_row_offset
    EQUW 1*ROW, 2*ROW, 3*ROW, 4*ROW

; Highlight the palette window's selected line.
; In:  item = the logical colour, 0-3
; Entry toggle: unhighlight the line highlighted last
; Clobbers: A, X, Y, screen_ptr
.palette_highlight
{
    LDA item
    ASL A
    TAY
    LDA palette_row_offset, Y
    CLC
    ADC window_address+2*5
    STA highlight_address
    LDA palette_row_offset+1, Y
    ADC window_address+2*5+1
    STA highlight_address+1
.toggle
    LDA highlight_address
    STA screen_ptr
    LDA highlight_address+1
    STA screen_ptr+1
    JMP invert_menu_row
}

; The palette line highlighted.
.highlight_address
    EQUB &00, &00

; The selection, kept while Animate runs.
.animate_sprite
    EQUB &00

; OptionsA Animate (CTRL-A): for a sprite with a partner, show the two in
; turn, six vsyncs each, in the animation window and the editing grid until
; Space or Escape (a function key counts as Escape). The flames, &0E and &0F,
; alternate; &20 and &21 each alternate with themselves upside down, and &22
; and &23 with each other upside down. Nothing happens for other sprites.
; Both frames are copied to frame_a and frame_b first, so the turning upside
; down doesn't touch the graphics set.
.cmd_animate
{
    LDA #&FF
    STA by_slot                     ; sprite numbers are slots from here
    LDA sprite
    STA animate_sprite
    TAX
    AND #&10
    BNE none
    TXA
    JSR slot_index
    TAX
    LDA slot_of_position, X
    CMP #&24                        ; slots &24-&28: no
    BCS none
    CMP #&20                        ; slots &20-&23
    BCS machine
    CMP #&0E
    BEQ flames
    CMP #&0F
    BEQ flames
.none
    RTS
.flames
    PHA
    AND #&FE                        ; &0E: copy &0E and &0F
    BNE copy_pair
.machine
    PHA
.copy_pair
    CMP #&22                        ; &22 and &23 copy both; &20 and &21 copy themselves
    BCC copy_from
    AND #&FE
.copy_from
    JSR sprite_address
    LDY #&00
.copy
    LDA (data_ptr), Y               ; two sprites' worth: the frame and the next slot
    STA frame_a, Y
    DEY
    BNE copy
    LDA #WINDOW_PICK
    LDX #LO(text_animation)
    LDY #HI(text_animation)
    JSR open_window
    LDA sprite
    JSR slot_index
    TAX
    LDA slot_of_position, X
    CMP #&10
    BCS machine_frames
    LDA #&08                        ; the flames' pair of entries
    BNE chosen
.machine_frames
    AND #&03                        ; &20-&23: their own pair
    ASL A
.chosen
    STA frame_index
.show
    TAX
    LDA #&06
    STA frame_delay
    LDA animation_frames, X
    STA sprite
    BPL draw                        ; upside down?
    JSR flip_vertically
    LDA #&06
    STA frame_delay
.draw
    LDA sprite
    AND #&7F
    STA sprite
    JSR draw_grid
    LDA sprite
    JSR draw_sheet_sprite
.wait
    JSR menu_keys_escape
    BIT MOS_ESCAPE_FLAG
    BMI stop
    LDX #INKEY_TEST(KEY_SPACE)
    JSR key_pressed
    BMI stop
    LDA #OSBYTE_WAIT_VSYNC
    JSR OSBYTE
    DEC frame_delay
    BNE wait
    LDA frame_index
    TAX
    EOR #&01
    STA frame_index
    PHA
    LDA animation_frames, X         ; back the right way up before it's shown again
    BPL other_frame
    JSR flip_vertically
.other_frame
    PLA
    JMP show
.stop
    PLA                             ; drop the slot
    LDX animate_sprite
    STX sprite
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JSR OSBYTE
    LDA #WINDOW_PICK                ; by_slot bit 7 clear: sheet positions again
    STA by_slot
    JSR close_window
    JMP redraw_grid
}

; Turn a sheet position into an index into slot_of_position: positions
; &20-&28 follow &00-&0F.
; In:  A = a large sprite's position
; Out: A = the index
.slot_index
{
    CMP #FIRST_SMALL
    BCC repeat_key.done
    CMP #AFTER_SMALL
    BCC repeat_key.done
    SBC #&10
    RTS
}

; Animate's place in animation_frames, and its countdown to the next
; frame.
.frame_index
    EQUB &00

.frame_delay
    EQUB &00

; Animate's frames, a pair for each animated slot: SPRITE_FRAME_A or _B,
; with UPSIDE_DOWN to show it turned over.
.animation_frames
    EQUB SPRITE_FRAME_A, SPRITE_FRAME_A + UPSIDE_DOWN    ; &20
    EQUB SPRITE_FRAME_A, SPRITE_FRAME_A + UPSIDE_DOWN    ; &21
    EQUB SPRITE_FRAME_A, SPRITE_FRAME_B + UPSIDE_DOWN    ; &22
    EQUB SPRITE_FRAME_B, SPRITE_FRAME_A + UPSIDE_DOWN    ; &23
    EQUB SPRITE_FRAME_B, SPRITE_FRAME_A                  ; &0E, &0F

; Read one of the cursor keys that move the selection, with auto-repeat:
; a press moves at once, then after twenty passes of the main loop every
; five.
; In:  X = INKEY_TEST() of the key
; Out: Y = &FF (N set) to move now, else 0
; Clobbers: A, X
.repeat_key
{
    JSR key_pressed
    BPL not_now
    STX key_held                    ; a key is held this pass
    LDY repeat_count                ; 0: time to repeat
    BEQ move
    STY key_repeating
    CPY #&14                        ; &14: a fresh press
    BEQ move
.not_now
    LDY #&00
.done
    RTS
.move
    LDY #&FF
    RTS
}

; The selection's auto-repeat countdown: &14 while no key is held.
.repeat_count
    EQUB &00

; Move the selection with the cursor keys, and pace the main loop: it waits
; until two centiseconds have passed since the last call. If the selection
; moves, the old sprite is drawn again without its box, the new one is boxed
; and drawn in the editing grid (with an undo copy).
; In:  A = 0 normally, else function keys count as Escape (picking a second
;      sprite)
; Out: N set if nothing changed (or CTRL is held: then nothing is done)
; Clobbers: A, X, Y, and as draw_grid
.select_sprite
{
    STA select_mode
    LDX #INKEY_TEST(KEY_CTRL)
    JSR key_pressed
    BMI repeat_key.done             ; CTRL held: return N set (repeat_key's RTS)
    LDA sprite
    STA old_sprite
    LDA #&00
    STA key_held
    STA key_repeating
    LDX #INKEY_TEST(KEY_RIGHT)
    JSR repeat_key
    BPL left
    JSR sheet_column                ; the last column of the row?
    CMP last_column
    BEQ left
    INC sprite
    LDA sprite
    CMP #FIRST_SMALL
    BNE wrap_right
    LDA #&20                        ; after &0F comes &20
.wrap_right
    STA sprite
.left
    LDX #INKEY_TEST(KEY_LEFT)
    JSR repeat_key
    BPL left_done
    JSR sheet_column
    CMP #&00
    BEQ left_done
    DEC sprite
    LDA sprite
    CMP #LAST_SMALL
    BNE wrap_left
    LDA #&0F                        ; before &20 comes &0F
.wrap_left
    STA sprite
.left_done
    LDX #INKEY_TEST(KEY_DOWN)
    JSR repeat_key
    BPL down_done
    JSR sheet_row
    CPX #&08                        ; the bottom row of small sprites
    BEQ down_done
    LDA sprite
    CMP #&28                        ; nothing below the last large sprite
    BEQ down_done
    CMP #&0F                        ; &0F, at the start of row 3, has &24 below it...
    BNE not_a
    LDA #&24
    BNE store_down
.not_a
    CMP #&0A                        ; ...and &0A has &0F
    BNE step_down
    LDA #&0F
    BNE store_down
.step_down
    CLC
    ADC row_down_step, X
.store_down
    STA sprite
.down_done
    LDX #INKEY_TEST(KEY_UP)
    JSR repeat_key
    BPL up_done
    JSR sheet_row
    CPX #&00
    BEQ up_done
    LDA sprite
    CMP #&0F                        ; the same two, upwards
    BNE not_f
    LDA #&0A
    BNE store_up
.not_f
    CMP #&24
    BNE step_up
    LDA #&0F
    BNE store_up
.step_up
    SEC
    LDA sprite
    SBC row_down_step-1, X
.store_up
    STA sprite

    ; The auto-repeat: back to &14 while no key is held, else count down.
.up_done
    LDA repeat_count
    BNE delay
    LDA #&04
    STA repeat_count
.delay
    LDX #&14
    LDA key_held
    BEQ store_delay
    LDX repeat_count
    LDA key_repeating
    BEQ store_delay
    DEX
.store_delay
    STX repeat_count
    LDA select_mode
    BEQ wait
    JSR menu_keys_escape

    ; Wait until the interval timer reaches two centiseconds.
.wait
    LDA #OSWORD_READ_INTERVAL_TIMER
    JSR reset_timer.osword
    LDX #&04
    LDA #&00
.check
    ORA timer_value, X
    DEX
    BNE check
    CMP #&00
    BNE waited
    LDA timer_value
    CMP #&02
    BCC wait
.waited
    LDA #&00
    STA timer_value
    JSR reset_timer
    LDA old_sprite                  ; moved?
    CMP sprite
    BEQ sheet_row.return_negative
    JSR draw_sheet_sprite           ; the old sprite, without its box
    LDA sprite
    JSR show_selection

    ; A small sprite's grid is 8x16: keep the cursor in it.
    LDA sprite_width
    CMP #SMALL_WIDTH
    BNE changed
    LDX cursor_x
    CPX #&08
    BCC clamp_y
    LDX #&07
    STX cursor_x
.clamp_y
    LDY cursor_y
    CPY #&10
    BCC changed
    LDY #&0F
    STY cursor_y
.changed
    LDA sprite                      ; and take an undo copy
    ORA #&80
    JSR draw_grid
    LDA #&00
    RTS
}

; How far down a step moves the selection from each row of the sheet:
; large rows 0-4, then small rows 0-3. Up uses the row above's. (Some
; moves are special cases in select_sprite.)
.row_down_step
    EQUB 5, 5, &15, 5               ; large rows: &0B-&0E go to &20-&23
    EQUB LO(-&14)                   ; from the bottom large row to the small sprites
    EQUB 4, 4, 4                    ; small rows

; Set the interval timer to zero, the start of the main loop's pacing.
; Clobbers: A, X, Y
.reset_timer
{
    LDX #&04
    LDA #&00
.clear
    STA timer_value, X
    DEX
    BPL clear
    LDA #OSWORD_WRITE_INTERVAL_TIMER
.osword
    LDX #LO(timer_value)
    LDY #HI(timer_value)
    JMP OSWORD
}

; Set while a held cursor key is counting down to its next repeat.
.key_repeating
    EQUB &00

; The selected sprite's row in the sheet.
; Out: X = row (0-4 for the large sprites, 5-8 for the small ones),
;      last_column = 4; A = its column for a large sprite, &80 for a small
.sheet_row
{
    LDX #&04
    STX last_column
    LDA sprite
    CMP #FIRST_SMALL
    BCC sheet_column.large
    CMP #AFTER_SMALL
    BCS large
    LSR A
    LSR A
    AND #&03
    CLC
    ADC #&05
    TAX
.return_negative
    LDA #&80
    RTS
.large
    SBC #&10
    BCS sheet_column.large
}

; The selected sprite's column in the sheet.
; Out: A = column, last_column = the last in its row (4 large, 3 small)
; Clobbers: X
.sheet_column
{
    LDA #&04
    STA last_column
    LDA sprite
    CMP #FIRST_SMALL
    BCC large
    CMP #AFTER_SMALL
    BCS small
    AND #&03
    LDX #&03
    STX last_column
    RTS
.small
    SBC #&10
.large
    JMP divide_by_5
}

; Where a pixel of the editing grid is on the screen.
; In:  X = pixel x, Y = pixel y
; Out: screen_ptr = its top line (four lines tall, one byte wide)
; Clobbers: A
.grid_address
{
    TYA
    PHA
    AND #&FE
    TAY
    TXA
    ASL A
    ASL A
    ASL A
    CLC
    ADC grid_row_address, Y
    STA screen_ptr
    LDA grid_row_address+1, Y
    ADC #&00
    STA screen_ptr+1
    PLA
    LSR A                           ; odd rows are the bottom half of the character row
    BCC done
    LDA screen_ptr
    ORA #&04
    STA screen_ptr
.done
    RTS
}

; Draw or rub out the pixel cursor: dots in the corners of a grid pixel,
; exclusive-ORed on.
; In:  X = pixel x, Y = pixel y
; Clobbers: A, Y, screen_ptr
.toggle_cursor
{
    JSR grid_address
    LDY #&03
.loop
    LDA cursor_shape, Y
    EOR (screen_ptr), Y
    STA (screen_ptr), Y
    DEY
    BPL loop
    RTS
}

; The pixel cursor's four lines: the outer pixels' high bits, top and
; bottom.
.cursor_shape
    EQUB &90, &00, &00, &90

; Ask for the name of a file to save to. If it exists it must be a graphics
; set or an IO file (setting io_file), and the user is asked whether to
; replace it: Cancel abandons the command.
; Out: input_buffer = the name; io_file bit 7 set for an IO file
; Clobbers: A, X, Y, and as open_window
.ask_save_name
{
    LDA #WINDOW_INPUT
    LDX #LO(text_save_name)
    LDY #HI(text_save_name)
    JSR open_window
    JSR input_line
    LDA #WINDOW_INPUT
    JSR close_window
    JSR file_info
    BCS done
    CMP #OSFILE_TYPE_FILE           ; it exists
    BNE new
    JMP file_exists
.new
    LDA #&00                        ; a new file is a graphics set
    STA io_file
.done
    RTS
}

; Environment Save File (CTRL-f7): save the graphics set, &4000-&4F33, or
; write its three pieces into an IO file in place.
.cmd_save_file
{
    LDX #&03
    JSR check_filing_system
    JSR ask_save_name
    BIT io_file
    BMI io
    LDY #&0F                        ; clear the block after the name
    LDA #&00
.clear
    STA osfile_block+2, Y
    DEY
    BPL clear
    LDA #HI(graphics)               ; load and start address &4000...
    STA osfile_block+3
    STA osfile_block+11
    CLC
    ADC #HI(graphics_end - graphics) ; ...end &4F34
    STA osfile_block+15
    LDA #LO(graphics_end)
    STA osfile_block+14
    LDA #OSFILE_SAVE
    JSR osfile_graphics
.done
    RTS

    ; An IO file: write the three pieces in.
.io
    JSR open_file.update
    LDA #&00
.segment
    PHA
    TAX
    JSR set_segment
    JSR read_block.write
    PLA
    CLC
    ADC #&06                        ; six bytes an entry...
    CMP #&12                        ; ...three entries
    BCC segment
    JSR close_files
    JMP done
}

; Environment Save Sprite (CTRL-f9): write the selected sprite (and an
; object's name) into its place in an existing graphics set or IO file.
.cmd_save_sprite
{
    LDX #&01
    JSR check_filing_system
    JSR ask_save_name
    JSR open_file.update
    LDA sprite
    JSR sprite_address
    JSR sprite_file_offset
    JSR sprite_last_byte
    INY
    STY gbpb_block+5
    LDA data_ptr
    STA gbpb_block+1
    LDA data_ptr+1
    STA gbpb_block+2
    JSR read_block.write
    LDA sprite_width
    CMP #SMALL_WIDTH
    BNE not_small
    JSR write_name
.not_small
    JSR close_files
    JMP start.redraw
}

; The file to save to exists: check what it is, and ask whether to replace
; it. Cancel returns from the command that asked (ask_save_name's caller).
.file_exists
{
    JSR ask_load_name.found
    LDX #LO(text_exists)
    LDY #HI(text_exists)
    LDA #WINDOW_QUESTION
    JSR menu
    CMP #&02                        ; Replace
    BNE cancel
    JMP ask_save_name.done
.cancel
    PLA                             ; drop ask_save_name's return
    PLA
    JMP cmd_save_file.done
}

; Call the filing system control vector.
.fscv
{
    JMP (FSCV)
}

; Point gbpb_block at the sprite's place in the file.
; In:  data_ptr = the sprite's bytes; io_file
; Clobbers: A
.sprite_file_offset
{
    LDA data_ptr
    SEC
    SBC #LO(graphics)
    STA gbpb_block+9
    LDA data_ptr+1
    SBC #HI(graphics)
    STA gbpb_block+10
    BIT io_file
    BMI io
    RTS
.io
    LDA gbpb_block+10
    CMP #HI(&E00)                   ; slot &28, at the start of IO
    BNE io_graphics
    LDA #&00
    STA gbpb_block+10
    RTS
.io_graphics
    LDA gbpb_block+9
    CLC
    ADC #LO(IO_GRAPHICS)
    STA gbpb_block+9
    LDA gbpb_block+10
    ADC #HI(IO_GRAPHICS)
    STA gbpb_block+10
    RTS
}

; Point gbpb_block at the object's name in the file.
; In:  sprite = the object; io_file
; Out: Y = the name's offset in object_names
; Clobbers: A, X
.name_file_offset
{
    JSR name_offset
    LDX #&00
    BIT io_file
    BMI io
    LDX #HI(object_names - graphics)
.io
    TYA
    CLC
    ADC #LO(IO_NAMES)               ; &E80 in a graphics set, &80 in IO: the same low byte
    BCC store
    INX
.store
    STA gbpb_block+9
    STX gbpb_block+10
    RTS
}

; Unused: read a file's pointer.
.unused_read_ptr
{
    LDY gbpb_block
    LDX #&8B
    JMP OSARGS
}

; Clear gbpb_block, and refuse a command the filing system can't do.
; In:  X = 0 or 1 for the sprite commands, which need random access (not on
;      tape), 2 or 3 for whole files
; Clobbers: A, Y
.check_filing_system
{
    LDY #&0F
    LDA #&00
.clear
    STA gbpb_block, Y
    DEY
    BPL clear
    BIT disc_fs
    BPL tape
.done
    RTS
.tape
    CPX #&02
    BCS done
    LDX #&78
    LDY #&29
    JMP show_error
}

; Unused: an error saying "Not implemented".
.unused_not_implemented
{
    LDX #LO(text)
    LDY #HI(text)
    JMP show_error
.text
    EQUB PLAIN, CR
    EQUS "Not implemented", CR
    EQUB TEXT_END
}

; Open the file named by osfile_block for reading; at update, for reading
; and writing. A missing file is "Bad File".
; Out: gbpb_block's handle
; Clobbers: A, X, Y
.open_file
{
    LDA #OSFIND_OPEN_INPUT
    BITABS
.update
    LDA #OSFIND_OPEN_UPDATE
    LDX osfile_block
    LDY osfile_block+1
    JSR OSFIND
    TAX
    BNE opened
    JMP bad_file
.opened
    STX gbpb_block
    RTS
}

; Environment Load Sprite (CTRL-f8): read the selected sprite (and an
; object's name) from its place in a graphics set or IO file.
.cmd_load_sprite
{
    LDX #&00
    JSR check_filing_system
    JSR ask_load_name
    JSR open_file
    LDA sprite
    JSR sprite_address
    JSR sprite_file_offset
    JSR sprite_last_byte
    INY
    STY gbpb_block+5
    LDA data_ptr
    STA gbpb_block+1
    LDA data_ptr+1
    STA gbpb_block+2
    JSR read_block
    LDA sprite_width
    CMP #SMALL_WIDTH
    BNE not_small
    JSR read_name
.not_small
    JSR close_files
    JMP start.redraw
}

; Write the selected object's name to the file, unless it's the man.
.write_name
{
    JSR name_transfer
    BCC read_block.write
    RTS
}

; Point gbpb_block at the selected object's name, in memory and in the file.
; Out: carry set (and nothing done) for the man, who has no name
; Clobbers: A, X, Y
.name_transfer
{
    LDA sprite
    CMP #THE_MAN
    BNE named
    RTS
.named
    JSR name_file_offset
    LDA #12                         ; a name's length
    STA gbpb_block+5
    JSR name_offset
    TYA
    CLC
    ADC #LO(object_names)
    STA gbpb_block+1
    LDA #HI(object_names)
    ADC #&00
    STA gbpb_block+2
    CLC
.done
    RTS
}

; Read the selected object's name from the file, unless it's the man.
.read_name
{
    JSR name_transfer
    BCS name_transfer.done
}

; Read the block gbpb_block describes from the file; at write, write it.
; Clobbers: A, X, Y
.read_block
{
    LDA #OSGBPB_READ_AT
    BITABS
.write
    LDA #OSGBPB_WRITE_AT
    LDX #LO(gbpb_block)
    LDY #HI(gbpb_block)
    JMP OSGBPB
}

; Close all open files.
.close_files
{
    LDA #OSFIND_CLOSE
    TAY                             ; all of them
    JMP OSFIND
}

; Ask for the name of a file to load from: it must exist ("No Such File")
; and, on a disc, be a graphics set (loading at &40xx, &Fxx long) or an IO
; file (&33xx long) - anything else is "Bad File".
; Entry found: just check what the file is
; Out: io_file bit 7 set for an IO file
; Clobbers: A, X, Y, and as open_window
.ask_load_name
{
    LDA #WINDOW_INPUT
    LDX #LO(text_load_name)
    LDY #HI(text_load_name)
    JSR open_window
    JSR input_line
    LDA #WINDOW_INPUT
    JSR close_window
    JSR file_info
    BCS found
    CMP #OSFILE_TYPE_FILE           ; not there
    BNE cmd_load_file.no_file
.found
    LDA #&00
    STA io_file
    BIT disc_fs
    BMI disc
    RTS
.disc
    LDA osfile_block+3              ; the load address's second byte
    CMP #HI(graphics)
    BNE not_graphics
    LDA osfile_block+11
    CMP #HI(graphics_end - graphics) ; the length's
    BNE not_graphics
    RTS
}

; Bit 7 set when the file being loaded or saved is IO, not a graphics set.
.io_file
    EQUB &00
.not_graphics
    LDA osfile_block+11
    CMP #&33                        ; an IO file is &33xx long
    BEQ io
    JMP bad_file
.io
    LDA #&FF
    STA io_file
    RTS

; Environment Load File (CTRL-f6): load a graphics set, or the three pieces
; of one from an IO file.
.cmd_load_file
{
    LDX #&02
    JSR check_filing_system
    JSR ask_load_name
    BIT io_file
    BMI load_io
    LDA #OSFILE_LOAD
    JSR osfile_graphics
    JMP start.redraw
.no_file
    LDX #LO(text_no_such_file)
    LDY #HI(text_no_such_file)
    JMP show_error
}

; Point gbpb_block at one of the pieces of an IO file.
; In:  X = 0, 6 or 12: the piece's entry in io_segments
; Clobbers: A
.set_segment
{
    LDA io_segments, X
    STA gbpb_block+1
    LDA io_segments+1, X
    STA gbpb_block+2
    LDA io_segments+2, X
    STA gbpb_block+9
    LDA io_segments+3, X
    STA gbpb_block+10
    LDA io_segments+4, X
    STA gbpb_block+5
    LDA io_segments+5, X
    STA gbpb_block+6
    RTS
}

; Load the graphics set's three pieces from an IO file.
.load_io
{
    JSR open_file
    LDA #&00                        ; the first entry
.segment
    PHA
    TAX
    JSR set_segment
    JSR read_block
    PLA
    CLC
    ADC #&06
    CMP #&12
    BCC segment
    JSR close_files
    JMP start.redraw
}

; Where the graphics set is in an IO file (as MISSION builds it): each piece's
; address in the set, its offset in the file and its length.
.io_segments
    EQUW graphics + &E00, IO_SLOT_28, &80       ; large slot &28
    EQUW object_names, IO_NAMES, 15*12          ; the names
    EQUW graphics, IO_GRAPHICS, &E00            ; slots &00-&27

; Read the catalogue entry of the file named in input_buffer (OSFILE 5).
; Out: carry set if the filing system isn't a disc one (nothing read); else
;      carry clear, A = the object type (1 for a file), osfile_block filled
; Clobbers: X, Y
.file_info
{
    LDX #LO(input_buffer)
    STX osfile_block
    LDY #HI(input_buffer)
    STY osfile_block+1
    SEC
    BIT disc_fs
    BPL cmd_obj_name.done
    LDA #OSFILE_READ_INFO
}

; OSFILE on the graphics set at &4000.
; In:  A = OSFILE reason (0 save, &FF load, 5 read catalogue entry),
;      osfile_block's name and, to save, its start and end
; Out: carry clear
; Clobbers: A, X, Y
.osfile_graphics
{
    LDX #&00
    STX osfile_block+6              ; exec address 0: load where we say
    LDX #LO(graphics)
    STX osfile_block+2
    LDX #HI(graphics)
    STX osfile_block+3
    BIT disc_fs
    BMI call
    PHA
    LDA #VDU_CLS                    ; on tape, clear the screen for the filing system's messages
    JSR OSWRCH
    PLA
.call
    LDX #LO(osfile_block)
    LDY #HI(osfile_block)
    JSR OSFILE
    CLC
    RTS
}

; The "Bad File" error.
.bad_file
{
    LDX #LO(text_bad_file)
    LDY #HI(text_bad_file)
    JMP show_error
}

; OptionsA Obj name (CTRL-N): rename the selected object (not the man).
.cmd_obj_name
{
    LDA sprite_width
    CMP #SMALL_WIDTH
    BEQ small
.done
    RTS
.small
    LDA sprite
    CMP #THE_MAN
    BEQ done
    LDA #WINDOW_INPUT
    LDX #LO(text_object_name)
    LDY #HI(text_object_name)
    JSR open_window
    JSR input_line
    JSR name_offset
    LDX #&00
.copy
    LDA input_buffer, X
    STA object_names, Y
    INY
    INX
    CPX #12
    BCC copy
    LDA #WINDOW_INPUT
    JSR close_window
    LDA sprite
.show
    JMP show_selection
}

; The line input_line edits: twelve characters, padded with spaces, and a
; CR after the sixteen bytes it clears.
.input_buffer
    SKIP 12
    EQUB CR, CR, CR, CR, CR

; Read a line of up to input_limit characters into input_buffer, echoing
; it at screen_ptr. Delete rubs out a character, CTRL-U the lot; Return
; ends it; Escape or a function key abandons the command.
; In:  screen_ptr = where to echo it (open_window leaves it after the text)
; Out: input_buffer, Y = its length
; Clobbers: A, X, screen_ptr, aux_ptr
.input_line
{
    LDY #12
    STY input_limit
    LDY #&00
    LDA #OSBYTE_FLUSH_BUFFERS       ; empty the keyboard buffer
    JSR OSBYTE
    LDY #&0F
    LDA #ascii(" ")
.blank
    STA input_buffer, Y
    DEY
    BPL blank
    INY
.read
    LDA #ascii(" ")                 ; the end of the line, so far
    STA input_buffer, Y
    JSR OSRDCH
    BCC got_key
.abandon
    JMP pick_second_sprite.abandon_command
.got_key
    CMP #CODE_F0
    BCS abandon
    CMP #CR
    BNE edit
    RTS
.edit
    AND #&7F
    CMP #ctrl("U")
    BNE not_wipe
    TYA
    TAX
    BNE rub_out
    BEQ read
.not_wipe
    CMP #DEL
    BNE add
    CPY #&00
    BEQ read
    LDX #&01
.rub_out
    LDA screen_ptr
    SEC
    SBC #CELL
    STA screen_ptr
    BCS erase
    DEC screen_ptr+1
.erase
    CLC                             ; exclusive-OR it off again
    LDA input_buffer-1, Y
    JSR print_char
    DEY
    DEX
    BNE rub_out
    JMP read
.add
    CMP #ascii(" ")
    BCC read
    CPY input_limit
    BCS read
    STA input_buffer, Y
    INY
    JSR print_char_advance          ; carry clear: exclusive-OR it on
    JMP read
}

; The longest line input_line takes.
.input_limit
    EQUB &00

; Paint: move the pixel cursor with Z X : /, accelerating as a key is held;
; choose the colour with 0-4; plot with Return or clear with Delete. Does
; nothing while CTRL is held, for the shortcuts.
; Clobbers: A, X, Y, and as draw_sheet_sprite
.edit_pixels
{
    LDX #INKEY_TEST(KEY_CTRL)
    JSR key_pressed
    BPL move
    RTS
.move
    LDX cursor_x
    LDY cursor_y
    STX old_cursor_x
    STY old_cursor_y
    LDA sprite_width                ; count_x = width*4 - 1, the last pixel across
    ASL A
    ASL A
    STA count_x
    ASL A                           ; count_y = width*8 - 1, the last row
    STA count_y
    DEC count_x
    DEC count_y
    LDX #INKEY_TEST(KEY_X)
    JSR key_pressed
    BPL not_right
    LDX cursor_x
    CPX count_x
    BCS not_right
    LDX #INKEY_TEST(KEY_X)
    JSR key_delay
    INC cursor_x
.not_right
    LDX #INKEY_TEST(KEY_Z)
    JSR key_pressed
    BPL not_left
    LDX cursor_x
    BEQ not_left
    LDX #INKEY_TEST(KEY_Z)
    JSR key_delay
    DEC cursor_x
.not_left
    LDX #INKEY_TEST(KEY_SLASH)
    JSR key_pressed
    BPL not_down
    LDY cursor_y
    CPY count_y
    BCS not_down
    LDX #INKEY_TEST(KEY_SLASH)
    JSR key_delay
    INC cursor_y
.not_down
    LDX #INKEY_TEST(KEY_COLON)
    JSR key_pressed
    BPL not_up
    LDY cursor_y
    BEQ not_up
    LDX #INKEY_TEST(KEY_COLON)
    JSR key_delay
    DEC cursor_y
.not_up
    LDX #INKEY_TEST(KEY_1)
    JSR key_pressed
    BPL not_1
    LDA #&01
    STA colour
    JSR show_colour
.not_1
    LDX #INKEY_TEST(KEY_2)
    JSR key_pressed
    BPL not_2
    LDA #&02
    STA colour
    JSR show_colour
.not_2
    LDX #INKEY_TEST(KEY_3)
    JSR key_pressed
    BPL not_3
    LDA #&03
    STA colour
    JSR show_colour
.not_3
    LDX #INKEY_TEST(KEY_4)
    JSR key_pressed
    BMI colour_0
    LDX #INKEY_TEST(KEY_0)
    JSR key_pressed
    BPL not_0

    ; 4 and 0 both give colour 0.
.colour_0
    LDA #&00
    STA colour
    JSR show_colour

    ; Moved: shorten the repeat delay and move the cursor.
.not_0
    LDA old_cursor_x
    EOR cursor_x
    BNE moved
    EOR cursor_y
    EOR old_cursor_y
    BEQ still
.moved
    LDA repeat_delay
    SEC
    SBC #&0A                        ; down to a minimum of 10
    CMP #&0A
    BCS delay_ok
    LDA #&0A
.delay_ok
    STA repeat_delay
    LDX cursor_x
    LDY cursor_y
    JSR toggle_cursor               ; draw it at the new place...
    LDX old_cursor_x
    LDY old_cursor_y
    JSR toggle_cursor               ; ...and rub it out at the old
    JMP plot_keys
.still
    LDA #&B9                        ; the delay before a held key first repeats
    STA repeat_delay
.plot_keys
    LDX #INKEY_TEST(KEY_DELETE)
    JSR key_pressed
    BPL not_delete
    LDA colour
    PHA
    INX                             ; X = &FF + 1: colour 0
    STX colour
    JSR plot
    PLA
    STA colour
    RTS
.not_delete
    LDX #INKEY_TEST(KEY_RETURN)
    JSR key_pressed
    BPL done

    ; Plot: fill the grid pixel (keeping the cursor on it), set the pixel in
    ; the sprite, and show the sprite in the sheet.
.plot
    LDX cursor_x
    LDY cursor_y
    JSR grid_address
    LDY #&03
    LDX colour
.block
    LDA colour_byte, X
    EOR cursor_shape, Y
    STA (screen_ptr), Y
    DEY
    BPL block
    LDA sprite
    LDX cursor_x
    LDY cursor_y
    JSR plot_pixel
    LDA sprite
    BNE not_background
    JSR repeat_background           ; the background tile repeats every eight bytes
.not_background
    LDA sprite
    JSR draw_sheet_sprite
.done
    RTS
}

; Sheet position 0 is the background: a 4x8 pixel tile repeated. Copy the
; eight bytes just changed through the whole sprite and redraw it.
; In:  data_ptr = the byte plot_pixel changed
.repeat_background
{
    LDA data_ptr
    AND #&F8
    STA data_ptr
    LDY #&07
.read
    LDA (data_ptr), Y
    STA background_tile, Y
    DEY
    BPL read
    LDY #&7F
    LDX #&07
.fill
    LDA background_tile, X
    STA graphics, Y
    DEX
    TXA
    AND #&07
    TAX
    DEY
    BPL fill
    CLC
    JMP redraw_grid
}

; The background tile's eight bytes.
.background_tile
    EQUB &00, &00, &00, &00, &00, &00, &00, &00

; The pixel cursor's key repeat: wait while the key is held, up to
; repeat_delay * 256 trips round a loop.
; In:  X = INKEY_TEST() of the key
; Clobbers: A, X, Y
.key_delay
{
    STX temp
    LDA repeat_delay
    STA count_x
.poll
    LDX temp
    JSR key_pressed
    BMI held
    RTS
.held
    LDX #&00
.spin
    DEX
    BNE spin
    DEC count_x
    BNE poll
    RTS
}

; The bits of each of the four pixels in a MODE 5 byte.
.pixel_mask
    EQUB &88, &44, &22, &11

; Find a pixel of a sprite.
; In:  A = sprite, X = pixel x, Y = pixel y
; Out: data_ptr = its byte, A = mask = its bits
; Clobbers: X, Y, pixel_x, pixel_y
.pixel_address
{
    STX pixel_x
    STY pixel_y
    JSR sprite_address
    LDA sprite_width
    ASL A
    ASL A
    ASL A
    TAY
    LDA pixel_x
    LSR A
    LSR A
    TAX
.column
    DEX                             ; a column of bytes for each four pixels across
    BMI got_column
    TYA
    CLC
    ADC data_ptr
    STA data_ptr
    BCC column
.got_column
    LDA pixel_y
    ORA data_ptr
    STA data_ptr
    LDA pixel_x
    AND #&03
    TAX
    LDA pixel_mask, X
    STA mask
    RTS
}

; Set a pixel of a sprite to colour.
; In:  A = sprite, X = pixel x, Y = pixel y, colour
; Clobbers: A, X, Y, data_ptr, temp, mask
.plot_pixel
{
    JSR pixel_address
    EOR #&FF
    LDY #&00
    AND (data_ptr), Y
    STA temp
    LDX colour
    LDA colour_byte, X
    AND mask
    ORA temp
    STA (data_ptr), Y
    RTS
}

; Read a pixel of a sprite.
; In:  A = sprite, X = pixel x, Y = pixel y
; Out: A = its colour, 0-3
; Clobbers: X, Y, data_ptr, mask
.read_pixel
{
    JSR pixel_address
    LDY #&00
    AND (data_ptr), Y

    ; Shift the pixel's two bits down to make its colour.
.find_bit
    LSR mask
    BCS got_bit
    LSR A
    BCC find_bit
.got_bit
    LSR A
    PHP
    LSR A
    LSR A
    LSR A
    PLP
    ROL A
    RTS
}

; Each menu's text, and the function key that opens it.
.menu_text
    EQUW text_options_a, text_options_b, text_environment, text_credits
.menu_keys
    EQUB INKEY_TEST({KEY_F0, KEY_F1, KEY_F2, KEY_F3})

; Read a command: a CTRL shortcut, or a choice from the menu whose function
; key is pressed.
; Out: A = the command's number in command_table (menu * 8 + item), 0 for
;      the credits, or &FF for none
; Clobbers: X, Y, and as menu
.read_command
{
    LDX #INKEY_TEST(KEY_CTRL)
    JSR key_pressed
    BPL menus
    LDA #24-1                       ; from the last of shortcut_keys
    STA temp
.shortcut
    LDY temp
    LDX shortcut_keys, Y
    BPL next_shortcut               ; not a key: an unused entry
    JSR key_pressed
    BMI found
.next_shortcut
    DEC temp
    BPL shortcut
    LDA #&FF
    RTS
.found
    INC temp                        ; the shortcut's command is one more than its place
    LDA temp
    RTS
.menus
    LDA #&03                        ; from the last menu, the credits
.menu_key
    PHA
    TAY
    LDX menu_keys, Y
    JSR key_pressed
    BPL next_menu
    PLA
    PHA
    ASL A
    TAY
    LDX menu_text, Y
    LDA menu_text+1, Y
    TAY
    PLA
    PHA
    JSR menu
    CMP #&00                        ; the credits: nothing to pick
    BNE picked
    PLA
    LDA #&00
    RTS
.picked
    STA temp
    PLA
    ASL A                           ; menu * 8 + item, or &FF if nothing was picked
    ASL A
    ASL A
    ORA temp
    RTS
.next_menu
    PLA
    SEC
    SBC #&01
    BCS menu_key
    RTS
}

; The CTRL shortcuts, in command order from command 1; entries that aren't
; keys (below &80) have none.
.shortcut_keys
    EQUB INKEY_TEST({KEY_X, KEY_Y, KEY_DELETE, KEY_U, KEY_A, KEY_N}), NO_KEY, NO_KEY ; OptionsA
    EQUB INKEY_TEST({KEY_S, KEY_COPY, KEY_O}), NO_KEY, INKEY_TEST({KEY_R, KEY_B}), NO_KEY, NO_KEY ; OptionsB
    EQUB INKEY_TEST({KEY_F8, KEY_F9, KEY_F6, KEY_F7, KEY_C}), 0, 0, 0                ; Environment

; Which cursor key the selection last saw held.
.key_held
    EQUB 0, 0
; Non-zero while picking a second sprite.
.select_mode
    EQUB 0
; The interval timer, as OSWORD 3 reads it.
.timer_value
    EQUB 0, 0, 0, 0, 0

; While picking a second sprite or animating, f0-f3 count as Escape: raise
; one (OSBYTE &7D) if any of them is pressed.
; Clobbers: A, X, Y
.menu_keys_escape
{
    LDA #&03
.loop
    PHA
    TAY
    LDX menu_keys, Y
    JSR key_pressed
    BPL next
    LDA #OSBYTE_RAISE_ESCAPE
    JSR OSBYTE
.next
    PLA
    SEC
    SBC #&01
    BCS loop
    RTS
}

; Not part of the program: what was in memory after it when it was saved
; (a pointer table and graphics, from the look of it).
.leftover
    EQUB &FF, &9A, &4C, &C3, &12, &FC, &1F, &01
    EQUB &1F, &44, &1F, &CD, &1F, &D7, &20, &56
    EQUB &1F, &8A, &20, &19, &1A, &F5, &20, &B7
    EQUS " H s & "
    EQUB &05, &20, &10, &1F, &0E, &20, &0A, &15
    EQUB &8B, &1C, &C2, &1C, &1E, &18, &75, &16
    EQUB &F5, &1C, &FC, &1D, &A9, &18, &A9, &18
    EQUB &A9, &18, &A9, &18, &0A, &15, &08, &07
    EQUB &0A
    EQUB &09, &0C, &0C, &19, &F0, &C0, &80, &33
    EQUB &77, &FF, &FF, &FF, &00, &00, &FF, &FF
    EQUB &FF, &CC, &88, &88, &00, &00, &FF, &FF
    EQUB &FF, &33, &11, &11, &0F, &03, &01, &CC
    EQUB &EE, &EE, &FF, &FF, &F0, &F0, &F0, &F0
    EQUS "pp00"
    EQUB &F0, &F0, &F0, &E0, &C0, &C0, &91, &C0
    EQUB &E0, &80, &11, &77, &FF, &FF, &FF, &FF
    EQUB &00, &00, &FF, &FF
    EQUB &FF, &88, &88, &88, &00, &00, &FF, &FF
    EQUB &FF, &00, &00, &00, &00, &00, &FF, &FF
    EQUB &FF, &00, &00, &10, &F0, &70, &30, &98
    EQUB &30, &70, &F0, &F0, &F0, &F0, &F0, &F0
    EQUB &F0, &F0, &F0, &F0, &F0, &F0, &F0, &E0
    EQUB &E0, &F0, &F0, &F0, &C0, &80
    EQUS "3ww333"
    EQUB &10, &10, &CC, &EE, &EE, &EE, &EE, &EE
    EQUB &F0, &F0, &F0, &70
    EQUS "pppp"
    EQUB &00, &00, &F0, &F0, &F0, &F0, &F0, &F0
    EQUB &FF, &FF, &F0, &E0, &C0, &C0, &91, &91
ENDSECTION

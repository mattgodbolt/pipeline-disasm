INCLUDE "os.6502inc"

; OS workspace not in os.6502inc.
ERROR_PTR    = &FD              ; the last error: BRK address, then number and message
ESCAPE_FLAG  = &FF              ; bit 7 set while an Escape is pending
RESET_VECTOR = &FFFC

; Screen layout: MODE 5, 20 character cells of 8 bytes across each row.
SCREEN = &5800
CELL   = 8
ROW    = &140

graphics      = &4000
object_names  = &4E80
graphics_end  = &4F34
frame_a       = &3E00
frame_b       = &3E80
undo_buffer   = &3F80
colour_swatch = SCREEN + 19*ROW + 1*CELL
name_box      = SCREEN + 19*ROW + 4*CELL
logo_screen   = SCREEN + 28*ROW + 18*CELL
grid_frame_top   = SCREEN + 10*CELL + 7
grid_frame_right = SCREEN + ROW + 18*CELL

; Zero page.
screen_ptr   = &50
data_ptr     = &52
save_ptr     = &54
pixel_x      = &56
pixel_y      = &57
aux_ptr      = &58
line_count   = &60
temp         = &61
count_x      = &62
count_y      = &63
item         = &64
mask         = &65
sprite_width = &70
sprite       = &71
old_sprite   = &72
cursor_x     = &73
cursor_y     = &74
old_cursor_x = &75
old_cursor_y = &76
colour       = &77
repeat_delay = &78
last_column  = &7A
by_slot      = &7B
border_ptr   = &7C
escape_latch = &7E

SECTION hidden_graphic, filename="H.GRAPH", org=&1AB0

.logo

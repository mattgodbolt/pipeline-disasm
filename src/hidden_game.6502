; H.GAME: PIPELINE itself (William Reeve & Ian Holmes, Superior Software 1988).
;
; The GAME stub reads this from the hidden sectors &122-&142 to &3000 and jumps
; to it. It's built to be loaded at &3000 but to run lower down: the loader at
; the start copies the rest into the stack page, page 8, &0400-&07FF and
; &0900-&23AC, sets up the screen and the sound event, and jumps to the game,
; which then loads the mission file IO over the loader (see io.6502inc).
;
; Names for the game's screen and data are in game.6502inc (the OS's in
; osconst.6502inc, a level's in leveldata.6502inc). Routine headers say what
; a routine is for, then In:, Out: and Clobbers: (where "everything" means
; the registers and whatever zero page the routines it calls use). Text is
; printed through the OS, placed with TEXT_AT.
;
; First drafted by tools/dis6502seg.py (hints/hidden_game.toml); edited by
; hand since, so don't regenerate over it.

INCLUDE "os.6502inc"
INCLUDE "osconst.6502inc"
INCLUDE "io.6502inc"

SECTION hidden_game, filename="H.GAME", org=&3000
.game
{
INCLUDE "game.6502inc"                  ; in the scope: its names are the game's own

; Zero page. The loader's block copy uses &00-&07 too (copy_return...).
monster_x = &00                         ; MONSTERS of MONSTER_BYTES: x, y in character cells
monster_y = &01
monster_direction = &02                 ; DIRECTION_*; + MONSTER_STUCK: stuck; MONSTER_GONE and up: not out
monster_turns = &03                     ; four 2-bit TURN_* fields, tried from the bottom
thrown_x = &10                          ; a thrown object in flight, in character cells
thrown_y = &11
thrown_direction = &12                  ; THROWN_*: its direction + 1, or 0 for nothing in flight
thrown_picture = &13                    ; its icon; once it lands, the cell type it hit
thrown_picture_high = &14
front_x = &15                           ; the cell in front of the player (or a thrown object hit)
front_y = &16
action = &17                            ; ACTION_*: the action to do next
frame_counter = &18                     ; +&20 a cycle; bit 7 picks the monsters' picture
thrown_object = &19                     ; the object thrown; + &80 while it lands; then &FF
backpack_slot = &1A                     ; the selected slot
throw_range = &1B                       ; cells the thrown object has left to fly
started_late = &1C                      ; nonzero: the game didn't start on level 1
pushes_left = &1D                       ; how many more crates the player may push
clock_fraction = &1E                    ; io_time_rate is added each cycle
clip_position = &1F                     ; the sprite's x or y, being clipped to the view
player_x = &20                          ; the player's map cell
player_y = &21
score = &22                             ; BCD: the low two digits
score_high = &23                        ; and the high two
backpack = &24                          ; BACKPACK_SLOTS: an object, or negative for empty
menu_key_left = &29                     ; the direction keys as MENU set them (the loader
menu_key_right = &2A                    ; copies all ten here, but the rest are soon
menu_key_up = &2B                       ; overwritten)
menu_key_down = &2C
empty_channel = &2D                     ; the sound channel the event says ran dry
lives = &2E
sound_channel = &30                     ; an OSWORD 7 block for sound effects
sound_channel_high = &31
sound_amplitude = &32
sound_amplitude_high = &33
sound_pitch = &34
sound_pitch_high = &35
sound_duration = &36
sound_duration_high = &37
tune_channel = &38                      ; an OSWORD 7 block for the tune
tune_channel_high = &39
tune_amplitude = &3A
tune_amplitude_high = &3B
tune_pitch = &3C
tune_pitch_high = &3D
tune_duration = &3E
tune_duration_high = &3F
tune_position = &40                     ; voice 1's next note
tune_position_2 = &41                   ; voice 2's
tune_swap = &42                         ; which voice plays alone: 0 voice 1, 1 voice 2
tune_transpose = &43                    ; 0 or TRANSPOSE_FOURTH
tune_together = &44                     ; nonzero: both voices play
triggers_fired = &48                    ; counts triggers that matched and acted
level = &49                             ; 0-3
draw_step = &4A                         ; drawing: cells to a picture's edge, a step from cell to cell, or flip the player
draw_step_high = &4B
monster_index = &4C
picture_stride = &4E                    ; bytes from one column of a picture to the next
picture_size = &4F                      ; negative: a whole picture; 1: an icon on the floor
work0 = &50                             ; scratch, used for all sorts
work1 = &51
work2 = &52
work3 = &53
work4 = &54
work5 = &55
start_x = &56                           ; the level's setup, copied from io_level_setup
start_y = &57
to_collect = &58                        ; sulphur still to collect
time_left = &59                         ; the clock
exit_x = &5A
exit_y = &5B
monster_food = &5C                      ; low nibble: a cell monsters eat; high: what they leave
alternate_cells = &5D                   ; 2 bits a cell type: which squares use its second picture
player_dead = &5E                       ; nonzero: lose a life
pipe_move = &5F                         ; inside a pipe: the move action that carries the player on
stage = &60                             ; STAGE_*
furthest_level = &61                    ; the title screen's start level goes up to this
front_cell = &62                        ; what's in the cell in front of the player
fill_screen = &63                       ; nonzero: clear_screen fills with the floor pattern, not black
tune_off = &64
effects_off = &65
action_keys = &66                       ; by action: P, D, M, CTRL, T, Return (actions 1-6)
key_map = action_keys + ACTION_MAP - 1  ; M
key_left = &6C                          ; this level's direction keys (actions 7-10)
key_right = &6D
key_up = &6E
key_down = &6F
cell_x = &70                            ; the map cell being looked at or drawn
cell_y = &71
screen_start = &72                      ; the CRTC's start address
screen_start_high = &73
view_sub_x = &74                        ; the character column, within its map cell, being drawn
view_sub_y = &75                        ; the character row, likewise
picture = &76                           ; the picture being drawn
picture_high = &77
screen = &78                            ; where it's being drawn
screen_high = &79
strip_cells = &7A                       ; map cells drawn along a row so far
cell_low_nibble = &7B                   ; the cell is in its map byte's low nibble
map_pointer = &7C
map_pointer_high = &7D
strip_cells_down = &7E                  ; map cells drawn down a column so far
steps = &7F
view_screen = &80                       ; the screen address of the view's top left
view_screen_high = &81
count_across = &82
count_down = &83
player_screen = &84
player_screen_high = &85
player_screen_base = &86                ; the player's top left on the screen
player_screen_base_high = &87
player_frame = &88                      ; +&20 a cell walked; bit 7 flips the player's picture
facing = &89                            ; DIRECTION_*
view_x = &8A                            ; the view's top left, in character cells (4 to a map cell)
view_y = &8B
sprite_columns = &8E                    ; character cells to draw, less 1
sprite_rows = &8F
sprite_column = &90
sprite_row = &91
sprite_screen = &92
sprite_screen_high = &93
view_cell_x = &94                       ; view_x DIV 4
view_cell_y = &95
temp = &96
sprite = &97                            ; the picture being drawn
sprite_high = &98
sprite_skip_x = &99                     ; character cells cut off the left
sprite_skip_y = &9A                     ; and the top
steps_since_drawn = &9B                 ; steps scrolled in a pipe since the player was last drawn

; Elsewhere.
trigger_flags = &0100                   ; a byte per trigger, from io_level_trigger_flags
keys_were_down = &0120                  ; a byte per direction key: 1 if it was down last time
step_y = &0124                          ; step's scratch
saved_extended_vectors = &037F          ; over the cassette filing system's workspace
map = &5800                             ; the level being played's map, copied from io_maps

menu_keys = &50                         ; where MENU leaves the ten keys
copy_return = &00
copy_from = &02
copy_to = &04
copy_count = &06

; A level's objects, OBJECT_BYTES each, laid over code that runs once.
objects = game_start
object_x = objects + 0
object_y = objects + 1
object_icon = objects + 2
object_flags = objects + 3

; The triggers' places and arguments, laid over the end of the game's own
; code by setup_level (trigger_places) and just past it.
trigger_args = trigger_places + 2 * PUZZLES     ; 4 bytes a trigger
trigger_condition = trigger_args + 3

; Masks for BIT that are other instructions' operands.
bit4_mask = show_map_centre + 1         ; the byte there is &10
bit6_mask = fire_object_vanishes + 1    ; the byte there is &40

; Entered from the GAME stub. Copies MENU's ten keys where the game wants
; them, copies the game into place, sets up the screen and the sound event,
; and starts the game.
; In: menu_keys = the ten keys MENU set up, as negative INKEY numbers.
.loader
    LDX #&FF                            ; the event handler lives in the stack page
    TXS
    LDY #MENU_KEYS - 1
.copy_keys_loop
    LDX key_order, Y
    LDA menu_keys, X                    ; MENU's key
    STA menu_key_left, X                ; as MENU left it
    STA action_keys, Y                  ; in the order the game tests its actions
    DEY
    BPL copy_keys_loop

; Each copy_block call is followed by its source, destination and length.
    JSR copy_block
    EQUW MOS_EXTENDED_VECTORS, saved_extended_vectors, &100 - LO(MOS_EXTENDED_VECTORS)
    JSR copy_block
    EQUW event_handler_load, event_handler, event_handler_end - event_handler
    JSR copy_block
    EQUW sound_data_load, sound_data, sound_data_end - sound_data
    JSR copy_block
    EQUW low_code_load, low_code, low_code_end - low_code
    JSR copy_block
    EQUW main_code_load, main_code, main_code_end - main_code

; MODE 5, then VDU 23,0,10,32;0;0;0 (CRTC register 10: no cursor), sent from
; the end of cursor_off_vdu backwards.
    LDA #VDU_MODE
    JSR OSWRCH
    LDA #5
    JSR OSWRCH
    LDY #cursor_off_vdu_end - cursor_off_vdu - 1
.cursor_off_loop
    LDA cursor_off_vdu, Y
    JSR OSWRCH
    DEY
    BPL cursor_off_loop

; The sound event: the OS calls EVNTV when a sound channel's queue empties
; (enabled when the tune starts), and the handler feeds the tune.
    SEI
    LDA #LO(event_handler)
    STA EVNTV
    LDA #HI(event_handler)
    STA EVNTV + 1
    CLI

; The game's screen is SCREEN to SCREEN_END, scrolled by the hardware.
    LDA #SCREEN_WRAP_8K
    STA SYSVIA_ORB
    JMP game_start

; Never printed: a note for whoever looks.
.message_to_crackers
    EQUS " GET YOUR GRUBBY LITTLE HANDS OFF THIS PROGRAM! "

; VDU 23, 0, CRTC_CURSOR_START, CRTC_CURSOR_OFF, 0, 0, 0, 0, 0, 0, backwards.
.cursor_off_vdu
    EQUB 0, 0, 0, 0, 0, 0, CRTC_CURSOR_OFF, CRTC_CURSOR_START, 0, VDU_DEFINE
.cursor_off_vdu_end

; For each of the action keys in the order the game tests them (action_keys),
; then the direction keys (key_left...), which of MENU's ten it is.
.key_order
    EQUB MENU_KEY_PICK_UP, MENU_KEY_DROP, MENU_KEY_MAP, MENU_KEY_BACKPACK
    EQUB MENU_KEY_THROW, MENU_KEY_USE
    EQUB MENU_KEY_LEFT, MENU_KEY_RIGHT, MENU_KEY_UP, MENU_KEY_DOWN
ASSERT P% - key_order = MENU_KEYS
ASSERT key_left = action_keys + ACTION_LEFT - 1

; Copy a block of memory, then return past the six bytes that follow the JSR.
; In: after the JSR, the source, the destination and the length, a word each.
; Clobbers: A, X, Y, copy_return, copy_from, copy_to, copy_count.
.copy_block
    PLA                                 ; the JSR's return address, less 1
    STA copy_return
    PLA
    STA copy_return + 1
    LDY #1
.copy_block_params
    LDA (copy_return), Y                ; the parameters into copy_from, copy_to, copy_count
    STA copy_from - 1, Y
    INY
    CPY #1 + 6
    BNE copy_block_params
    LDX copy_count
    TYA                                 ; step the return address past them
    CLC
    ADC copy_return
    BCC copy_block_data
    INC copy_return + 1
.copy_block_data
    STA copy_return
    LDY #0
.copy_block_loop
    LDA (copy_from), Y
    STA (copy_to), Y
    INY
    BNE copy_block_count
    INC copy_from + 1
    INC copy_to + 1
.copy_block_count
    TXA
    BNE copy_block_next
    DEC copy_count + 1
.copy_block_next
    DEX
    TXA
    ORA copy_count + 1
    BEQ copy_block_return
    BNE copy_block_loop
.copy_block_return
    JMP (copy_return)                   ; return past the parameters

; Never used: zeros to the end of the page.
.loader_unused
    SKIP 25

; The sound event handler, run in the stack page (the stack never gets this
; deep).
.event_handler_load
SECTION event_handler, org=&0131

; EVNTV, for the "output buffer empty" event (the only one enabled): play the
; tune's next note on the channel that ran dry, and when a voice has played
; its last note, start the tune again with the next variation.
; In: X = the buffer that's empty (BUFFER_SOUND_0 + the sound channel).
; Preserves A, X and Y.
.event_handler
    PHA
    TXA
    PHA
    TYA
    PHA
    DEX                                 ; X - BUFFER_SOUND_0: the channel that's run dry
    DEX
    DEX
    DEX
    STX empty_channel
    JSR play_tune                       ; play its next note
    LDA tune_position                   ; has the first voice finished?
    CMP #TUNE_NOTES
    BEQ restart_tune
    TAX                                 ; the first voice is part way through
    BNE event_handler_return
    LDA tune_position_2                 ; or the second, when only it is playing
    CMP #TUNE_NOTES
    BNE event_handler_return

; Both voices back to the start, each with a silent note to get the event
; going again; then step the variation. The tune goes round voice 1 alone,
; both, voice 1 alone a fourth up, both a fourth up, then the same with voice
; 2 alone instead.
.restart_tune
    LDY #1
    STY tune_channel                    ; channel 1
    STY tune_channel_high               ; SOUND_SYNC_1: in step with the other voice
    DEY
    STY tune_position                   ; both voices to their first note
    STY tune_position_2
    STY tune_amplitude                  ; silent
    STY tune_amplitude_high
    STY tune_duration                   ; for no time
    STY tune_duration_high
    JSR sound_tune_block
    INC tune_channel                    ; channel 2
    JSR sound_tune_block
    LDA tune_together
    EOR #&01
    STA tune_together
    BNE event_handler_return
    LDA tune_transpose
    EOR #TRANSPOSE_FOURTH
    STA tune_transpose
    BNE event_handler_return
    LDA tune_swap
    EOR #&01
    STA tune_swap
.event_handler_return
    PLA
    TAY
    PLA
    TAX
    PLA
    RTS

; Copied but never used.
.event_handler_unused
    SKIP 12
.event_handler_end
ENDSECTION

; The tune played during a level, in the printer buffer, and the four sound
; envelopes, written straight into the OS's envelope store rather than with
; OSWORD 8.
.sound_data_load
SECTION sound_data, org=&0880
.sound_data

; The tune: two voices of TUNE_VOICE_BYTES notes, each a byte with the pitch
; (in semitones up from the voice's lowest note) in the high nibble and the
; duration (in twentieths of a second) in the low; see play_voice. Only the
; first TUNE_NOTES of each are played.
.tune
    EQUB &59, &73, &86, &D6, &C9, &A3, &86, &76, &59, &73, &86, &56, &79, &43, &16, &06
    EQUB &59, &73, &86, &D6, &C9, &A3, &86, &76, &59, &73, &86, &46, &5C, &5C, &70, &00
.tune_voice_2
    EQUB &56, &86, &56, &86, &46, &76, &46, &76, &56, &86, &56, &86, &46, &76, &16, &06
    EQUB &56, &86, &56, &86, &46, &76, &46, &76, &56, &86, &56, &46, &5C, &5B, &30, &00

; Envelopes 1-4, as the OS keeps them (ENVELOPE's parameters after its
; number, padded to 16 bytes): T, PI1-3, PN1-3, AA, AD, AS, AR, ALA, ALD.
; See ENVELOPE_VOICE_1 and the rest.
.envelopes
ASSERT envelopes = MOS_ENVELOPES
    EQUB 4, 1, -1, 1, 1, 2, 1, 70, 10, -12, -15, 70, 100, 0, 0, 0
    EQUB 5, 1, -1, 0, 1, 1, 0, 100, -10, 0, -12, 100, 0, 0, 0, 0
    EQUB &84, 0, 8, -8, 3, 1, 1, 126, -5, -10, -20, 126, 0, 0, 0, 0
    EQUB 3, 0, 0, 0, 1, 1, 1, 100, -6, 0, -8, 126, 0, 0, 0, 0
.sound_data_end
ENDSECTION

; Not copied: zeros to the end of the page.
.sound_data_padding
    SKIP 32

; Map view patterns and the code that scrolls the playing area.
.low_code_load
SECTION low_code, org=&0400
.low_code

; What the map view (the M key) draws for each cell type: 4 pixels by 4 lines,
; a byte (four MODE 5 pixels) a line. Then the player, facing each way.
.map_view_patterns
    EQUB &00, &00, &00, &00             ; CELL_FLOOR
    EQUB &10, &30, &70, &F0             ; 1-4: curved walls
    EQUB &80, &C0, &E0, &F0
    EQUB &F0, &70, &30, &10
    EQUB &F0, &E0, &C0, &80
    EQUB &F0, &F0, &F0, &F0             ; 5: a wall
    EQUB &06, &69, &69, &06             ; CELL_CRATE
    EQUB &FF, &FF, &66, &66             ; CELL_SULPHUR
    EQUB &1F, &2F, &4F, &8F             ; CELL_WALL
    EQUB &FF, &60, &60, &FF             ; 9: a wall
    EQUB &60, &90, &90, &60             ; CELL_LAVA
    EQUB &06, &0F, &0F, &06             ; CELL_JUNCTION
    EQUB &00, &0F, &0F, &00             ; CELL_PIPE_ACROSS
    EQUB &06, &06, &06, &06             ; CELL_PIPE_DOWN
    EQUB &F0, &96, &96, &F0             ; CELL_FIRE
    EQUB &00, &00, &00, &00             ; CELL_OBJECT: not shown
.map_view_player
    EQUB &C3, &69, &69, &C3             ; DIRECTION_LEFT, and so on
    EQUB &3C, &69, &69, &3C
    EQUB &96, &F0, &69, &0F
    EQUB &0F, &69, &F0, &96

; Clear the game screen to black, or with fill_screen set to the floor
; picture's first character cell over and over; reset the hardware scroll and
; set up the CRTC for the game's screen. The display is off meanwhile.
; Out: screen_start and view_screen at the top of the screen.
; Clobbers: A, X, Y, work0, work1.
.clear_screen
    JSR blank_display
    TAY                                 ; A = 0
    STA work0
    STA view_screen
    STA screen_start
    LDA #HI(SCREEN)
    STA work1
    STA view_screen_high
    LDA #HI(SCREEN) DIV 8               ; the CRTC counts in 8 bytes
    STA screen_start_high
    LDX #CHAR_BYTES - 1
.clear_screen_loop
    LDA fill_screen                     ; black...
    BEQ clear_screen_store
    INX
    TXA                                 ; ...or the floor's pattern
    AND #CHAR_BYTES - 1
    TAX
    LDA tile(CELL_FLOOR), X
.clear_screen_store
    STA (work0), Y
    INY
    BNE clear_screen_loop
    INC work1
    BPL clear_screen_loop               ; to SCREEN_END

; Program CRTC registers 1-9 from crtc_values, then the start address. R1 is
; last, so the display comes back on (blank_display turns it off with R1 = 0)
; once the rest is set.
; Clobbers: A, X.
.setup_crtc
    LDX #crtc_values_end - crtc_values
.setup_crtc_loop
    LDA crtc_values - 1, X              ; register X
    JSR set_crtc_register
    DEX
    BNE setup_crtc_loop
    JMP set_screen_start

; Find the picture for map cell (cell_x, cell_y): off the map, lava's second
; picture; an object's icon, to be drawn on the floor; or the cell's own.
; Out: picture; picture_size negative for a whole picture, 1 for an icon.
; Clobbers: A, X, Y, temp, work0, work1, map_pointer, cell_low_nibble.
.cell_picture
    LDA #&80                            ; a whole picture
    STA picture_size
    LDX cell_x
    LDY cell_y
    JSR cell_at_checked                 ; carry set: off the map
    BCC cell_picture_on_map
    LDX #LO(io_alternates + 3 * PICTURE_BYTES) ; outside the map is lava (its second picture)
    LDY #HI(io_alternates + 3 * PICTURE_BYTES)
    BCS cell_picture_found
.cell_picture_on_map
    LDX cell_x
    LDY cell_y
    JSR cell_type_picture
.cell_picture_found
    STX picture
    STY picture_high
    RTS

; Find the picture for a thing at map cell (X, Y).
; In: A = a cell type (0-15), &10 + an object's icon, or &20 + a player
; picture (which nothing asks for).
; Out: X, Y = the picture's address. For a cell type, also Z set for a whole
; picture, clear for an icon to draw on the floor (with picture and
; picture_size 1 set for it).
; Clobbers: A, temp, work0, work1.
.thing_picture
    CMP #&20
    BCS player_picture
    CMP #&10
    BCS icon_picture

; A cell type: an object cell (CELL_OBJECT) gets its object's icon.
.cell_type_picture
    CMP #CELL_OBJECT
    BCC tile_picture
    JSR object_picture_at               ; the object here's icon
    STX picture
    STY picture_high
    CPY #HI(io_no_object_picture)       ; none here: a whole picture
    BEQ cell_type_picture_done
    LDA #1                              ; draw the icon on the floor
    STA picture_size
.cell_type_picture_done
    RTS

; The picture for cell type A at map cell (X, Y). ALTERNATES cell types have a
; second picture, used on the squares alternate_cells picks: alternate_offsets
; has the difference to add for them, on even and odd squares of a
; checkerboard.
; Out: X, Y = the picture's address; A = 0.
; Clobbers: temp.
.tile_picture
    PHA
    STY temp
    TXA
    CLC
    ADC temp                            ; x + y
    LSR A                               ; carry: an odd square
    PLA
    PHA
    PHP
    LDX #2 + 2 * ALTERNATES             ; X = 2 + 2 * the type's place, or 0
    LDY #ALTERNATES
.tile_picture_find
    DEX
    DEX
    DEY
    BMI tile_picture_found
    CMP alternate_cell_types, Y         ; one with a second picture?
    BNE tile_picture_find
.tile_picture_found
    PLP
    TXA
    BEQ tile_picture_add
    BCC tile_picture_offset
    ADC #alternate_offsets_odd - alternate_offsets_even - 1 ; (the carry's set)
.tile_picture_offset
    TAX
.tile_picture_add
    PLA
    ASL A
    TAY
    LDA alternate_offsets, X
    ADC tile_addresses, Y
    STA temp
    LDA alternate_offsets + 1, X
    ADC tile_addresses + 1, Y
    TAY
    LDX temp
    LDA #0
    RTS

; Player picture A AND 3: player_facing(A AND 3).
.player_picture
    AND #3
    LSR A                               ; * PICTURE_BYTES
    ROR A
    TAX
    LDY #HI(io_player)
    BCC player_picture_done
    INY
.player_picture_done
    RTS

; Object icon A AND 15: icon(A AND 15).
.icon_picture
    LDY #HI(io_object_icons)
    AND #&0F
    LSR A                               ; * ICON_BYTES
    ROR A
    ROR A
    ROR A
    BCC icon_picture_done
    INY
.icon_picture_done
    TAX
    RTS

; A character cell of floor round an icon, which only covers the middle
; of its map cell.
.draw_row_floor_cell
    LDA tile(CELL_FLOOR), Y
    STA (screen), Y
    DEY
    BPL draw_row_floor_cell
    BMI draw_row_part_next

; Draw one character row of a map cell's picture across X character cells
; from screen: the cell's whole width, or with X = ~2 its last two columns
; (the view's left edge cuts the first cell in half). An icon is drawn with
; the floor round it.
; In: picture, picture_size (as cell_picture leaves them); view_sub_y = the
; row within the map cell; draw_step = the columns to the cell's right edge.
; Clobbers: A, X, Y, picture, screen, draw_step, picture_stride.
.draw_row_part
    LDA #PICTURE_COLUMN_BYTES
    LDY picture_size                    ; a whole picture's columns are 32 bytes apart...
    BMI draw_row_part_stride
    LSR A                               ; ...an icon's 16
.draw_row_part_stride
    STA picture_stride
    TXA
    BPL draw_row_part_first_row
    EOR #&FF                            ; cut off: draw ~X cells
    TAX
    LDA #2 * PICTURE_COLUMN_BYTES       ; past the first two columns
    INY
    BMI draw_row_part_skip
    LSR A
.draw_row_part_skip
    JSR skip_picture_columns
.draw_row_part_first_row
    LDA view_sub_y                      ; the row within the picture
    INY
    BMI draw_row_part_offset
    LSR A                               ; (an icon's rows are 1 and 2: 0 and 1)
.draw_row_part_offset
    ASL A                               ; * CHAR_BYTES
    ASL A
    ASL A
    ADC picture
    STA picture
    BCC draw_row_part_loop
    INC picture_high
.draw_row_part_loop
    LDY #CHAR_BYTES - 1                 ; beside an icon?
    LDA draw_step
    JSR in_icon_border
    BEQ draw_row_floor_cell
    LDA view_sub_y                      ; or above or below it?
    CLC
    ADC #1
    JSR in_icon_border
    BEQ draw_row_floor_cell
.draw_row_part_copy
    LDA (picture), Y                    ; a character cell of the picture
    STA (screen), Y
    DEY
    BPL draw_row_part_copy
    LDA picture                         ; on to the next column
    CLC
    ADC picture_stride
    STA picture
    BCC draw_row_part_next
    INC picture_high
.draw_row_part_next
    JSR next_screen_cell
    DEC draw_step
    DEX
    BNE draw_row_part_loop
    RTS

; Move screen one character cell right, wrapping round the screen.
; Clobbers: A.
.next_screen_cell
    LDA screen
    CLC
    ADC #CHAR_BYTES
    STA screen
    BCC next_screen_cell_done
    LDA screen_high

; Set screen's high byte to A plus the carry, wrapped round the screen.
.wrap_screen_high_carry
    ADC #0
.wrap_screen_high
    AND #HI(SCREEN_SIZE) - 1
    ORA #HI(SCREEN)
    STA screen_high
.next_screen_cell_done
    RTS

; Draw a character row across the view: row view_sub_y of map cells cell_x
; to cell_x + VIEW_CELLS, at screen. The view's left and right edges cut the
; first and last cells in half (the view is always half a cell in across
; when a row is drawn: walking up or down, or redrawing the view).
; In: cell_x, cell_y, view_sub_y, screen; strip_cells = 0.
; Clobbers: A, X, Y, cell_x, strip_cells, screen, the picture variables,
; draw_step, temp, work0, work1, map_pointer, cell_low_nibble.
.draw_row
    JSR cell_picture
    LDY #CHARS_PER_CELL                 ; columns to the cell's right edge
    LDX #CHARS_PER_CELL                 ; columns to draw
    LDA strip_cells
    BNE draw_row_not_first
    LDX #&FF EOR 2                      ; the first cell: its right half
    LDY #2
    BNE draw_row_cell
.draw_row_not_first
    CMP #VIEW_CELLS
    BNE draw_row_cell
    LDX #2                              ; the last cell: its left half
.draw_row_cell
    STY draw_step
    JSR draw_row_part
    INC strip_cells
    INC cell_x
    LDA strip_cells
    CMP #VIEW_CELLS + 1
    BNE draw_row
    RTS

; Point map_pointer at the byte holding map cell (cell_x, cell_y): the map is
; stored a column at a time, MAP_COLUMN_BYTES a column, two cells a byte.
; Out: map_pointer; cell_low_nibble = 1 for an odd cell_y, in the low nibble.
; Clobbers: A, Y.
.map_address
    LDA cell_x
    LDY #0
    STY map_pointer_high
    LDY #5                              ; * MAP_COLUMN_BYTES
.map_address_times_32
    ASL A
    ROL map_pointer_high
    DEY
    BNE map_address_times_32
    STA map_pointer                     ; cell_x * 32
    LDA cell_y                          ; + cell_y / 2
    LSR A
    CLC
    ADC map_pointer
    STA map_pointer
    BCC map_address_nibble
    INC map_pointer_high
.map_address_nibble
    LDA cell_y
    AND #1
    STA cell_low_nibble
    LDA map_pointer_high
    CLC
    ADC #HI(map)                        ; + map
    STA map_pointer_high
    RTS
ASSERT MAP_COLUMN_BYTES = 1 << 5 AND LO(map) = 0

; As draw_row_floor_cell, for a column.
.draw_column_floor_cell
    LDA tile(CELL_FLOOR), Y
    STA (screen), Y
    DEY
    BPL draw_column_floor_cell
    BMI draw_column_part_next

; Draw one character column of a map cell's picture down X character cells
; from screen: as draw_row_part, with X = ~2 for the cell's last two rows (cut
; by the view's top edge).
; In: picture, picture_size; view_sub_x = the column within the map cell;
; draw_step = the rows to the cell's bottom edge.
; Clobbers: A, X, Y, picture, screen, draw_step.
.draw_column_part
    LDY picture_size
    TXA
    BPL draw_column_part_first_column
    EOR #&FF
    TAX
    LDA #2 * CHAR_BYTES                 ; past the first two rows
    JSR skip_picture_columns
.draw_column_part_first_column
    LDA view_sub_x                      ; the column within the picture
    INY
    BMI draw_column_part_offset
    LSR A                               ; (an icon's columns are 1 and 2: 0 and 1)
.draw_column_part_offset
    LSR A                               ; * PICTURE_COLUMN_BYTES
    ROR A
    ROR A
    ROR A
    INY
    BMI draw_column_part_add
    ROR A                               ; an icon's: * ICON_COLUMN_BYTES
.draw_column_part_add
    CLC
    ADC picture
    STA picture
    BCC draw_column_part_loop
    INC picture_high
.draw_column_part_loop
    LDY #CHAR_BYTES - 1                 ; above or below an icon?
    LDA draw_step
    JSR in_icon_border
    BEQ draw_column_floor_cell
    LDA view_sub_x                      ; or beside it?
    CLC
    ADC #1
    JSR in_icon_border
    BEQ draw_column_floor_cell
.draw_column_part_copy
    LDA (picture), Y                    ; a character cell of the picture
    STA (screen), Y
    DEY
    BPL draw_column_part_copy
    LDA picture                         ; on to the next row
    CLC
    ADC #CHAR_BYTES
    STA picture
    BCC draw_column_part_next
    INC picture_high
.draw_column_part_next
    INC screen_high                     ; down a character row
    BPL draw_column_part_count
    LDA #HI(SCREEN)
    STA screen_high
.draw_column_part_count
    DEC draw_step
    DEX
    BNE draw_column_part_loop
    RTS

; Draw a character column down the view: column view_sub_x of map cells
; cell_y to cell_y + VIEW_CELLS, at screen, the first and last cut in half.
; In: cell_x, cell_y, view_sub_x, screen; strip_cells_down = 0.
; Clobbers: as draw_row, with cell_y and strip_cells_down.
.draw_column
    JSR cell_picture
    LDY #CHARS_PER_CELL                 ; rows to the cell's bottom edge
    LDX #CHARS_PER_CELL                 ; rows to draw
    LDA strip_cells_down
    BNE draw_column_not_first
    LDX #&FF EOR 2                      ; the first cell: its bottom half
    LDY #2
    BNE draw_column_cell
.draw_column_not_first
    CMP #VIEW_CELLS
    BNE draw_column_cell
    LDX #2                              ; the last cell: its top half
.draw_column_cell
    STY draw_step
    JSR draw_column_part
    INC strip_cells_down
    INC cell_y
    LDA strip_cells_down
    CMP #VIEW_CELLS + 1
    BNE draw_column
    RTS

; Scroll the view a character cell right, left, up or down: move the CRTC's
; start address and the view's top left on the screen, wrapping round.
; Clobbers: A, X.
.scroll_right
    INC view_x                          ; the view moves right
    INC screen_start                    ; the CRTC starts a character on
    BNE scroll_right_screen
    INC screen_start_high
.scroll_right_screen
    LDA view_screen                     ; and so does the view's top left
    CLC
    ADC #CHAR_BYTES
    STA view_screen
    BCC scroll_done
    INC view_screen_high
    BPL scroll_done
    LDA #HI(SCREEN)                     ; off the end: wrap round
    STA view_screen_high
    LDA #HI(SCREEN) DIV 8
    STA screen_start_high
    BNE scroll_done
.scroll_left
    DEC view_x
    DEC screen_start
    LDA screen_start
    CMP #&FF
    BNE scroll_left_screen
    DEC screen_start_high
.scroll_left_screen
    LDA view_screen
    SEC
    SBC #CHAR_BYTES
    STA view_screen
    BCS scroll_done
    DEC view_screen_high
    LDA view_screen_high
    CMP #HI(SCREEN) - 1                 ; off the start: wrap round
    BNE scroll_done
    LDA #HI(SCREEN_END - 1)
    STA view_screen_high
    LDA #HI(SCREEN_END - 1) DIV 8
    STA screen_start_high
.scroll_done
    JMP set_screen_start
.scroll_up
    DEC view_y                          ; the view moves up
    DEC view_screen_high
    SEC
    LDA screen_start                    ; a character row is 32 of the CRTC's 8 bytes
    SBC #ROW_BYTES / 8
    STA screen_start
    BCS scroll_up_done
    DEC screen_start_high
    LDA screen_start_high
    CMP #HI(SCREEN) DIV 8 - 1           ; off the start: wrap round
    BNE scroll_up_done
    LDA #HI(SCREEN_END - 1)
    STA view_screen_high
    LDA #HI(SCREEN_END - 1) DIV 8
    STA screen_start_high
.scroll_up_done
    JMP set_screen_start
.scroll_down
    INC view_y
    INC view_screen_high
    CLC
    LDA screen_start
    ADC #ROW_BYTES / 8
    STA screen_start
    BCC scroll_up_done
    INC screen_start_high
    LDA screen_start_high
    CMP #HI(SCREEN_END) DIV 8           ; off the end: wrap round
    BNE scroll_up_done
    LDA #HI(SCREEN)
    STA view_screen_high
    LDA #HI(SCREEN) DIV 8
    STA screen_start_high
    BNE scroll_up_done

; Walk the player a cell down: scroll the view a character row at a time,
; four times, drawing each new bottom row of map cells. The player, drawn on
; the screen, would scroll with it, so each step rubs out their trail and
; draws them back in the middle; and things that move by themselves move a
; character a step.
; Clobbers: A, X, Y and the drawing variables.
.walk_down
    JSR next_player_frame               ; the player's walking picture
    LDA #2                              ; the new row is half way through a cell
    STA view_sub_y
    LDX #CHARS_PER_CELL - 1
    STX steps
.walk_down_step
    JSR scroll_down
    JSR rub_out_above_player            ; rub out the trail behind the player
    LDA view_screen_high                ; the view's bottom row: the screen being 32
    SEC                                 ; rows round, the one above its top
    SBC #1
    JSR wrap_screen_high
    LDA view_screen
    STA screen
    LDA #0
    STA strip_cells
    LDA view_cell_x
    STA cell_x                          ; the cells VIEW_CELLS below the top
    LDA view_cell_y
    CLC
    ADC #VIEW_CELLS
    STA cell_y
    JSR draw_row
    JSR move_things                     ; monsters and thrown objects
    INC view_sub_y                      ; the next row down...
    LDA view_sub_y
    AND #CHARS_PER_CELL - 1
    STA view_sub_y
    BNE walk_down_next
    INC view_cell_y                     ; ...in the next cell
.walk_down_next
    DEC steps
    BPL walk_down_step
    RTS

; Walk a cell up, drawing each new top row.
.walk_up
    JSR next_player_frame
    LDA #1
    STA view_sub_y
    LDX #CHARS_PER_CELL - 1
    STX steps
.walk_up_step
    LDA #0
    STA strip_cells
    LDA view_cell_x
    STA cell_x
    LDA view_cell_y
    STA cell_y
    LDA view_screen
    STA screen
    JSR scroll_up
    JSR rub_out_below_player
    LDA view_screen_high
    STA screen_high
    JSR draw_row
    JSR move_things
    LDA screen_high                     ; (to no purpose: screen_high is set
    CLC                                 ; afresh before it's next used)
    ADC #SCREEN_ROWS - 1
    BPL walk_up_wrapped
    SBC #SCREEN_ROWS - 1
.walk_up_wrapped
    STA screen_high
    DEC view_sub_y
    LDA view_sub_y
    AND #CHARS_PER_CELL - 1
    STA view_sub_y
    CMP #CHARS_PER_CELL - 1
    BNE walk_up_next
    DEC view_cell_y
.walk_up_next
    DEC steps
    BPL walk_up_step
    RTS

; Walk a cell right, drawing each new right-hand column.
.walk_right
    JSR next_player_frame
    LDA #2
    STA view_sub_x
    LDX #CHARS_PER_CELL - 1
    STX steps
.walk_right_step
    LDA view_cell_x
    CLC
    ADC #VIEW_CELLS
    STA cell_x
    LDA view_cell_y
    STA cell_y
    LDA #0
    STA strip_cells_down
    JSR scroll_right
    JSR rub_out_left_of_player
    LDA view_screen                     ; the view's last column
    CLC
    ADC #(SCREEN_COLUMNS - 1) * CHAR_BYTES
    STA screen
    LDA view_screen_high
    JSR wrap_screen_high_carry
    JSR draw_column
    JSR move_things
    INC view_sub_x
    LDA view_sub_x
    AND #CHARS_PER_CELL - 1
    STA view_sub_x
    BNE walk_right_next
    INC view_cell_x
.walk_right_next
    DEC steps
    BPL walk_right_step
    RTS

; Walk a cell left, drawing each new left-hand column.
.walk_left
    JSR next_player_frame
    LDA #1
    STA view_sub_x
    LDX #CHARS_PER_CELL - 1
    STX steps
.walk_left_step
    LDA #0
    STA strip_cells_down
    LDA view_cell_x
    STA cell_x
    LDA view_cell_y
    STA cell_y
    JSR scroll_left
    JSR rub_out_right_of_player
    LDA view_screen
    STA screen
    LDA view_screen_high
    STA screen_high
    JSR draw_column
    JSR move_things
    DEC view_sub_x
    LDA view_sub_x
    AND #CHARS_PER_CELL - 1
    STA view_sub_x
    CMP #CHARS_PER_CELL - 1
    BNE walk_left_next
    DEC view_cell_x
.walk_left_next
    DEC steps
    BPL walk_left_step
    RTS

; The cell types with a second picture; alternate_pictures has their second
; pictures, in the same order. They're what the Level Designer calls the fatal
; trap, the collectable, wall two and wall one, and alternate_cells has their
; bits in the reverse order, wall one at the top.
.alternate_cell_types
    EQUB CELL_LAVA, CELL_SULPHUR, CELL_WALL, 5
ASSERT P% - alternate_cell_types = ALTERNATES

; Copied but never used.
.low_code_unused
    SKIP 6
.low_code_end
ENDSECTION

; The game.
.main_code_load
SECTION main_code, org=&0900
.main_code

; Called by the event handler when a sound channel's queue runs dry: play the
; next note of whichever tune voice belongs to that channel. tune_swap and
; tune_together pick which voices play: voice 1 on channel 1 unless voice 2 is
; playing alone, voice 2 on channel 2 unless voice 1 is.
; Clobbers: A, X, Y, the tune block.
.play_tune
    LDA tune_swap                       ; voice 1 on channel 1...
    EOR #&01
    ORA tune_together
    JSR play_voice                      ; ...unless voice 2 plays alone
    LDA tune_swap                       ; voice 2 on channel 2...
    ORA tune_together
    ASL A                               ; ...unless voice 1 plays alone

; Play the next note of the voice on channel A, if that's the channel that
; ran dry. Channel 1 plays voice 1, an octave above voice 2 on channel 2; each
; voice's last note is pitched nearly another octave up. The voice's channel
; is also its envelope.
; In: A = the channel (1 or 2), or 0 if the voice isn't playing.
; Clobbers: A, X, Y, the tune block.
.play_voice
    BEQ play_voice_done
    CMP empty_channel                   ; the channel that ran dry?
    BNE play_voice_done
    TAX
    LDA tune_position - 1, X            ; the voice's next note
    INC tune_position - 1, X
    STA tune_channel                    ; (tune_channel as scratch)
    DEX
    TXA
    ASL A                               ; * TUNE_VOICE_BYTES: voice 2's notes
    ASL A
    ASL A
    ASL A
    ASL A
    ADC tune_channel
    INX
    STX tune_channel                    ; the channel...
    STX tune_amplitude                  ; ...and the same envelope
    TAX
    LDY #0
    STY tune_channel_high
    STY tune_amplitude_high
    STY tune_pitch_high
    STY tune_duration_high
    LDA tune, X                         ; a note: semitones, duration
    PHA
    AND #&F0
    LSR A                               ; * SEMITONE
    LSR A
    ADC tune_transpose
    ADC #TUNE_LOWEST
    LDY tune_channel
    DEY
    BNE play_voice_last_note
    ADC #OCTAVE                         ; voice 1 an octave up
.play_voice_last_note
    LDX tune_position, Y                ; the voice's last note...
    CPX #TUNE_NOTES
    BNE play_voice_note
    ADC #OCTAVE - 1                     ; ...a little under an octave up
.play_voice_note
    STA tune_pitch
    PLA
    AND #&0F                            ; in 20ths of a second
    STA tune_duration

; SOUND with the block at tune_channel.
; Clobbers: A, X, Y.
.sound_tune_block
    LDX #LO(tune_channel)
    LDY #HI(tune_channel)
    LDA #OSWORD_SOUND
    JMP OSWORD

; Add A to picture, halved for an icon: to skip columns or rows of a picture.
; In: Y = picture_size + 1, from the caller's INY. This increments it again,
; and it stays negative for a whole picture.
; Clobbers: A.
.skip_picture_columns
    INY                                 ; an icon's columns are half as big
    BMI advance_picture
    LSR A
.advance_picture
    CLC
    ADC picture
    STA picture
    BCC play_voice_done
    INC picture_high
.play_voice_done
    RTS

; Count a cell walked: every four, the player's picture turns upside down or
; back (see draw_player).
; Clobbers: A.
.next_player_frame
    LDA player_frame
    CLC
    ADC #&20
    STA player_frame
    RTS

; The second pictures of alternate_cell_types, as picture numbers counted from
; io_tiles (io_alternates has them in the order 5, 7, 8, A).
.alternate_pictures
    EQUB FIRST_ALTERNATE + 3, FIRST_ALTERNATE + 1, FIRST_ALTERNATE + 2, FIRST_ALTERNATE

; CRTC registers 1-9: 32 characters across and 32 rows of 8 lines, the screen
; centred.
.crtc_values
    EQUB SCREEN_COLUMNS, 45, 36, 38, 0, SCREEN_ROWS, 34, 1, 7
.crtc_values_end

; The address of each cell type's picture.
.tile_addresses
FOR type = 0..15
    EQUW tile(type)
NEXT

; What to add to a cell type's picture address on squares that show its
; second picture, set up by setup_alternate_pictures: a zero word for cell
; types that have none, then a word for each alternate_cell_types on even
; squares, then on odd.
.alternate_offsets
    EQUW 0
.alternate_offsets_even
    EQUW 0, 0, 0, 0
.alternate_offsets_odd
    EQUW 0, 0, 0, 0
.alternate_offsets_end

; Rub out monster A, with the floor picture.
; Clobbers: A, X, Y and the sprite variables.
.erase_monster
    JSR monster_position
    LDA #HI(tile(CELL_FLOOR))
    STA sprite_high
    LDA #LO(tile(CELL_FLOOR))
    STA sprite
    SEC
    JMP draw_sprite

; Draw monster A: the monsters' two frames are cell types E's and F's
; pictures, so the caller puts 0 or PICTURE_BYTES in sprite for the low byte.
; Clobbers: A, X, Y and the sprite variables.
.draw_monster
    JSR monster_position
    LDA #HI(tile(CELL_FIRE))
    STA sprite_high
    SEC
    JMP draw_sprite

; Draw the player in the middle of the view, facing their way. Every four
; cells walked (player_frame's bit 7) the picture is drawn upside down, and
; facing up or down the other of the two up and down pictures is used.
; Clobbers: A, X, Y, picture, player_screen, player_screen_base, draw_step,
; count_across, count_down, steps_since_drawn.
.draw_player
    LDA player_frame
    AND #&80                            ; flipped?
    STA picture
    STA draw_step
    LDA facing                          ; * PICTURE_BYTES: left or right...
    LSR A
    ROR A
    BCC draw_player_picture
    EOR picture                         ; ...or up and down, swapped when flipped
.draw_player_picture
    STA picture
    LDA #HI(io_player)
    ADC #0
    STA picture_high
    LDA #LO(PLAYER_CHAR * ROW_BYTES + PLAYER_CHAR * CHAR_BYTES)
    ADC view_screen
    STA player_screen
    STA player_screen_base
    LDA #HI(PLAYER_CHAR * ROW_BYTES + PLAYER_CHAR * CHAR_BYTES)
    ADC view_screen_high
    BPL draw_player_screen
    SBC #HI(SCREEN_SIZE) - 1            ; (the carry's clear)
.draw_player_screen
    STA player_screen_high
    STA player_screen_base_high
    BNE draw_player_at

; As the view scrolls a character, the player, drawn in screen memory, scrolls
; with it: rub out the edge of their picture that's left behind, on the side
; away from the way the view moves, then draw them again in the middle. Inside
; a pipe the player isn't drawn, so only the first few steps (the width of
; the picture left from before) are rubbed out.
; Clobbers: as draw_player, with draw_step_high.
.rub_out_below_player
    LDA player_screen_base
    STA player_screen
    LDA player_screen_base_high         ; the player's bottom row...
    CLC
    ADC #CHARS_PER_CELL - 1
    BPL rub_out_row
    SBC #HI(SCREEN_SIZE) - 1            ; (the carry's clear)
.rub_out_row
    STA player_screen_high
    LDY #0                              ; ...across
    STY draw_step_high
    LDA #CHAR_BYTES
    STA draw_step
    BNE rub_out_trail
.rub_out_right_of_player
    LDA player_screen_base              ; the player's right column...
    CLC
    ADC #(CHARS_PER_CELL - 1) * CHAR_BYTES
    STA player_screen
    LDA player_screen_base_high
    ADC #0
    BPL rub_out_right_wrapped
    SBC #HI(SCREEN_SIZE) - 1            ; (the carry's clear)
.rub_out_right_wrapped
    BNE rub_out_column
.rub_out_left_of_player
    LDA player_screen_base
    STA player_screen
    LDA player_screen_base_high
.rub_out_column
    STA player_screen_high
    LDY #LO(ROW_BYTES)                  ; ...down
    STY draw_step
    INY
    STY draw_step_high
.rub_out_trail
    LDX steps_since_drawn               ; inside a pipe...
    LDA pipe_move
    BEQ rub_out_trail_draw
    INX
    CPX #CHARS_PER_CELL + 1             ; ...rub out only the first few
    BCC rub_out_trail_draw
    RTS
.rub_out_trail_draw
    STX steps_since_drawn
    LDX #CHARS_PER_CELL
.rub_out_trail_cell
    LDY #CHAR_BYTES - 1
.rub_out_trail_copy
    LDA tile(CELL_FLOOR), Y             ; floor
    STA (player_screen), Y
    DEY
    BPL rub_out_trail_copy
    LDA draw_step                       ; the next cell along
    CLC
    ADC player_screen
    STA player_screen
    LDA draw_step_high
    ADC player_screen_high
    BPL rub_out_trail_next
    SBC #HI(SCREEN_SIZE) - 1            ; (the carry's clear)
.rub_out_trail_next
    STA player_screen_high
    DEX
    BNE rub_out_trail_cell
    JMP draw_player
.rub_out_above_player
    LDA player_screen_base
    STA player_screen
    LDA player_screen_base_high
    BNE rub_out_row

; Draw the player's picture at player_screen: 4 x 4 character cells, a column
; at a time. With draw_step nonzero it's drawn upside down, each column's
; bytes copied backwards by a self-modified LDA abs,X. Inside a pipe it isn't
; drawn at all.
; In: picture, player_screen, draw_step.
; Clobbers: A, X, Y, picture, player_screen, count_across, count_down,
; steps_since_drawn.
.draw_player_at
    LDX #PICTURE_COLUMN_BYTES - 1       ; the last byte of a column, for flipping
    LDA picture
    STA draw_player_flipped_copy + 1    ; self-modified: flipped pictures copy from here
    LDA picture_high
    STA draw_player_flipped_copy + 2
    LDA pipe_move                       ; inside a pipe: not drawn
    BEQ draw_player_cells
    RTS
.draw_player_cells
    STA steps_since_drawn               ; (A = 0) drawn now
    LDA #CHARS_PER_CELL - 1
    STA count_across                    ; (counting rows down a column)
    STA count_down                      ; (counting columns)
.draw_player_cell
    LDA draw_step                       ; flipped?
    BNE draw_player_flipped
    LDY #CHAR_BYTES - 1
.draw_player_copy
    LDA (picture), Y
    STA (player_screen), Y
    DEY
    BPL draw_player_copy
    LDA picture
    CLC
    ADC #CHAR_BYTES
    STA picture
    BCC draw_player_down
    INC picture_high
.draw_player_down
    INC player_screen_high              ; down a character row
    BPL draw_player_next
    LDA #HI(SCREEN)
    STA player_screen_high
.draw_player_next
    DEC count_across
    BPL draw_player_cell
    TXA                                 ; flipped: the next column's last byte
    CLC
    ADC #2 * PICTURE_COLUMN_BYTES
    TAX
    LDA player_screen                   ; the next column across...
    CLC
    ADC #CHAR_BYTES
    STA player_screen
    BCC draw_player_wrap
    INC player_screen_high
.draw_player_wrap
    LDA player_screen_high              ; ...back up to the top
    SEC
    SBC #CHARS_PER_CELL
    CMP #HI(SCREEN)
    BCS draw_player_column
    ADC #HI(SCREEN_SIZE)
.draw_player_column
    STA player_screen_high
    LDA #CHARS_PER_CELL - 1
    STA count_across
    DEC count_down
    BPL draw_player_cell
.draw_player_at_done
    RTS
.draw_player_flipped
    LDY #0
.draw_player_flipped_copy
    LDA &FFFF, X                        ; self-modified: the picture
    DEX
    STA (player_screen), Y
    INY
    CPY #CHAR_BYTES
    BNE draw_player_flipped_copy
    BEQ draw_player_down

; Redraw the whole view from the map: hatch the screen, then draw the map in
; from the edges, a column from each side and a row from each side in turn, a
; frame a step. The middle 4 x 4 characters are left for the player. For the
; start of a level, after a teleport, and back from the backpack or the map.
; In: the screen cleared, with the view at its top left; view_cell_x and _y.
; Clobbers: A, X, Y and the drawing variables.
.redraw_view
    LDA #0                              ; steps in from the edges
    STA steps
    STA count_across
    STA screen
    TAY
    STA steps_since_drawn
    LDA #HI(SCREEN)
    STA screen_high
    LDA #&FF                            ; &7F, &BF, &DF...: one bit clear, moving
    CLC                                 ; along, makes a diagonal hatch
.redraw_view_hatch
    ROR A
    STA (screen), Y
    DEY
    BNE redraw_view_hatch
    INC screen_high
    BPL redraw_view_hatch
.redraw_view_step
    LDA steps                           ; from the left, then the right
    LSR A
    EOR count_across                    ; the column, 0-31
    TAY
    ASL A
    ASL A
    ASL A
    STA screen
    LDA #HI(SCREEN)
    STA screen_high
    LDA #0
    STA strip_cells_down
    TYA
    ADC #CHARS_PER_CELL / 2             ; the view's left edge is half a cell in
    PHA
    AND #CHARS_PER_CELL - 1
    STA view_sub_x
    PLA
    LSR A
    LSR A
    CLC
    ADC view_cell_x
    STA cell_x
    LDA view_cell_y
    STA cell_y
    JSR draw_column                     ; a column
    LDA #0
    STA screen
    STA strip_cells
    LDA steps                           ; and a row, from the top, then the bottom
    LSR A
    EOR count_across
    PHA
    CLC
    ADC #HI(SCREEN)
    STA screen_high
    PLA
    ADC #CHARS_PER_CELL / 2
    PHA
    AND #CHARS_PER_CELL - 1
    STA view_sub_y
    PLA
    LSR A
    LSR A
    CLC
    ADC view_cell_y
    STA cell_y
    LDA view_cell_x
    STA cell_x
    JSR draw_row                        ; a row
    JSR wait_vsync                      ; one step a frame
    LDA count_across                    ; the other side
    EOR #SCREEN_COLUMNS - 1
    STA count_across
    INC steps
    LDA steps
    CMP #SCREEN_COLUMNS - CHARS_PER_CELL ; all but the player's middle four
    BCC redraw_view_step
    JMP draw_player

; Monster A's position.
; Out: X, Y = its x and y in character cells.
; Clobbers: A.
.monster_position
    ASL A
    ASL A
    TAY
    LDX monster_x, Y
    LDA monster_y, Y
    TAY
.move_things_done
    RTS

; Move everything that moves by itself one character cell: a thrown object,
; then each monster that's out, the way it's going (one that's stuck is drawn
; where it is).
; Clobbers: A, X, Y, monster_index and the drawing variables.
.move_things
    LDA player_dead                     ; nothing moves while the player dies
    BNE move_things_done
    LDA thrown_direction                ; something thrown?
    BEQ move_monsters
    CMP #THROWN_LEFT
    BEQ thrown_left
    CMP #THROWN_RIGHT
    BEQ thrown_right
    CMP #THROWN_UP
    BEQ thrown_up
    INC thrown_y                        ; THROWN_DOWN
    JMP draw_thrown
.thrown_left
    DEC thrown_x
    JMP draw_thrown
.thrown_right
    INC thrown_x
    JMP draw_thrown
.thrown_up
    DEC thrown_y
.draw_thrown
    LDA thrown_picture
    STA sprite
    LDA thrown_picture_high
    STA sprite_high
    LDX thrown_x
    LDY thrown_y
    JSR draw_icon_on_floor              ; drawn on the floor
.move_monsters
    LDA #MONSTERS - 1
    STA monster_index
.move_monster
    LDA monster_index
    ASL A                               ; * MONSTER_BYTES
    ASL A
    TAX
    LDA monster_direction, X            ; its direction
    PHA
    CMP #MONSTER_STUCK                  ; stuck or gone: it doesn't move
    BCS move_monster_direction
    TXA
    PHA
    LDA monster_index
    JSR erase_monster                   ; rub it out
    PLA
    TAX
.move_monster_direction
    PLA
    BEQ monster_left                    ; DIRECTION_LEFT
    CMP #DIRECTION_RIGHT
    BEQ monster_right
    CMP #DIRECTION_UP
    BEQ monster_up
    CMP #MONSTER_GONE                   ; not out
    BCS next_monster
    CMP #DIRECTION_DOWN
    BNE monster_stuck
    INC monster_y, X
    JMP monster_moved
.monster_left
    DEC monster_x, X
    JMP monster_moved
.monster_right
    INC monster_x, X
    JMP monster_moved
.monster_up
    DEC monster_y, X
.monster_moved
    LDA frame_counter                   ; the monsters' frame
    AND #PICTURE_BYTES
    STA sprite
    LDA monster_index
    JSR draw_monster                    ; draw it
.next_monster
    DEC monster_index
    BPL move_monster
    RTS
.monster_stuck
    LDA frame_counter                   ; stuck: draw it where it is
    AND #PICTURE_BYTES
    STA sprite
    LDA monster_index
    JSR draw_monster
    JMP next_monster

; Copy the part of the whole picture at sprite that clip_sprite_x and _y
; found to be in the view to sprite_screen, a column of character cells at a
; time. The skips are added without a carry into the high byte: no picture
; the game draws starts far enough into a page to need one.
; Clobbers: A, Y, sprite, sprite_screen, sprite_column, sprite_row.
.draw_sprite_clipped
    LDA sprite_columns
    STA sprite_column
    LDA sprite_skip_x                   ; past the columns cut off...
    LSR A                               ; * PICTURE_COLUMN_BYTES
    ROR A
    ROR A
    ROR A
    ADC sprite
    STA sprite
    LDA sprite_skip_y                   ; ...and the rows
    ASL A                               ; * CHAR_BYTES
    ASL A
    ASL A
    ADC sprite
    STA sprite
.draw_sprite_column
    LDA sprite_rows
    STA sprite_row
.draw_sprite_cell
    LDY #CHAR_BYTES - 1
.draw_sprite_copy
    LDA (sprite), Y
    STA (sprite_screen), Y
    DEY
    BPL draw_sprite_copy
    INC sprite_screen_high              ; down a character row
    BPL draw_sprite_next_row
    LDA #HI(SCREEN)
    STA sprite_screen_high
.draw_sprite_next_row
    LDA sprite
    CLC
    ADC #CHAR_BYTES
    STA sprite
    BCC draw_sprite_count_rows
    INC sprite_high
.draw_sprite_count_rows
    DEC sprite_row
    BPL draw_sprite_cell
    LDA sprite_rows                     ; past the rows cut off at the bottom
    EOR #CHARS_PER_CELL - 1
    ASL A                               ; * CHAR_BYTES
    ASL A
    ASL A
    ADC sprite
    STA sprite
    BCC draw_sprite_next_column
    INC sprite_high
.draw_sprite_next_column
    LDA sprite_screen
    CLC
    ADC #CHAR_BYTES
    STA sprite_screen
    BCC draw_sprite_back_to_top
    INC sprite_screen_high
.draw_sprite_back_to_top
    LDA sprite_screen_high              ; back to the top
    CLC
    SBC sprite_rows
    AND #HI(SCREEN_SIZE) - 1
    ORA #HI(SCREEN)
    STA sprite_screen_high
    DEC sprite_column
    BPL draw_sprite_column
    RTS

; Never called: in_icon_border for a sprite's column and row.
.sprite_in_icon_border
    LDA sprite_column
    JSR in_icon_border
    BEQ in_icon_border_done
    LDA sprite_row

; Is position A of a map cell's 4 columns or rows outside an icon (which
; covers only the middle two), when picture_size says it's an icon?
; In: A = 1-4, counting from either edge; picture_size.
; Out: Z set if it's outside an icon.
; Clobbers: A.
.in_icon_border
    CMP picture_size
    BEQ in_icon_border_done
    SEC
    SBC #CHARS_PER_CELL - 1
    CMP picture_size
.in_icon_border_done
    RTS

; Draw the icon at sprite in the middle of a floor picture at character
; position (X, Y): copy it into the middle of the floor's own picture, draw
; that, then (by an RTS to a pushed address) put the floor's middle back.
; Clobbers: as draw_sprite.
.draw_icon_on_floor
    TXA
    PHA
    TYA
    PHA
    LDX #ICON_COLUMN_BYTES - 1
    LDY #ICON_BYTES - 1
.draw_icon_right_half
    LDA (sprite), Y                     ; the icon's right column...
    STA tile(CELL_FLOOR) + 2 * PICTURE_COLUMN_BYTES + CHAR_BYTES, X
    DEY
    DEX
    BPL draw_icon_right_half
    LDX #ICON_COLUMN_BYTES - 1
.draw_icon_left_half
    LDA (sprite), Y                     ; ...and left, into the floor's middle
    STA tile(CELL_FLOOR) + 1 * PICTURE_COLUMN_BYTES + CHAR_BYTES, X
    DEY
    DEX
    BPL draw_icon_left_half
    LDA #LO(tile(CELL_FLOOR))           ; draw the floor picture
    STA sprite
    LDA #HI(tile(CELL_FLOOR))
    STA sprite_high
    PLA
    TAY
    PLA
    TAX
    SEC                                 ; draw_sprite: a whole picture
    LDA #HI(restore_floor_picture - 1)  ; then return to restore_floor_picture
    PHA
    LDA #LO(restore_floor_picture - 1)
    PHA

; Draw a picture at character position (X, Y) on the map, as much of it as
; is in the view.
; In: sprite = a whole picture with the carry set; or with it clear, an icon,
; drawn in the middle of a floor picture (draw_icon_on_floor).
; Clobbers: A, X, Y and the sprite variables.
.draw_sprite
    BCC draw_icon_on_floor
    LDA #CHARS_PER_CELL - 1             ; 4 x 4 cells, none cut off
    STA sprite_columns
    STA sprite_rows
    LDA #0
    STA sprite_screen_high
    STA sprite_skip_x
    STA sprite_skip_y
    JSR clip_sprite_x
    JSR clip_sprite_y
    JMP draw_sprite_clipped

; Put back the middle two columns of the floor picture, which are all the
; same as its last character cell (the floor is one cell's pattern).
; Clobbers: A, X, Y.
.restore_floor_picture
    LDY #2 * PICTURE_COLUMN_BYTES - 1
    LDX #CHAR_BYTES - 1
.restore_floor_loop
    LDA tile(CELL_FLOOR) + PICTURE_BYTES - CHAR_BYTES, X ; the floor's last character cell
    STA tile(CELL_FLOOR) + PICTURE_COLUMN_BYTES, Y
    DEX
    TXA
    AND #CHAR_BYTES - 1
    TAX
    DEY
    BPL restore_floor_loop
    RTS

; Clip a picture to the view across: which of its 4 columns, from character
; x = X, are in the view's 32 from view_x? Character positions wrap round at
; 256, the map's width, so a view_x from &E2 up is a view running off the
; map's right edge, or from &F1, one hanging off its left edge.
; Out: sprite_skip_x, sprite_columns, sprite_screen; or if none of the
; picture is in view, returns from the caller (draw_sprite) instead.
; Clobbers: A, clip_position.
.clip_sprite_x
    STX clip_position
    LDA view_x
    CMP #&E2                            ; the view runs off an edge of the map?
    BCS clip_sprite_x_wrapped
    CMP clip_position                   ; starts left of the view?
    BCS clip_sprite_left
    ADC #SCREEN_COLUMNS - CHARS_PER_CELL ; the view's last column but 3
    CMP clip_position                   ; ends right of the view?
    BCC clip_sprite_right
.clip_sprite_x_screen
    TXA                                 ; wholly in view
    SEC
    SBC view_x
    ASL A                               ; * CHAR_BYTES
    ASL A
    ASL A
    ADC view_screen
    STA sprite_screen
    BCC clip_sprite_x_done
    INC sprite_screen_high
.clip_sprite_x_done
    RTS

; Out of view: drop the return address and return from draw_sprite.
.clip_sprite_out_of_view
    PLA
    PLA
    RTS

; The same for rows, from character y = Y and view_y.
; Out: sprite_skip_y, sprite_rows and sprite_screen_high (added to it); or
; returns from draw_sprite.
.clip_sprite_y
    STY clip_position
    LDA view_y
    CMP #&E2
    BCC clip_sprite_y_on_map
    JMP clip_sprite_y_wrapped
.clip_sprite_left
    SBC clip_position
.clip_sprite_left_cells
    CMP #CHARS_PER_CELL                 ; wholly out of view
    BCS clip_sprite_out_of_view
    STA sprite_skip_x                   ; the columns cut off
    EOR #CHARS_PER_CELL - 1
    STA sprite_columns
    LDA view_screen
    STA sprite_screen
    RTS
.clip_sprite_right
    ADC #CHARS_PER_CELL - 1             ; the view's last column
    CMP clip_position
    BCC clip_sprite_out_of_view
    SBC clip_position
    STA sprite_columns
    BCS clip_sprite_x_screen
.clip_sprite_x_wrapped
    CMP #&F1                            ; hanging off the left edge?
    BCS clip_sprite_x_far_left
    CMP clip_position
    BCS clip_sprite_left
    BCC clip_sprite_x_screen
.clip_sprite_x_far_left
    ADC #SCREEN_COLUMNS - CHARS_PER_CELL - 1 ; (the carry's set)
    CMP clip_position
    BCC clip_sprite_right
    BCS clip_sprite_x_screen
.clip_sprite_y_on_map
    LDA view_y
    CMP clip_position
    BCS clip_sprite_top
    ADC #SCREEN_ROWS - CHARS_PER_CELL
    CMP clip_position
    BCC clip_sprite_bottom
.clip_sprite_y_screen
    TYA
    SEC
    SBC view_y
    CLC
    ADC view_screen_high
    ADC sprite_screen_high
.clip_sprite_y_wrap
    AND #HI(SCREEN_SIZE) - 1
    ORA #HI(SCREEN)
    STA sprite_screen_high
    RTS
.clip_sprite_top
    SBC clip_position
    CMP #CHARS_PER_CELL
    BCS clip_sprite_out_of_view
    STA sprite_skip_y
    EOR #CHARS_PER_CELL - 1
    STA sprite_rows
    LDA view_screen_high
    ADC sprite_screen_high
    STA sprite_screen_high
    BNE clip_sprite_y_wrap
.clip_sprite_bottom
    ADC #CHARS_PER_CELL - 1
    CMP clip_position
    BCS clip_sprite_bottom_cells
    JMP clip_sprite_out_of_view
.clip_sprite_bottom_cells
    SBC clip_position
    STA sprite_rows
    BCS clip_sprite_y_screen
.clip_sprite_y_wrapped
    CMP #&F1
    BCS clip_sprite_y_far_up
    CMP clip_position
    BCS clip_sprite_top
    BCC clip_sprite_y_screen
.clip_sprite_y_far_up
    ADC #SCREEN_ROWS - CHARS_PER_CELL - 1 ; (the carry's set)
    CMP clip_position
    BCC clip_sprite_bottom
    BCS clip_sprite_y_screen

; Turn the display off: CRTC register 1, characters displayed per row, to 0.
; Out: A = 0, X = CRTC_HORIZONTAL_DISPLAYED.
.blank_display
    LDX #CRTC_HORIZONTAL_DISPLAYED
    LDA #0

; CRTC register X = A.
; Preserves A, X, Y.
.set_crtc_register
    STX CRTC_ADDR                       ; register
    STA CRTC_DATA                       ; value
    RTS

; The map view (the M key) shows the map a byte (4 pixels) by 4 lines a cell:
; a character cell holds two cells, one above the other, so the 64 rows fit
; and 32 of the 64 columns show at a time. Map column x is drawn at SCREEN +
; 8x, and the screen starts at map column screen_start: so columns x and x +
; 32 share memory, a character row apart, and only the columns in view are
; drawn. Scrolling moves the screen's start a character and draws the column
; that comes into view over the one that went out.
; Draw all the columns in view.
; Clobbers: A, X, Y, work0-work3, sprite, sprite_high.
.draw_map_view
    LDX #SCREEN_COLUMNS - 1
.draw_map_view_loop
    TXA
    PHA
    JSR draw_map_view_column
    PLA
    TAX
    DEX
    BPL draw_map_view_loop
.map_view_return
    RTS

; Scroll the map view one column, drawing the column that comes into view.
; Clobbers: as draw_map_view.
.map_view_scroll_left
    LDA screen_start                    ; already at the left?
    BEQ map_view_return
    DEC screen_start
    LDA #0
.map_view_draw_left
    BEQ draw_map_view_column
.map_view_scroll_right
    LDA screen_start
    CMP #MAP_SIZE - SCREEN_COLUMNS      ; already at the right?
    BEQ map_view_return
    INC screen_start
    LDA #SCREEN_COLUMNS - 1             ; the rightmost column

; Draw map view column A (0-31 across the screen; map column A plus
; screen_start), top to bottom, and set the screen's start.
; Clobbers: as draw_map_view.
.draw_map_view_column
    CLC
    ADC screen_start
    STA work0
    STA sprite
    PHA                                 ; show from here
    JSR set_screen_start
    PLA
    LDY #HI(SCREEN) DIV 8               ; work0 = SCREEN + 8 * column
    STY work1
    LDY #0
    STY work2
    LDX #3
.draw_map_view_address
    ASL work0
    ROL work1
    LSR A                               ; work2 = map + MAP_COLUMN_BYTES * column
    ROR work2
    DEX
    BNE draw_map_view_address
    ADC #HI(map)
    STA work3
    LDA #SCREEN_ROWS - 1                ; counting character rows down
    STA sprite_high
.draw_map_view_byte
    LDA (work2), Y
    PHA
    ASL A                               ; the odd row's cell, in the low nibble,
    ASL A                               ; in the lower four lines...
    LDY #CHAR_BYTES - 1
    JSR draw_map_view_cell
    PLA                                 ; ...and the even row's above it
    LSR A
    LSR A
    JSR draw_map_view_cell
    INY
    INC work2
    INC work1                           ; the next character row, wrapping
    BPL draw_map_view_next
    LDA #HI(SCREEN)
    STA work1
.draw_map_view_next
    DEC sprite_high
    BPL draw_map_view_byte
    RTS

; Wait for the vsync, then point the CRTC at screen_start.
; Clobbers: A, X.
.set_screen_start
    JSR wait_vsync
    LDX #CRTC_START_HIGH
    LDA screen_start_high
    JSR set_crtc_register
    INX                                 ; CRTC_START_LOW
    LDA screen_start
    JMP set_crtc_register
ASSERT CRTC_START_LOW = CRTC_START_HIGH + 1

; Wait for the vertical sync. Preserves A.
.wait_vsync
    PHA
    LDA #OSBYTE_WAIT_VSYNC
    JSR OSBYTE
    PLA
    RTS

; Draw one map cell in the map view: four lines of its pattern, or of the
; player's if they're there.
; In: A's bits 2-5 = the cell type; Y = the last of its four lines in the
; character cell (7 for an odd row, 3 for an even); work0 = the character
; cell; sprite = the map column; sprite_high = 31 - the character row.
; Out: Y four lines up.
; Clobbers: A, X.
.draw_map_view_cell
    AND #&0F << 2                       ; the type * 4: its pattern
    TAX
    LDA sprite                          ; the player's cell?
    CMP player_x
    BNE draw_map_view_pattern
    TYA                                 ; the carry: an odd row
    LSR A
    LSR A
    LSR A
    LDA sprite_high
    EOR #SCREEN_ROWS - 1
    ROL A                               ; the map row
    CMP player_y
    BNE draw_map_view_pattern
    LDA facing                          ; the player, facing their way
    ASL A
    ASL A
    ADC #map_view_player - map_view_patterns ; (the carry's set)
    TAX
.draw_map_view_pattern
    STX draw_map_view_copy + 1          ; self-modified: the pattern's low byte
    LDX #3
.draw_map_view_copy
    LDA map_view_patterns, X
    STA (work0), Y
    DEY
    DEX
    BPL draw_map_view_copy
    RTS
ASSERT LO(map_view_patterns) = 0

; What's in map cell (X, Y), as the player meets it: off the map is lava,
; and the exit, while it shows its icon (CELL_OBJECT), is a wall.
; Out: A = the cell type, Z set if it's empty floor; carry set off the map or
; at the exit.
; Clobbers: X, Y, cell_x, cell_y, map_pointer, cell_low_nibble.
.cell_at
    CPX exit_x
    BNE cell_at_checked
    CPY exit_y
    BNE cell_at_checked
    JSR read_map_cell
    CMP #CELL_OBJECT                    ; the exit's icon
    BNE cell_at_exit                    ; a wall
    LDA #CELL_WALL
.cell_at_exit
    CMP #0
    RTS

; As cell_at but without the exit.
; Out: A = the cell type, Z set if it's empty floor; carry set off the map.
; Clobbers: as cell_at.
.cell_at_checked
    CPX #MAP_SIZE                       ; off the map?
    BCS cell_off_map
    CPY #MAP_SIZE
    BCC read_map_cell
.cell_off_map
    LDA #CELL_LAVA                      ; lava
    RTS

; Read map cell (X, Y), on the map.
; Out: A = the cell type, Z set if it's empty floor; carry clear.
.read_map_cell
    STX cell_x
    STY cell_y
    JSR map_address
    LDA (map_pointer), Y
    LDX cell_low_nibble
    BNE read_map_cell_nibble
    LSR A                               ; even rows in the high nibble
    LSR A
    LSR A
    LSR A
.read_map_cell_nibble
    AND #&0F
    CLC
.set_cell_return
    RTS

; Put the view's top left at map cell (X, Y), and the player VIEW_CELLS / 2
; cells further on in the middle of it, and empty their cell: the start of a
; level, or a teleport. (X, Y) become where the level starts again after a
; life is lost, so a teleport moves that too.
; Clobbers: A, X, Y, work0, cell_x, cell_y, map_pointer, cell_low_nibble.
.place_player
    STX start_x
    STY start_y
    TXA
    STA view_cell_x
    PHA
    ASL A                               ; * CHARS_PER_CELL
    ASL A
    CLC
    ADC #CHARS_PER_CELL / 2
    STA view_x                          ; half a cell in
    PLA
    ADC #VIEW_CELLS / 2                 ; the player is in the middle
    STA player_x
    TAX
    TYA
    STA view_cell_y
    PHA
    ASL A
    ASL A
    CLC
    ADC #CHARS_PER_CELL / 2
    STA view_y
    PLA
    ADC #VIEW_CELLS / 2
    STA player_y
    JSR find_front

; Empty the player's cell.
; Clobbers: as set_cell.
.clear_player_cell
    LDX player_x
    LDY player_y
    LDA #CELL_FLOOR

; Set map cell (X, Y) to type A, if it's on the map. The exit can't be
; emptied.
; Out: carry set if nothing was written (off the map, or emptying the exit).
; Clobbers: A, X, Y, work0, cell_x, cell_y, map_pointer, cell_low_nibble.
.set_cell
    CPX #MAP_SIZE
    BCS set_cell_return
    CPY #MAP_SIZE
    BCS set_cell_return
    CPX exit_x
    BNE set_cell_write
    CPY exit_y
    BNE set_cell_write
    CMP #CELL_FLOOR                     ; don't empty the exit
    BEQ set_cell_done
.set_cell_write
    STA work0
    STX cell_x
    STY cell_y
    JSR map_address
    LDA (map_pointer), Y
    LDX cell_low_nibble
    BEQ set_cell_high_nibble
    AND #&F0
    JMP set_cell_store
.set_cell_high_nibble
    ASL work0
    ASL work0
    ASL work0
    ASL work0
    AND #&0F
.set_cell_store
    ORA work0
    STA (map_pointer), Y
.set_cell_done
    RTS

; Start the tune from the beginning: the sound event on, and a silent note on
; channels 1 and 2 together, whose ending sets the event handler going.
; Clobbers: A, X, Y, the sound effects' block.
.start_tune
    LDX #0
    LDY #4
.start_tune_reset
    STX tune_position, Y                ; tune_position to tune_together
    STX sound_amplitude, Y              ; silent, for no time
    DEY
    BPL start_tune_reset
    LDA #OSBYTE_ENABLE_EVENT            ; X = EVENT_OUTPUT_EMPTY
    JSR OSBYTE
    LDY #1                              ; channel 1, SOUND_SYNC_1: in step with one other
    STY sound_channel
    STY sound_channel_high
    DEY
    STY sound_duration_high
    LDX #LO(sound_channel)              ; (Y = HI(sound_channel))
    LSR A                               ; OSBYTE left A alone: OSWORD_SOUND
    JSR OSWORD
    INC sound_channel                   ; channel 2
    LDX #LO(sound_channel)
    LDY #HI(sound_channel)
    JMP OSWORD
ASSERT OSBYTE_ENABLE_EVENT DIV 2 = OSWORD_SOUND AND EVENT_OUTPUT_EMPTY = 0 AND HI(sound_channel) = 0

; Flush all the buffers, which stops the tune (and loses any keys pressed).
; Clobbers: A, X, Y.
.flush_buffers
    LDX #0                              ; all of them
    LDA #OSBYTE_FLUSH_BUFFERS
    JMP OSBYTE

; How a step in each direction moves: left, right, up, down, then up-left,
; up-right, down-left, down-right, and DIRECTION_NONE, nowhere.
.direction_dx
    EQUB -1, 1, 0, 0, -1, 1, -1, 1, 0
.direction_dy
    EQUB 0, 0, -1, 1, -1, -1, 1, 1, 0
ASSERT direction_dy - direction_dx = DIRECTION_NONE + 1

; Directions turned: indexed by the direction plus TURN_BACK, TURN_AHEAD,
; TURN_CLOCKWISE or TURN_ANTICLOCKWISE times TURN_ROW.
.turns
    EQUB DIRECTION_RIGHT, DIRECTION_LEFT, DIRECTION_DOWN, DIRECTION_UP     ; back
    EQUB DIRECTION_LEFT, DIRECTION_RIGHT, DIRECTION_UP, DIRECTION_DOWN     ; ahead
    EQUB DIRECTION_UP, DIRECTION_DOWN, DIRECTION_RIGHT, DIRECTION_LEFT     ; clockwise
    EQUB DIRECTION_DOWN, DIRECTION_UP, DIRECTION_LEFT, DIRECTION_RIGHT     ; anticlockwise
ASSERT P% - turns = (TURN_ANTICLOCKWISE + 1) * TURN_ROW

; Look at the cell in front of the player: find_front from where they face,
; look_at_front at front_x and front_y, look_at at (X, Y).
; Out: front_x, front_y, front_cell; A, Z and carry as cell_at.
; Clobbers: X, Y, cell_x, cell_y, map_pointer, cell_low_nibble.
.find_front
    LDY facing
    LDA player_x
    CLC
    ADC direction_dx, Y
    STA front_x
    LDA player_y
    CLC
    ADC direction_dy, Y
    STA front_y
.look_at_front
    LDX front_x
    LDY front_y
.look_at
    STX front_x
    STY front_y
    JSR cell_at
    STA front_cell
    RTS

; The title screen's pictures: six flames (a monster's first picture) and the
; player, facing up.
; Clobbers: A, X, Y and the sprite variables.
.draw_title_pictures
    LDA #0
    STA sprite
    LDY #title_flames_end - title_flames - 2
.draw_title_flame
    TYA
    PHA
    LDA #HI(tile(CELL_FIRE))            ; a flame
    STA sprite_high
    LDA title_flames, Y
    TAX
    LDA title_flames + 1, Y
    TAY
    SEC
    JSR draw_sprite
    PLA
    TAY
    DEY
    DEY
    BPL draw_title_flame
    LDA #HI(player_facing(DIRECTION_UP)) ; the player
    STA sprite_high
    LDX #16
    LDY #27
    SEC
    JMP draw_sprite

; The flames' x and y, in character cells (the view being 2 in from the
; screen's edges).
.title_flames
    EQUB 6, 24, 16, 8, 16, 19, 10, 21, 26, 24, 21, 22
.title_flames_end

; Work out alternate_offsets for this level from alternate_cells: two bits
; for each cell type with a second picture, from the top 5, 8, 7 and A (the
; designer's wall one, wall two, collectable and fatal trap), the low bit to
; use it on odd squares, the high on even.
; Clobbers: A, X, Y, work0-work3.
.setup_alternate_pictures
    LDX #ALTERNATES - 1
    LDA #0
    STA work0
    LDY #alternate_offsets_end - alternate_offsets - 1
.setup_alternate_clear
    STA alternate_offsets, Y            ; no second pictures
    DEY
    BPL setup_alternate_clear
    LDA #&C0                            ; two bits a cell type, from the top
.setup_alternate_cell
    PHA
    ASL work0
    LDA alternate_pictures, X
    SEC                                 ; the difference in pictures...
    SBC alternate_cell_types, X
    PHA
    ASL A
    PLA
    ROR A
    STA work1                           ; ...times PICTURE_BYTES, signed
    ROR work0
    PLA
    STA work2
    PHA
    AND alternate_cells                 ; this cell type's two bits
.setup_alternate_bits
    LSR work2
    BCS setup_alternate_store
    LSR A
    BCC setup_alternate_bits
.setup_alternate_store
    STA work3
    TXA
    ASL A
    TAY
    LSR work3                           ; bit 0: odd squares
    BCC setup_alternate_even
    LDA work0
    STA alternate_offsets_odd, Y
    LDA work1
    STA alternate_offsets_odd + 1, Y
.setup_alternate_even
    LSR work3                           ; bit 1: even squares
    BCC setup_alternate_next
    LDA work0
    STA alternate_offsets_even, Y
    LDA work1
    STA alternate_offsets_even + 1, Y
.setup_alternate_next
    DEX
    PLA
    LSR A
    LSR A
    BCC setup_alternate_cell
    RTS

; Print the name of object icon A.
; Clobbers: A, X, Y, work0.
.print_object_name
    ASL A                               ; * OBJECT_NAME_LENGTH
    ASL A
    STA work0
    ASL A
    ADC work0
    TAY
    LDX #OBJECT_NAME_LENGTH - 1
ASSERT OBJECT_NAME_LENGTH = 12

; Print X + 1 characters from io_object_names + Y.
; Clobbers: A, X, Y.
.print_names_text
    LDA io_object_names, Y
    JSR OSWRCH
    INY
    DEX
    BPL print_names_text
    RTS

; The title and backpack screens' frame: a row of cell 5's picture (a wall)
; across the top and bottom of the view and a column down each side (the view
; is offset half a cell, so only half of each shows).
; Clobbers: A, X, Y, work2 and the sprite variables.
.draw_title_border
    LDA #VIEW_CELLS                     ; 9 pictures a side
    STA work2
.draw_title_border_loop
    LDY #0
    JSR draw_border_across
    LDY #VIEW_CELLS * CHARS_PER_CELL
    JSR draw_border_across
    LDX #0
    JSR draw_border_down
    LDX #VIEW_CELLS * CHARS_PER_CELL
    JSR draw_border_down
    DEC work2
    BPL draw_title_border_loop
    RTS
.draw_border_across
    LDA work2
    ASL A
    ASL A
    TAX
    BPL draw_border_picture
.draw_border_down
    LDA work2
    ASL A
    ASL A
    TAY
.draw_border_picture
    LDA #LO(tile(5))
    STA sprite
    LDA #HI(tile(5))
    STA sprite_high
    SEC
    JMP draw_sprite

; The entry code is printed in a base-32 alphabet, "1"-"9" then "A"-"W".
; print_code_byte prints A's low 5 bits, then its top 5 (bits 3-7);
; print_code_digit just the low 5.
; Clobbers: A.
.print_code_byte
    PHA
    JSR print_code_digit
    PLA
    LSR A
    LSR A
    LSR A
.print_code_digit
    AND #&1F
    CLC
    ADC #ascii("1")                     ; "1" for 0
    CMP #ascii("9") + 1
    BCC print_code_char
    ADC #ascii("A") - ascii("9") - 2    ; "A" for 9 (the carry's set)
.print_code_char
    JMP OSWRCH

; Scramble a byte for a code: rotate it left a bit, then swap each pair of
; bits. This undoes the scrambling of the levels' edit codes (code_byte in
; leveldata.6502inc), giving their BCD digits back.
; Out: A. Clobbers: work0.
.scramble
    PHA
    ASL A                               ; the top bit...
    PLA
    ROL A                               ; ...round to the bottom
    PHA
    AND #&55                            ; the even bits up...
    ASL A
    STA work0
    PLA
    AND #&AA                            ; ...and the odd ones down
    LSR A
    ORA work0
    RTS

; Print the characters after the JSR, up to a NOP, and carry on at the NOP.
; (Text is printed through the OS: see TEXT_AT for where it lands.)
; Clobbers: A, Y, work0, work1.
.print_inline
    PLA                                 ; the return address is the byte before the text
    CLC
    ADC #1
    STA work0
    PLA
    ADC #0
    STA work1
    LDY #0
.print_inline_loop
    LDA (work0), Y
    CMP #OPCODE_NOP                     ; NOP ends it
    BEQ print_inline_return
    JSR OSWRCH
    INC work0
    BNE print_inline_loop
    INC work1
    BNE print_inline_loop
.print_inline_return
    JMP (work0)                         ; and runs

; The backpack screen's text: the time left, the level, the tune and sound
; effects settings, and the score. Under 10, the time is in its label's
; colour 3 (red in level 1's palette), else colour 2 like the other values.
; Clobbers: A, X, Y, work0, work1.
.print_status
    JSR print_inline
    TEXT_AT 10, 16
    EQUB VDU_COLOUR, 3
    EQUS "Time:"
    NOP
    LDA time_left
    CMP #10                             ; under 10...
    BCC print_status_time
    PHA
    JSR print_inline                    ; ...stays in colour 3
    EQUB VDU_COLOUR, 2
    NOP
    PLA

; A decimal number up to 255, without leading zeros.
.print_status_time
    LDX #&FF
.print_hundreds
    INX
    SEC
    SBC #100                            ; hundreds
    BCS print_hundreds
    ADC #100
    PHA
    TXA
    BEQ print_tens
    JSR print_digit
.print_tens
    TAY                                 ; nonzero if there were hundreds
    PLA
    LDX #0
.print_tens_loop
    INX
    SEC
    SBC #10                             ; tens
    BCS print_tens_loop
    ADC #10
    PHA
    DEX
    BNE print_tens_digit                ; no tens...
    TYA
    BEQ print_units                     ; ...and no hundreds: just the units
.print_tens_digit
    TXA
    LDX #3                              ; a zero tens digit prints
    CMP #0
    JSR print_digit
.print_units
    PLA
    JSR print_digit
    JSR print_inline
    TEXT_AT 8, 18
    EQUB VDU_COLOUR, 3
    EQUS "Level:"
    EQUB VDU_COLOUR, 2
    NOP
    JSR print_level

; The tune and sound effects settings; also printed when T or S changes them.
; Clobbers: A, X, Y, work0, work1.
.print_sound_settings
    JSR print_inline
    TEXT_AT 10, 21
    EQUB VDU_COLOUR, 3
    EQUS "Tune"
    NOP
    LDA tune_off
    JSR print_yes_no
    JSR print_inline
    TEXT_AT 4, 22
    EQUB VDU_COLOUR, 3
    EQUS "SoundFX"
    NOP
    LDA effects_off
    JSR print_yes_no
    JSR print_inline
    TEXT_AT 8, 19
    NOP

; "Score:" and the score, 4 BCD digits.
; Clobbers: A, X, Y, work0, work1.
.print_score
    JSR print_inline
    EQUB VDU_COLOUR, 3
    EQUS "Score:"
    EQUB VDU_COLOUR, 2
    NOP
    LDX #0
    LDA score_high
    JSR print_bcd
    LDA score
.print_bcd
    PHA
    LSR A
    LSR A
    LSR A
    LSR A
    JSR print_digit
    PLA
    AND #&0F

; Print digit A, counting digits in X: leading zeros print nothing (VDU 0)
; while X is under 3 (so the last of four always prints), and 0 prints as the
; letter O.
; In: A = the digit, Z set if it's 0; X = digits so far.
; Out: X one more, or 4 after a digit that isn't 0.
; Clobbers: A.
.print_digit
    BEQ print_digit_zero
    LDX #3
    ORA #ascii("0")                     ; a digit; zeros from now on print
    BNE print_digit_char
.print_digit_zero
    CPX #3                              ; a leading zero?
    BCC print_digit_char
    LDA #ascii("O")                     ; zero is the letter O
.print_digit_char
    INX                                 ; VDU 0 prints nothing
    JMP OSWRCH

; Print ": yes" for A zero (the tune_off and effects_off flags), else ": no".
; Clobbers: A, Y, work0, work1.
.print_yes_no
    PHA
    JSR print_inline
    EQUS ":"
    EQUB VDU_COLOUR, 2
    NOP
    PLA
    BEQ print_yes
    JSR print_inline
    EQUS "no"
    NOP
    RTS
.print_yes
    JSR print_inline
    EQUS "yes"
    NOP
    RTS

; Never called: the level after a TAB to the right of the title screen's.
.print_level_at
    JSR print_inline
    TEXT_AT 24, 13
    EQUB VDU_COLOUR, 2
    NOP

; Print the level's number, 1-4.
; Clobbers: A.
.print_level
    LDA level
    CLC
    ADC #ascii("1")                     ; "1" for level 0
    JMP OSWRCH

; "WELL DONE!" in blocks: 11 rows of 32 bits, a bit a character cell, the top
; bit leftmost.
FUNCTION blocks_byte(row) = SUM(FIND(CODES(".#"), CODES(row)) * {128, 64, 32, 16, 8, 4, 2, 1})
MACRO BLOCKS row
    ASSERT LEN(row) = SCREEN_COLUMNS, "a row of blocks is 32 characters"
    EQUB blocks_byte(row[0..7]), blocks_byte(row[8..15]), blocks_byte(row[16..23]), blocks_byte(row[24..31])
ENDMACRO
.well_done_bitmap
    BLOCKS "#...#.###.#....#................"
    BLOCKS "#...#.#...#....#................"
    BLOCKS "#...#.##..#....#................"
    BLOCKS "#.#.#.#...#....#................"
    BLOCKS ".#.#..###.####.####............."
    BLOCKS "................................"
    BLOCKS "###...##..#..#.###.#............"
    BLOCKS "#..#.#..#.##.#.#...#............"
    BLOCKS "#..#.#..#.####.##..#............"
    BLOCKS "#..#.#..#.#.##.#................"
    BLOCKS "###...##..#..#.###.#............"

; A block's character cell: colours 2 and 3, speckled. The cell to its right
; gets WELL_DONE_SHADOW, two pixels of colour 1, unless the next block covers
; it.
.well_done_block
    EQUB &F5, &FE, &FB, &FE, &F7, &FD, &FB, &FF
WELL_DONE_SHADOW = &0C

; After a level: clear 13 character rows across the middle of the view and
; show WELL DONE! in big letters, then wait 4 seconds.
; Clobbers: A, X, Y, screen, cell_low_nibble.
.show_well_done
    LDA view_screen
    STA screen
    LDA view_screen_high
    CLC                                 ; nine character rows down
    ADC #9
    JSR wrap_screen_high
    LDA #13                             ; 13 rows
    STA cell_low_nibble                 ; (as a counter)
.show_well_done_clear
    LDX #SCREEN_COLUMNS
.show_well_done_cell
    LDY #CHAR_BYTES - 1
    LDA #0
.show_well_done_blank
    STA (screen), Y
    DEY
    BPL show_well_done_blank
    JSR next_screen_cell
    DEX
    BNE show_well_done_cell
    DEC cell_low_nibble
    BNE show_well_done_clear
    LDA view_screen                     ; 6 characters in...
    CLC
    ADC #6 * CHAR_BYTES
    STA screen
    LDA view_screen_high                ; ...ten rows down
    ADC #10
    AND #&3F                            ; (as good as &1F: the ORA sets bit 5)
    ORA #HI(SCREEN)
    STA screen_high
    LDA #&80                            ; the bitmap's top bit first
    STA cell_low_nibble                 ; (as a mask)
.show_well_done_bit
    LDA well_done_bitmap, X
    AND cell_low_nibble
    BEQ show_well_done_next
    LDY #2 * CHAR_BYTES - 1             ; the shadow in this cell and the next...
    LDA #WELL_DONE_SHADOW
.show_well_done_block
    STA (screen), Y
    DEY
    BPL show_well_done_block
    LDY #CHAR_BYTES - 1                 ; ...then the block over it in this one
.show_well_done_shade
    LDA well_done_block, Y
    STA (screen), Y
    DEY
    BPL show_well_done_shade
.show_well_done_next
    JSR next_screen_cell
    LSR cell_low_nibble
    BCC show_well_done_bit
    ROR cell_low_nibble                 ; the carry: back to the top bit
    INX
    CPX #well_done_block - well_done_bitmap ; 11 rows of 4 bytes
    BCC show_well_done_bit
    LDA #4 * 50                         ; 4 seconds
    BITABS                              ; (skips the LDA)

; Wait a second, or (wait_ticks) A fiftieths of a second, by the OS's vsync
; countdown.
; Clobbers: A.
.wait_a_second
    LDA #50
.wait_ticks
    STA MOS_VSYNC_COUNTER
.wait_ticks_loop
    LDA MOS_VSYNC_COUNTER
    BNE wait_ticks_loop
    RTS

; A random number from 0 to Y - 1: A, mixed with the system VIA's timer 1 low
; byte and the user VIA's timer 2 high byte, modulo Y.
; In: A, Y.
; Out: A; the carry clear.
; Clobbers: work0.
.random
    EOR SYSVIA_T1CL                     ; free-running: as good as random
    EOR USRVIA_T2CH
    STY work0
.random_mod
    CMP work0
    BCC random_done
    SBC work0
    BCS random_mod
.random_done
    RTS

; The game is over: flames fill the view from the player outwards, crackling.
; Clobbers: A, X, Y, view_sub_x, view_sub_y, steps, count_across, work0 and
; the sprite variables.
.burn_up
    JSR wait_a_second
    LDA view_x                          ; on the player (a character higher)
    CLC
    ADC #PLAYER_CHAR
    STA view_sub_x                      ; (the square's top left)
    LDA view_y
    CLC
    ADC #PLAYER_CHAR - 1
    STA view_sub_y
    LDA #2                              ; a square from 2 characters across
    STA steps                           ; to 30
.burn_up_ring
    LDA #100                            ; 100 flames a ring
    STA count_across
.burn_up_flame
    LDA USRVIA_T2CL                     ; either flame picture
    AND #PICTURE_BYTES
    STA sprite
    LDY steps
    JSR random
    ADC view_sub_x
    TAX
    JSR random                          ; somewhere in the square
    ADC view_sub_y
    TAY
    LDA #HI(tile(CELL_FIRE))
    STA sprite_high
    SEC
    JSR draw_sprite                     ; a flame
    DEC count_across
    BNE burn_up_flame
    BIT USRVIA_T2CL                     ; now and then...
    BVC burn_up_next_ring
    LDY #4                              ; envelope 1-4
    JSR random
    TAX
    INX
    LDY #3                              ; white noise 4-6, as long
    JSR random
    ORA #4
    JSR sound_effect                    ; ...a crackle
.burn_up_next_ring
    DEC view_sub_x                      ; the square grows
    DEC view_sub_y
    INC steps
    INC steps
    LDA steps
    CMP #SCREEN_COLUMNS
    BCC burn_up_ring
    RTS

; Never used.
.burn_up_unused
    SKIP 36

; The picture for an object cell at map cell (X, Y): the exit's icon, the
; icon of the object there, or if none, the picture kept for that.
; Out: X, Y = the picture's address.
; Clobbers: A, work0, work1.
.object_picture_at
    CPX exit_x
    BNE object_picture_find
    CPY exit_y
    BNE object_picture_find
.exit_picture
    LDX #LO(icon(EXIT_ICON))
    LDY #HI(icon(EXIT_ICON))
    RTS
.object_picture_find
    JSR find_object
    BCC no_object_picture

; The icon of the object at offset Y in objects.
; Out: X, Y = the picture's address.
; Clobbers: A.
.object_icon_picture
    LDA object_icon, Y
    ORA #&10                            ; &10 + the icon
    JMP thing_picture
.no_object_picture
    LDX #LO(io_no_object_picture)
    LDY #HI(io_no_object_picture)
    RTS

; The game proper starts here, from the loader, and this runs once: each
; level's objects are copied over it (objects), and nothing comes back here.
.game_start
    EOR #&48                            ; (to no purpose: A is loaded next)
    LDA #LO(error_handler)              ; errors go to error_handler
    STA BRKV
    LDA #HI(error_handler)
    STA BRKV + 1
    LDA #0
    STA score
    STA score_high
    STA effects_off
    STA tune_off
    STA fill_screen
    STA level
    JSR flush_buffers                   ; no keys waiting
    JSR load_mission                    ; load the mission
ASSERT P% - game_start = OBJECTS * OBJECT_BYTES

; The title screen, then a game.
.new_game
    JSR title_screen
    LDX #START_LIVES
    STX lives
    LDA #0
    STA score
    STA score_high

; A level from the start, and after losing a life.
.start_level
    JSR setup_level
.restart_level
    JSR reset_level
    JSR clear_screen
    JSR set_level_palette               ; the level's palette
    JSR redraw_view
    LDA tune_off
    BNE game_loop
    JSR start_tune

; The game's main loop, a cycle at a time: the clock ticks at the mission's
; rate (not while in a pipe), with warning beeps in the last 20; once the
; exit is lit the time left is scored, and the player has 4 ticks to get
; clear.
.game_loop
    LDA time_left
    BEQ time_up                         ; out of time?
    JSR play_cycle                      ; move the player and everything else
    LDA pipe_move
    BNE check_dead                      ; the clock stops in pipes
    LDA clock_fraction
    CLC
    ADC io_time_rate                    ; the mission's clock rate
    STA clock_fraction
    BCC check_dead
    DEC time_left
    LDA time_left
    CMP #20                             ; the last 20 ticks...
    BCS check_dead
    LDA stage
    BNE warn_time_running_out
    LDA #0                              ; ...beep
    JSR sound_beep
    JMP check_dead
.warn_time_running_out
    LDX #ENVELOPE_VOICE_2               ; ...a noise instead once the exit is lit
    LDA #4
    JSR sound_effect
.check_dead
    LDA player_dead
    BNE lose_life
    LDA stage
    CMP #STAGE_EXIT_LIT                 ; the exit has just been lit:
    BNE game_loop
    INC stage                           ; STAGE_ESCAPING
    LDX time_left                       ; a point for each tick left, and one
    JSR add_points                      ; more (add_points)
    LDA #4                              ; and 4 ticks to get clear
    STA time_left
    BNE game_loop

; Out of time: with the exit lit, the player is safe 5 or more cells from it,
; across or down; otherwise they're caught in the blaze, and the view is
; wiped to bare floor.
.time_up
    LDX stage
    CPX #STAGE_ESCAPING                 ; the exit lit?
    BNE lose_life
    JSR far_from_exit                   ; far enough across...
    BCS level_complete
    INX
    SEC
    JSR far_from_exit                   ; ...or down: safe
    BCS level_complete
    INC fill_screen                     ; caught in it
    JSR clear_screen
    DEC fill_screen

; Lose a life. With none left, burn up and back to the title; if the exit
; had been lit the level counts as done.
.lose_life
    JSR flush_buffers
    JSR sound_trigger                   ; a sound
    JSR draw_player
    DEC lives
    BNE lose_life_again
    JSR burn_up                         ; the last life
    JSR close_view
    JMP new_game
.lose_life_again
    LDX #COLOUR_RED + 8                 ; colour 0 flashes red and cyan
    JSR vdu_palette
    JSR close_view
    LDA stage                           ; died after lighting the exit?
    BNE next_level
    JMP restart_level

; The level's done: flash the palette, WELL DONE, 101 points (add_points).
.level_complete
    JSR flush_buffers
    LDA #5
    JSR sound_effect_4
    JSR flash_palette                   ; flash
    JSR show_well_done
    INC stage                           ; STAGE_DONE
    LDX #100
    JSR add_points

; On to the next level, or after the fourth, the end of the mission. Doing a
; level without having lost a life this game lets the next game start from
; the next one.
.next_level
    INC level
    LDA level
    CMP #IO_LEVELS                      ; four levels
    BCS mission_complete
    LDX lives
    CPX #START_LIVES                    ; no lives lost...
    BCC next_level_screen
    CMP furthest_level                  ; ...so the title can start on the next level
    BCC next_level_screen
    STA furthest_level
.next_level_screen
    JSR set_level_palette
    LDA lives
    CLC
    JSR show_edit_code                  ; the backpack screen, with the finished level's edit code
    JSR wait_for_space                  ; wait for Space
    JMP start_level
.mission_complete
    JSR mission_done
    JMP new_game

; Flash colour 0 through physical colours 7 down to 0, 8 times, a frame each,
; then back to the level's palette.
; Clobbers: A, X, Y, work0, work2, work4.
.flash_palette
    LDA #8
    LDX #1

; The same A times, X frames a colour.
.flash_palette_times
    STA work0                           ; flashes
    STX work2                           ; frames a colour
.flash_palette_cycle
    LDX #COLOUR_WHITE
.flash_palette_colour
    JSR vdu_palette                     ; logical 0 = physical X
    LDA work2
    STA work4
    TXA
.flash_palette_wait
    JSR wait_vsync                      ; wait
    DEC work4
    BNE flash_palette_wait
    TAX
    DEX
    BPL flash_palette_colour
    DEC work0
    BNE flash_palette_cycle

; Set the palette for the level (or level A from set_palette) from
; io_palettes.
; Clobbers: A, X, Y, work0.
.set_level_palette
    LDA level
.set_palette
    ASL A                               ; 4 colours a level
    ASL A
    ADC #3                              ; the level's last colour first
    TAY
    LDA #3
    STA work0
.set_palette_loop
    JSR set_palette_entry
    DEY
    DEC work0
    BNE set_palette_loop
.set_palette_entry
    LDX io_palettes, Y                  ; logical << 4 | physical

; VDU 19, X >> 4, X, 0, 0, 0: logical colour X's high nibble is physical
; colour X's low.
; Clobbers: A.
.vdu_palette
    LDA #VDU_PALETTE
    JSR OSWRCH
    TXA
    LSR A
    LSR A
    LSR A
    LSR A
    JSR OSWRCH
    TXA
    JSR OSWRCH
    LDA #0
    JSR OSWRCH
    JSR OSWRCH
    JMP OSWRCH

; Is the player 5 or more cells from the exit, across (X = STAGE_ESCAPING)
; or down (X one more)?
; In: the carry set.
; Out: the carry set if so.
; Clobbers: A.
.far_from_exit
    LDA player_x - STAGE_ESCAPING, X    ; player_x or player_y...
    SBC exit_x - STAGE_ESCAPING, X      ; ...less exit_x or exit_y
    BCS far_from_exit_distance
    EOR #&FF                            ; how far
    ADC #1
.far_from_exit_distance
    CMP #5
    RTS
ASSERT player_y = player_x + 1 AND exit_y = exit_x + 1

; Space on the title screen: start, returning from title_screen (the timer is
; resynchronised twice).
.title_start
    JSR resync_timer

; Just after a vsync, with interrupts off, restart the system VIA's timer 1
; (the OS's 100 Hz tick) from its latch, keeping its interrupts clear of the
; vsync's.
; Clobbers: A, X, Y.
.resync_timer
    JSR wait_vsync
    SEI
    LDY #9                              ; a little more
    JSR delay
    LDA SYSVIA_T1LL                     ; timer 1 from its latch
    STA SYSVIA_T1LL
    LDA SYSVIA_T1LH
    STA SYSVIA_T1CH
    CLI
    RTS

; The title screen: Space starts at the chosen level, S steps the level (up to
; furthest_level), L loads another mission.
; Out: level and started_late set.
; Clobbers: everything.
.title_screen
    LDA #0                              ; level 1 unless S is pressed
    STA started_late
    STA level
    JSR set_level_palette
    JSR draw_title_screen               ; the title screen's pictures
    JSR print_inline
    TEXT_AT 6, 13
    EQUB VDU_COLOUR, 3
    EQUS "Start:"
    TEXT_AT 6, 11                       ; and above it the score
    NOP
    JSR print_score
    LDX #1                              ; just the input buffers
    LDA #OSBYTE_FLUSH_BUFFERS
    JSR OSBYTE
.title_screen_key
    JSR print_inline
    TEXT_AT 18, 13
    EQUB VDU_COLOUR, 2
    NOP
    JSR print_level                     ; the level to start on
    JSR OSRDCH
    BCC title_screen_got_key            ; Escape?
    JSR acknowledge_escape
.title_screen_got_key
    AND #&DF                            ; upper case, and Space is 0
    BEQ title_start                     ; Space: start
    CMP #ascii("S")
    BEQ title_screen_next_level
    CMP #ascii("L")                     ; load a mission
    BNE title_screen_key
    JMP ask_for_mission
.title_screen_next_level
    LDX level                           ; S: the next level that can be started on
    CPX furthest_level
    BCC title_screen_set_level
    LDX #&FF
.title_screen_set_level
    INX
    STX level
    STX started_late
    BPL title_screen_key                ; always

; The title screen (also behind the filename prompt and an error): text on,
; the frame, the heading, the flames and the player.
; Clobbers: everything.
.draw_title_screen
    JSR print_inline
    EQUB VDU_ENABLE, VDU_TEXT_CURSOR, VDU_RESET_WINDOWS, VDU_COLOUR, COLOUR_BACKGROUND + 0
    NOP
    JSR draw_screen_frame
    JMP draw_title_pictures

; Drop the two bytes set_cell_and_draw pushed, and return from it.
.drop_two_and_return
    PLA
    PLA
    RTS

; Empty the cell under monster X / 4.
; Clobbers: as set_cell_and_draw.
.empty_monster_cell
    JSR monster_cell
    LDA #CELL_FLOOR

; Set map cell (X, Y) to A and draw it. Off the map (or emptying the exit),
; nothing happens.
; Clobbers: A, X, Y, work0, work1 and the drawing variables.
.set_cell_and_draw
    STA work1                           ; the type
    TXA
    PHA
    TYA
    PHA
    LDA work1
    JSR set_cell                        ; nothing written?
    BCS drop_two_and_return
    PLA
    ASL A                               ; * CHARS_PER_CELL
    ASL A
    TAY
    PLA
    ASL A
    ASL A
    TAX
    LDA work1

; Draw cell type A's picture at character position (X, Y): whole, or for an
; object an icon on the floor.
; Clobbers: A, X, Y, temp, work0, work1 and the sprite variables.
.draw_thing_at
    PHA
    STX sprite
    STY sprite_high
    JSR to_cell
    PLA
    JSR thing_picture                   ; its picture
    SEC                                 ; a cell's picture: whole
    BEQ draw_picture_at
.draw_icon_at
    CLC                                 ; an icon: on the floor
.draw_picture_at
    TXA                                 ; sprite and X, Y swapped
    LDX sprite
    STA sprite
    TYA
    LDY sprite_high
    STA sprite_high
    JMP draw_sprite

; The exit's icon, top left of the backpack screen once the exit is lit.
; Clobbers: A, X, Y and the sprite variables.
.draw_exit_icon
    LDA #4                              ; character position 4, 4
    STA sprite
    STA sprite_high
    JSR exit_picture
    JMP draw_icon_at

; Start (or restart) the level: facing up, the direction keys as MENU set
; them, the clock reset, the exit back in place, the player at the start.
; Clobbers: everything.
.reset_level
    LDX #DIRECTION_UP                   ; facing up
    STX facing
    INX
.reset_level_keys
    LDA menu_key_left, X                ; the direction keys back as MENU set them
    STA key_left, X
    DEX
    BPL reset_level_keys
    INX
    STX stage                           ; all zero
    STX pipe_move
    STX player_dead
    STX frame_counter
    STX player_frame
    STX action
    STX clock_fraction
    LDX exit_x
    LDY exit_y
    LDA #CELL_OBJECT                    ; the exit's icon on its cell
    JSR set_cell
    LDA level
    ASL A
    ASL A
    ASL A
    TAY
    LDA io_level_setup + LEVEL_TIME, Y
    STA time_left                       ; the clock
    LDX start_x
    LDY start_y
    JSR place_player

; Forget which direction keys were down; also the do-nothing action.
; Clobbers: A, X.
.clear_keys_down
    LDX #3
    LDA #0
.clear_keys_down_loop
    STA keys_were_down, X               ; nothing held
    DEX
    BPL clear_keys_down_loop
    RTS

; Copy the level's data out of IO into the variables the game plays with: its
; setup, its map (to map, where it can change), monsters, objects and
; triggers; the backpack starts empty.
; Clobbers: everything.
.setup_level
    LDA level
    ASL A                               ; * LEVEL_SETUP_BYTES
    ASL A
    ASL A
    ADC #LEVEL_SETUP_BYTES - 1
    TAY
    LDX #LEVEL_SETUP_BYTES - 1
.setup_level_setup
    LDA io_level_setup, Y               ; the setup bytes, from start_x
    STA start_x, X
    DEY
    DEX
    BPL setup_level_setup
    INY
    TYA                                 ; level * 8: the map's page offset
    PHA
    ADC #HI(io_maps)                    ; the level's map
    STA work1
    LDY #0
    STY work0
    STY backpack_slot
    STY thrown_direction
    STY pushes_left
    STY clock_fraction
    STY work2
    LDA #HI(map)                        ; goes to map
    STA work3
    LDX #HI(IO_MAP_SIZE)                ; 8 pages
.setup_level_map
    LDA (work0), Y
    STA (work2), Y
    INY
    BNE setup_level_map
    INC work1
    INC work3
    DEX
    BNE setup_level_map
    PLA
    ASL A                               ; level * 16
    ADC #MONSTERS * MONSTER_BYTES - 1
    TAY
    LDX #MONSTERS * MONSTER_BYTES - 1
.setup_level_monsters
    LDA io_level_monsters, Y            ; monsters
    STA monster_x, X
    DEY
    DEX
    BPL setup_level_monsters
    INY
    TYA                                 ; level * 32
    ASL A
    ADC #OBJECTS * OBJECT_BYTES - 1
    TAY
    LDX #OBJECTS * OBJECT_BYTES - 1
.setup_level_objects
    LDA io_level_objects, Y             ; objects...
    STA objects, X
    LDA io_level_trigger_flags, Y       ; ...and trigger flags
    STA trigger_flags, X
    DEY
    DEX
    BPL setup_level_objects
    INY
    TYA                                 ; level * 64
    ASL A
    ADC #2 * PUZZLES - 1
    TAY
    LDX #2 * PUZZLES - 1
.setup_level_triggers
    LDA io_level_trigger_places, Y      ; triggers' places...
    STA trigger_places, X
    LDA io_level_trigger_args_0, Y      ; ...and arguments, in two halves
    STA trigger_args, X
    LDA io_level_trigger_args_1, Y
    STA trigger_args + 2 * PUZZLES, X
    DEY
    DEX
    BPL setup_level_triggers
    LDY #BACKPACK_SLOTS - 1
.setup_level_backpack
    STX backpack, Y                     ; X = EMPTY_SLOT
    DEY
    BPL setup_level_backpack
    JMP setup_alternate_pictures
ASSERT LEVEL_SETUP_BYTES = alternate_cells + 1 - start_x AND LEVEL_TIME = time_left - start_x
ASSERT OBJECTS * OBJECT_BYTES = PUZZLES AND LO(io_maps) = 0 AND LO(IO_MAP_SIZE) = 0

; One cycle of play: the player's turn, then four frames of the keys being
; read and things moving a character, then the monsters are marked on the
; map as fire (deadly) until they next move. A step ends the cycle early,
; having moved things itself (move).
; Clobbers: everything.
.play_cycle
    JSR player_turn
    LDA player_dead                     ; dead?
    BNE play_cycle_done
    JSR think                           ; think...
    LDA #CHARS_PER_CELL
    STA work2
.play_cycle_step
    JSR wait_vsync                      ; ...then four frames
    JSR read_keys
    JSR move_things
    DEC work2
    BNE play_cycle_step
.mark_monsters
    LDA #CELL_FIRE                      ; monsters are deadly cells
    BNE set_monster_cells

; Move a thrown object on a cell, advance the frame counter, decide where each
; monster goes next, and take the monsters off the map.
; Clobbers: everything.
.think
    JSR fly_thrown                      ; a thrown object
    LDA frame_counter
    CLC
    ADC #&20
    STA frame_counter
    LDA #MONSTERS - 1
    STA work4
.think_monster
    LDA work4                           ; each monster's 4 bytes...
    ASL A
    ASL A
    ADC #MONSTER_BYTES - 1
    TAX
    LDY #MONSTER_BYTES - 1
.think_monster_copy
    LDA monster_x, X                    ; ...to work0-work3
    STA work0, Y
    DEX
    DEY
    BPL think_monster_copy
    INX
    JSR monster_think                   ; where it goes
    DEC work4
    BPL think_monster
    LDA #CELL_FLOOR                     ; and take them off the map

; Set the cells of the monsters that are out to type A.
.set_monster_cells
    STA work5
    LDA #MONSTERS - 1
    STA work4
.set_monster_cell
    LDA work4
    ASL A
    ASL A
    TAX
    LDA monster_direction, X            ; not out?
    CMP #MONSTER_GONE
    BCS set_monster_cell_next
    JSR monster_cell
    LDA work5
    JSR set_cell
.set_monster_cell_next
    DEC work4
    BPL set_monster_cell
.play_cycle_done
    RTS

; Is the key with negative INKEY number X pressed?
; Out: Z set (X = 0, Y = &FF) if it is.
; Clobbers: A.
.key_pressed
    LDA #OSBYTE_INKEY
    LDY #&FF
    JSR OSBYTE
    INX                                 ; &FF + 1 = 0 when pressed
.do_nothing
    RTS

; The player's turn: Escape gives up a life (with SHIFT, the game). Then look
; at what's in front of the player and underneath, try every trigger, and do
; an action: the one pressed, or the pipe's move while in a pipe.
; Clobbers: everything.
.player_turn
    BIT MOS_ESCAPE_FLAG                 ; Escape?
    BPL player_turn_no_escape
.give_up
    LDX #INKEY_TEST(KEY_SHIFT)          ; SHIFT too?
    JSR key_pressed
    BNE give_up_life
    INX                                 ; one life left, about to be lost
    STX lives
.give_up_life
    INC player_dead
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE      ; also, as pipe_move, the player isn't
    STA pipe_move                       ; drawn again
    JMP OSBYTE
.player_turn_no_escape
    JSR find_front
    LDX player_x
    LDY player_y
    JSR cell_at                         ; what the player stands on...
    JSR check_pipe_end                  ; ...as it affects pipes
    LDA #0
.player_turn_triggers
    PHA
    LDY #0                              ; triggers fired by walking onto them
    JSR use_trigger
    PLA
    CLC
    ADC #1
    CMP #PUZZLES                        ; all of them
    BNE player_turn_triggers
    LDX player_x
    LDY player_y
    JSR cell_at
    JSR check_underfoot                 ; lava, fire, the exit...
    LDA player_dead
    BNE do_nothing
    LDA action                          ; an action already decided?
    CMP #ACTION_STOP
    BEQ do_action
    LDA pipe_move                       ; in a pipe, carried on...
    BNE do_action
    JSR read_keys                       ; ...or a key
    LDA action
.do_action
    ASL A                               ; action_table
    TAY
    LDA #ACTION_NONE
    STA action
    LDX action_table, Y
    LDA action_table + 1, Y

; Jump to X + 256 * A.
; Clobbers: work0, work1.
.jump_to
    STX work0
    STA work1
    JMP (work0)

; Action 4, CTRL: the backpack screen. The mission, the lives left, the
; backpack's contents and the selected object's name, the time, level, score
; and sound settings; see backpack_keys. Space goes back to the game.
.backpack_screen
    JSR save_view                       ; remember where the view was
    LDA lives
    JSR draw_backpack_screen            ; the screen, the lives
    LDA #&80
    JSR print_selected_name             ; no name yet
    JSR selection_position              ; the selection cursor, the player's picture...
    LDA #HI(player_facing(DIRECTION_UP))
    JSR draw_page_picture               ; ...drawn
    JSR print_status
.backpack_screen_loop
    BIT MOS_ESCAPE_FLAG                 ; Escape: lose a life
    BMI give_up
    JSR backpack_keys                   ; the backpack screen's keys
    LDX #INKEY_TEST(KEY_SPACE)          ; Space
    JSR key_pressed
    BNE backpack_screen_loop
.backpack_screen_done
    LDA work4                           ; the view as it was
    STA view_x
    LDA work5
    STA view_y
    JMP redraw_view

; The backpack screen's keys: Z and X (as MENU set them, whatever a trigger
; has done to this level's) move the selection, M shows the map, S and T turn
; the sound effects and the tune on and off. Called round a loop until Space.
; Clobbers: everything.
.backpack_keys
    LDX backpack_slot                   ; the selected object's name
    LDA backpack, X
    JSR print_selected_name
    LDX menu_key_left                   ; left...
    JSR key_pressed
    BEQ backpack_select
    LDX menu_key_right                  ; ...or right
    JSR key_pressed
    BEQ backpack_select_right
    LDA level                           ; the map?
    CMP io_map_levels
    BCS backpack_keys_sound
    LDX key_map
    JSR key_pressed
    BNE backpack_keys_sound
    PLA                                 ; out of the backpack screen
    PLA
    JMP show_map
.backpack_keys_sound
    LDX #INKEY_TEST(KEY_S)              ; S: sound effects
    JSR key_pressed
    BEQ backpack_toggle_effects
    LDX #INKEY_TEST(KEY_T)              ; T: the tune
    JSR key_pressed
    BNE backpack_keys_done
    LDA tune_off
    EOR #1
    STA tune_off
    BNE backpack_tune_off
    JSR start_tune                      ; on
    BNE backpack_show_settings          ; (OSWORD returns with Z clear)

; Show the new setting, then wait a moment so the key doesn't repeat.
.backpack_tune_off
    JSR flush_buffers                   ; off
.backpack_show_settings
    LDX #24                             ; the floor over the end of the old
    LDY #23                             ; settings
    LDA #CELL_FLOOR
    JSR draw_thing_at
    JSR print_sound_settings            ; and print the new
    JMP short_pause                     ; a pause
.backpack_toggle_effects
    LDA effects_off
    EOR #1
    STA effects_off
    BPL backpack_show_settings
.backpack_select_right
    LDY #1                              ; right (key_pressed leaves Y = &FF for left)

; Move the selection Y (-1 or 1) slots, sliding the cursor (the player's
; picture) along below the backpack; off either end it slides all the way
; back to the other.
.backpack_select
    STY work2
    JSR selection_position              ; where the cursor is
    STX work0
    STY work1
    LDA backpack_slot
    CLC
    ADC work2
    BMI backpack_select_wrap_left       ; off the left?
    CMP io_backpack_last                ; off the right?
    BEQ backpack_select_slide
    BCS backpack_select_wrap_right
.backpack_select_slide
    STA backpack_slot
    LDA #BACKPACK_SPACING               ; a character a step
    STA work3
.backpack_slide_cursor
    JSR wait_vsync
    JSR wait_vsync
    LDX work0                           ; rub out...
    LDY work1
    LDA #HI(tile(CELL_FLOOR))           ; ...with the floor
    JSR draw_page_picture
    LDA work0
    CLC
    ADC work2
    STA work0
    TAX
    LDY work1
    LDA #HI(player_facing(DIRECTION_UP)) ; draw it a character on
    JSR draw_page_picture
    DEC work3
    BNE backpack_slide_cursor
.backpack_keys_done
    RTS
.backpack_select_wrap_left
    LDA io_backpack_last
    BNE backpack_select_wrap
.backpack_select_wrap_right
    LDA #0
.backpack_select_wrap
    PHA
    LDA work2                           ; slide back the other way
    EOR #&FE                            ; (1 and -1 swap)
    STA work2
    JSR selection_position
    LDA #HI(tile(CELL_FLOOR))
    JSR draw_page_picture
    LDY #11                             ; a row lower
    STY work1
    LDX work0
    LDA #HI(player_facing(DIRECTION_UP))
    JSR draw_page_picture
    LDA io_backpack_last                ; BACKPACK_SPACING steps for each slot
    ASL A
    STA work3
    ASL A
    ADC work3
    STA work3
    JSR backpack_slide_cursor
    PLA
    STA backpack_slot
    JSR selection_position
    INY
    LDA #HI(tile(CELL_FLOOR))
    JSR draw_page_picture
    JSR selection_position
    LDA #HI(player_facing(DIRECTION_UP))

; Draw the whole picture at A * 256 at character position (X, Y).
; Clobbers: A, X, Y and the sprite variables.
.draw_page_picture
    STA sprite_high
    LDA #0
    STA sprite
    SEC
    JMP draw_sprite

; The selection cursor's character position: below the selected slot.
; Out: X = slot * BACKPACK_SPACING + 7, Y = 10.
; Clobbers: A.
.selection_position
    LDA backpack_slot
    ASL A                               ; * BACKPACK_SPACING
    ASL A
    ADC backpack_slot
    ADC backpack_slot
    ADC #7
    TAX
    LDY #10
    RTS
ASSERT BACKPACK_SPACING = 6

; A clear screen with the floor pattern, the frame and the PIPELINE heading,
; for the title and backpack screens. Their pictures are drawn at character
; positions as the view's, with the view half a cell in.
; Clobbers: everything.
.draw_screen_frame
    LDA #CHARS_PER_CELL / 2
    STA view_x
    STA view_y
    DEC fill_screen                     ; fill with the floor pattern
    JSR clear_screen
    INC fill_screen
    JSR draw_title_border
    JSR print_inline
    TEXT_AT 8, 3
    EQUB VDU_COLOUR, 2, VDU_COLOUR, COLOUR_BACKGROUND + 0
    EQUS "PIPELINE"
    NOP
    RTS

; The backpack screen: the mission, a picture of the player for each life,
; the exit's icon once it's lit, and what's in the backpack.
; In: A = the number of lives; the carry set to leave out the mission text.
; Clobbers: everything.
.draw_backpack_screen
    PHP
    STA work3
    JSR draw_screen_frame
    PLP
    BCS draw_lives
    LDY #LO(io_mission_text - io_object_names) ; the mission text
    LDX #IO_MISSION_SIZE - 1
    JSR print_names_text
.draw_lives
    LDA facing                          ; the player's picture for the way they face
    LSR A                               ; * PICTURE_BYTES
    ROR A
    STA sprite
    LDA #0
    ADC #HI(io_player)
    STA sprite_high
    LDA work3
    ASL A                               ; 8 characters apart
    ASL A
    ASL A
    TAX
    LDY #27                             ; along the bottom
    SEC
    JSR draw_sprite
    DEC work3
    BNE draw_lives
    LDA stage                           ; the exit lit?
    BEQ draw_backpack
    JSR draw_exit_icon
.draw_backpack
    LDA #BACKPACK_SLOTS - 1
    STA work0
.draw_backpack_slot
    LDX work0
    LDA backpack, X
    BMI draw_backpack_next              ; empty?
    ASL A
    ASL A
    TAY
    JSR object_icon_picture             ; its icon
    STX sprite
    STY sprite_high
    LDA work0                           ; at slot * BACKPACK_SPACING + 7, 7
    ASL A
    ASL A
    ADC work0
    ADC work0
    ADC #7
    TAX
    LDY #7
    CLC                                 ; on the floor
    JSR draw_sprite
.draw_backpack_next
    DEC work0
    BPL draw_backpack_slot
.draw_backpack_done
    RTS

; Action 3, M: the map, on levels below io_map_levels.
.map_screen
    LDA level
    CMP io_map_levels                   ; no map this level?
    BCS draw_backpack_done
    JSR save_view                       ; remember the view
    JSR clear_screen

; The map view (from the backpack screen too), scrolled to put the player in
; the middle where it can: Z and X scroll it, Space goes back. The SBC's
; operand, &10, is also used as a mask by BIT (see bit4_mask).
.show_map
    LDA player_x                        ; player_x - 16...
    SEC
.show_map_centre
    SBC #SCREEN_COLUMNS / 2
    BCS show_map_clamp
    LDA #0
.show_map_clamp
    CMP #MAP_SIZE - SCREEN_COLUMNS + 1  ; ...between 0 and 32
    BCC show_map_draw
    LDA #MAP_SIZE - SCREEN_COLUMNS
ASSERT SCREEN_COLUMNS / 2 = &10         ; for bit4_mask
.show_map_draw
    STA screen_start
    JSR blank_display                   ; draw it with the display off
    JSR draw_map_view
    JSR setup_crtc
.show_map_loop
    BIT MOS_ESCAPE_FLAG
    BMI show_map_escape
    LDX menu_key_left                   ; Z
    JSR key_pressed
    BNE show_map_right
    JSR map_view_scroll_left
    JMP show_map_space
.show_map_right
    LDX menu_key_right                  ; X
    JSR key_pressed
    BNE show_map_space
    JSR map_view_scroll_right
.show_map_space
    LDX #INKEY_TEST(KEY_SPACE)          ; Space
    JSR key_pressed
    BNE show_map_loop
    JSR clear_screen                    ; back to the game
    JMP backpack_screen_done
.show_map_escape
    JMP give_up

; The selected object's name under the backpack, on a band of colour 1; or
; just the band.
; In: A = the object, or negative for none.
; Clobbers: A, X, Y, work0, work1.
.print_selected_name
    PHA
    JSR print_inline
    TEXT_AT 4, 31
    EQUB VDU_COLOUR, COLOUR_BACKGROUND + 1, VDU_COLOUR, 3
    NOP
    PLA
    BPL print_selected_object
    LDA #VDU_BACKSPACE                  ; nothing selected: back a character...
    JSR OSWRCH
    LDY #OBJECT_NAME_LENGTH + 2
    LDA #ascii(" ")                     ; ...and spaces a character past a name
.print_selected_blank
    JSR OSWRCH
    DEY
    BNE print_selected_blank
    BEQ print_selected_done
.print_selected_object
    ASL A
    ASL A
    TAY
    LDA object_icon, Y
    JSR print_object_name
.print_selected_done
    JSR print_inline
    EQUB VDU_COLOUR, COLOUR_BACKGROUND + 0
    NOP
    RTS

; Remember where the view is, in work4 and work5, for backpack_screen_done.
; Clobbers: A.
.save_view
    LDA view_x
    STA work4
    LDA view_y
    STA work5
    RTS

; Actions 7-10: a step left, right, up or down. Turn that way, then step into
; the next cell if it's empty, sulphur, or a pipe running this way, which
; carries the player along until it ends; a crate is pushed if the player has
; pushes left. Anything else stops the player: lava or fire kill. Inside a
; pipe the step goes on whatever's ahead (check_underfoot steers). After a
; step, the move ends the cycle (the walk moved everything four times
; already).
; In: Y = the action * 2; the carry clear.
.move
    TYA                                 ; (action - ACTION_LEFT) * 2...
    SBC #2 * ACTION_LEFT - 1            ; (the carry's clear)
    LSR A                               ; ...halved: the direction
    STA facing
    TAY
    LSR A                               ; the pipe that runs this way:
    CLC
    ADC #CELL_PIPE_ACROSS
    STA work4                           ; across for left and right, down for up and down
ASSERT DIRECTION_UP = 2 AND DIRECTION_DOWN = 3 AND CELL_PIPE_DOWN = CELL_PIPE_ACROSS + 1
    TYA
    LDX player_x
    LDY player_y
    JSR step                            ; the cell to step into...
    TXA
    PHA
    TYA
    PHA
    JSR look_at                         ; ...and what's there
    LDA pipe_move                       ; already in a pipe?
    BNE move_on
    LDA front_cell                      ; empty?
    BEQ move_on
    CMP work4                           ; a pipe this way?
    BEQ move_into_pipe
    CMP #CELL_SULPHUR                   ; something to collect?
    BEQ move_on
    JSR try_push                        ; a crate to push?
    BCS move_on
    LDA front_cell
    JSR check_deadly                    ; something in the way: lava or fire kill
    PLA                                 ; no step: drop the cell pushed
    PLA
    JMP draw_player

; Into a pipe: it carries the player on with this move.
.move_into_pipe
    JSR draw_player_at_done             ; (just an RTS)
    LDA facing                          ; carried on by this move
    CLC
    ADC #ACTION_LEFT
    STA pipe_move

; Unless a trigger has stopped the player (ACTION_STOP), step: walk the view a
; cell (walks, by direction), and see what's ahead now.
.move_on
    JSR think                           ; everything else moves
    LDA action                          ; a trigger said stop?
    BNE move_done
    PLA
    TAY
    PLA
    TAX
    STX player_x                        ; the step
    STY player_y
    LDA facing                          ; and the cell in front
    JSR step
    JSR look_at
    LDA facing                          ; the walk
    ASL A
    TAY
    LDX walks, Y
    LDA walks + 1, Y
    JSR jump_to
.move_done
    PLA                                 ; two bytes off the stack: after a step,
    PLA                                 ; the return to play_cycle, so this ends the
    JMP mark_monsters                   ; cycle; if stopped, the cell pushed

; The walk routines, by direction.
.walks
    EQUW walk_left
    EQUW walk_right
    EQUW walk_up
    EQUW walk_down

; Can the player push the crate in front of them? Only with pushes left, and
; only into an empty cell.
; In: A = the cell in front.
; Out: the carry set if it moved.
; Clobbers: A, X, Y, work0-work5 and the drawing variables.
.try_push
    CMP #CELL_CRATE
    BEQ try_push_crate
.no_push
    CLC
.try_push_done
    RTS
.try_push_crate
    LDA pushes_left                     ; no pushes left?
    BEQ no_push
    LDY facing
    JSR push_cell
    BCC try_push_return
    DEC pushes_left                     ; one fewer
.try_push_return
    RTS

; Push the cell in front of the player a cell further in direction Y, if the
; cell beyond is empty.
; Out: the carry set if it moved.
; Clobbers: A, X, Y, work0-work5 and the drawing variables.
.push_cell
    STY work2
    TYA
    LDX front_x                         ; the cell beyond the one in front
    LDY front_y
    JSR step
    JSR cell_at                         ; empty?
    BNE no_push
    LDX front_x
    LDY front_y
    LDA work2
    JSR move_cell
    SEC
    RTS

; What the player stands on, after the triggers have had their turn. On
; foot: sulphur is collected, and anything else that isn't floor kills
; (lava, fire, or whatever a trigger put there). In a pipe: at a junction,
; follow a pipe round a corner or straight on; ahead, a dead end, or a cell a
; pipe can't go into, turns the player back, and lava or fire kill.
; In: A = the cell underfoot.
; Clobbers: everything.
.check_underfoot
    STA work0
    LDX pipe_move                       ; in a pipe?
    BEQ underfoot_on_foot
    JSR check_pipe_end_in_pipe          ; out of it?
    LDX pipe_move
    BEQ try_push_done
    CMP #CELL_JUNCTION                  ; a junction?
    BNE pipe_check_ahead
    LDA #TURN_ANTICLOCKWISE * TURN_ROW  ; anticlockwise first
    STA work2

; Try turning anticlockwise, then clockwise, then straight on, for a pipe
; going that way.
.pipe_junction_turn
    LDA work2
    CLC
    ADC facing
    TAY
    LDA turns, Y                        ; a direction
    STA work0
    LDX #CELL_PIPE_ACROSS               ; across for left or right...
    CMP #DIRECTION_UP
    BCC pipe_junction_try
    INX                                 ; ...down for up or down
.pipe_junction_try
    STX work1
    LDX player_x
    LDY player_y
    JSR step
    JSR look_at                         ; the next cell that way
    CMP work1
    BEQ pipe_junction_found
    LDA work2                           ; then clockwise, then straight on
    SEC
    SBC #(TURN_ANTICLOCKWISE - TURN_CLOCKWISE) * TURN_ROW
    STA work2
    BNE pipe_junction_turn              ; (TURN_BACK: not tried)
    BEQ pipe_reverse                    ; no way on: turn back
ASSERT TURN_ANTICLOCKWISE - TURN_CLOCKWISE = TURN_CLOCKWISE - TURN_AHEAD AND TURN_BACK = 0
.underfoot_on_foot
    CMP #CELL_SULPHUR                   ; the thing to collect?
    BEQ collect
    TAX                                 ; anything else kills
    BNE kill_player
    RTS
.pipe_junction_found
    LDA work0                           ; the move that way
    ADC #ACTION_LEFT - 1                ; (the carry's set)
    STA pipe_move
    RTS
.pipe_check_ahead
    LDA front_cell                      ; the cell ahead: empty...
    BEQ check_deadly
    CMP #CELL_SULPHUR                   ; ...or to collect: carry on
    BEQ check_deadly
    CMP #CELL_LAVA                      ; walls, crates: blocked
    BCC pipe_reverse
    CMP #CELL_OBJECT                    ; lava or fire: as below; pipes: carry on
    BCC check_deadly
.pipe_reverse
    LDY pipe_move                       ; the reverse move
    LDA reverse_moves - ACTION_LEFT, Y
    STA pipe_move
    LDA #0                              ; (and on into check_deadly, harmlessly)
    STA work1

; Lava and fire kill.
; In: A = a cell type.
; Out: player_dead nonzero if it's deadly.
.check_deadly
    CMP #CELL_LAVA
    BEQ kill_player
    CMP #CELL_FIRE
    BNE check_deadly_done
.kill_player
    STA player_dead                     ; nonzero: dead
.check_deadly_done
    RTS

; At the start of the player's turn, before the triggers, what the player
; stands on: on foot, as check_underfoot (so that's done before the triggers
; and after); in a pipe, sulphur is collected, and on the floor, out of the
; pipe's end, the pipe lets go.
; In: A = the cell underfoot.
; Clobbers: everything.
.check_pipe_end
    LDX pipe_move
    BEQ underfoot_on_foot
.check_pipe_end_in_pipe
    CMP #CELL_SULPHUR
    BEQ collect
    TAX
    BNE check_deadly_done               ; out of the pipe
    STA pipe_move
    JMP draw_player

; Collect the sulphur the player stands on: a point, and when it's the last
; one needed, the player spins round four times to a falling arpeggio.
; Out: the carry clear.
; Clobbers: everything.
.collect
    LDA #0                              ; pipes let go
    STA pipe_move
    JSR clear_player_cell               ; it's gone
    JSR draw_player
    LDA #&B4                            ; a sound
    JSR sound_beep
    JSR add_point                       ; a point
    LDA to_collect                      ; the last one?
    BEQ check_deadly_done
    DEC to_collect
    BNE check_deadly_done
    STA clock_fraction
    STA work1
    LDA #16                             ; 16 turns
    STA work0
.collect_spin
    LDA facing                          ; anticlockwise
    CLC
    ADC #TURN_ANTICLOCKWISE * TURN_ROW
    TAY
    LDA turns, Y
    STA facing
    JSR draw_player
    LDA work1                           ; down &3F, wrapping round: four notes
    SEC                                 ; falling, then four from a semitone
    SBC #&3F                            ; higher, and so on
    STA work1
    JSR sound_tone
    LDY #&80                            ; a pause
    JSR delay
    DEC work0
    BNE collect_spin
    CLC
    RTS

; Action 7: put monster A AND 3 in map cell (A DIV 4, Y DIV 4) (its position
; in characters is A and Y with their low bits clear), going direction Y AND
; 3 with turning preferences X, and move its fire cell there. A monster
; that was gone comes back.
.action_move_monster
    JSR trigger_arguments
    STX work0
    PHA
    AND #MONSTERS - 1                   ; monster A AND 3
    ASL A                               ; * MONSTER_BYTES
    ASL A
    TAX
    LDA monster_x, X                    ; where it was, in cells
    LSR A
    LSR A
    STA work2
    LDA monster_y, X
    LSR A
    LSR A
    STA work3
    PLA
    AND #&FF - (CHARS_PER_CELL - 1)     ; where it goes
    STA monster_x, X
    LSR A
    LSR A
    STA work4
    TYA
    AND #&FF - (CHARS_PER_CELL - 1)
    STA monster_y, X
    LSR A
    LSR A
    STA work5
    TYA                                 ; its direction, in the bits that
    AND #3                              ; the position left over
    STA monster_direction, X
    LDA work0                           ; its turning preferences
    STA monster_turns, X
    LDA #CELL_FIRE                      ; move its mark, a fire cell
    BNE move_cell_type

; Move what's in map cell (X, Y) a cell in direction A, objects and all, over
; whatever is there, and draw both cells.
; Out: the carry set if the cell was empty (nothing moved).
; Clobbers: A, X, Y, work0-work5 and the drawing variables.
.move_cell
    STX work2
    STY work3
    JSR step                            ; the destination
    STX work4
    STY work5
    LDX work2
    LDY work3
    JSR cell_at                         ; what's here
    SEC                                 ; nothing: carry set
    BEQ move_cell_done
.move_cell_type
    PHA
    CMP #CELL_OBJECT                    ; an object?
    BNE move_cell_draw
    LDX work2
    LDY work3
    JSR find_object
    BCC move_cell_draw
.move_object
    LDA work4                           ; it moves too
    STA object_x, Y
    LDA work5
    STA object_y, Y
.move_cell_draw
    LDX work2
    LDY work3
    LDA #CELL_FLOOR                     ; empty where it was
    JSR set_cell_and_draw
    PLA
    LDX work4
    LDY work5                           ; and fill where it goes
    JSR set_cell_and_draw
    CLC
.move_cell_done
    RTS

; Read the keys into action, unless an action's waiting: P, D, M, CTRL, T and
; Return are actions 1-6 (the first pressed, from 6 down), the directions 7-10.
; The way the player faces walks on while its key is held; another direction
; counts only once its key has been let go since it was last down (and with
; the facing key not held, every direction key is forgotten as let go).
; Clobbers: A, X, Y, work0, work1.
.read_keys
    LDA action
    BNE move_cell_done
    LDA #ACTION_USE                     ; 6 action keys...
    STA action
.read_action_key
    LDY action
    LDX action_keys - 1, Y              ; ...tested from Return down to P
    JSR key_pressed
    BEQ move_cell_done
    DEC action
    BNE read_action_key
    LDY facing                          ; the way the player faces...
    CLC                                 ; ...may be held
    JSR test_move_key
    LDA action
    BNE read_move_keys
    JSR clear_keys_down                 ; no move: forget what was held
.read_move_keys
    LDY #DIRECTION_DOWN                 ; each direction key
.read_move_key
    SEC                                 ; a new direction must be pressed afresh
    JSR test_move_key
    DEY
    BPL read_move_key
    RTS

; Is direction key Y pressed? With the carry set it counts only if it wasn't
; down last time. Sets action to ACTION_LEFT + Y if it counts.
; Clobbers: A, X, Y, work0, work1.
.test_move_key
    ROL work1                           ; the carry into the mask's bit 0
    STY work0
    LDX key_left, Y
    JSR key_pressed
    BNE test_move_key_note
    LDY work0
    LDA keys_were_down, Y               ; held since last time?
    AND work1
    BNE move_cell_done
    TYA
    CLC
    ADC #ACTION_LEFT
    STA action
.test_move_key_note
    LDY work0                           ; remember: 1 if it's down
    TXA
    EOR #1
    STA keys_were_down, Y
    RTS

; Shrink the display to nothing by narrowing the CRTC's displayed area and
; moving its syncs to keep it centred, a frame at a time; then black and a
; clear screen.
; Clobbers: A, X, Y, work0, work1.
.close_view
    JSR pause
    LDY #40                             ; from 40 characters and rows to none
.close_view_step
    TYA
    LDX #CRTC_HORIZONTAL_DISPLAYED
    JSR set_crtc_register
    LSR A
    CLC
    ADC #45 - SCREEN_COLUMNS / 2        ; the sync kept centred (45 for 32)
    INX                                 ; CRTC_HSYNC_POSITION
    JSR set_crtc_register
    TYA
    LDX #CRTC_VERTICAL_DISPLAYED
    JSR set_crtc_register
    LSR A
    CLC
    ADC #34 - SCREEN_ROWS / 2           ; likewise (34 for 32)
    INX                                 ; CRTC_VSYNC_POSITION
    JSR set_crtc_register
    TYA
    JSR wait_vsync
    TAY
    DEY
    BPL close_view_step
    LDX #COLOUR_BLACK                   ; logical colour 0 black
    JSR vdu_palette
    JSR clear_screen                    ; and the CRTC back
ASSERT CRTC_HSYNC_POSITION = CRTC_HORIZONTAL_DISPLAYED + 1 AND CRTC_VSYNC_POSITION = CRTC_VERTICAL_DISPLAYED + 1

; Wait a moment: four (pause) or two (short_pause) delay loops of 65536
; turns.
; Clobbers: X, Y.
.pause
    JSR short_pause
.short_pause
    LDY #0
    JSR delay
    JMP delay

; All four levels done. If the last one was finished properly the palette goes
; wild for a while. Then the last level's edit code, "Praise and
; felicitations!", and for the locked (competition) mission played from the
; start, an entry code; wait for Space.
; Clobbers: everything.
.mission_done
    LDA #0
    JSR set_palette                     ; level 1's palette
    LDA stage
    CMP #STAGE_DONE                     ; the last level done properly?
    BCC mission_done_screen
    STA work0                           ; three times round
.mission_done_flash
    STA ULA_PALETTE                     ; any old colours...
    JSR wait_vsync
    CLC
    ADC #5                              ; ...through every combination
    BNE mission_done_flash
    DEC work0
    BNE mission_done_flash
    JSR set_palette                     ; back to level 1's
    JSR pause
    JSR pause
.mission_done_screen
    LDA #IO_LEVELS
    STA level                           ; the last level's edit code
    LDA #START_LIVES                    ; 3 lives' pictures; no mission text
    SEC
    JSR show_edit_code
    JSR print_inline
    TEXT_AT 6, 11
    EQUB VDU_COLOUR, 3
    EQUS "Praise"
    EQUB VDU_RIGHT
    EQUS "and"
    TEXT_AT 2, 12
    EQUS "felicitations!"
    NOP
    LDA io_locked                       ; the original, locked mission...
    BPL mission_done_wait
    LDA started_late                    ; ...played from level 1?
    BEQ show_entry_code
.mission_done_wait
    JMP wait_for_space

; The entry code: the score, scrambled, and a checksum of the whole of the
; mission's level data (io_attrs to the end of the maps) so the code shows
; which mission was played, printed in the 1-9, A-W alphabet: ten
; characters, in a box of background colour 2. In order: a digit of the
; checksum's sum, the score's low byte (two), four more of the checksum, one
; of the score mixed, and the score's high byte (two).
.show_entry_code
    JSR print_inline
    TEXT_AT 4, 19
    EQUS "Entry"
    EQUB VDU_RIGHT
    EQUS "code:-"
    EQUB VDU_COLOUR, COLOUR_BACKGROUND + 2, VDU_COLOUR, 1
    TEXT_AT 4, 22
    NOP
    LDA score_high                      ; the score, scrambled
    JSR scramble
    PHA
    LDA score
    JSR scramble
    PHA
    LDA #HI(io_attrs)                   ; the checksum runs from io_attrs...
    STA work5
    LDX #4
    LDA #0
.entry_code_clear
    STA work0, X
    DEX
    BPL entry_code_clear
    LDX #HI(io_graphics - 1) - HI(io_attrs) ; ...to the end of the maps
    LDY #LO(io_attrs)
    CLC
.entry_code_sum
    ROL A                               ; shift and mix
    ROR work0
    ROL work1
    ROR work2
    ROL work3
    BCC entry_code_add
    EOR work1
.entry_code_add
    ADC (work4), Y                      ; add a byte
    BCC entry_code_next
    INC work2
.entry_code_next
    INY
    BNE entry_code_sum
    INC work5
    DEX
    BPL entry_code_sum
    PHA
    LDA #ascii(" ")                     ; a space, in the box
    JSR OSWRCH
    PLA
    JSR print_code_digit
    PLA
    EOR #&AA                            ; the score's low byte...
    JSR print_code_byte
    LDX #3                              ; the checksum
.entry_code_print
    LDA work0, X
    JSR print_code_digit
    DEX
    BPL entry_code_print
    LDA score                           ; the score mixed
    ASL A
    ROL A
    EOR score_high
    JSR scramble
    JSR print_code_digit
    PLA
    EOR #&55                            ; ...and the high byte
    JSR print_code_byte
    JSR print_inline
    EQUS " "
    TEXT_AT 4, 21                       ; the box's top...
    NOP
    JSR print_12_spaces
    JSR print_inline
    TEXT_AT 4, 23                       ; ...and bottom
    NOP
    JSR print_12_spaces
    JSR print_inline
    EQUB VDU_COLOUR, COLOUR_BACKGROUND + 0
    NOP

; Wait for Space to be pressed and let go, then clear any Escape.
; Clobbers: A, X, Y.
.wait_for_space
    LDX #INKEY_TEST(KEY_SPACE)          ; Space down...
    JSR key_pressed
    BNE wait_for_space
.wait_for_space_up
    LDX #INKEY_TEST(KEY_SPACE)          ; ...and up
    JSR key_pressed
    BEQ wait_for_space_up

; Clear an Escape.
; Clobbers: A, X, Y.
.acknowledge_escape
    LDA #OSBYTE_ACKNOWLEDGE_ESCAPE
    JMP OSBYTE

; Print 12 spaces.
; Clobbers: A, X.
.print_12_spaces
    LDA #ascii(" ")
    LDX #12
.print_spaces_loop
    JSR OSWRCH
    DEX
    BNE print_spaces_loop
    RTS

; After a level: the backpack screen with the edit code of the level just
; finished (level is already the next level, and the codes are read from one
; before io_edit_code_*).
; In: A = the lives to show; the carry set to leave out the mission text.
; Clobbers: everything.
.show_edit_code
    JSR draw_backpack_screen
    JSR print_inline
    TEXT_AT 6, 16
    EQUB VDU_COLOUR, COLOUR_BACKGROUND + 1, VDU_COLOUR, 2
    EQUS "Edit code:"
    TEXT_AT 10, 17
    EQUB VDU_COLOUR, COLOUR_BACKGROUND + 0, VDU_COLOUR, 3
    NOP
    LDY level                           ; the level just finished's
    LDA io_edit_code_high - 1, Y
    JSR print_code_pair
    LDA io_edit_code_middle - 1, Y
    JSR print_code_pair
    LDA io_edit_code_low - 1, Y

; A byte of an edit code, unscrambled, as two digits.
; Clobbers: A, X, work0.
.print_code_pair
    JSR scramble
    LDX #3                              ; zeros print
    JMP print_bcd

; Is there an object at map cell (X, Y)?
; Out: the carry set, Y = its offset in objects and X its number, if so.
; Clobbers: A, work0, work1.
.find_object
    STX work0
    STY work1
    LDY #(OBJECTS - 1) * OBJECT_BYTES
    LDX #OBJECTS - 1
.find_object_loop
    LDA object_x, Y
    CMP work0
    BNE find_object_next
    LDA object_y, Y
    CMP work1
    BEQ find_object_done
.find_object_next
    DEY
    DEY
    DEY
    DEY
    DEX
    BPL find_object_loop
    CLC
.find_object_done
    RTS

; Never reached: a JMP to light_exit.
.unused_jump
    JMP light_exit

; Action 1, P: pick up the object in front into the selected slot, or the
; last free one; with nothing to collect left, in front of the exit, light
; it instead (light_exit).
; Clobbers: everything.
.pick_up
    JSR light_exit
    LDA front_cell
    CMP #CELL_OBJECT
    BNE action_done
    LDX backpack_slot
    LDA backpack, X
    BMI pick_up_into_slot
    LDX io_backpack_last                ; the selected slot's taken: the last free one
.pick_up_free_slot
    LDA backpack, X
    BMI pick_up_into_slot
    DEX
    BPL pick_up_free_slot
.action_done
    RTS                                 ; no room
.pick_up_into_slot
    STX backpack_slot
    LDX front_x
    LDY front_y
    JSR find_object                     ; the object in front
    BCC action_done
    LDA #OBJECT_ABSENT                  ; off the map
    STA object_x, Y
    LDY backpack_slot
    STX backpack, Y                     ; into the backpack
    LDX front_x
    LDY front_y
    LDA #CELL_FLOOR
    JMP set_cell_and_draw               ; and its cell's empty

; Action 2, D: drop the selected object (or any) into the empty cell in front.
; Clobbers: everything.
.drop
    LDY front_cell
    BNE action_done                     ; the cell in front must be empty
    JSR selected_object
    DEY                                 ; EMPTY_SLOT
    STY backpack, X
    STX backpack_slot
    LDX front_x
    LDY front_y

; Put object A at map cell (X, Y) and draw it.
; Clobbers: A, X, Y, work0-work5 and the drawing variables.
.put_object
    STX work2
    STX work4
    STY work3
    STY work5
    ASL A
    ASL A
    TAY
    LDA #CELL_OBJECT                    ; its cell's an object cell
    PHA
    JMP move_object

; The selected object, or if that slot's empty, the one in the highest slot;
; with none at all, return from the caller.
; Out: A = the object, X = its slot.
.selected_object
    LDX backpack_slot
    LDA backpack, X
    BPL selected_object_done
    LDX #BACKPACK_SLOTS - 1
.selected_object_any
    LDA backpack, X                     ; any object
    BPL selected_object_done
    DEX
    BPL selected_object_any
    PLA                                 ; none: return from the action
    PLA
.selected_object_done
    RTS

; Action 5, T: throw the selected object from the empty cell in front, the
; way the player faces, up to io_throw_distance cells (with 0, nothing can be
; thrown). OBJECT_NO_THROW doesn't stop it: see fly_thrown.
; Clobbers: everything.
.throw
    JSR selected_object
    STX backpack_slot
    STX work0
    TAX
    LDY io_throw_distance               ; nothing can be thrown
    BEQ throw_done
    LDA front_cell
    BNE throw_done                      ; the cell in front must be empty

; Throw object X Y cells from the cell in front: out of the backpack and off
; the map, flying as a sprite (move_things moves it a character at a time).
; In: work0 = its slot in the backpack.
; Out: the carry set if something was already in flight.
; Clobbers: A, X, Y.
.launch_object
    SEC                                 ; already something in flight?
    LDA thrown_direction
    BNE throw_done
    STX thrown_object
    STY throw_range
    ROR A                               ; (THROWN_NONE and the carry) &80: the slot's empty
    LDY work0
    STA backpack, Y
    LDA front_x                         ; from the cell in front, in characters
    ASL A
    ASL A
    STA thrown_x
    LDA front_y
    ASL A
    ASL A
    STA thrown_y
    TXA
    ASL A
    ASL A
    TAY
    LDA #OBJECT_ABSENT                  ; off the map
    STA object_x, Y
    JSR object_icon_picture             ; it flies as its icon
    STX thrown_picture
    STY thrown_picture_high
    LDX facing                          ; THROWN_*: the way the player faces, + 1
    INX
    STX thrown_direction
    CLC
.throw_done
    RTS

; Once a cycle (think): move a thrown object a cell. It lands when it runs
; out of range, comes to something that isn't empty, or would hit the player;
; the cell it lands against (in thrown_picture now: floor for the player or
; the end of its range) and its direction then count for its triggers
; (try_object_trigger goes to throw_trigger), unless it's OBJECT_NO_THROW.
; Unless used up, it lands in the empty cell it reached.
; Clobbers: everything.
.fly_thrown
    LDX thrown_x                        ; its cell
    LDY thrown_y
    JSR to_cell
    LDA thrown_direction                ; in flight?
    BEQ throw_done
    SEC
    SBC #1                              ; the direction
    PHA
    JSR step                            ; the next cell
    PLA
    CPX player_x                        ; the player?
    BNE fly_thrown_ahead
    LDA #CELL_FLOOR
    CPY player_y
    BEQ thrown_lands
.fly_thrown_ahead
    JSR cell_at                         ; empty?
    BNE thrown_lands
    DEC throw_range                     ; out of range?
    BNE throw_done
.thrown_lands
    STA thrown_picture                  ; what it hit, for its triggers
    LSR thrown_x                        ; its cell
    LSR thrown_x
    LSR thrown_y
    LSR thrown_y
    LDX thrown_x
    LDY thrown_y
    LDA #CELL_FLOOR                     ; rub out its sprite
    JSR set_cell_and_draw
    LDA #LO(throw_trigger)              ; its triggers are throw triggers
    STA try_object_trigger_jump + 1
    LDA #HI(throw_trigger)
    STA try_object_trigger_jump + 2
    DEC thrown_direction                ; its direction
    LDX thrown_object
    TXA
    PHA
    ORA #&80                            ; landing (find_carried looks for this)
    STA thrown_object
    ASL A
    ASL A
    TAY
    LDA object_flags, Y                 ; its flags
    SEC
    BMI thrown_landed                   ; OBJECT_NO_THROW: no triggers
    JSR fire_object_triggers
.thrown_landed
    LDX #THROWN_NONE
    STX thrown_direction
    DEX
    STX thrown_object
    PLA
    BCC throw_done                      ; gone?
    LDX thrown_x                        ; it lands
    LDY thrown_y
    JMP put_object

; Try object X's triggers (X, X + OBJECTS, X + 2 * OBJECTS, X + 3 *
; OBJECTS), through use_trigger or throw_trigger, as patched into
; try_object_trigger. If one fires, a use is used: OBJECT_NO_CHARGES's never
; run out, and an OBJECT_VANISHES object with none left is gone.
; In: A = its uses and flags.
; Out: the carry clear if the object's gone. With the carry set: A negative
; if its triggers were tried and none fired; A = 0 if it had no uses left,
; and none were tried.
; Clobbers: everything.
.fire_object_triggers
    AND #OBJECT_USES                    ; no uses left: nothing
    SEC
    BEQ throw_done
    LDA #0
    STA triggers_fired
    TXA
    PHA
    JSR try_object_trigger
    PLA
    PHA
    ORA #1 * OBJECTS                    ; its four triggers
    JSR try_object_trigger
    PLA
    PHA
    ORA #2 * OBJECTS
    JSR try_object_trigger
    PLA
    PHA
    ORA #3 * OBJECTS
    JSR try_object_trigger
    PLA
    TAX
    ASL A
    ASL A
    TAY
    LDA triggers_fired                  ; did any fire?
    BEQ fire_object_nothing
    LDA object_flags, Y
    PHA
    AND #OBJECT_VANISHES OR OBJECT_NO_THROW
    STA work0
    PLA
    AND #OBJECT_USES
    BEQ fire_object_uses
    CMP #OBJECT_NO_CHARGES              ; 32 and up: never used up
    BCS fire_object_done
    SBC #0                              ; a use less (the carry's clear)
.fire_object_uses
    SEC
    PHA
    ORA work0
    STA object_flags, Y
    PLA
    BNE fire_object_done
    LDA work0
.fire_object_vanishes
    AND #OBJECT_VANISHES                ; used up: does it go?
    BEQ fire_object_done
    CLC
.fire_object_done
    RTS
ASSERT OBJECT_VANISHES = &40            ; for bit6_mask
.fire_object_nothing
    SEC
    LDA #&80
    RTS
.try_object_trigger
    LDY #PUZZLE_USES_OBJECT             ; triggers fired by an object
.try_object_trigger_jump
    JMP do_nothing                      ; self-modified: use_trigger or throw_trigger

; Action 6, Return: use the selected object where the player stands, facing
; the way they do.
; Clobbers: everything.
.use
    JSR selected_object
    STX backpack_slot
    LDX #LO(use_trigger)                ; its triggers are use triggers
    STX try_object_trigger_jump + 1
    LDX #HI(use_trigger)
    STX try_object_trigger_jump + 2
    TAX
    ASL A
    ASL A
    TAY
    LDA object_flags, Y
    JSR fire_object_triggers            ; fire them
    BMI delay_done                      ; none fired
    BCS use_pause                       ; kept
    ASL A                               ; gone: OBJECT_VANISHES * 2, an empty slot
    LDX backpack_slot
    STA backpack, X
.use_pause
    LDY #&C0

; Wait Y * 256 turns of a DEX loop (Y = 0: 65536).
; Clobbers: X, Y.
.delay
    LDX #0
.delay_loop
    DEX
    BNE delay_loop
    DEY
    BNE delay_loop
.delay_done
    RTS

; Try trigger A for a thrown object that has landed: one fired by an object
; (PUZZLE_USES_OBJECT), not fired already (PUZZLE_OFF), at the cell it landed
; in (or anywhere along an IGNORE coordinate), and meeting the condition: the
; direction it flew, the cell type it landed against.
; Clobbers: everything.
.throw_trigger
    TAX
    LDA trigger_flags, X                ; fired by an object...
    EOR #PUZZLE_USES_OBJECT             ; ...not yet fired
    AND #PUZZLE_USES_OBJECT OR PUZZLE_OFF
    BNE delay_done
    INC triggers_fired                  ; tried
    TXA
    ASL A
    TAY
    LDA trigger_places, Y               ; where it is
    BMI throw_trigger_y                 ; anywhere across?
    CMP thrown_x                        ; where it landed?
    BNE trigger_no_match
.throw_trigger_y
    LDA trigger_places + 1, Y
    BMI throw_trigger_condition
    CMP thrown_y
    BNE trigger_no_match
.throw_trigger_condition
    TYA
    ASL A
    TAY                                 ; the trigger * 4, for trigger_args
    LDA trigger_condition, Y            ; the condition
    STA work0
    BPL throw_trigger_cell              ; CONDITION_CHECK_DIRECTION?
    AND #CONDITION_DIRECTION
    LSR A
    LSR A
    LSR A
    LSR A
    CMP thrown_direction                ; the way it flew?
    BNE trigger_no_match
    LDA work0
.throw_trigger_cell
    BIT bit6_mask                       ; CONDITION_CHECK_CELL?
    BEQ throw_trigger_fires
    AND #CONDITION_CELL
    CMP thrown_picture                  ; what it landed against?
    BNE trigger_no_match

; It fires: its action works on the cell the object hit, beyond where it
; landed (front_x, front_y), with that cell's type and the direction it flew.
.throw_trigger_fires
    STY work0
    LDA thrown_picture
    STA work5
    STX work4
    LDX thrown_x
    LDY thrown_y
    LDA thrown_direction
    JSR step                            ; the cell beyond
    STX front_x
    STY front_y
    LDX work4
    LDY work0
    LDA thrown_direction
    BPL trigger_fires

; Try trigger A for the player: one fired by walking onto it, or by using an
; object (Y), not fired already, where the player is (or anywhere along an
; IGNORE coordinate), and meeting the condition: the way the player faces,
; the type of the cell in front.
; In: Y = 0 for walking, PUZZLE_USES_OBJECT for an object used.
; Clobbers: everything.
.use_trigger
    INC triggers_fired                  ; tried
    TAX
    TYA                                 ; walked on or used, matching...
    EOR trigger_flags, X
    AND #PUZZLE_USES_OBJECT OR PUZZLE_OFF ; ...and not yet fired
    BNE trigger_no_match
    TXA
    ASL A
    TAY
    LDA trigger_places, Y               ; where it is
    BMI use_trigger_y                   ; anywhere across?
    CMP player_x                        ; where the player is?
    BNE trigger_no_match
.use_trigger_y
    LDA trigger_places + 1, Y
    BMI use_trigger_condition
    CMP player_y
    BNE trigger_no_match
.use_trigger_condition
    TYA
    ASL A
    TAY                                 ; the trigger * 4, for trigger_args
    LDA trigger_condition, Y            ; the condition
    STA work0
    BPL use_trigger_cell                ; CONDITION_CHECK_DIRECTION?
    AND #CONDITION_DIRECTION
    LSR A
    LSR A
    LSR A
    LSR A
    CMP facing                          ; the way the player faces?

; (throw_trigger's misses come here too.)
.trigger_no_match
    BNE trigger_fails
    LDA work0
.use_trigger_cell
    BIT bit6_mask                       ; CONDITION_CHECK_CELL?
    BEQ use_trigger_fires
    AND #CONDITION_CELL
    CMP front_cell                      ; the cell in front?
    BNE trigger_fails
.use_trigger_fires
    LDA front_cell
    STA work5
    LDA facing

; The trigger fires, if PUZZLE_COUNTS_COLLECTS doesn't hold it back until
; everything's collected; unless it's PUZZLE_REUSABLE, it's marked PUZZLE_OFF
; (before its action, so one whose action fails is spent all the same). Its
; action, the flags' low nibble, gets the trigger's arguments (Y = the
; trigger * 4, for trigger_arguments), the cell it's facing in work5 and the
; direction in work4. Then front_x, front_y and front_cell are looked at
; again.
; In: A = the direction; X = the trigger; Y = the trigger * 4.
.trigger_fires
    STA work4
    LDA trigger_flags, X
    STA work2
    BIT bit6_mask                       ; PUZZLE_COUNTS_COLLECTS?
    BEQ trigger_once
    LDA to_collect
    BNE trigger_fails
    LDA work2
.trigger_once
    BIT bit4_mask                       ; PUZZLE_REUSABLE?
    BNE trigger_action
    ORA #PUZZLE_OFF
    STA trigger_flags, X
.trigger_action
    AND #PUZZLE_ACTION
    ASL A
    TAX
    LDA trigger_actions, X
    STA trigger_action_call + 1         ; self-modify the JSR
    LDA trigger_actions + 1, X
    STA trigger_action_call + 2
.trigger_action_call
    JSR do_nothing                      ; self-modified: the action
    JMP find_front                      ; and look again

; Action 1: move the cell at (X, Y) a cell in direction A.
.action_move_cell
    JSR trigger_arguments
    JSR move_cell                       ; carry set: nothing moved
    BCS trigger_fails
    BCC sound_trigger

; An action that doesn't happen, after it's pushed a byte or two (or with its
; return address to drop): the trigger didn't fire after all.
.trigger_fails_pop2
    PLA
.trigger_fails_pop
    PLA
.trigger_fails
    DEC triggers_fired                  ; it didn't fire after all
.light_exit_done
    RTS

; Action 14: push the cell in front, direction A (a TURN_* times TURN_ROW)
; turned from the way the player faces.
.action_push
    JSR front_blocked
    BCS trigger_fails_pop2
    JSR trigger_arguments
    ADC work4                           ; turned from the way the player faces (the carry's clear)
    TAX
    LDY turns, X
    JSR push_cell
    BCC trigger_fails
    BCS sound_trigger

; In front of the exit, with nothing left to collect and the exit not lit
; yet: light it. The exit becomes fire, and the player has a few ticks to get
; away.
; Clobbers: everything.
.light_exit
    LDA front_x
    CMP exit_x
    BNE light_exit_done
    LDA front_y
    SBC exit_y                          ; carry set by the CMP
    ORA to_collect                      ; everything collected...
    ORA stage                           ; ...and not lit yet
    BNE light_exit_done
    STA clock_fraction                  ; the clock starts afresh
    INC stage                           ; STAGE_EXIT_LIT
    LDX #ENVELOPE_VOICE_1
    LDA #4
    JSR sound_effect
    LDA #CELL_FIRE                      ; the exit is fire
    BNE set_front_cell

; Action 2: the cell in front becomes type A.
.action_set_front
    JSR front_blocked
    BCS trigger_fails_pop2
    JSR sound_trigger
    JSR trigger_arguments
.set_front_cell
    LDX front_x
    LDY front_y
    JMP set_cell_and_draw

; Action 5: object A explodes, wherever it is: on the map, landing, or in the
; backpack, which kills the player. The trigger's third argument is the
; object * 4 (the Level Designer stores it so), its offset in objects.
.action_explode
    JSR trigger_arguments
    JSR find_carried                    ; carried or landing?
    BEQ explode_carried
    LDA object_x, Y                     ; where it is
    PHA
    TAX
    LDA object_y, Y
    PHA
    TAY
    JSR cell_at                         ; still there?
    CMP #CELL_OBJECT
    BNE trigger_fails_pop2
    PLA
    TAY
    PLA
    TAX
.explode_at
    JSR blast

; Sound effects on the noise channel: sound_effect with envelope X, pitch and
; duration A; sound_effect_4 with envelope 4; sound_trigger, a trigger's
; noise; sound_effect_pitch, setting only the pitch. Not with effects_off.
; Clobbers: A, X. Preserves Y.
.sound_trigger
    LDA #6
.sound_effect_4
    LDX #ENVELOPE_BEEP
.sound_effect
    STA sound_duration
.sound_effect_pitch
    STA sound_pitch
    STX sound_amplitude                 ; envelope
    LDA #SOUND_FLUSH + CHANNEL_NOISE
    STA sound_channel
.make_sound
    LDA effects_off                     ; sound effects off?
    BNE make_sound_done
    TYA
    PHA
    LDY #0
    STY sound_channel_high
    LDX #LO(sound_channel)
    LDA #OSWORD_SOUND
    JSR OSWORD
    PLA
    TAY
.make_sound_done
    RTS
.explode_in_flight
    LDX thrown_x                        ; where it landed
    LDY thrown_y
    BPL explode_at
.explode_carried
    BCC explode_in_flight
    LDA #EMPTY_SLOT                     ; it's gone from the backpack...
    STA backpack, X
    LDX player_x                        ; ...where the player is
    LDY player_y

; Empty the 9 cells round map cell (X, Y), and if the player's in one of
; them, they die.
; Clobbers: A, X, Y, work0-work4 and the drawing variables.
.blast
    LDA #DIRECTION_NONE                 ; the eight neighbours and the cell itself
    STA work4
    STX work2
    STY work3
.blast_cell
    LDX work2
    LDY work3
    LDA work4
    JSR step
    CPX player_x
    BNE blast_empty
    CPY player_y
    BNE blast_empty
    INC player_dead                     ; caught in it
.blast_empty
    LDA #CELL_FLOOR
    JSR set_cell_and_draw
    DEC work4
    BPL blast_cell
    RTS

; Action 3: before the exit's lit, set the clock to X (unless A has
; SET_LEVELS_KEEP_TIME) and the number to collect to Y (unless it has
; SET_LEVELS_KEEP_COLLECTS).
; Clobbers: everything.
.action_set_clock
    JSR trigger_arguments
    PHA
    LDA stage
    BNE action_fails                    ; only before the exit's lit
    PLA
    BMI set_clock_collect               ; SET_LEVELS_KEEP_TIME
    STX time_left
.set_clock_collect
    LSR A
    BCS set_clock_sound                 ; SET_LEVELS_KEEP_COLLECTS
ASSERT SET_LEVELS_KEEP_TIME = &80 AND SET_LEVELS_KEEP_COLLECTS = &01
    STY to_collect
.set_clock_sound
    LDA #&96

; Sound effects on channel 3: pitch A, with envelope 3 for 8 twentieths of a
; second, or (sound_beep) envelope 4 for 10. Not with effects_off.
; Clobbers: A, X. Preserves Y.
.sound_tone
    STA sound_pitch
    LDA #ENVELOPE_TONE
    LDX #8
.sound_channel_3
    STA sound_amplitude
    STX sound_duration
    LDA #SOUND_FLUSH + CHANNEL_EFFECTS
    STA sound_channel
    BNE make_sound
.sound_beep
    STA sound_pitch
    LDA #ENVELOPE_BEEP
    LDX #10
    BNE sound_channel_3
.action_fails
    JMP trigger_fails_pop

; Action 0: map cell (X, Y) becomes type A.
.action_set_cell
    JSR trigger_arguments
    JSR set_cell_and_draw
    JMP sound_trigger

; Action 13: the player may push A crates.
.action_set_pushes
    JSR trigger_arguments
    STA pushes_left
    LDA #&50
    BNE sound_tone

; Action 15: swap the left and right keys, and up and down, for the rest of
; the level.
.action_swap_keys
    LDX key_down
    LDA key_up
    STA key_down
    STX key_up
    LDX key_right
    LDA key_left
    STA key_right
    STX key_left
    LDA #ACTION_NONE
    STA action
    LDA #&35
    BNE sound_tone

; Action 12: give object A Y uses (unless it's the object landing, whose
; triggers these are), and re-enable trigger A, the object's first; with a
; flash.
.action_recharge
    JSR trigger_arguments
    JSR find_carried                    ; landing?
    PHA
    BMI action_fails
    ASL A
    ASL A
    TAX
    STY work0
    LDA object_flags, X                 ; Y uses, its flags (and NO_CHARGES) kept
    AND #OBJECT_NO_CHARGES OR OBJECT_VANISHES OR OBJECT_NO_THROW
    ORA work0
    STA object_flags, X
    LDA #1                              ; a flash
    TAX
    JSR flash_palette_times
    PLA
    TAY
    BPL enable_trigger

; Action 10: re-enable triggers A, X and Y.
.action_enable
    JSR trigger_arguments
    PHA
    JSR enable_trigger
    TXA
    TAY
    JSR enable_trigger
    PLA
    TAY
.enable_trigger
    LDA trigger_flags, Y
    AND #&FF - PUZZLE_OFF
    STA trigger_flags, Y
    RTS

; Is object A the one landing (whose triggers are being tried), or in the
; backpack? An object still in flight is neither.
; Out: landing, Z set and the carry clear; in the backpack, Z and the carry
; set and X its slot; else Z clear and the carry set. A = the object, + &80
; if landing.
.find_carried
    ORA #&80                            ; landing?
    CMP thrown_object
    CLC
    BEQ find_carried_done
    SBC #&7F                            ; (the carry's clear: - &80)
    LDX #BACKPACK_SLOTS - 1
.find_carried_loop
    CMP backpack, X                     ; in the backpack?
    BEQ find_carried_done
    DEX
    BPL find_carried_loop
    SEC
.find_carried_done
    RTS

; Action 11: disable triggers A, X and Y.
.action_disable
    JSR trigger_arguments
    PHA
    JSR disable_trigger
    TXA
    TAY
    JSR disable_trigger
    PLA
    TAY
.disable_trigger
    LDA trigger_flags, Y
    ORA #PUZZLE_OFF
    STA trigger_flags, Y
    RTS

; Action 6: monster X / 4 goes direction A: MONSTER_GONE or more takes it off
; the map, for 26 points (score_monster). X = &10 means all four, but only
; monster 3 gets A: set_monster_direction leaves A changed, and the loop
; passes the next monster its predecessor's X, so monsters 2 and 1 get 12 and
; 8 (gone) and monster 0 gets 4, stuck going left, which it soon moves out
; of. (No trigger in the shipped mission asks for all four.)
.action_set_monster
    JSR sound_trigger
    JSR trigger_arguments
    CPX #MONSTERS * MONSTER_BYTES       ; all of them?
    BEQ set_all_monsters
.set_monster_direction
    LDY monster_direction, X            ; its old direction
    STA monster_direction, X
    TYA
    EOR #MONSTER_GONE                   ; was out and now isn't?
    AND monster_direction, X
    CMP #MONSTER_GONE
    BCC set_monster_done
    STX work4
    JSR empty_monster_cell              ; off the map...
    JSR score_monster                   ; ...for 26 points
    LDX work4
.set_monster_done
    RTS
.set_all_monsters
    DEX                                 ; monsters 3 to 0
    DEX
    DEX
    DEX
    JSR set_monster_direction
    TXA
    BNE set_all_monsters
    RTS

; Action 9: the cell in front changes from type A to X, or X to A.
; In: Y = the trigger * 4.
.action_toggle
    INY
    LDA work5                           ; the cell in front
    CMP trigger_args - 1, Y             ; A?
    BEQ action_toggle_set
    DEY
    CMP trigger_args + 1, Y             ; X?
    BEQ action_toggle_set
.action_toggle_fails
    JMP trigger_fails
.action_toggle_set
    JSR sound_trigger
    LDA trigger_args, Y                 ; the other
    PHA
    LDX front_x
    LDY front_y
    PLA
    JMP set_cell_and_draw

; Action 4: throw object A (carried) Y cells, from the empty cell in front,
; and stop the player's step.
.action_launch
    LDA work5                           ; the cell in front must be empty
    BNE action_toggle_fails
    JSR trigger_arguments
    JSR find_carried                    ; carried?
    BNE action_toggle_fails
    STX work0                           ; its slot
    TAX
    JSR launch_object                   ; throw it
    BCS action_toggle_fails
    LDA #ACTION_STOP                    ; no step
    STA action
    LSR A                               ; noise 5
    LDX #ENVELOPE_TONE
    JMP sound_effect

; Action 8: teleport the view's top left to cell (X, Y), so the player to
; (X + 4, Y + 4), which is also where the level restarts from now, with a
; flash; and stop the player's step.
.action_teleport
    LDA #ACTION_STOP
    STA action
    JSR trigger_arguments
    JSR place_player                    ; move the view and the player
    LDX #ENVELOPE_BEEP
    LDA #2
    JSR sound_effect                    ; a sound...
    LDA #2                              ; ...two flashes, 4 frames a colour...
    LDX #4
    JSR flash_palette_times
    JSR clear_screen                    ; ...and the view redrawn
    LDA #0
    LDX #ENVELOPE_BEEP
    JSR sound_effect_pitch
    JMP redraw_view

; Look at the cell in front, preserving Y.
; Out: front_cell; the carry set if it's the exit or off the map.
; Clobbers: A, X, cell_x, cell_y, map_pointer, cell_low_nibble.
.front_blocked
    TYA
    PHA
    JSR look_at_front
    PLA
    TAY
    RTS

; Trigger Y / 4's arguments.
; Out: A, X and Y = its first three arguments.
.trigger_arguments
    LDA trigger_args, Y
    PHA
    LDA trigger_args + 1, Y
    TAX
    LDA trigger_args + 2, Y
    TAY
    PLA
    RTS

; Monster X / 4's map cell.
; Out: X, Y.
; Clobbers: A.
.monster_cell
    LDY monster_y, X
    LDA monster_x, X
    TAX

; Character position (X, Y) to map cell (X, Y).
; Clobbers: A.
.to_cell
    TXA
    LSR A
    LSR A
    TAX
    TYA
    LSR A
    LSR A
    TAY
.monster_think_done
    RTS

; Decide where a monster goes next. If its fire cell has gone (something's
; been put there), it's gone, for 26 points. Otherwise it tries up to four
; ways, each a 2-bit field of its turns (from the bottom) picking from turns:
; back, ahead, clockwise or anticlockwise. It goes into an empty cell or an
; object's; if the cell is what it eats (monster_food) it turns that into
; what it leaves, and is gone. If it can't go anywhere it's stuck.
; In: work0-work3 = its x, y, direction and turns; work4 = its number.
; Clobbers: everything.
.monster_think
    LDA work2
    CMP #MONSTER_GONE
    BCS monster_think_done              ; not out?
    AND #3                              ; stuck or not, the way it was going
    STA work2
    LDA #DIRECTION_NONE                 ; its own cell
    JSR cell_beside_monster
    CMP #CELL_FIRE                      ; still fire?
    BNE monster_gone
    LDA #%11                            ; the first field
    STA work5
.monster_try_turn
    LDA work5
    LDY #0
.monster_turn_field
    INY                                 ; find the field...
    LSR A
    BCC monster_turn_field
    LDA work5                           ; ...and take it
    AND work3
.monster_turn_shift
    LSR A
    DEY
    BNE monster_turn_shift
    ROL A                               ; back, ahead, clockwise, anticlockwise...
    ASL A                               ; ...* TURN_ROW
    ASL A
ASSERT TURN_ROW = 4
    ADC work2
    TAY
    LDA turns, Y                        ; the way to try
    PHA
    JSR cell_beside_monster             ; what's there
    BEQ monster_set_direction           ; empty: go
    CMP #CELL_OBJECT
    BEQ monster_set_direction           ; an object: go
    EOR monster_food                    ; food?
    AND #&0F
    BEQ monster_eats
    ASL work5                           ; the next field
    ASL work5
    PLA
    BCC monster_try_turn                ; none left?
    LDA work2                           ; stuck
    ORA #MONSTER_STUCK
    PHA
.monster_set_direction
    LDA work4
    ASL A
    ASL A
    TAX
    PLA
    STA monster_direction, X
    RTS
.monster_eats
    LDA #&66                            ; a sound
    JSR sound_tone
    PLA
    TAY
    JSR step_from_monster               ; the cell it eats...
    LDA monster_food                    ; ...becomes what it leaves
    LSR A
    LSR A
    LSR A
    LSR A
    JSR set_cell_and_draw
    LDA work4
    ASL A
    ASL A
    TAX
    JSR empty_monster_cell              ; and the monster's cell empty
.monster_gone
    LDA #MONSTER_GONE
    PHA
    JSR score_monster                   ; 26 points
    JMP monster_set_direction

; What's in the cell beside the monster (work0, work1) in direction A
; (DIRECTION_NONE: its own).
; Out: A, Z and carry as cell_at.
; Clobbers: as cell_at.
.cell_beside_monster
    JSR step_from_monster
    JMP cell_at
.step_from_monster
    PHA
    LDX work0
    LDY work1
    JSR to_cell
    PLA

; One step in direction A from map cell (X, Y).
; Out: X, Y.
; Clobbers: A.
.step
    STY step_y                          ; (a spare byte in the stack page)
    TAY
    TXA
    CLC
    ADC direction_dx, Y
    TAX
    LDA step_y
    CLC
    ADC direction_dy, Y
    TAY
    RTS

; Add points to the score, in BCD: score_monster 26 (25 was surely meant),
; add_points X + 1 (with X = 0, 257), add_point 1. add_points runs into
; add_point after its loop, hence the one more.
; Clobbers: A, X.
.score_monster
    LDX #25
.add_points
    JSR add_point
    DEX
    BNE add_points
.add_point
    SED                                 ; BCD
    LDA score
    CLC
    ADC #1
    STA score
    LDA score_high
    ADC #0
    STA score_high
    CLD
    RTS

; L on the title screen: ask for a mission file name (up to 12 characters, in
; a box between arrows) and load it.
.ask_for_mission
    JSR draw_title_screen
    JSR print_inline
    TEXT_AT 6, 11
    EQUB VDU_COLOUR, COLOUR_BACKGROUND + 1, VDU_COLOUR, 2
    EQUS "Filename ?"
    TEXT_AT 30, 15
    EQUS "<"                            ; "<" at the right...
    EQUB VDU_BACKSPACE, VDU_BACKSPACE   ; ...back past it and blank the box
FOR n = 1..FILENAME_LENGTH
    EQUB VDU_DELETE                     ; (in colour 1) leftwards...
NEXT
    EQUB VDU_BACKSPACE, VDU_BACKSPACE
    EQUS ">"                            ; ...">" at the left...
    EQUB VDU_RIGHT                      ; ...and the cursor at the box's start
    NOP
    LDA #OSWORD_READ_LINE
    LDX #LO(read_line_block)
    LDY #HI(read_line_block)
    JSR OSWORD
    JSR load_mission                    ; load it
    JMP title_screen

; Load the mission file named at mission_filename (":0.$.IO" unless the
; player has asked for another) to io_start. The game has taken the DFS's
; workspace at &0E00-&10FF (and the NMI area and extended vectors), so first
; swap SWAP_START to SWAP_END out of the way into the screen, put an RTI
; where the NMI handler goes, put back the extended vectors the loader saved,
; and ask the filing systems to claim their workspace again (service calls 1
; and 2), then *DISK. Output is turned off while the file loads, then the game
; is swapped back. The display is off throughout.
; Clobbers: A, X, Y, work0-work3.
.load_mission
    JSR blank_display
    STA furthest_level                  ; A = 0: no starting late on a new mission
    JSR swap_memory                     ; the game's code out of the way
    LDA #OPCODE_RTI
    STA MOS_NMI_ROUTINE                 ; NMIs are ignored until the DFS sets them up
    LDY #&100 - LO(MOS_EXTENDED_VECTORS) - 1
.load_mission_vectors
    LDA saved_extended_vectors, Y       ; the extended vectors back
    STA MOS_EXTENDED_VECTORS, Y
    DEY
    BPL load_mission_vectors
    LDA #OSBYTE_SERVICE_CALL
    LDX #SERVICE_CLAIM_ABSOLUTE
    LDY #&0E                            ; (the page the claims start from)
    JSR OSBYTE
    LDX #SERVICE_CLAIM_PRIVATE
    LDY #&10
    JSR OSBYTE
    LDX #LO(disk_command)
    LDY #HI(disk_command)
    JSR OSCLI                           ; *DISK
    LDY #osfile_block - osfile_block_template - 1
.load_mission_block
    LDA osfile_block_template, Y
    STA osfile_block, Y
    DEY
    BPL load_mission_block
    LDA #VDU_DISABLE                    ; no output...
    JSR OSWRCH
    LDX #LO(osfile_block)
    LDY #HI(osfile_block)
    LDA #OSFILE_LOAD
    JSR OSFILE
    LDA #VDU_ENABLE                     ; ...output again
    JSR OSWRCH

; Swap SWAP_START to SWAP_END with as much of the screen from SCREEN.
; Clobbers: A, X, Y, work0-work3.
.swap_memory
    LDY #0
    STY work0
    STY work2
    LDA #HI(SCREEN)
    STA work1
    LDA #HI(SWAP_START)
    STA work3
    LDX #SWAP_PAGES
.swap_memory_loop
    LDA (work0), Y
    PHA
    LDA (work2), Y
    STA (work0), Y
    PLA
    STA (work2), Y
    INY
    BNE swap_memory_loop
    INC work1
    INC work3
    DEX
    BNE swap_memory_loop
    RTS

; What runs while the game's swapped out must be outside the swap, and what
; error_handler looks at to tell inside it.
ASSERT load_mission >= SWAP_END AND osfile_block_template >= SWAP_END AND error_handler >= SWAP_END
ASSERT flash_palette_cycle >= SWAP_START AND flash_palette_cycle < SWAP_END

; OSFILE's parameter block: the file name's address, the load address
; io_start, an execution address of 0 (whose low byte 0 says to load at that
; address) and the rest unused; copied to osfile_block before each load
; since OSFILE writes into it.
.osfile_block_template
    EQUW mission_filename
    EQUD io_start, 0, 0, 0
.osfile_block
    SKIP osfile_block - osfile_block_template

; The mission file's name, and OSWORD 0's block for reading another into it:
; up to FILENAME_LENGTH characters, from space to &FF.
.mission_filename
    EQUS ":0.$.IO     ", CR
ASSERT P% - mission_filename = FILENAME_LENGTH + 1
.read_line_block
    EQUW mission_filename
    EQUB FILENAME_LENGTH, ascii(" "), &FF
.disk_command
    EQUS "DISK", CR

; BRKV: an error (from the filing system, loading a mission). If it happened
; while the game's code was swapped out (a sample of it isn't where it
; should be), swap it back; then show the error and "Press SPACE:" on the
; title screen, and start again from the title.
.error_handler
    LDA flash_palette_cycle             ; LDX #COLOUR_WHITE here means the code is in place
    CMP #OPCODE_LDX_IMMEDIATE
    BNE error_handler_swap_back
    LDA flash_palette_cycle + 1
    CMP #COLOUR_WHITE
    BEQ error_handler_message
.error_handler_swap_back
    JSR swap_memory
.error_handler_message
    JSR flush_buffers
    JSR draw_title_screen
    JSR print_inline
    TEXT_AT 4, 15
    EQUS "Press"
    EQUB VDU_RIGHT
    EQUS "SPACE:"
    TEXT_AT 2, 11                       ; the error message
    NOP
    LDY #1                              ; past the error number
    LDA MOS_ERROR_PTR
    STA work0
    LDA MOS_ERROR_PTR + 1
    STA work1
.error_handler_print
    LDA (work0), Y
    BEQ error_handler_done
    CMP #ascii(" ")                     ; spaces as cursor movement, control codes left out
    BCC error_handler_next
    BNE error_handler_char
    LDA #VDU_RIGHT
.error_handler_char
    JSR OSWRCH
.error_handler_next
    INY
    BNE error_handler_print
    INC work1
    BNE error_handler_print
.error_handler_done
    JSR wait_for_space
    LDX #&FF                            ; the stack's no use after an error
    TXS
    JMP new_game

; The triggers' actions, by the low nibble of their flags (PUZZLE_*).
.trigger_actions
    EQUW action_set_cell
    EQUW action_move_cell
    EQUW action_set_front
    EQUW action_set_clock
    EQUW action_launch
    EQUW action_explode
    EQUW action_set_monster
    EQUW action_move_monster
    EQUW action_teleport
    EQUW action_toggle
    EQUW action_enable
    EQUW action_disable
    EQUW action_recharge
    EQUW action_set_pushes
    EQUW action_push
    EQUW action_swap_keys
ASSERT P% - trigger_actions = 2 * (PUZZLE_ACTION + 1)

; The player's actions, by action number (ACTION_*): nothing, P, D, M, CTRL,
; T, Return, the four directions, and nothing again when a trigger has
; stopped the player.
.action_table
    EQUW clear_keys_down
    EQUW pick_up
    EQUW drop
    EQUW map_screen
    EQUW backpack_screen
    EQUW throw
    EQUW use
    EQUW move
    EQUW move
    EQUW move
    EQUW move
    EQUW clear_keys_down
ASSERT P% - action_table = 2 * (ACTION_STOP + 1)

; For each move action, the opposite one: a pipe turns the player back.
.reverse_moves
    EQUB ACTION_RIGHT, ACTION_LEFT, ACTION_DOWN, ACTION_UP

; Each trigger's place, x and y, copied in by setup_level over what was here:
; bytes left in the file, not code. Their arguments (trigger_args) follow,
; past the end of what the loader copies, up to IO.
.trigger_places
    EQUB &0C, &0C, &19, &F0, &C0, &80, &33, &77
    EQUB &FF, &FF, &FF, &00, &00, &FF, &FF, &FF
    EQUB &CC, &88, &88, &00, &00, &FF, &FF, &FF
    EQUB &33, &11, &11, &0F, &03, &01, &CC, &EE
    EQUB &EE, &FF, &FF, &F0, &F0, &F0, &F0, &70
    EQUB &70, &30, &30, &F0, &F0, &F0, &E0, &C0
    EQUB &C0, &91, &C0, &E0, &80, &11, &77, &FF
    EQUB &FF, &FF, &FF, &00, &00, &FF, &FF, &FF
.main_code_end
ASSERT main_code_end = trigger_args AND trigger_args + 4 * PUZZLES = io_start
ENDSECTION

; Past the end of what the loader copies: leftovers, never used.
.leftover
    EQUB &88, &88, &88, &00, &00, &FF, &FF, &FF, &00, &00, &00, &00, &00, &FF, &FF, &FF
    EQUB &00, &00, &10, &F0, &70, &30, &98, &30, &70, &F0, &F0, &F0, &F0, &F0, &F0, &F0
    EQUB &F0, &F0, &F0, &F0, &F0, &F0, &E0, &E0, &F0, &F0, &F0, &C0, &80, &33, &77, &77
    EQUB &33, &33, &33, &10, &10, &CC, &EE, &EE, &EE, &EE, &EE, &F0, &F0, &F0, &70, &70
    EQUB &70, &70, &70, &00, &00, &F0, &F0, &F0, &F0, &F0, &F0, &FF, &FF, &F0, &E0, &C0
    EQUB &C0, &91, &91
}
ENDSECTION

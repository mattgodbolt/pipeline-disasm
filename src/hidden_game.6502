    EQUB &33, &33, &33, &10, &10, &CC, &EE, &EE, &EE, &EE, &EE, &F0, &F0, &F0, &70, &70
    EQUB &70, &70, &70, &00, &00, &F0, &F0, &F0, &F0, &F0, &F0, &FF, &FF, &F0, &E0, &C0

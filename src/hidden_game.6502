; H.GAME: PIPELINE itself (William Reeve & Ian Holmes, Superior Software 1988).
;
; The GAME stub reads this from the hidden sectors &122-&142 to &3000 and jumps
; to it. It's built to be loaded at &3000 but to run lower down: the loader at
; the start copies the rest into the stack page, page 8, &0400-&07FF and
; &0900-&23AC, sets up the screen and the sound event, and jumps to the game,
; which then loads the mission file IO over the loader (see io.6502inc).
;
; Generated from hints/hidden_game.toml and hints/hidden_game/*.toml by
; tools/dis6502seg.py; edit those and regenerate.

INCLUDE "os.6502inc"
INCLUDE "io.6502inc"

SECTION hidden_game, filename="H.GAME", org=&3000
.game
{
; Zero page. The loader's block copy uses &00-&07 too (copy_return...).
monster_x = &00                         ; 4 monsters of 4 bytes; x, y in character cells
monster_y = &01
monster_direction = &02                 ; 0-3 moving, 4-7 stuck, 8 up: not out
monster_turns = &03                     ; which ways it tries when it's blocked
thrown_x = &10                          ; a thrown object in flight, in character cells
thrown_y = &11
thrown_direction = &12                  ; 0: nothing in flight, else direction + 1
thrown_picture = &13
thrown_picture_high = &14
front_x = &15                           ; the cell in front of the player
front_y = &16
action = &17                            ; the action to do next (see action_table)
frame_counter = &18                     ; +&20 a cycle; bit 7 picks the monsters' frame
thrown_object = &19                     ; the object in flight, + &80
backpack_slot = &1A                     ; the selected slot
throw_range = &1B                       ; cells the thrown object has left to fly
started_late = &1C                      ; nonzero: the game didn't start on level 1
pushes_left = &1D                       ; how many more crates the player may push
clock_fraction = &1E                    ; io_time_rate is added each cycle
clip_position = &1F
player_x = &20                          ; the player's cell
player_y = &21
score = &22                             ; BCD: the low two digits
score_high = &23                        ; and the high two
backpack = &24                          ; 4 slots: an object, or negative for empty
menu_key_left = &29                     ; the direction keys as MENU set them
menu_key_right = &2A
menu_key_up = &2B
menu_key_down = &2C
empty_channel = &2D                     ; the sound channel the event says ran dry
lives = &2E
sound_channel = &30                     ; an OSWORD 7 block for sound effects
sound_channel_high = &31
sound_amplitude = &32
sound_amplitude_high = &33
sound_pitch = &34
sound_pitch_high = &35
sound_duration = &36
sound_duration_high = &37
tune_channel = &38                      ; an OSWORD 7 block for the tune
tune_channel_high = &39
tune_amplitude = &3A
tune_amplitude_high = &3B
tune_pitch = &3C
tune_pitch_high = &3D
tune_duration = &3E
tune_duration_high = &3F
tune_position = &40                     ; voice 1's next note
tune_position_2 = &41                   ; voice 2's
tune_swap = &42                         ; which voice plays alone
tune_transpose = &43                    ; 0 or &14
tune_together = &44                     ; both voices play, or one
triggers_fired = &48                    ; counts triggers that matched
level = &49                             ; 0-3
draw_step = &4A                         ; drawing: cells to a picture's edge, a screen step, or flip the player
draw_step_high = &4B
monster_index = &4C
picture_stride = &4E                    ; bytes from one character cell of a picture to the next across
picture_size = &4F                      ; negative: 4x4 cells; 1: a 2x2 icon on the floor
work0 = &50                             ; scratch, used for all sorts
work1 = &51
work2 = &52
work3 = &53
work4 = &54
work5 = &55
start_x = &56                           ; the level's setup, copied from io_level_setup
start_y = &57
to_collect = &58                        ; cell 7s still to collect
time_left = &59                         ; the clock
exit_x = &5A
exit_y = &5B
monster_food = &5C                      ; low nibble: a cell monsters eat; high: what they leave
alternate_cells = &5D                   ; 2 bits a cell type: which squares use its second picture
player_dead = &5E                       ; nonzero: lose a life
pipe_move = &5F                         ; inside a pipe: the move action that carries the player on
stage = &60                             ; 0 collecting; 1 exit found; 2 the last few seconds; 3 done
furthest_level = &61                    ; the title screen's start level goes up to this
front_cell = &62                        ; what's in the cell in front of the player
fill_screen = &63                       ; clear_screen fills with the floor pattern, not black
tune_off = &64
effects_off = &65
action_keys = &66                       ; P, D, M, CTRL, T, Return: actions 1-6
key_map = &68
key_left = &6C                          ; this level's direction keys: actions 7-10
key_right = &6D
key_up = &6E
key_down = &6F
cell_x = &70                            ; the map cell being looked at or drawn
cell_y = &71
screen_start = &72                      ; the CRTC's start address
screen_start_high = &73
view_sub_x = &74                        ; view_x MOD 4: which character column of the left cell shows
view_sub_y = &75
picture = &76                           ; the picture being drawn
picture_high = &77
screen = &78                            ; where it's being drawn
screen_high = &79
strip_cells = &7A
cell_low_nibble = &7B                   ; the cell is in its map byte's low nibble
map_pointer = &7C
map_pointer_high = &7D
strip_cells_down = &7E
steps = &7F
view_screen = &80                       ; the screen address of the view's top left
view_screen_high = &81
count_across = &82
count_down = &83
player_screen = &84
player_screen_high = &85
player_screen_base = &86
player_screen_base_high = &87
player_frame = &88                      ; +&20 a step
facing = &89                            ; 0 left, 1 right, 2 up, 3 down
view_x = &8A                            ; the view's top left, in character cells (4 to a map cell)
view_y = &8B
sprite_columns = &8E                    ; character cells to draw, less 1
sprite_rows = &8F
sprite_column = &90
sprite_row = &91
sprite_screen = &92
sprite_screen_high = &93
view_cell_x = &94                       ; view_x DIV 4
view_cell_y = &95
temp = &96
sprite = &97                            ; the picture being drawn
sprite_high = &98
sprite_skip_x = &99                     ; character cells cut off the left
sprite_skip_y = &9A
player_steps = &9B
ESCAPE_FLAG = &FF                       ; the OS's: bit 7 set when Escape is pressed

; Elsewhere.
trigger_flags = &0100                   ; a byte per trigger, from io_level_trigger_flags
keys_were_down = &0120                  ; a byte per direction key, for repeat
offset_y = &0124
OS_COUNTDOWN = &0240                    ; the OS decrements it every 1/50 second
saved_extended_vectors = &037F          ; the OS's cassette workspace
NMI_HANDLER = &0D00                     ; where the OS jumps on an NMI
EXTENDED_VECTORS = &0D9F                ; the OS's extended vector table
trigger_args = &23AD                    ; 4 bytes a trigger, from io_level_trigger_args
map = &5800                             ; the level being played's map, copied from io_maps
SCREEN = &6000                          ; the game's 8K screen

menu_keys = &50                         ; where MENU leaves the ten keys
copy_return = &00
copy_from = &02
copy_to = &04
copy_count = &06
objects = game_start                    ; 8 objects of 4 bytes: x, y, icon, uses and flags
KEY_SHIFT = -1                          ; negative INKEY numbers
KEY_T = -36
KEY_S = -82
KEY_SPACE = -99
bit4_mask = show_map_centre + 1         ; the byte there is &10

; Entered from the GAME stub with the ten keys MENU set up in key_codes, as
; negative INKEY numbers. Copies the keys where the game wants them, copies
; the game into place, sets up the screen and the sound event, and starts the
; game. The stack is reset because the event handler lives in the stack page.
.loader
    LDX #&FF                            ; the event handler lives in the stack page
    TXS
    LDY #&09
.copy_keys_loop
    LDX key_order, Y
    LDA menu_keys, X                    ; MENU's key
    STA menu_key_left, X                ; as MENU left it
    STA action_keys, Y                  ; in the order the game tests its actions
    DEY
    BPL copy_keys_loop

; Each copy_block call is followed by its source, destination and length.
    JSR copy_block
    EQUW EXTENDED_VECTORS, saved_extended_vectors, &100 - LO(EXTENDED_VECTORS)
    JSR copy_block
    EQUW event_handler_load, event_handler, event_handler_end - event_handler
    JSR copy_block
    EQUW sound_data_load, sound_data, sound_data_end - sound_data
    JSR copy_block
    EQUW low_code_load, low_code, low_code_end - low_code
    JSR copy_block
    EQUW main_code_load, main_code, main_code_end - main_code

; MODE 5, then VDU 23,0,10,32;0;0;0 (CRTC register 10: no cursor), sent from
; the end of cursor_off_vdu backwards.
    LDA #&16
    JSR OSWRCH
    LDA #&05
    JSR OSWRCH
    LDY #&09
.L304B
    LDA cursor_off_vdu, Y
    JSR OSWRCH
    DEY
    BPL L304B

; The sound event: the OS calls EVNTV when a sound channel's queue empties
; (enabled when the tune starts), and the handler feeds the tune.
    SEI
    LDA #LO(event_handler)
    STA EVNTV
    LDA #HI(event_handler)
    STA &0221
    CLI

; Addressable latch bit 5 clear (with bit 4 set by MODE 5): the screen wraps
; round at 8K, so the game's screen is &6000-&7FFF with hardware scrolling.
    LDA #&05
    STA SYSVIA_ORB
    JMP game_start

; Never printed: a note for whoever looks.
.message_to_crackers
    EQUS " GET YOUR GRUBBY LITTLE HANDS OFF THIS PROGRAM! "
.cursor_off_vdu
    EQUB 0, 0, 0, 0, 0, 0, 32, 10, 0, 23

; For each of the action keys in the order the game tests them (action_keys),
; which of MENU's ten it is.
.key_order
    EQUB 4, 5, 9, 8, 7, 6, 0, 1, 2, 3     ; P, D, M, CTRL, T, Return, Z, X, :, /

; Copy a block of memory, then return past the six bytes that follow the JSR:
; the source, the destination and the length.
; Clobbers: A, X, Y, copy_return, copy_from, copy_to, copy_count.
.copy_block
    PLA                                 ; the JSR's return address, less 1
    STA copy_return
    PLA
    STA copy_return + 1
    LDY #&01
.copy_block_params
    LDA (copy_return), Y                ; the parameters into copy_from, copy_to, copy_count
    STA copy_from - 1, Y
    INY
    CPY #&07
    BNE copy_block_params
    LDX copy_count
    TYA                                 ; step the return address past them
    CLC
    ADC copy_return
    BCC copy_block_data
    INC copy_return + 1
.copy_block_data
    STA copy_return
    LDY #&00
.copy_block_loop
    LDA (copy_from), Y
    STA (copy_to), Y
    INY
    BNE copy_block_count
    INC copy_from + 1
    INC copy_to + 1
.copy_block_count
    TXA
    BNE copy_block_next
    DEC copy_count + 1
.copy_block_next
    DEX
    TXA
    ORA copy_count + 1
    BEQ copy_block_return
    BNE copy_block_loop
.copy_block_return
    JMP (copy_return)                   ; return past the parameters

; Never used.
.loader_unused
    EQUB &00, &00, &00, &00, &00, &00, &00, &00
    EQUB &00, &00, &00, &00, &00, &00, &00, &00
    EQUB &00, &00, &00, &00, &00, &00, &00, &00
    EQUB &00

; The sound event handler, run in the stack page (the stack never gets this
; deep).
.event_handler_load
SECTION event_handler, org=&0131

; EVNTV handler for the "output buffer empty" event (the only one enabled):
; X is the buffer, 4-7 for sound channels 0-3. Plays the tune's next note on
; the channel that ran out, and when the first voice reaches its end, starts
; the tune again with the next variation. Preserves A, X and Y.
.event_handler
    PHA
    TXA
    PHA
    TYA
    PHA
    DEX                                 ; X - 4: the sound channel that's run dry
    DEX
    DEX
    DEX
    STX empty_channel
    JSR play_tune                       ; play its next note
    LDA tune_position                   ; has the first voice finished?
    CMP #&1E
    BEQ restart_tune
    TAX                                 ; the first voice is part way through
    BNE event_handler_return
    LDA tune_position_2                 ; or the second, when only it is playing
    CMP #&1E
    BNE event_handler_return

; Both voices back to the start, each with a silent note to get the event
; going again; then step the variation: every other time round, transpose
; by 20 semitones' worth (&14), and every other time that, swap the voices.
.restart_tune
    LDY #&01
    STY tune_channel                    ; channel 1
    STY tune_channel_high               ; in step with the other voice (SOUND &101)
    DEY
    STY tune_position                   ; both voices to their first note
    STY tune_position_2
    STY tune_amplitude                  ; silent
    STY tune_amplitude_high
    STY tune_duration                   ; for no time
    STY tune_duration_high
    JSR sound_tune_block
    INC tune_channel                    ; channel 2
    JSR sound_tune_block
    LDA tune_together
    EOR #&01
    STA tune_together
    BNE event_handler_return
    LDA tune_transpose
    EOR #&14
    STA tune_transpose
    BNE event_handler_return
    LDA tune_swap
    EOR #&01
    STA tune_swap
.event_handler_return
    PLA
    TAY
    PLA
    TAX
    PLA
    RTS

; Copied but never used.
.event_handler_unused
    EQUB &00, &00, &00, &00, &00, &00, &00, &00
    EQUB &00, &00, &00, &00
.event_handler_end
ENDSECTION

; The title tune, in the printer buffer, and the four sound envelopes, written
; straight into the OS's envelope store rather than with OSWORD 8.
.sound_data_load
SECTION sound_data, org=&0880
.sound_data

; The tune: two voices of 32 notes, each a byte with the pitch step in the
; high nibble and the duration in the low. See play_tune_note.
.tune
    EQUB &59, &73, &86, &D6, &C9, &A3, &86, &76, &59, &73, &86, &56, &79, &43, &16, &06
    EQUB &59, &73, &86, &D6, &C9, &A3, &86, &76, &59, &73, &86, &46, &5C, &5C, &70, &00
.tune_voice_2
    EQUB &56, &86, &56, &86, &46, &76, &46, &76, &56, &86, &56, &86, &46, &76, &16, &06
    EQUB &56, &86, &56, &86, &46, &76, &46, &76, &56, &86, &56, &46, &5C, &5B, &30, &00

; Envelopes 1-4, as the OS keeps them (ENVELOPE's parameters after its
; number, padded to 16 bytes): T, PI1-3, PN1-3, AA, AD, AS, AR, ALA, ALD.
; 1 and 2 are the tune's voices, 3 and 4 sound effects.
.envelope_1
    EQUB 4, 1, -1, 1, 1, 2, 1, 70, 10, -12, -15, 70, 100, 0, 0, 0
    EQUB 5, 1, -1, 0, 1, 1, 0, 100, -10, 0, -12, 100, 0, 0, 0, 0
    EQUB &84, 0, 8, -8, 3, 1, 1, 126, -5, -10, -20, 126, 0, 0, 0, 0
    EQUB 3, 0, 0, 0, 1, 1, 1, 100, -6, 0, -8, 126, 0, 0, 0, 0
.sound_data_end
ENDSECTION

; Not copied.
.sound_data_padding
    EQUB &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00
    EQUB &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00

; Map view patterns and the code that scrolls the playing area.
.low_code_load
SECTION low_code, org=&0400
.low_code

; What the map view (the M key) draws for each cell type: 4 pixels by 4 lines,
; a byte a line. Then the player, facing each way.
.map_view_patterns
    EQUB &00, &00, &00, &00
    EQUB &10, &30, &70, &F0
    EQUB &80, &C0, &E0, &F0
    EQUB &F0, &70, &30, &10
    EQUB &F0, &E0, &C0, &80
    EQUB &F0, &F0, &F0, &F0
    EQUB &06, &69, &69, &06
    EQUB &FF, &FF, &66, &66
    EQUB &1F, &2F, &4F, &8F
    EQUB &FF, &60, &60, &FF
    EQUB &60, &90, &90, &60
    EQUB &06, &0F, &0F, &06
    EQUB &00, &0F, &0F, &00
    EQUB &06, &06, &06, &06
    EQUB &F0, &96, &96, &F0
    EQUB &00, &00, &00, &00
.map_view_player
    EQUB &C3, &69, &69, &C3
    EQUB &3C, &69, &69, &3C
    EQUB &96, &F0, &69, &0F
    EQUB &0F, &69, &F0, &96

; Clear the game screen, &6000-&7FFF, to black, or with fill_screen set to the
; pattern of the floor's top left character cell; reset the hardware scroll
; and set up the CRTC for the game's 32 x 32 character screen.
; Clobbers: A, X, Y, work0, work1.
.clear_screen
    JSR blank_display                   ; turn the display off while the screen is redrawn
    TAY                                 ; A = 0
    STA work0
    STA view_screen
    STA screen_start
    LDA #HI(SCREEN)
    STA work1
    STA view_screen_high
    LDA #HI(SCREEN) DIV 8
    STA screen_start_high
    LDX #&07
.clear_screen_loop
    LDA fill_screen                     ; black...
    BEQ clear_screen_store
    INX
    TXA                                 ; ...or the floor's pattern
    AND #&07
    TAX
    LDA io_tiles, X
.clear_screen_store
    STA (work0), Y
    INY
    BNE clear_screen_loop
    INC work1
    BPL clear_screen_loop

; Program CRTC registers 1-9 from crtc_values: 1 last, so the display comes
; back on (blank_display turns it off with R1 = 0) once the rest is set.
.setup_crtc
    LDX #&09
.setup_crtc_loop
    LDA crtc_values - 1, X              ; register X
    JSR set_crtc_register
    DEX
    BNE setup_crtc_loop
    JMP set_screen_start

; Find the picture for map cell (cell_x, cell_y): off the map, the second
; lava picture; an object's icon (with picture_size 1, to be drawn on the
; floor); or the cell's own picture.
; Returns: picture, picture_size. Clobbers: A, X, Y, temp.
.cell_picture
    LDA #&80
    STA picture_size
    LDX cell_x
    LDY cell_y
    JSR cell_at_checked                 ; carry set: off the map
    BCC cell_picture_on_map
    LDX #LO(io_animation + 3 * 128)     ; outside the map is lava
    LDY #HI(io_animation + 3 * 128)
    BCS cell_picture_found
.cell_picture_on_map
    LDX cell_x
    LDY cell_y
    JSR cell_type_picture
.cell_picture_found
    STX picture
    STY picture_high
    RTS

; Find the picture for a thing to draw at map cell (X, Y): A is a cell type
; (0-15), &10 + an object icon, or &20 + a player picture.
; Returns: X, Y = the picture's address. Clobbers: A, temp.
.thing_picture
    CMP #&20
    BCS player_picture
    CMP #&10
    BCS icon_picture

; A cell type: cell F holds an object, so draw its icon.
.cell_type_picture
    CMP #&0F
    BCC tile_picture
    JSR object_picture_at               ; the object here's icon
    STX picture
    STY picture_high
    CPY #HI(io_no_object_picture)       ; none here?
    BEQ cell_type_picture_done
    LDA #&01                            ; draw the icon on the floor
    STA picture_size
.cell_type_picture_done
    RTS

; The picture for cell type A at (X, Y). Four cell types have a second
; picture, used on the squares alternate_cells picks: alternate_offsets has
; the difference to add for them, on even and odd squares of a checkerboard.
.tile_picture
    PHA
    STY temp
    TXA
    CLC
    ADC temp                            ; x + y
    LSR A                               ; carry: an odd square
    PLA
    PHA
    PHP
    LDX #&0A
    LDY #&04
.tile_picture_find
    DEX
    DEX
    DEY
    BMI tile_picture_found
    CMP alternate_cell_types, Y         ; one with a second picture?
    BNE tile_picture_find
.tile_picture_found
    PLP
    TXA
    BEQ tile_picture_add
    BCC tile_picture_offset
    ADC #&07                            ; odd squares' offsets are 8 bytes on
.tile_picture_offset
    TAX
.tile_picture_add
    PLA
    ASL A
    TAY
    LDA alternate_offsets, X
    ADC tile_addresses, Y
    STA temp
    LDA alternate_offsets + 1, X
    ADC tile_addresses + 1, Y
    TAY
    LDX temp
    LDA #&00
    RTS

; Player picture A AND 3: io_player + 128 times that.
.player_picture
    AND #&03
    LSR A
    ROR A
    TAX
    LDY #HI(io_player)
    BCC player_picture_done
    INY
.player_picture_done
    RTS

; Object icon A AND 15: io_object_icons + 32 times that.
.icon_picture
    LDY #HI(io_object_icons)
    AND #&0F
    LSR A
    ROR A
    ROR A
    ROR A
    BCC icon_picture_done
    INY
.icon_picture_done
    TAX
    RTS

; A character cell of floor round an icon, which only covers the middle
; of its map cell.
.draw_row_floor_cell
    LDA io_tiles, Y
    STA (screen), Y
    DEY
    BPL draw_row_floor_cell
    BMI draw_row_part_next

; Draw one character row of the picture at picture across X character cells,
; from screen. X negative skips the picture's first two columns and draws
; ~X (the view's left edge cuts the first cell in half). view_sub_y is the
; row within the picture; draw_step counts the columns to the picture's
; right edge, for the floor round an icon.
; Clobbers: A, X, Y, picture, screen, draw_step, picture_stride.
.draw_row_part
    LDA #&20
    LDY picture_size                    ; a 4x4 picture's columns are 32 bytes apart...
    BMI draw_row_part_stride
    LSR A                               ; ...an icon's 16
.draw_row_part_stride
    STA picture_stride
    TXA
    BPL draw_row_part_first_row
    EOR #&FF                            ; cut off: draw ~X cells
    TAX
    LDA #&40                            ; past the first two columns
    INY
    BMI draw_row_part_skip
    LSR A
.draw_row_part_skip
    JSR skip_picture_columns
.draw_row_part_first_row
    LDA view_sub_y                      ; the row within the picture
    INY
    BMI draw_row_part_offset
    LSR A
.draw_row_part_offset
    ASL A
    ASL A
    ASL A
    ADC picture
    STA picture
    BCC draw_row_part_loop
    INC picture_high
.draw_row_part_loop
    LDY #&07                            ; beyond an icon's edge?
    LDA draw_step
    JSR in_icon_border
    BEQ draw_row_floor_cell
    LDA view_sub_y                      ; or below it?
    CLC
    ADC #&01
    JSR in_icon_border
    BEQ draw_row_floor_cell
.draw_row_part_copy
    LDA (picture), Y                    ; a character cell of the picture
    STA (screen), Y
    DEY
    BPL draw_row_part_copy
    LDA picture                         ; on to the next column
    CLC
    ADC picture_stride
    STA picture
    BCC draw_row_part_next
    INC picture_high
.draw_row_part_next
    JSR next_screen_cell
    DEC draw_step
    DEX
    BNE draw_row_part_loop
    RTS

; Move screen one character cell right, wrapping round the 8K screen.
.next_screen_cell
    LDA screen
    CLC
    ADC #&08
    STA screen
    BCC next_screen_cell_done
    LDA screen_high

; Set screen's high byte to A plus the carry, wrapped into &60-&7F.
.wrap_screen_high_carry
    ADC #&00
.wrap_screen_high
    AND #&1F
    ORA #HI(SCREEN)
    STA screen_high
.next_screen_cell_done
    RTS

; Draw a whole character row across the view: row view_sub_y of map cells
; cell_x to cell_x + 8, at screen. The view's left and right edges cut the
; first and last cells in half (view_sub_x is always 2 when moving up or
; down, the only time a row is drawn).
; Clobbers: A, X, Y, cell_x, strip_cells, picture, screen, temp.
.draw_row
    JSR cell_picture
    LDY #&04
    LDX #&04
    LDA strip_cells
    BNE draw_row_not_first
    LDX #&FD
    LDY #&02                            ; the first cell: its right half
    BNE draw_row_cell
.draw_row_not_first
    CMP #&08
    BNE draw_row_cell
    LDX #&02                            ; the last cell: its left half
.draw_row_cell
    STY draw_step
    JSR draw_row_part
    INC strip_cells
    INC cell_x
    LDA strip_cells
    CMP #&09
    BNE draw_row
    RTS

; Point map_pointer at the byte holding map cell (cell_x, cell_y): the map is
; stored a column at a time, 32 bytes a column, two cells a byte.
; Returns: map_pointer, cell_low_nibble (cell_y odd). Clobbers: A, Y.
.map_address
    LDA cell_x
    LDY #&00
    STY map_pointer_high
    LDY #&05
.map_address_times_32
    ASL A
    ROL map_pointer_high
    DEY
    BNE map_address_times_32
    STA map_pointer                     ; cell_x * 32
    LDA cell_y                          ; + cell_y / 2
    LSR A
    CLC
    ADC map_pointer
    STA map_pointer
    BCC map_address_nibble
    INC map_pointer_high
.map_address_nibble
    LDA cell_y
    AND #&01
    STA cell_low_nibble
    LDA map_pointer_high
    CLC
    ADC #HI(map)                        ; + map
    STA map_pointer_high
    RTS

; As draw_row_floor_cell, for a column.
.draw_column_floor_cell
    LDA io_tiles, Y
    STA (screen), Y
    DEY
    BPL draw_column_floor_cell
    BMI draw_column_part_next

; Draw one character column of the picture at picture down X character cells,
; from screen; as draw_row_part, with view_sub_x the column within the
; picture.
.draw_column_part
    LDY picture_size
    TXA
    BPL draw_column_part_first_column
    EOR #&FF
    TAX
    LDA #&10                            ; past the first two rows
    JSR skip_picture_columns
.draw_column_part_first_column
    LDA view_sub_x                      ; the column within the picture
    INY
    BMI draw_column_part_offset
    LSR A
.draw_column_part_offset
    LSR A
    ROR A
    ROR A
    ROR A
    INY
    BMI draw_column_part_add
    ROR A
.draw_column_part_add
    CLC
    ADC picture
    STA picture
    BCC draw_column_part_loop
    INC picture_high
.draw_column_part_loop
    LDY #&07
    LDA draw_step
    JSR in_icon_border
    BEQ draw_column_floor_cell
    LDA view_sub_x
    CLC
    ADC #&01
    JSR in_icon_border
    BEQ draw_column_floor_cell
.draw_column_part_copy
    LDA (picture), Y                    ; a character cell of the picture
    STA (screen), Y
    DEY
    BPL draw_column_part_copy
    LDA picture                         ; on to the next row
    CLC
    ADC #&08
    STA picture
    BCC draw_column_part_next
    INC picture_high
.draw_column_part_next
    INC screen_high                     ; down a character row
    BPL draw_column_part_count
    LDA #HI(SCREEN)
    STA screen_high
.draw_column_part_count
    DEC draw_step
    DEX
    BNE draw_column_part_loop
    RTS

; Draw a whole character column down the view: column view_sub_x of map cells
; cell_y to cell_y + 8, at screen.
.draw_column
    JSR cell_picture
    LDY #&04
    LDX #&04
    LDA strip_cells_down
    BNE draw_column_not_first
    LDX #&FD
    LDY #&02
    BNE draw_column_cell
.draw_column_not_first
    CMP #&08
    BNE draw_column_cell
    LDX #&02
.draw_column_cell
    STY draw_step
    JSR draw_column_part
    INC strip_cells_down
    INC cell_y
    LDA strip_cells_down
    CMP #&09
    BNE draw_column
    RTS

; Scroll the view one character cell, by moving the CRTC's start address and
; the view's top left on the screen, wrapping round the 8K screen.
; Clobbers: A.
.scroll_right
    INC view_x                          ; the view moves right
    INC screen_start                    ; the CRTC starts a character on
    BNE scroll_right_screen
    INC screen_start_high
.scroll_right_screen
    LDA view_screen                     ; and so does the view's top left
    CLC
    ADC #&08
    STA view_screen
    BCC scroll_done
    INC view_screen_high
    BPL scroll_done
    LDA #HI(SCREEN)                     ; off the end: wrap round
    STA view_screen_high
    LDA #HI(SCREEN) DIV 8
    STA screen_start_high
    BNE scroll_done
.scroll_left
    DEC view_x
    DEC screen_start
    LDA screen_start
    CMP #&FF
    BNE scroll_left_screen
    DEC screen_start_high
.scroll_left_screen
    LDA view_screen
    SEC
    SBC #&08
    STA view_screen
    BCS scroll_done
    DEC view_screen_high
    LDA view_screen_high
    CMP #HI(SCREEN) - 1
    BNE scroll_done
    LDA #HI(SCREEN + &1FFF)
    STA view_screen_high
    LDA #HI(SCREEN + &1FFF) DIV 8
    STA screen_start_high
.scroll_done
    JMP set_screen_start
.scroll_up
    DEC view_y                          ; the view moves up
    DEC view_screen_high
    SEC
    LDA screen_start                    ; a character row is 32 cells
    SBC #&20
    STA screen_start
    BCS scroll_up_done
    DEC screen_start_high
    LDA screen_start_high
    CMP #HI(SCREEN) DIV 8 - 1
    BNE scroll_up_done
    LDA #HI(SCREEN + &1FFF)
    STA view_screen_high
    LDA #HI(SCREEN + &1FFF) DIV 8
    STA screen_start_high
.scroll_up_done
    JMP set_screen_start
.scroll_down
    INC view_y
    INC view_screen_high
    CLC
    LDA screen_start
    ADC #&20
    STA screen_start
    BCC scroll_up_done
    INC screen_start_high
    LDA screen_start_high
    CMP #HI(SCREEN + &2000) DIV 8
    BNE scroll_up_done
    LDA #HI(SCREEN)
    STA view_screen_high
    LDA #HI(SCREEN) DIV 8
    STA screen_start_high
    BNE scroll_up_done

; Walk the player a cell down: scroll the view down a character row at a
; time, drawing each new bottom row and moving everything else on screen.
; Clobbers: A, X, Y and most of the drawing variables.
.walk_down
    JSR next_player_frame               ; the player's walking picture
    LDA #&02                            ; the view's top is half way through a cell
    STA view_sub_y
    LDX #&03
    STX steps
.walk_down_step
    JSR scroll_down
    JSR rub_out_above_player            ; rub out the trail behind the player
    LDA view_screen_high
    SEC
    SBC #&01
    JSR wrap_screen_high
    LDA view_screen                     ; the new row is just above the top, in memory
    STA screen
    LDA #&00
    STA strip_cells
    LDA view_cell_x
    STA cell_x                          ; the cells 8 below the top
    LDA view_cell_y
    CLC
    ADC #&08
    STA cell_y
    JSR draw_row
    JSR move_things                     ; monsters and thrown objects
    INC view_sub_y                      ; the next row down...
    LDA view_sub_y
    AND #&03
    STA view_sub_y
    BNE walk_down_next
    INC view_cell_y                     ; ...in the next cell
.walk_down_next
    DEC steps
    BPL walk_down_step
    RTS

; Walk a cell up.
.walk_up
    JSR next_player_frame
    LDA #&01
    STA view_sub_y
    LDX #&03
    STX steps
.walk_up_step
    LDA #&00
    STA strip_cells
    LDA view_cell_x
    STA cell_x
    LDA view_cell_y
    STA cell_y
    LDA view_screen
    STA screen
    JSR scroll_up
    JSR rub_out_below_player
    LDA view_screen_high
    STA screen_high
    JSR draw_row
    JSR move_things
    LDA screen_high
    CLC
    ADC #&1F
    BPL walk_up_wrapped
    SBC #&1F
.walk_up_wrapped
    STA screen_high
    DEC view_sub_y
    LDA view_sub_y
    AND #&03
    STA view_sub_y
    CMP #&03
    BNE walk_up_next
    DEC view_cell_y
.walk_up_next
    DEC steps
    BPL walk_up_step
    RTS

; Walk a cell right.
.walk_right
    JSR next_player_frame
    LDA #&02
    STA view_sub_x
    LDX #&03
    STX steps
.walk_right_step
    LDA view_cell_x
    CLC
    ADC #&08
    STA cell_x
    LDA view_cell_y
    STA cell_y
    LDA #&00
    STA strip_cells_down
    JSR scroll_right
    JSR rub_out_left_of_player
    LDA view_screen
    CLC
    ADC #&F8
    STA screen
    LDA view_screen_high
    JSR wrap_screen_high_carry
    JSR draw_column
    JSR move_things
    INC view_sub_x
    LDA view_sub_x
    AND #&03
    STA view_sub_x
    BNE walk_right_next
    INC view_cell_x
.walk_right_next
    DEC steps
    BPL walk_right_step
    RTS

; Walk a cell left.
.walk_left
    JSR next_player_frame
    LDA #&01
    STA view_sub_x
    LDX #&03
    STX steps
.walk_left_step
    LDA #&00
    STA strip_cells_down
    LDA view_cell_x
    STA cell_x
    LDA view_cell_y
    STA cell_y
    JSR scroll_left
    JSR rub_out_right_of_player
    LDA view_screen
    STA screen
    LDA view_screen_high
    STA screen_high
    JSR draw_column
    JSR move_things
    DEC view_sub_x
    LDA view_sub_x
    AND #&03
    STA view_sub_x
    CMP #&03
    BNE walk_left_next
    DEC view_cell_x
.walk_left_next
    DEC steps
    BPL walk_left_step
    RTS

; The cell types with a second picture: lava, the thing to collect, and
; two more. alternate_pictures has their second pictures, in the same order.
.alternate_cell_types
    EQUB &0A, &07, &08, &05

; Copied but never used.
.low_code_unused
    EQUB &00, &00, &00, &00, &00, &00
.low_code_end
ENDSECTION

; The game.
.main_code_load
SECTION main_code, org=&0900
.main_code

; Called by the event handler when a sound channel's queue runs dry: play the
; next note of whichever tune voice belongs to that channel. tune_swap and
; tune_together pick which voices play: voice 1 on channel 1 unless voice 2 is
; playing alone, voice 2 on channel 2 unless voice 1 is.
; Clobbers: A, X, Y, the tune block.
.play_tune
    LDA tune_swap                       ; voice 1 on channel 1...
    EOR #&01
    ORA tune_together
    JSR play_voice                      ; ...unless voice 2 plays alone
    LDA tune_swap                       ; voice 2 on channel 2...
    ORA tune_together
    ASL A                               ; ...unless voice 1 plays alone

; A is the channel a voice plays on (1 or 2), or 0 if it isn't playing.
; A note's high nibble is a step of a semitone; the voice on channel 1 is an
; octave above the other, and each voice's last note is pitched higher still.
; The voice's channel is also its envelope.
.play_voice
    BEQ play_voice_done
    CMP empty_channel                   ; the channel that ran dry?
    BNE play_voice_done
    TAX
    LDA tune_position - 1, X            ; the voice's next note
    INC tune_position - 1, X
    STA tune_channel                    ; (tune_channel as scratch)
    DEX
    TXA
    ASL A                               ; voice 2's notes are 32 on
    ASL A
    ASL A
    ASL A
    ASL A
    ADC tune_channel
    INX
    STX tune_channel                    ; the channel...
    STX tune_amplitude                  ; ...and the same envelope
    TAX
    LDY #&00
    STY tune_channel_high
    STY tune_amplitude_high
    STY tune_pitch_high
    STY tune_duration_high
    LDA tune, X                         ; a note: pitch step, duration
    PHA
    AND #&F0
    LSR A                               ; 4 to a semitone
    LSR A
    ADC tune_transpose
    ADC #&21                            ; the tune's lowest note
    LDY tune_channel
    DEY
    BNE play_voice_last_note
    ADC #&30                            ; voice 1 an octave up
.play_voice_last_note
    LDX tune_position, Y                ; the voice's last note...
    CPX #&1E
    BNE play_voice_note
    ADC #&2F                            ; ...a little under an octave up
.play_voice_note
    STA tune_pitch
    PLA
    AND #&0F                            ; in 20ths of a second
    STA tune_duration

; SOUND with the block at tune_channel.
.sound_tune_block
    LDX #LO(tune_channel)
    LDY #HI(tune_channel)
    LDA #7
    JMP OSWORD

; Add A to picture: halved for an icon (Y is picture_size and is incremented
; twice here and in the caller, so it stays negative for a 4x4 picture).
.skip_picture_columns
    INY                                 ; an icon's columns are half as big
    BMI advance_picture
    LSR A
.advance_picture
    CLC
    ADC picture
    STA picture
    BCC play_voice_done
    INC picture_high
.play_voice_done
    RTS

; The player's picture alternates as they walk.
.next_player_frame
    LDA player_frame
    CLC
    ADC #&20
    STA player_frame
    RTS

; The second pictures of alternate_cell_types, as picture numbers counted from
; io_tiles. The CRTC values overlap the last: setup_crtc reads from
; crtc_values - 1 with X from 9 down to 1.
.alternate_pictures
    EQUB &1B, &19, &1A, &18                 ; A, 7, 8, 5: pictures 27, 25, 26, 24

; CRTC registers 1-9: 32 characters across and 32 rows of 8 lines, the screen
; centred.
.crtc_values
    EQUB 32, 45, 36, 38, 0, 32, 34, 1, 7

; The address of each cell type's picture.
.tile_addresses
FOR n = 0..15
    EQUW io_tiles + n * 128
NEXT

; What to add to a cell type's picture address on squares that show its
; second picture, set up by setup_alternate_pictures: a zero word for cell
; types that have none, then a word for each alternate_cell_types on even
; squares, then on odd.
.alternate_offsets
    EQUW 0
.alternate_offsets_even
    EQUW 0, 0, 0, 0
.alternate_offsets_odd
    EQUW 0, 0, 0, 0

; Monster A: rub it out with the floor picture, or draw it, with a picture
; whose low byte the caller has put in sprite (the monsters' two frames are
; cell types E and F's pictures).
.erase_monster
    JSR monster_position
    LDA #HI(io_tiles)
    STA sprite_high
    LDA #LO(io_tiles)
    STA sprite
    SEC
    JMP draw_sprite
.draw_monster
    JSR monster_position
    LDA #HI(io_tiles + &E * 128)
    STA sprite_high
    SEC
    JMP draw_sprite

; Draw the player in the middle of the view: their picture for the way they
; face; walking up or down alternates two pictures, drawn upside down on every
; other step.
; Clobbers: A, X, Y, picture, player_screen, draw_step.
.draw_player
    LDA player_frame
    AND #&80                            ; every other step...
    STA picture
    STA draw_step
    LDA facing                          ; left 0, right 1: &5400, &5480
    LSR A
    ROR A
    BCC draw_player_picture             ; up and down: &5500 or &5580...
    EOR picture                         ; ...alternating, flipped too
.draw_player_picture
    STA picture
    LDA #HI(io_player)
    ADC #&00
    STA picture_high
    LDA #LO(14 * 8)                     ; the view's 14th character across...
    ADC view_screen
    STA player_screen
    STA player_screen_base
    LDA #HI(14 * &100 + 14 * 8)         ; ...and down: the middle
    ADC view_screen_high
    BPL draw_player_screen
    SBC #&1F
.draw_player_screen
    STA player_screen_high
    STA player_screen_base_high
    BNE draw_player_at

; Rub out the edge of the player's picture that scrolling left behind, as the
; view moves a character towards one side, then draw the player again in the
; middle. Inside a pipe the player isn't drawn, and only the first few steps'
; trails are rubbed out.
.rub_out_below_player
    LDA player_screen_base
    STA player_screen
    LDA player_screen_base_high         ; the player's bottom row...
    CLC
    ADC #&03
    BPL rub_out_row
    SBC #&1F
.rub_out_row
    STA player_screen_high
    LDY #&00                            ; ...across
    STY draw_step_high
    LDA #&08
    STA draw_step
    BNE rub_out_trail
.rub_out_right_of_player
    LDA player_screen_base              ; the player's right column...
    CLC
    ADC #&18
    STA player_screen
    LDA player_screen_base_high
    ADC #&00
    BPL rub_out_right_wrapped
    SBC #&1F
.rub_out_right_wrapped
    BNE rub_out_column
.rub_out_left_of_player
    LDA player_screen_base
    STA player_screen
    LDA player_screen_base_high
.rub_out_column
    STA player_screen_high
    LDY #&00                            ; ...down
    STY draw_step
    INY
    STY draw_step_high
.rub_out_trail
    LDX player_steps                    ; inside a pipe...
    LDA pipe_move
    BEQ rub_out_trail_draw
    INX
    CPX #&05                            ; ...rub out only the first few
    BCC rub_out_trail_draw
    RTS
.rub_out_trail_draw
    STX player_steps
    LDX #&04
.rub_out_trail_cell
    LDY #&07
.rub_out_trail_copy
    LDA io_tiles, Y                     ; floor
    STA (player_screen), Y
    DEY
    BPL rub_out_trail_copy
    LDA draw_step
    CLC
    ADC player_screen
    STA player_screen
    LDA draw_step_high
    ADC player_screen_high
    BPL rub_out_trail_next
    SBC #&1F
.rub_out_trail_next
    STA player_screen_high
    DEX
    BNE rub_out_trail_cell
    JMP draw_player
.rub_out_above_player
    LDA player_screen_base
    STA player_screen
    LDA player_screen_base_high
    BNE rub_out_row

; Draw the player's picture at player_screen: 4 x 4 character cells, a column
; at a time. draw_step nonzero draws it flipped top to bottom by copying each
; column's bytes backwards with a self-modified LDA abs,X.
.draw_player_at
    LDX #&1F                            ; the last byte of a column, for flipping
    LDA picture
    STA draw_player_flipped_copy + 1    ; self-modified: flipped pictures copy from here
    LDA picture_high
    STA draw_player_flipped_copy + 2
    LDA pipe_move                       ; inside a pipe: not drawn
    BEQ draw_player_cells
    RTS
.draw_player_cells
    STA player_steps
    LDA #&03
    STA count_across
    STA count_down
.draw_player_cell
    LDA draw_step                       ; flipped?
    BNE draw_player_flipped
    LDY #&07
.draw_player_copy
    LDA (picture), Y
    STA (player_screen), Y
    DEY
    BPL draw_player_copy
    LDA picture
    CLC
    ADC #&08
    STA picture
    BCC draw_player_down
    INC picture_high
.draw_player_down
    INC player_screen_high              ; down a character row
    BPL draw_player_next
    LDA #HI(SCREEN)
    STA player_screen_high
.draw_player_next
    DEC count_across
    BPL draw_player_cell
    TXA                                 ; flipped: the next column's last byte
    CLC
    ADC #&40
    TAX
    LDA player_screen                   ; the next column across...
    CLC
    ADC #&08
    STA player_screen
    BCC draw_player_wrap
    INC player_screen_high
.draw_player_wrap
    LDA player_screen_high              ; ...back up to the top
    SEC
    SBC #&04
    CMP #HI(SCREEN)
    BCS draw_player_column
    ADC #&20
.draw_player_column
    STA player_screen_high
    LDA #&03
    STA count_across
    DEC count_down
    BPL draw_player_cell
.return_0AD0
    RTS
.draw_player_flipped
    LDY #&00
.draw_player_flipped_copy
    LDA &FFFF, X                        ; self-modified: the picture
    DEX
    STA (player_screen), Y
    INY
    CPY #&08
    BNE draw_player_flipped_copy
    BEQ draw_player_down

; Redraw the whole view from the map: fill the screen with stripes, then draw
; it in from both sides a column and a row at a time, waiting for a vsync each
; step, as a level starts.
; Clobbers: A, X, Y and the drawing variables.
.redraw_view
    LDA #&00                            ; steps in from the edges
    STA steps
    STA count_across
    STA screen
    TAY
    STA player_steps
    LDA #HI(SCREEN)
    STA screen_high
    LDA #&FF                            ; &7F, &3F, &1F...: stripes
    CLC
.redraw_view_stripes
    ROR A
    STA (screen), Y
    DEY
    BNE redraw_view_stripes
    INC screen_high
    BPL redraw_view_stripes
.redraw_view_step
    LDA steps                           ; from the left, then the right
    LSR A
    EOR count_across                    ; the column, 0-31
    TAY
    ASL A
    ASL A
    ASL A
    STA screen
    LDA #HI(SCREEN)
    STA screen_high
    LDA #&00
    STA strip_cells_down
    TYA
    ADC #&02                            ; the view's left edge is half a cell in
    PHA
    AND #&03
    STA view_sub_x
    PLA
    LSR A
    LSR A
    CLC
    ADC view_cell_x
    STA cell_x
    LDA view_cell_y
    STA cell_y
    JSR draw_column                     ; a column
    LDA #&00
    STA screen
    STA strip_cells
    LDA steps                           ; and a row, from the top, then the bottom
    LSR A
    EOR count_across
    PHA
    CLC
    ADC #HI(SCREEN)
    STA screen_high
    PLA
    ADC #&02
    PHA
    AND #&03
    STA view_sub_y
    PLA
    LSR A
    LSR A
    CLC
    ADC view_cell_y
    STA cell_y
    LDA view_cell_x
    STA cell_x
    JSR draw_row                        ; a row
    JSR wait_vsync                      ; one step a frame
    LDA count_across                    ; the other side
    EOR #&1F
    STA count_across
    INC steps
    LDA steps
    CMP #&1C                            ; 28 steps meet in the middle
    BCC redraw_view_step
    JMP draw_player

; Monster A's position: X, Y = its x and y in character cells.
.monster_position
    ASL A
    ASL A
    TAY
    LDX monster_x, Y
    LDA monster_y, Y
    TAY
.move_things_done
    RTS

; Move everything that moves by itself one character cell: a thrown object,
; then each monster that's out, in the direction it's going (8 and up: not
; out; 4-7: stuck, drawn without moving).
; Clobbers: A, X, Y, monster_index and the drawing variables.
.move_things
    LDA player_dead                     ; nothing moves while the player dies
    BNE move_things_done
    LDA thrown_direction                ; something thrown?
    BEQ move_monsters
    CMP #&01
    BEQ thrown_left
    CMP #&02
    BEQ thrown_right
    CMP #&03
    BEQ thrown_up
    INC thrown_y                        ; 4: down
    JMP draw_thrown
.thrown_left
    DEC thrown_x                        ; 1: left
    JMP draw_thrown
.thrown_right
    INC thrown_x                        ; 2: right
    JMP draw_thrown
.thrown_up
    DEC thrown_y                        ; 3: up
.draw_thrown
    LDA thrown_picture
    STA sprite
    LDA thrown_picture_high
    STA sprite_high
    LDX thrown_x
    LDY thrown_y
    JSR draw_icon_on_floor              ; drawn on the floor
.move_monsters
    LDA #&03
    STA monster_index
.move_monster
    LDA monster_index
    ASL A
    ASL A
    TAX
    LDA monster_direction, X            ; its direction
    PHA
    CMP #&04                            ; 4 and up: it doesn't move
    BCS move_monster_direction
    TXA
    PHA
    LDA monster_index
    JSR erase_monster                   ; rub it out
    PLA
    TAX
.move_monster_direction
    PLA
    BEQ monster_left
    CMP #&01
    BEQ monster_right
    CMP #&02
    BEQ monster_up
    CMP #&08                            ; 8 and up: not out
    BCS next_monster
    CMP #&03
    BNE monster_stuck
    INC monster_y, X                    ; 3: down
    JMP monster_moved
.monster_left
    DEC monster_x, X                    ; 0: left
    JMP monster_moved
.monster_right
    INC monster_x, X                    ; 1: right
    JMP monster_moved
.monster_up
    DEC monster_y, X                    ; 2: up
.monster_moved
    LDA frame_counter                   ; the monsters' frame
    AND #&80
    STA sprite
    LDA monster_index
    JSR draw_monster                    ; draw it
.next_monster
    DEC monster_index
    BPL move_monster
    RTS
.monster_stuck
    LDA frame_counter                   ; stuck: draw it where it is
    AND #&80
    STA sprite
    LDA monster_index
    JSR draw_monster
    JMP next_monster

; Copy the part of the 4x4 picture at sprite that clip_sprite_x and _y found
; to be in the view to sprite_screen, a column of character cells at a time.
; Clobbers: A, Y, sprite, sprite_screen, sprite_column, sprite_row.
.draw_sprite_clipped
    LDA sprite_columns
    STA sprite_column
    LDA sprite_skip_x                   ; past the columns cut off...
    LSR A
    ROR A
    ROR A
    ROR A
    ADC sprite
    STA sprite
    LDA sprite_skip_y                   ; ...and the rows
    ASL A
    ASL A
    ASL A
    ADC sprite
    STA sprite
.draw_sprite_column
    LDA sprite_rows
    STA sprite_row
.draw_sprite_cell
    LDY #&07
.draw_sprite_copy
    LDA (sprite), Y
    STA (sprite_screen), Y
    DEY
    BPL draw_sprite_copy
    INC sprite_screen_high              ; down a character row
    BPL draw_sprite_next_row
    LDA #HI(SCREEN)
    STA sprite_screen_high
.draw_sprite_next_row
    LDA sprite
    CLC
    ADC #&08
    STA sprite
    BCC draw_sprite_count_rows
    INC sprite_high
.draw_sprite_count_rows
    DEC sprite_row
    BPL draw_sprite_cell
    LDA sprite_rows                     ; past the rows cut off at the bottom
    EOR #&03
    ASL A
    ASL A
    ASL A
    ADC sprite
    STA sprite
    BCC draw_sprite_next_column
    INC sprite_high
.draw_sprite_next_column
    LDA sprite_screen
    CLC
    ADC #&08
    STA sprite_screen
    BCC draw_sprite_back_to_top
    INC sprite_screen_high
.draw_sprite_back_to_top
    LDA sprite_screen_high              ; back to the top
    CLC
    SBC sprite_rows
    AND #&1F
    ORA #HI(SCREEN)
    STA sprite_screen_high
    DEC sprite_column
    BPL draw_sprite_column
    RTS

; Never called.
.sprite_in_icon_border
    LDA sprite_column
    JSR in_icon_border
    BEQ in_icon_border_done
    LDA sprite_row

; Is position A (1-4, counting in from the far edge) of a map cell outside an
; icon? An icon, picture_size 1, covers only the middle two of four.
; Returns: Z set if it's outside.
.in_icon_border
    CMP picture_size
    BEQ in_icon_border_done
    SEC
    SBC #&03
    CMP picture_size
.in_icon_border_done
    RTS

; Draw the icon at sprite in the middle of a floor picture at character
; position (X, Y): copy it into the middle of the floor's own picture, draw
; that, then (by an RTS to a pushed address) put the floor's middle back.
.draw_icon_on_floor
    TXA
    PHA
    TYA
    PHA
    LDX #&0F
    LDY #&1F
.draw_icon_right_half
    LDA (sprite), Y                     ; the icon's right column...
    STA io_tiles + 2 * 32 + 8, X
    DEY
    DEX
    BPL draw_icon_right_half
    LDX #&0F
.draw_icon_left_half
    LDA (sprite), Y                     ; ...and left, into the floor's middle
    STA io_tiles + 1 * 32 + 8, X
    DEY
    DEX
    BPL draw_icon_left_half
    LDA #LO(io_tiles)                   ; draw the floor picture
    STA sprite
    LDA #HI(io_tiles)
    STA sprite_high
    PLA
    TAY
    PLA
    TAX
    SEC                                 ; returning to restore_floor_picture
    LDA #HI(restore_floor_picture - 1)
    PHA
    LDA #LO(restore_floor_picture - 1)
    PHA

; Draw a 4x4 picture at character position (X, Y) on the map (4 to a map
; cell), whatever of it is in the view: sprite is the picture, and with the
; carry clear it's an icon on a floor picture instead (draw_icon_on_floor).
; Clobbers: A, X, Y and the sprite variables.
.draw_sprite
    BCC draw_icon_on_floor
    LDA #&03                            ; 4 x 4 cells, none cut off
    STA sprite_columns
    STA sprite_rows
    LDA #&00
    STA sprite_screen_high
    STA sprite_skip_x
    STA sprite_skip_y
    JSR clip_sprite_x
    JSR clip_sprite_y
    JMP draw_sprite_clipped

; Put back the middle two columns of the floor picture, which are all the
; same as its last column's last character cell.
.restore_floor_picture
    LDY #&3F
    LDX #&07
.restore_floor_loop
    LDA io_tiles + 3 * 32 + 3 * 8, X    ; the floor's last character cell
    STA io_tiles + 1 * 32, Y
    DEX
    TXA
    AND #&07
    TAX
    DEY
    BPL restore_floor_loop
    RTS

; Which of a picture's 4 columns at character x = X are in the view (32
; columns from view_x, which wraps round to &E2-&FF as the view goes past the
; map's left edge)? Sets sprite_skip_x, sprite_columns and sprite_screen, or
; if none are, returns from the caller (draw_sprite) instead.
.clip_sprite_x
    STX clip_position
    LDA view_x
    CMP #&E2                            ; the view hangs off the map's left edge?
    BCS clip_sprite_x_wrapped
    CMP clip_position                   ; starts left of the view?
    BCS clip_sprite_left
    ADC #&1C                            ; the view's last column but 3
    CMP clip_position                   ; ends right of the view?
    BCC clip_sprite_right
.clip_sprite_x_screen
    TXA                                 ; wholly in view
    SEC
    SBC view_x
    ASL A
    ASL A
    ASL A
    ADC view_screen
    STA sprite_screen
    BCC clip_sprite_x_done
    INC sprite_screen_high
.clip_sprite_x_done
    RTS

; Out of view: drop the return address and return from draw_sprite.
.clip_sprite_out_of_view
    PLA
    PLA
    RTS

; The same for rows, from character y = Y and view_y: sets sprite_skip_y,
; sprite_rows and the high byte of sprite_screen.
.clip_sprite_y
    STY clip_position
    LDA view_y
    CMP #&E2
    BCC clip_sprite_y_on_map
    JMP clip_sprite_y_wrapped
.clip_sprite_left
    SBC clip_position
.clip_sprite_left_cells
    CMP #&04                            ; wholly out of view
    BCS clip_sprite_out_of_view
    STA sprite_skip_x                   ; the columns cut off
    EOR #&03
    STA sprite_columns
    LDA view_screen
    STA sprite_screen
    RTS
.clip_sprite_right
    ADC #&03
    CMP clip_position
    BCC clip_sprite_out_of_view
    SBC clip_position
    STA sprite_columns
    BCS clip_sprite_x_screen
.clip_sprite_x_wrapped
    CMP #&F1
    BCS clip_sprite_x_far_left
    CMP clip_position
    BCS clip_sprite_left
    BCC clip_sprite_x_screen
.clip_sprite_x_far_left
    ADC #&1B
    CMP clip_position
    BCC clip_sprite_right
    BCS clip_sprite_x_screen
.clip_sprite_y_on_map
    LDA view_y
    CMP clip_position
    BCS clip_sprite_top
    ADC #&1C
    CMP clip_position
    BCC clip_sprite_bottom
.clip_sprite_y_screen
    TYA
    SEC
    SBC view_y
    CLC
    ADC view_screen_high
    ADC sprite_screen_high
.clip_sprite_y_wrap
    AND #&1F
    ORA #HI(SCREEN)
    STA sprite_screen_high
    RTS
.clip_sprite_top
    SBC clip_position
    CMP #&04
    BCS clip_sprite_out_of_view
    STA sprite_skip_y
    EOR #&03
    STA sprite_rows
    LDA view_screen_high
    ADC sprite_screen_high
    STA sprite_screen_high
    BNE clip_sprite_y_wrap
.clip_sprite_bottom
    ADC #&03
    CMP clip_position
    BCS clip_sprite_bottom_cells
    JMP clip_sprite_out_of_view
.clip_sprite_bottom_cells
    SBC clip_position
    STA sprite_rows
    BCS clip_sprite_y_screen
.clip_sprite_y_wrapped
    CMP #&F1
    BCS clip_sprite_y_far_up
    CMP clip_position
    BCS clip_sprite_top
    BCC clip_sprite_y_screen
.clip_sprite_y_far_up
    ADC #&1B
    CMP clip_position
    BCC clip_sprite_bottom
    BCS clip_sprite_y_screen

; CRTC register 1, characters displayed per row, to 0: the display goes blank.
.blank_display
    LDX #&01
    LDA #&00

; CRTC register X = A.
.set_crtc_register
    STX CRTC_ADDR                       ; register
    STA CRTC_DATA                       ; value
    RTS

; The map view (the M key): the whole 64 x 64 map at a byte (4 pixels) by 4
; lines a cell, so 32 of its 64 columns at a time, scrolled by moving the
; screen start a character (and a map column) at a time; screen_start is the
; leftmost column shown. Draw all 32 columns.
.draw_map_view
    LDX #&1F
.draw_map_view_loop
    TXA
    PHA
    JSR draw_map_view_column
    PLA
    TAX
    DEX
    BPL draw_map_view_loop
.map_view_return
    RTS

; Scroll the map view one column, drawing the column that comes into view.
.map_view_scroll_left
    LDA screen_start                    ; already at the left?
    BEQ map_view_return
    DEC screen_start
    LDA #&00
.map_view_draw_left
    BEQ draw_map_view_column
.map_view_scroll_right
    LDA screen_start
    CMP #&20                            ; already at the right?
    BEQ map_view_return
    INC screen_start
    LDA #&1F                            ; the rightmost column

; Draw map view column A (0-31 across the screen; map column A plus
; screen_start), top to bottom: two map cells to a character cell.
; Clobbers: A, X, Y, work0-work3, sprite.
.draw_map_view_column
    CLC
    ADC screen_start
    STA work0
    STA sprite
    PHA                                 ; show from here
    JSR set_screen_start
    PLA
    LDY #HI(SCREEN) DIV 8               ; work0 = SCREEN + 8 * column
    STY work1
    LDY #&00
    STY work2
    LDX #&03
.draw_map_view_address
    ASL work0
    ROL work1
    LSR A                               ; work2 = map + 32 * map column
    ROR work2
    DEX
    BNE draw_map_view_address
    ADC #HI(map)
    STA work3
    LDA #&1F                            ; 32 character rows
    STA sprite_high
.draw_map_view_byte
    LDA (work2), Y
    PHA
    ASL A                               ; the even row's cell...
    ASL A
    LDY #&07
    JSR draw_map_view_cell
    PLA                                 ; ...and the odd's
    LSR A
    LSR A
    JSR draw_map_view_cell
    INY
    INC work2
    INC work1                           ; the next character row, wrapping
    BPL draw_map_view_next
    LDA #HI(SCREEN)
    STA work1
.draw_map_view_next
    DEC sprite_high
    BPL draw_map_view_byte
    RTS

; Wait for the vsync, then point the CRTC at screen_start.
; Clobbers: A, X.
.set_screen_start
    JSR wait_vsync
    LDX #&0C
    LDA screen_start_high
    JSR set_crtc_register
    INX
    LDA screen_start
    JMP set_crtc_register

; Wait for the vertical sync (OSBYTE &13). Preserves A.
.wait_vsync
    PHA
    LDA #&13
    JSR OSBYTE
    PLA
    RTS

; Draw one map cell in the map view: A's bits 2-5 are its type, 4 times;
; Y the last of its 4 lines. The player's cell shows the player instead.
.draw_map_view_cell
    AND #&3C
    TAX
    LDA sprite                          ; the player's cell?
    CMP player_x
    BNE draw_map_view_pattern
    TYA
    LSR A
    LSR A
    LSR A
    LDA sprite_high
    EOR #&1F
    ROL A
    CMP player_y
    BNE draw_map_view_pattern
    LDA facing                          ; the player, facing their way
    ASL A
    ASL A
    ADC #map_view_player - map_view_patterns
    TAX
.draw_map_view_pattern
    STX draw_map_view_copy + 1          ; self-modified: the pattern
    LDX #&03
.draw_map_view_copy
    LDA map_view_patterns, X
    STA (work0), Y
    DEY
    DEX
    BPL draw_map_view_copy
    RTS

; What's in map cell (X, Y), as the player meets it: off the map is lava (A),
; and the exit, while it shows its icon (F), is a wall (8).
; Returns: A = the cell type, Z set if it's empty floor (0).
; Clobbers: X, Y, cell_x, cell_y, map_pointer.
.cell_at
    CPX exit_x
    BNE cell_at_checked
    CPY exit_y
    BNE cell_at_checked
    JSR read_map_cell
    CMP #&0F                            ; the exit's icon
    BNE cell_at_exit                    ; a wall
    LDA #&08
.cell_at_exit
    CMP #&00
    RTS

; As cell_at but without the exit. Returns with the carry set off the map.
.cell_at_checked
    CPX #&40                            ; off the map?
    BCS cell_off_map
    CPY #&40
    BCC read_map_cell
.cell_off_map
    LDA #&0A                            ; lava
    RTS

; Read map cell (X, Y), on the map.
.read_map_cell
    STX cell_x
    STY cell_y
    JSR map_address
    LDA (map_pointer), Y
    LDX cell_low_nibble
    BNE read_map_cell_nibble
    LSR A                               ; even rows in the high nibble
    LSR A
    LSR A
    LSR A
.read_map_cell_nibble
    AND #&0F
    CLC
.set_cell_return
    RTS

; Put the player in the view at its top left cell (X, Y) + (4, 4), the view
; showing half a cell beyond: the start of a level, or a teleport.
.place_player
    STX start_x
    STY start_y
    TXA
    STA view_cell_x
    PHA
    ASL A
    ASL A
    CLC
    ADC #&02
    STA view_x                          ; half a cell in
    PLA
    ADC #&04                            ; the player is 4 cells in
    STA player_x
    TAX
    TYA
    STA view_cell_y
    PHA
    ASL A
    ASL A
    CLC
    ADC #&02
    STA view_y
    PLA
    ADC #&04
    STA player_y
    JSR find_front

; Empty the player's cell.
.clear_player_cell
    LDX player_x
    LDY player_y
    LDA #&00

; Set map cell (X, Y) to type A, if it's on the map. The exit can't be
; emptied.
; Clobbers: A, X, Y, work0, cell_x, cell_y, map_pointer.
.set_cell
    CPX #&40
    BCS set_cell_return
    CPY #&40
    BCS set_cell_return
    CPX exit_x
    BNE set_cell_write
    CPY exit_y
    BNE set_cell_write
    CMP #&00                            ; don't empty the exit
    BEQ set_cell_done
.set_cell_write
    STA work0
    STX cell_x
    STY cell_y
    JSR map_address
    LDA (map_pointer), Y
    LDX cell_low_nibble
    BEQ set_cell_high_nibble
    AND #&F0
    JMP set_cell_store
.set_cell_high_nibble
    ASL work0
    ASL work0
    ASL work0
    ASL work0
    AND #&0F
.set_cell_store
    ORA work0
    STA (map_pointer), Y
.set_cell_done
    RTS

; Start the tune: everything back to the beginning, the sound event on, and a
; silent note on channels 1 and 2 together, whose ending starts the event
; handler off.
.start_tune
    LDX #&00
    LDY #&04
.start_tune_reset
    STX tune_position, Y
    STX sound_amplitude, Y
    DEY
    BPL start_tune_reset
    LDA #&0E                            ; enable event 0, output buffer empty
    JSR OSBYTE
    LDY #&01                            ; channel 1, in step with one other
    STY sound_channel
    STY sound_channel_high
    DEY
    STY sound_duration_high
    LDX #&30
    LSR A                               ; OSWORD 7, SOUND
    JSR OSWORD
    INC sound_channel                   ; channel 2
    LDX #&30
    LDY #&00
    JMP OSWORD

; Flush all the buffers, which stops the tune (and loses any keys pressed).
.flush_buffers
    LDX #&00
    LDA #&0F
    JMP OSBYTE

; How a step in each direction moves: left, right, up, down, then up-left,
; up-right, down-left, down-right, and 8, nowhere.
.direction_dx
    EQUB -1, 1, 0, 0, -1, 1, -1, 1, 0
.direction_dy
    EQUB 0, 0, -1, 1, -1, -1, 1, 1, 0

; Directions turned: indexed by the direction plus 0 for its opposite, 4 for
; itself, 8 turned clockwise and 12 anticlockwise.
.turns
    EQUB 1, 0, 3, 2         ; opposite
    EQUB 0, 1, 2, 3         ; the same
    EQUB 2, 3, 1, 0         ; clockwise
    EQUB 3, 2, 0, 1         ; anticlockwise

; Look at the cell in front of the player.
; Returns: front_x, front_y, front_cell (and A, Z as cell_at).
.find_front
    LDY facing
    LDA player_x
    CLC
    ADC direction_dx, Y
    STA front_x
    LDA player_y
    CLC
    ADC direction_dy, Y
    STA front_y
.look_at_front
    LDX front_x
    LDY front_y
.look_at
    STX front_x
    STY front_y
    JSR cell_at
    STA front_cell
    RTS

; The title screen's pictures: six flames (a monster's picture) and the
; player.
.draw_title_pictures
    LDA #&00
    STA sprite
    LDY #&0A
.draw_title_flame
    TYA
    PHA
    LDA #HI(io_tiles + &E * 128)        ; a flame
    STA sprite_high
    LDA title_flames, Y
    TAX
    LDA title_flames + 1, Y
    TAY
    SEC
    JSR draw_sprite
    PLA
    TAY
    DEY
    DEY
    BPL draw_title_flame
    LDA #HI(io_player + 2 * 128)        ; the player
    STA sprite_high
    LDX #&10
    LDY #&1B
    SEC
    JMP draw_sprite

; x, y in character cells.
.title_flames
    EQUB 6, 24, 16, 8, 16, 19, 10, 21, 26, 24, 21, 22

; Work out alternate_offsets for this level from alternate_cells: for each of
; the 4 cell types with a second picture, two bits say whether it's used on
; odd and on even squares.
.setup_alternate_pictures
    LDX #&03
    LDA #&00
    STA work0
    LDY #&11
.setup_alternate_clear
    STA alternate_offsets, Y            ; no second pictures
    DEY
    BPL setup_alternate_clear
    LDA #&C0                            ; two bits a cell type, from the top
.setup_alternate_cell
    PHA
    ASL work0
    LDA alternate_pictures, X
    SEC                                 ; the difference in pictures...
    SBC alternate_cell_types, X
    PHA
    ASL A
    PLA
    ROR A
    STA work1                           ; ...times 128
    ROR work0
    PLA
    STA work2
    PHA
    AND alternate_cells                 ; this cell type's two bits
.setup_alternate_bits
    LSR work2
    BCS setup_alternate_store
    LSR A
    BCC setup_alternate_bits
.setup_alternate_store
    STA work3
    TXA
    ASL A
    TAY
    LSR work3                           ; bit 0: odd squares
    BCC setup_alternate_even
    LDA work0
    STA alternate_offsets_odd, Y
    LDA work1
    STA alternate_offsets_odd + 1, Y
.setup_alternate_even
    LSR work3                           ; bit 1: even squares
    BCC setup_alternate_next
    LDA work0
    STA alternate_offsets_even, Y
    LDA work1
    STA alternate_offsets_even + 1, Y
.setup_alternate_next
    DEX
    PLA
    LSR A
    LSR A
    BCC setup_alternate_cell
    RTS

; Print object A's name.
.print_object_name
    ASL A                               ; 12 characters a name
    ASL A
    STA work0
    ASL A
    ADC work0
    TAY
    LDX #&0B

; Print X + 1 characters from io_object_names + Y.
.print_names_text
    LDA io_object_names, Y
    JSR OSWRCH
    INY
    DEX
    BPL print_names_text
    RTS

; The title and backpack screens' frame: a row of cell 5's picture across the
; top and bottom of the view and a column down each side (the view is offset
; two characters, so only half of each shows).
.draw_title_border
    LDA #&08                            ; 9 pictures a side
    STA work2
.draw_title_border_loop
    LDY #&00
    JSR draw_border_across
    LDY #&20
    JSR draw_border_across
    LDX #&00
    JSR draw_border_down
    LDX #&20
    JSR draw_border_down
    DEC work2
    BPL draw_title_border_loop
    RTS
.draw_border_across
    LDA work2
    ASL A
    ASL A
    TAX
    BPL draw_border_picture
.draw_border_down
    LDA work2
    ASL A
    ASL A
    TAY
.draw_border_picture
    LDA #LO(io_tiles + 5 * 128)
    STA sprite
    LDA #HI(io_tiles + 5 * 128)
    STA sprite_high
    SEC
    JMP draw_sprite

; The entry and edit codes are printed in a base-32 alphabet, "1"-"9" then
; "A"-"W". Print A's low 5 bits, then its top 5 (bits 3-7).
.print_code_byte
    PHA
    JSR print_code_digit
    PLA
    LSR A
    LSR A
    LSR A
.print_code_digit
    AND #&1F
    CLC
    ADC #&31                            ; '1' for 0
    CMP #&3A
    BCC print_code_char
    ADC #&06                            ; 'A' for 9
.print_code_char
    JMP OSWRCH

; Scramble a byte for a code: rotate it left a bit, then swap each pair of
; bits. Returns: A. Clobbers: work0.
.scramble
    PHA
    ASL A                               ; the top bit...
    PLA
    ROL A                               ; ...round to the bottom
    PHA
    AND #&55                            ; the even bits up...
    ASL A
    STA work0
    PLA
    AND #&AA                            ; ...and the odd ones down
    LSR A
    ORA work0
    RTS

; Print the characters after the JSR, up to a NOP (&EA), and carry on at the
; NOP. Clobbers: A, Y, work0, work1.
.print_inline
    PLA                                 ; the return address is the byte before the text
    CLC
    ADC #&01
    STA work0
    PLA
    ADC #&00
    STA work1
    LDY #&00
.print_inline_loop
    LDA (work0), Y
    CMP #&EA                            ; NOP ends it
    BEQ print_inline_return
    JSR OSWRCH
    INC work0
    BNE print_inline_loop
    INC work1
    BNE print_inline_loop
.print_inline_return
    JMP (work0)                         ; and runs

; The backpack screen's text: the time left (in red when it's under 10), the
; level, the tune and sound effects settings, and the score.
.print_status
    JSR print_inline
    EQUB &1F, &09, &13, &11, &03
    EQUS "Time:"
    NOP
    LDA time_left
    CMP #10                             ; under 10...
    BCC print_status_time
    PHA
    JSR print_inline                    ; ...stays red
    EQUB &11, &02
    NOP
    PLA

; A decimal number up to 255.
.print_status_time
    LDX #&FF
.print_hundreds
    INX
    SEC
    SBC #100                            ; hundreds
    BCS print_hundreds
    ADC #100
    PHA
    TXA
    BEQ print_tens
    JSR print_digit
.print_tens
    TAY
    PLA
    LDX #&00
.print_tens_loop
    INX
    SEC
    SBC #10                             ; tens
    BCS print_tens_loop
    ADC #10
    PHA
    DEX
    BNE print_tens_digit                ; no tens...
    TYA
    BEQ print_units                     ; ...and no hundreds: just the units
.print_tens_digit
    TXA
    LDX #&03
    CMP #&00
    JSR print_digit
.print_units
    PLA
    JSR print_digit
    JSR print_inline
    EQUB &1F, &00, &15, &11, &03
    EQUS "Level:"
    EQUB &11, &02
    NOP
    JSR print_level

; Also printed when T or S changes them.
.print_sound_settings
    JSR print_inline
    EQUB &1F, &09, &17, &11, &03
    EQUS "Tune"
    NOP
    LDA tune_off
    JSR print_yes_no
    JSR print_inline
    EQUB &1F, &02, &18, &11, &03
    EQUS "SoundFX"
    NOP
    LDA effects_off
    JSR print_yes_no
    JSR print_inline
    EQUB &1F, &10, &15
    NOP

; "Score:" and the score, 4 BCD digits.
.print_score
    JSR print_inline
    EQUB &11, &03
    EQUS "Score:"
    EQUB &11, &02
    NOP
    LDX #&00
    LDA score_high
    JSR print_bcd
    LDA score
.print_bcd
    PHA
    LSR A
    LSR A
    LSR A
    LSR A
    JSR print_digit
    PLA
    AND #&0F

; Print digit A, counting digits in X: leading zeros print nothing (VDU 0)
; until the third, and 0 prints as the letter O.
.print_digit
    BEQ print_digit_zero
    LDX #&03
    ORA #&30                            ; a digit; zeros from now on print
    BNE print_digit_char
.print_digit_zero
    CPX #&03                            ; a leading zero?
    BCC print_digit_char
    LDA #&4F                            ; zero is the letter O
.print_digit_char
    INX                                 ; VDU 0 prints nothing
    JMP OSWRCH

; Print ": yes" for A zero (the tune_off and effects_off flags), else ": no".
.print_yes_no
    PHA
    JSR print_inline
    EQUB &3A, &11, &02
    NOP
    PLA
    BEQ print_yes
    JSR print_inline
    EQUB &6E, &6F
    NOP
    RTS
.print_yes
    JSR print_inline
    EQUB &79, &65, &73
    NOP
    RTS

; Never called.
.print_level_at
    JSR print_inline
    EQUB &1F, &08, &11, &11, &02
    NOP
.print_level
    LDA level
    CLC
    ADC #&31                            ; '1' for level 0
    JMP OSWRCH

; "WELL DONE!" in blocks: 11 rows of 32 bits, a bit a character cell.
.well_done_bitmap
    EQUB %10001011, %10100001, %00000000, %00000000
    EQUB %10001010, %00100001, %00000000, %00000000
    EQUB %10001011, %00100001, %00000000, %00000000
    EQUB %10101010, %00100001, %00000000, %00000000
    EQUB %01010011, %10111101, %11100000, %00000000
    EQUB %00000000, %00000000, %00000000, %00000000
    EQUB %11100011, %00100101, %11010000, %00000000
    EQUB %10010100, %10110101, %00010000, %00000000
    EQUB %10010100, %10111101, %10010000, %00000000
    EQUB %10010100, %10101101, %00000000, %00000000
    EQUB %11100011, %00100101, %11010000, %00000000

; The bottom half of a block's character cells: a shadow.
.well_done_block
    EQUB &F5, &FE, &FB, &FE, &F7, &FD, &FB, &FF

; After a level: clear 13 character rows across the middle of the view and
; show WELL DONE! in big letters, then wait 4 seconds.
.show_well_done
    LDA view_screen
    STA screen
    LDA view_screen_high
    CLC                                 ; nine character rows down
    ADC #9
    JSR wrap_screen_high
    LDA #13                             ; 13 rows
    STA cell_low_nibble
.show_well_done_clear
    LDX #&20
.show_well_done_cell
    LDY #&07
    LDA #&00
.show_well_done_blank
    STA (screen), Y
    DEY
    BPL show_well_done_blank
    JSR next_screen_cell
    DEX
    BNE show_well_done_cell
    DEC cell_low_nibble
    BNE show_well_done_clear
    LDA view_screen                     ; 6 characters in...
    CLC
    ADC #6 * 8
    STA screen
    LDA view_screen_high                ; ...ten rows down
    ADC #10
    AND #&3F
    ORA #HI(SCREEN)
    STA screen_high
    LDA #&80                            ; the bitmap's top bit first
    STA cell_low_nibble
.show_well_done_bit
    LDA well_done_bitmap, X
    AND cell_low_nibble
    BEQ show_well_done_next
    LDY #&0F                            ; the block's two character cells...
    LDA #&0C
.show_well_done_block
    STA (screen), Y
    DEY
    BPL show_well_done_block
    LDY #&07                            ; ...the lower with its shadow
.show_well_done_shade
    LDA well_done_block, Y
    STA (screen), Y
    DEY
    BPL show_well_done_shade
.show_well_done_next
    JSR next_screen_cell
    LSR cell_low_nibble
    BCC show_well_done_bit
    ROR cell_low_nibble                 ; the carry: back to the top bit
    INX
    CPX #well_done_block - well_done_bitmap; 11 rows of 4 bytes
    BCC show_well_done_bit
    LDA #200                            ; 4 seconds
    BITABS                                  ; skip the next LDA

; Wait A fiftieths of a second, by the OS's vsync countdown.
.wait_a_second
    LDA #50
.wait_ticks
    STA OS_COUNTDOWN
.wait_ticks_loop
    LDA OS_COUNTDOWN
    BNE wait_ticks_loop
    RTS

; A random number from 0 to Y - 1, from the free-running VIA timers.
; Clobbers: work0.
.random
    EOR SYSVIA_T1CL                     ; the timers' low bytes are as good as random
    EOR USRVIA_T2CH
    STY work0
.random_mod
    CMP work0
    BCC random_done
    SBC work0
    BCS random_mod
.random_done
    RTS

; The game is over: the player bursts into flames that spread out across the
; view, crackling.
.burn_up
    JSR wait_a_second
    LDA view_x                          ; the middle of the view
    CLC
    ADC #&0E
    STA view_sub_x
    LDA view_y
    CLC
    ADC #&0D
    STA view_sub_y
    LDA #&02                            ; flames spread from 2 cells to 31
    STA steps
.burn_up_ring
    LDA #&64                            ; 100 flames a ring
    STA count_across
.burn_up_flame
    LDA USRVIA_T2CL                     ; either flame picture
    AND #&80
    STA sprite
    LDY steps
    JSR random
    ADC view_sub_x
    TAX
    JSR random                          ; within steps of the middle
    ADC view_sub_y
    TAY
    LDA #HI(io_tiles + &E * 128)
    STA sprite_high
    SEC
    JSR draw_sprite                     ; a flame
    DEC count_across
    BNE burn_up_flame
    BIT USRVIA_T2CL                     ; now and then...
    BVC burn_up_next_ring
    LDY #&04
    JSR random
    TAX
    INX
    LDY #&03
    JSR random
    ORA #&04
    JSR L1F7A                           ; ...a crackle
.burn_up_next_ring
    DEC view_sub_x                      ; the ring grows
    DEC view_sub_y
    INC steps
    INC steps
    LDA steps
    CMP #&20
    BCC burn_up_ring
    RTS

; Never used.
.unused_1260
    EQUB &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00
    EQUB &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00
    EQUB &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00, &00

; The picture for an object cell (F) at (X, Y): the exit's icon, the icon of
; the object there, or if none, the picture kept for that.
; Returns: X, Y = the picture's address.
.object_picture_at
    CPX exit_x
    BNE object_picture_find
    CPY exit_y
    BNE object_picture_find
.exit_picture
    LDX #LO(io_object_icons + 15 * 32)
    LDY #HI(io_object_icons + 15 * 32)
    RTS
.object_picture_find
    JSR L1C69
    BCC no_object_picture

; Object Y / 4's icon.
.object_icon
    LDA objects + 2, Y
    ORA #&10                            ; &10 + the icon
    JMP thing_picture
.no_object_picture
    LDX #LO(io_no_object_picture)
    LDY #HI(io_no_object_picture)
    RTS

; The game proper starts here, run once. It's also where each level's eight
; objects are kept, 4 bytes each (see objects), over this code once it has
; run.
.game_start
    EOR #&48                            ; (the first object's x and y, harmless)
    LDA #LO(error_handler)              ; errors go to error_handler
    STA BRKV
    LDA #HI(error_handler)
    STA BRKV + 1
    LDA #&00
    STA score
    STA score_high
    STA effects_off
    STA tune_off
    STA fill_screen
    STA level
    JSR flush_buffers                   ; no keys waiting
    JSR L222E                           ; load the mission

; The title screen, then a game: three lives.
.new_game
    JSR title_screen
    LDX #&03                            ; three lives
    STX lives
    LDA #&00
    STA score
    STA score_high

; A level from the start, and after losing a life.
.start_level
    JSR setup_level
.restart_level
    JSR reset_level
    JSR clear_screen
    JSR set_level_palette               ; the level's palette
    JSR redraw_view
    LDA tune_off
    BNE game_loop
    JSR start_tune

; The game's main loop, a cycle at a time: the clock ticks at the mission's
; rate (not while in a pipe), with warning beeps in the last 20; once the
; exit's charge is set (stage 1) the time left is scored and the player has 4
; ticks to get clear.
.game_loop
    LDA time_left
    BEQ time_up                         ; out of time?
    JSR play_cycle                      ; move the player and everything else
    LDA pipe_move
    BNE check_dead                      ; the clock stops in pipes
    LDA clock_fraction
    CLC
    ADC io_time_rate                    ; the mission's clock rate
    STA clock_fraction
    BCC check_dead
    DEC time_left
    LDA time_left
    CMP #20                             ; the last 20 ticks...
    BCS check_dead
    LDA stage
    BNE warn_time_running_out
    LDA #&00                            ; ...beep
    JSR L1FF1
    JMP check_dead
.warn_time_running_out
    LDX #&02                            ; ...a different beep with the charge set
    LDA #&04
    JSR L1F7A
.check_dead
    LDA player_dead
    BNE lose_life
    LDA stage
    CMP #&01                            ; the charge has just been set:
    BNE game_loop
    INC stage                           ; stage 2: run
    LDX time_left                       ; a point for each tick left
    JSR L21DB
    LDA #&04                            ; and 4 ticks to get clear
    STA time_left
    BNE game_loop

; Out of time: with the charge set, the player is safe 5 or more cells from
; the exit, across or down; otherwise they're caught (the screen flashes).
.time_up
    LDX stage
    CPX #&02                            ; the charge set?
    BNE lose_life
    JSR far_from_exit                   ; far enough across...
    BCS level_complete
    INX
    SEC
    JSR far_from_exit                   ; ...or down: safe
    BCS level_complete
    INC fill_screen                     ; caught in it: flash
    JSR clear_screen
    DEC fill_screen

; Lose a life. With none left, burn up and back to the title; if the charge
; had been set the level counts as done.
.lose_life
    JSR flush_buffers
    JSR L1F76                           ; a sound
    JSR draw_player
    DEC lives
    BNE lose_life_again
    JSR burn_up                         ; the last life
    JSR L1ADE
    JMP new_game
.lose_life_again
    LDX #&09
    JSR vdu_palette                     ; colour 0 flashes
    JSR L1ADE
    LDA stage                           ; died after setting the charge?
    BNE next_level
    JMP restart_level

; The level's done: flash the palette, WELL DONE, 100 points.
.level_complete
    JSR flush_buffers
    LDA #&05
    JSR L1F78
    JSR flash_palette                   ; flash
    JSR show_well_done
    INC stage                           ; stage 3: done
    LDX #100                            ; 100 points
    JSR L21DB

; On to the next level, or after the fourth, the end of the mission. Doing a
; level without losing a life lets the next game start from the next one.
.next_level
    INC level
    LDA level
    CMP #IO_LEVELS                      ; four levels
    BCS mission_complete
    LDX lives
    CPX #&03                            ; no lives lost...
    BCC show_edit_code
    CMP furthest_level                  ; ...so the title can start on the next level
    BCC show_edit_code
    STA furthest_level
.show_edit_code
    JSR set_level_palette
    LDA lives
    CLC
    JSR L1C31                           ; the backpack screen, with the next level's edit code
    JSR L1C13                           ; wait for Space
    JMP start_level
.mission_complete
    JSR L1B1A
    JMP new_game

; Flash colour 0 through physical colours 7 down to 0, 8 times, a frame each,
; then back to the level's palette.
.flash_palette
    LDA #&08
    LDX #&01

; The same A times, X frames a colour.
.flash_palette_times
    STA work0                           ; flashes
    STX work2                           ; frames a colour
.flash_palette_cycle
    LDX #&07
.flash_palette_colour
    JSR vdu_palette                     ; logical 0 = physical X
    LDA work2
    STA work4
    TXA
.flash_palette_wait
    JSR wait_vsync                      ; wait
    DEC work4
    BNE flash_palette_wait
    TAX
    DEX
    BPL flash_palette_colour
    DEC work0
    BNE flash_palette_cycle

; Set the palette for the level (or level A from set_palette) from
; io_palettes.
; Clobbers: A, X, Y, work0.
.set_level_palette
    LDA level
.set_palette
    ASL A
    ASL A
    ADC #&03                            ; the level's last colour first
    TAY
    LDA #&03
    STA work0
.set_palette_loop
    JSR set_palette_entry
    DEY
    DEC work0
    BNE set_palette_loop
.set_palette_entry
    LDX io_palettes, Y                  ; logical << 4 | physical

; VDU 19, X >> 4, X, 0, 0, 0: logical colour X's high nibble is physical
; colour X's low.
.vdu_palette
    LDA #&13                            ; VDU 19
    JSR OSWRCH
    TXA
    LSR A
    LSR A
    LSR A
    LSR A
    JSR OSWRCH
    TXA
    JSR OSWRCH
    LDA #&00
    JSR OSWRCH
    JSR OSWRCH
    JMP OSWRCH

; Is the player 5 or more cells from the exit, across (X = 2) or down (3)?
; Returns: carry set if so. Called with the carry set.
.far_from_exit
    LDA player_x - 2, X                 ; player_x or player_y...
    SBC exit_x - 2, X                   ; ...less exit_x or exit_y
    BCS far_from_exit_distance
    EOR #&FF                            ; how far
    ADC #&01
.far_from_exit_distance
    CMP #5
    RTS

; Space on the title screen: start, returning from title_screen.
.title_start
    JSR resync_timer

; Just after a vsync, with interrupts off, restart the system VIA's timer 1
; (the OS's 100 Hz tick) from its latch, keeping its interrupts clear of the
; vsync's.
.resync_timer
    JSR wait_vsync
    SEI
    LDY #&09                            ; a little more
    JSR L1E20
    LDA SYSVIA_T1LL                     ; timer 1 from its latch
    STA SYSVIA_T1LL
    LDA SYSVIA_T1LH
    STA SYSVIA_T1CH
    CLI
    RTS

; The title screen: Space starts at the chosen level, S steps the level (up to
; furthest_level), L loads another mission.
; Returns: with level and started_late set.
.title_screen
    LDA #&00                            ; level 1 unless S is pressed
    STA started_late
    STA level
    JSR set_level_palette
    JSR draw_title_screen               ; the title screen's pictures
    JSR print_inline
    EQUB &1F, &13, &10, &11, &03
    EQUS "Start:"
    EQUB &1F, &07, &0F
    NOP
    JSR print_score
    LDX #&01
    LDA #&0F
    JSR OSBYTE                          ; flush the keyboard buffer
.title_screen_key
    JSR print_inline
    EQUB &1F, &05, &11, &11, &02
    NOP
    JSR print_level                     ; the level to start on
    JSR OSRDCH
    BCC title_screen_got_key            ; Escape?
    JSR L1C21
.title_screen_got_key
    AND #&DF                            ; upper case, and Space is 0
    BEQ title_start                     ; Space: start
    CMP #&53                            ; S...
    BEQ title_screen_next_level
    CMP #&4C                            ; L: load a mission
    BNE title_screen_key
    JMP L21F1
.title_screen_next_level
    LDX level                           ; S: the next level that can be started on
    CPX furthest_level
    BCC title_screen_set_level
    LDX #&FF
.title_screen_set_level
    INX
    STX level
    STX started_late
    BPL title_screen_key                ; always

; Clear the screen for the title or backpack screens: the frame, the heading,
; the flames and the player.
.draw_title_screen
    JSR print_inline
    EQUB &06, &04, &1A, &11, &80
    NOP
    JSR draw_screen_frame
    JMP draw_title_pictures

; Return from the caller's caller.
.return_from_caller
    PLA
    PLA
    RTS

; Empty the cell under monster X / 4.
.empty_monster_cell
    JSR L2130
    LDA #&00

; Set map cell (X, Y) to A and draw it. Off the map, nothing happens.
; Clobbers: A, X, Y and the drawing variables.
.set_cell_and_draw
    STA work1                           ; the type
    TXA
    PHA
    TYA
    PHA
    LDA work1
    JSR set_cell                        ; off the map?
    BCS return_from_caller
    PLA
    ASL A                               ; cell y * 4
    ASL A
    TAY
    PLA
    ASL A
    ASL A                               ; cell x * 4
    TAX
    LDA work1

; Draw thing A (as thing_picture) at character position (X, Y): a cell's own
; picture whole, an icon on the floor.
.draw_thing_at
    PHA
    STX sprite
    STY sprite_high
    JSR L2135
    PLA
    JSR thing_picture                   ; its picture
    SEC                                 ; a cell's picture: whole
    BEQ draw_picture_at
.draw_icon_at
    CLC                                 ; an icon: on the floor
.draw_picture_at
    TXA                                 ; sprite and X, Y swapped
    LDX sprite
    STA sprite
    TYA
    LDY sprite_high
    STA sprite_high
    JMP draw_sprite

; The exit's icon, top left of the backpack screen once the exit is lit.
.draw_exit_icon
    LDA #&04                            ; character position 4, 4
    STA sprite
    STA sprite_high
    JSR exit_picture
    JMP draw_icon_at

; Start (or restart) the level: facing up, the direction keys as they were,
; the clock reset, the exit back in place, the player at the start.
.reset_level
    LDX #&02                            ; facing up
    STX facing
    INX
.reset_level_keys
    LDA menu_key_left, X                ; the direction keys back as MENU set them
    STA key_left, X
    DEX
    BPL reset_level_keys
    INX
    STX stage                           ; all zero
    STX pipe_move
    STX player_dead
    STX frame_counter
    STX player_frame
    STX action
    STX clock_fraction
    LDX exit_x
    LDY exit_y
    LDA #&0F                            ; the exit's icon on its cell
    JSR set_cell
    LDA level
    ASL A
    ASL A
    ASL A
    TAY
    LDA io_level_setup + LEVEL_TIME, Y
    STA time_left                       ; the clock
    LDX start_x
    LDY start_y
    JSR place_player

; Forget which direction keys were down (and the action is 0 too).
.clear_keys_down
    LDX #&03
    LDA #&00
.clear_keys_down_loop
    STA keys_were_down, X               ; nothing held
    DEX
    BPL clear_keys_down_loop
    RTS

; Copy the level's data out of IO into the variables the game plays with: its
; setup, its map (to map, where it can change), monsters, objects and
; triggers; the backpack starts empty.
.setup_level
    LDA level
    ASL A
    ASL A
    ASL A
    ADC #&07
    TAY
    LDX #&07
.setup_level_setup
    LDA io_level_setup, Y               ; the 8 setup bytes, from start_x
    STA start_x, X
    DEY
    DEX
    BPL setup_level_setup
    INY
    TYA
    PHA
    ADC #HI(io_maps)                    ; the level's map
    STA work1
    LDY #&00
    STY work0
    STY backpack_slot
    STY thrown_direction
    STY pushes_left
    STY clock_fraction
    STY work2
    LDA #HI(map)                        ; goes to map
    STA work3
    LDX #&08                            ; 8 pages
.setup_level_map
    LDA (work0), Y
    STA (work2), Y
    INY
    BNE setup_level_map
    INC work1
    INC work3
    DEX
    BNE setup_level_map
    PLA
    ASL A                               ; level * 16
    ADC #&0F
    TAY
    LDX #&0F
.setup_level_monsters
    LDA io_level_monsters, Y            ; monsters
    STA monster_x, X
    DEY
    DEX
    BPL setup_level_monsters
    INY
    TYA                                 ; level * 32
    ASL A
    ADC #&1F
    TAY
    LDX #&1F
.setup_level_objects
    LDA io_level_objects, Y             ; objects...
    STA objects, X
    LDA io_level_trigger_flags, Y       ; ...and trigger flags
    STA trigger_flags, X
    DEY
    DEX
    BPL setup_level_objects
    INY
    TYA                                 ; level * 64
    ASL A
    ADC #&3F
    TAY
    LDX #&3F
.setup_level_triggers
    LDA io_level_trigger_places, Y      ; triggers' places...
    STA trigger_places, X
    LDA io_level_trigger_args_0, Y      ; ...and arguments
    STA trigger_args, X
    LDA io_level_trigger_args_1, Y
    STA trigger_args + 64, X
    DEY
    DEX
    BPL setup_level_triggers
    LDY #&03
.setup_level_backpack
    STX backpack, Y                     ; X = &FF: every slot empty
    DEY
    BPL setup_level_backpack
    JMP setup_alternate_pictures

; One cycle of play: the player's turn, then four frames of the keys being
; read and things moving, then the monsters are marked on the map as deadly
; cells (E) until they next move.
.play_cycle
    JSR player_turn
    LDA player_dead                     ; dead?
    BNE play_cycle_done
    JSR think                           ; think...
    LDA #&04
    STA work2
.play_cycle_step
    JSR wait_vsync                      ; ...then four frames
    JSR L1A8F
    JSR move_things
    DEC work2
    BNE play_cycle_step
.mark_monsters
    LDA #&0E                            ; monsters are deadly cells
    BNE set_monster_cells

; Move a thrown object on a cell, advance the frame counter, decide where each
; monster goes next, and take the monsters off the map.
.think
    JSR L1D38                           ; a thrown object
    LDA frame_counter
    CLC
    ADC #&20
    STA frame_counter
    LDA #&03
    STA work4
.think_monster
    LDA work4                           ; each monster's 4 bytes...
    ASL A
    ASL A
    ADC #&03
    TAX
    LDY #&03
.think_monster_copy
    LDA monster_x, X                    ; ...to work0-work3
    STA work0, Y
    DEX
    DEY
    BPL think_monster_copy
    INX
    JSR L213E                           ; where it goes
    DEC work4
    BPL think_monster
    LDA #&00                            ; and take them off the map
.set_monster_cells
    STA work5
    LDA #&03
    STA work4
.set_monster_cell
    LDA work4
    ASL A
    ASL A
    TAX
    LDA monster_direction, X            ; not out?
    CMP #&08
    BCS set_monster_cell_next
    JSR L2130
    LDA work5
    JSR set_cell
.set_monster_cell_next
    DEC work4
    BPL set_monster_cell
.play_cycle_done
    RTS

; Is the key with negative INKEY number X pressed? (OSBYTE &81.)
; Returns: Z set if it is.
.key_pressed
    LDA #&81                            ; INKEY
    LDY #&FF
    JSR OSBYTE
    INX                                 ; &FF + 1 = 0 when pressed
.do_nothing
    RTS

; The player's turn: Escape gives up a life (with SHIFT, the game). Then look
; at what's in front of the player and underneath, try every trigger, and do
; an action: the one pressed, or the pipe's move while in a pipe.
.player_turn
    BIT ESCAPE_FLAG                     ; Escape?
    BPL player_turn_no_escape
.give_up
    LDX #&FF                            ; SHIFT too?
    JSR key_pressed
    BNE give_up_life
    INX                                 ; one life left, about to be lost
    STX lives
.give_up_life
    INC player_dead
    LDA #&7E                            ; (no more moves)
    STA pipe_move
    JMP OSBYTE                          ; acknowledge Escape
.player_turn_no_escape
    JSR find_front
    LDX player_x
    LDY player_y
    JSR cell_at                         ; what the player stands on...
    JSR L19C4                           ; ...as it affects pipes
    LDA #&00
.player_turn_triggers
    PHA
    LDY #&00                            ; walking onto triggers
    JSR L1E88
    PLA
    CLC
    ADC #&01
    CMP #&20                            ; 32 of them
    BNE player_turn_triggers
    LDX player_x
    LDY player_y
    JSR cell_at
    JSR L194D                           ; lava, fire, the exit...
    LDA player_dead
    BNE do_nothing
    LDA action                          ; an action already decided?
    CMP #&0B
    BEQ do_action
    LDA pipe_move                       ; in a pipe, carried on...
    BNE do_action
    JSR L1A8F                           ; ...or a key
    LDA action
.do_action
    ASL A                               ; action_table
    TAY
    LDA #&00
    STA action
    LDX D2351, Y
    LDA D2351+1, Y

; Jump to X + 256 * A.
.jump_to
    STX work0
    STA work1
    JMP (work0)

; CTRL: the backpack screen. The mission, the lives left, the backpack's
; contents and the selected object's name, the time, level, score and sound
; settings; see backpack_keys. Space goes back to the game.
.backpack_screen
    JSR save_view                       ; remember where the view was
    LDA lives
    JSR draw_backpack_screen            ; the screen, the lives
    LDA #&80
    JSR print_selected_name             ; no name yet
    JSR selection_position              ; the selection box...
    LDA #&55
    JSR draw_page_picture               ; ...drawn
    JSR print_status
.backpack_screen_loop
    BIT ESCAPE_FLAG                     ; Escape: lose a life
    BMI give_up
    JSR backpack_keys                   ; the backpack screen's keys
    LDX #LO(KEY_SPACE)                  ; Space
    JSR key_pressed
    BNE backpack_screen_loop
.backpack_screen_done
    LDA work4                           ; the view as it was
    STA view_x
    LDA work5
    STA view_y
    JMP redraw_view

; The backpack screen's keys: Z and X (as MENU set them, whatever a trigger
; has done to this level's) move the selection, M shows the map, S and T turn
; the sound effects and the tune on and off. Called round a loop until Space.
.backpack_keys
    LDX backpack_slot                   ; the selected object's name
    LDA backpack, X
    JSR print_selected_name
    LDX menu_key_left                   ; left...
    JSR key_pressed
    BEQ backpack_select
    LDX menu_key_right                  ; ...or right
    JSR key_pressed
    BEQ backpack_select_right
    LDA level                           ; the map?
    CMP io_map_levels
    BCS backpack_keys_sound
    LDX key_map
    JSR key_pressed
    BNE backpack_keys_sound
    PLA                                 ; out of the backpack screen
    PLA
    JMP show_map
.backpack_keys_sound
    LDX #LO(KEY_S)                      ; S: sound effects
    JSR key_pressed
    BEQ backpack_toggle_effects
    LDX #LO(KEY_T)                      ; T: the tune
    JSR key_pressed
    BNE backpack_keys_done
    LDA tune_off
    EOR #&01
    STA tune_off
    BNE backpack_tune_off
    JSR start_tune                      ; on
    BNE backpack_show_settings

; Show the new setting, then wait a moment so the key doesn't repeat.
.backpack_tune_off
    JSR flush_buffers                   ; off
.backpack_show_settings
    LDX #&18                            ; blank the old setting
    LDY #&17
    LDA #&00
    JSR draw_thing_at
    JSR print_sound_settings            ; and print the new
    JMP L1B12                           ; a pause
.backpack_toggle_effects
    LDA effects_off
    EOR #&01
    STA effects_off
    BPL backpack_show_settings
.backpack_select_right
    LDY #&01                            ; right (key_pressed leaves Y = &FF for left)

; Move the selection Y (-1 or 1) slots, sliding the cursor (the player's
; picture) along below the backpack; off either end it slides all the way
; back to the other.
.backpack_select
    STY work2
    JSR selection_position              ; where the cursor is
    STX work0
    STY work1
    LDA backpack_slot
    CLC
    ADC work2
    BMI backpack_select_wrap_left       ; off the left?
    CMP io_backpack_last                ; off the right?
    BEQ backpack_select_slide
    BCS backpack_select_wrap_right
.backpack_select_slide
    STA backpack_slot
    LDA #&06                            ; six character steps a slot
    STA work3
.backpack_slide_cursor
    JSR wait_vsync
    JSR wait_vsync
    LDX work0                           ; rub out...
    LDY work1
    LDA #HI(io_tiles)                   ; ...with the floor
    JSR draw_page_picture
    LDA work0
    CLC
    ADC work2
    STA work0
    TAX
    LDY work1
    LDA #HI(io_player + 2 * 128)        ; draw it a character on
    JSR draw_page_picture
    DEC work3
    BNE backpack_slide_cursor
.backpack_keys_done
    RTS
.backpack_select_wrap_left
    LDA io_backpack_last
    BNE backpack_select_wrap
.backpack_select_wrap_right
    LDA #&00
.backpack_select_wrap
    PHA
    LDA work2                           ; slide back the other way
    EOR #&FE
    STA work2
    JSR selection_position
    LDA #HI(io_tiles)
    JSR draw_page_picture
    LDY #&0B                            ; from below the screen's middle row
    STY work1
    LDX work0
    LDA #HI(io_player + 2 * 128)
    JSR draw_page_picture
    LDA io_backpack_last                ; six steps for each slot
    ASL A
    STA work3
    ASL A
    ADC work3
    STA work3
    JSR backpack_slide_cursor
    PLA
    STA backpack_slot
    JSR selection_position
    INY
    LDA #HI(io_tiles)
    JSR draw_page_picture
    JSR selection_position
    LDA #HI(io_player + 2 * 128)

; Draw the picture at A * 256 at character position (X, Y).
.draw_page_picture
    STA sprite_high
    LDA #&00
    STA sprite
    SEC
    JMP draw_sprite

; The selection cursor's character position: X = slot * 6 + 7, Y = 10.
.selection_position
    LDA backpack_slot
    ASL A                               ; * 6
    ASL A
    ADC backpack_slot
    ADC backpack_slot
    ADC #&07                            ; + 7
    TAX
    LDY #&0A
    RTS

; A clear screen with the floor pattern, the frame and the PIPELINE heading,
; for the title and backpack screens.
.draw_screen_frame
    LDA #&02
    STA view_x
    STA view_y
    DEC fill_screen                     ; fill with the floor pattern
    JSR clear_screen
    INC fill_screen
    JSR draw_title_border
    JSR print_inline
    EQUB &1F, &00, &09, &11, &02, &11, &80
    EQUS "PIPELINE"
    NOP
    RTS

; The backpack screen (A is the number of lives; the carry set leaves out the
; mission text): the mission, a picture of the player for each life, the
; exit's icon once it's lit, and what's in the backpack.
.draw_backpack_screen
    PHP
    STA work3
    JSR draw_screen_frame
    PLP
    BCS draw_lives
    LDY #LO(io_mission_text - io_object_names); the mission text
    LDX #IO_MISSION_SIZE - 1
    JSR print_names_text
.draw_lives
    LDA facing                          ; the player's picture for the way they face
    LSR A
    ROR A
    STA sprite
    LDA #&00
    ADC #HI(io_player)
    STA sprite_high
    LDA work3
    ASL A
    ASL A
    ASL A
    TAX
    LDY #&1B                            ; along the bottom
    SEC
    JSR draw_sprite
    DEC work3
    BNE draw_lives
    LDA stage                           ; the exit lit?
    BEQ draw_backpack
    JSR draw_exit_icon
.draw_backpack
    LDA #&03
    STA work0
.draw_backpack_slot
    LDX work0
    LDA backpack, X
    BMI draw_backpack_next              ; empty?
    ASL A
    ASL A
    TAY
    JSR object_icon                     ; its icon
    STX sprite
    STY sprite_high
    LDA work0                           ; at slot * 6 + 7, 7
    ASL A
    ASL A
    ADC work0
    ADC work0
    ADC #&07
    TAX
    LDY #&07
    CLC                                 ; on the floor
    JSR draw_sprite
.draw_backpack_next
    DEC work0
    BPL draw_backpack_slot
.map_key_done
    RTS

; M: the map, on levels below io_map_levels. Also from the backpack screen.
.map_key
    LDA level
    CMP io_map_levels                   ; no map this level?
    BCS map_key_done
    JSR save_view                       ; remember the view
    JSR clear_screen

; The map view, scrolled to put the player in the middle where it can: Z and
; X scroll it, Space goes back. The SBC's operand, &10, is also used as a
; mask by BIT (see bit4_mask).
.show_map
    LDA player_x                        ; player_x - 16...
    SEC
.show_map_centre
    SBC #16
    BCS show_map_clamp
    LDA #&00
.show_map_clamp
    CMP #33                             ; ...between 0 and 32
    BCC show_map_draw
    LDA #32
.show_map_draw
    STA screen_start
    JSR blank_display                   ; draw it with the display off
    JSR draw_map_view
    JSR setup_crtc
.show_map_loop
    BIT ESCAPE_FLAG
    BMI show_map_escape
    LDX menu_key_left                   ; Z
    JSR key_pressed
    BNE show_map_right
    JSR map_view_scroll_left
    JMP show_map_space
.show_map_right
    LDX menu_key_right                  ; X
    JSR key_pressed
    BNE show_map_space
    JSR map_view_scroll_right
.show_map_space
    LDX #LO(KEY_SPACE)                  ; Space
    JSR key_pressed
    BNE show_map_loop
    JSR clear_screen                    ; back to the game
    JMP backpack_screen_done
.show_map_escape
    JMP give_up

; The selected object's name, A, under the backpack: or blank if A is
; negative.
.print_selected_name
    PHA
    JSR print_inline                    ; TAB(6, 31) COLOUR 129 COLOUR 3
    EQUB &1F, &06, &1F, &11, &81, &11, &03
    NOP
    PLA
    BPL print_selected_object
    LDA #&08                            ; nothing selected: back a character...
    JSR OSWRCH
    LDY #&0E
    LDA #&20                            ; ...and 14 spaces
.print_selected_blank
    JSR OSWRCH
    DEY
    BNE print_selected_blank
    BEQ print_selected_done
.print_selected_object
    ASL A
    ASL A
    TAY
    LDA objects + 2, Y
    JSR print_object_name
.print_selected_done
    JSR print_inline                    ; COLOUR 128
    EQUB &11, &80
    NOP
    RTS

; Remember where the view is, in work4 and work5, for backpack_screen_done.
.save_view
    LDA view_x
    STA work4
    LDA view_y
    STA work5
    RTS

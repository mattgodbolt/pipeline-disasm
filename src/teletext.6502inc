; Mode 7 (SAA5050 teletext) control codes, as the BBC's screen memory holds
; them. Each takes a character cell, shown as a space, and changes the rest
; of its row from there (the chip ignores bit 7, and the OS writes them
; with it set). Characters &A0-&BF and &E0-&FF in a graphics colour are
; 2x3 blocks of "sixels"; &C0-&DF stay letters even then.

TT_ALPHA_RED        = &81
TT_ALPHA_GREEN      = &82
TT_ALPHA_YELLOW     = &83
TT_ALPHA_BLUE       = &84
TT_ALPHA_MAGENTA    = &85
TT_ALPHA_CYAN       = &86
TT_ALPHA_WHITE      = &87
TT_FLASH            = &88
TT_STEADY           = &89
TT_NORMAL_HEIGHT    = &8C
TT_DOUBLE_HEIGHT    = &8D
TT_GRAPHICS_RED     = &91
TT_GRAPHICS_GREEN   = &92
TT_GRAPHICS_YELLOW  = &93
TT_GRAPHICS_BLUE    = &94
TT_GRAPHICS_MAGENTA = &95
TT_GRAPHICS_CYAN    = &96
TT_GRAPHICS_WHITE   = &97
TT_CONCEAL          = &98
TT_CONTIGUOUS       = &99
TT_SEPARATED        = &9A
TT_BLACK_BACKGROUND = &9C
TT_NEW_BACKGROUND   = &9D   ; the background takes the current foreground colour
TT_HOLD_GRAPHICS    = &9E
TT_RELEASE_GRAPHICS = &9F

TT_SOLID_BLOCK      = &FF   ; all six sixels lit

MODE7_COLUMNS = 40
MODE7_ROWS    = 25
MODE7_SCREEN  = &7C00
